# Materuni Hosts — local configuration template
# Copy this file to .env (never commit .env).
# Astro exposes ONLY PUBLIC_ variables to browser bundles.
# These two values are public client credentials; protect data with Supabase RLS.

PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Optional public site metadata (not required by the current static build).
PUBLIC_SITE_URL=https://materunihosts.com

# ---------------------------------------------------------------------------
# SERVER / SUPABASE EDGE FUNCTION SECRETS
# Do NOT prefix these with PUBLIC_. Do NOT put them in client-side code.
# Configure with: supabase secrets set NAME=value
# For local Edge Function development use supabase/functions/.env (gitignored).
# Supabase-hosted Edge Functions provide SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY automatically; do not manually publish them.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# RESEND_API_KEY=
# EMAIL_FROM=Materuni Hosts <bookings@your-verified-domain.com>
# ADMIN_NOTIFICATION_EMAIL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ADMIN_NUMBER=255...
# WHATSAPP_BOOKING_TEMPLATE=
# WHATSAPP_TEMPLATE_LANGUAGE=en

# ---------------------------------------------------------------------------
# HOSTING
# Vercel automatically supplies VERCEL, VERCEL_ENV, VERCEL_URL and
# VERCEL_PROJECT_PRODUCTION_URL in its build/runtime environment.
# Netlify automatically supplies CONTEXT, URL, DEPLOY_URL and SITE_ID.
# No custom Netlify/Vercel variables are required for the current static build.
# Do not copy hosting system variables into PUBLIC_ variables.
# ---------------------------------------------------------------------------
