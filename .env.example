# Materuni Hosts v59 — safe environment template
# Copy to .env for local Astro development. Never commit .env.
# Only PUBLIC_* values may be shipped to the browser.

PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
PUBLIC_SITE_URL=http://localhost:4321

# Supabase Edge Function secrets — server-side ONLY.
# Hosted Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Never add either to PUBLIC_ variables, Astro code, or Git.
# ALLOWED_ORIGINS=https://materunihosts.com,https://www.materunihosts.com,http://localhost:4321
# Add your exact preview hostname here before testing from a preview deployment.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# RESEND_API_KEY=
# EMAIL_FROM=Materuni Hosts <bookings@your-verified-domain.com>
# ADMIN_NOTIFICATION_EMAIL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ADMIN_NUMBER=255XXXXXXXXX
# WHATSAPP_BOOKING_TEMPLATE=
# WHATSAPP_TEMPLATE_LANGUAGE=en

# Vercel: Astro build command npm run build; output dist.
# Vercel provides VERCEL, VERCEL_ENV and VERCEL_URL automatically.
# Netlify (preview/testing only): npm run build; publish directory dist.
# Netlify provides CONTEXT, URL and DEPLOY_URL automatically.
# Do not place hosting access tokens or provider secrets in browser variables.
