---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import { supabaseUrl } from "../lib/supabase-public";

const mediaBase = `${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const waterfall = mediaBase + "waterfall_image/1791998303073-materuni-waterfall-hike.jpg";
const coffee = mediaBase + "coffee_image/1791998412318-materuni-tour.jpg";
const cooking = mediaBase + "cooking_image/1791998880538-materuni-cooking-lesson.jpg";
const community = mediaBase + "story_image/1791995912146-materuni-community.jpg";
---
<SiteLayout
  title="About Materuni Hosts | Local Chagga Experiences in Materuni"
  description="Meet Materuni Hosts: locally hosted waterfall walks, Chagga coffee and cooking experiences, village culture and day trips in Materuni near Moshi, Tanzania."
>
<main class="about-page">
  <section class="about-hero">
    <div class="about-hero-copy">
      <p class="eyebrow">OUR STORY · MATERUNI VILLAGE · KILIMANJARO</p>
      <h1>Discover Materuni with people who know the place.</h1>
      <p>Materuni Hosts welcomes visitors to experience the landscapes, culture and everyday life of Materuni Village, near Moshi in Tanzania’s Kilimanjaro Region. Our experiences connect guests with local hosts through guided walks, Chagga coffee traditions, food, village culture and time outdoors.</p>
      <div class="actions">
        <a class="button" href="/experiences">Explore all experiences</a>
        <a class="text-link" href="/booking">Plan your visit</a>
      </div>
    </div>
    <Image src={community} alt="Community life and local hosting in Materuni Village" width={900} height={760} format="webp" quality={78} loading="eager" fetchpriority="high" />
  </section>

  <section class="about-intro">
    <p class="eyebrow">WHO WE ARE</p>
    <h2>A local welcome, with a range of ways to explore.</h2>
    <p>Materuni Hosts is a locally hosted tourism business based in Materuni Village, in the green foothills of Mount Kilimanjaro. We help visitors discover more of the area through a balanced range of nature, cultural and day-trip experiences.</p>
    <p>Whether you come for the waterfall, want to learn how Chagga coffee is prepared, join a traditional cooking session or explore the wider Moshi area, we aim to make your visit clear, welcoming and connected to the place.</p>
  </section>

  <section class="experience-grid" aria-labelledby="about-experiences-title">
    <div class="section-heading">
      <p class="eyebrow">EXPERIENCES</p>
      <h2 id="about-experiences-title">Different ways to experience Materuni.</h2>
      <p>Choose the experience that best matches your interests and the time you have.</p>
    </div>
    <article class="experience">
      <Image src={waterfall} alt="Waterfall and forest walk in Materuni" width={720} height={520} format="webp" quality={76} loading="lazy" />
      <div><h3>Waterfall and nature walks</h3><p>Follow local walking routes through the green landscape to Materuni Waterfall and discover the natural setting around the village.</p><a href="/materuni-waterfall-tour">Explore waterfall tours</a></div>
    </article>
    <article class="experience">
      <Image src={coffee} alt="Traditional coffee experience with local hosts in Materuni" width={720} height={520} format="webp" quality={76} loading="lazy" />
      <div><h3>Chagga coffee and village culture</h3><p>Learn about local coffee traditions, take part in roasting and grinding, and spend time discovering village life with local hosts.</p><a href="/materuni-coffee-tour">Explore the coffee experience</a></div>
    </article>
    <article class="experience">
      <Image src={cooking} alt="Traditional Chagga cooking experience in Materuni" width={720} height={520} format="webp" quality={76} loading="lazy" />
      <div><h3>Traditional food and cooking</h3><p>Take part in a hands-on cooking experience and learn about ingredients and food traditions from the area.</p><a href="/experiences">Explore all experiences</a></div>
    </article>
  </section>

  <section class="local-approach">
    <div>
      <p class="eyebrow">OUR LOCAL APPROACH</p>
      <h2>Experiences shaped by local knowledge.</h2>
      <p>Our hosts help guests understand the place beyond the viewpoints. Depending on the experience, a visit may include a guided village walk, coffee preparation, local food, cultural activities or a nature walk. Activities and inclusions are explained before a booking is confirmed.</p>
      <ul>
        <li>Local hosts and guides who share knowledge of Materuni and the surrounding area.</li>
        <li>Experiences that introduce Chagga food, coffee traditions and village life respectfully.</li>
        <li>Clear per-person prices and experience details before you confirm.</li>
        <li>Thoughtful visits that encourage respect for local people, culture and the natural environment.</li>
      </ul>
      <a class="button" href="/sustainability">Our approach to community and sustainability</a>
    </div>
    <Image src={community} alt="Materuni community and village setting" width={760} height={900} format="webp" quality={76} loading="lazy" />
  </section>

  <section class="about-next">
    <p class="eyebrow">PLAN YOUR VISIT</p>
    <h2>Start with the experience that interests you.</h2>
    <p>Compare our tours and day trips, check what is included, then send a booking request. Your host will confirm availability and arrangements before your booking is final.</p>
    <div class="actions">
      <a class="button" href="/experiences">View experiences</a>
      <a class="text-link" href="/booking">Send a booking request</a>
      <a class="text-link" href="/contact">Contact Materuni Hosts</a>
    </div>
  </section>
</main>
</SiteLayout>

<style>
.about-page{color:#242421}
.about-page .about-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(280px,.95fr);gap:clamp(28px,5vw,68px);align-items:center;padding:clamp(48px,7vw,88px) clamp(22px,7vw,100px);background:#1a3322;color:#faf7f2}
.about-page .about-hero img{width:100%;height:clamp(280px,38vw,470px);object-fit:cover;border-radius:16px}
.about-page .eyebrow{color:#c5a059;font:800 11px Manrope,sans-serif;letter-spacing:.16em}
.about-page h1,.about-page h2{font-family:"Cormorant Garamond",serif;font-weight:600;line-height:1.05}
.about-page h1{font-size:clamp(44px,6vw,72px);margin:14px 0}
.about-page h2{font-size:clamp(34px,4.5vw,52px);color:#1a3322;margin:10px 0 18px}
.about-page .about-hero p:not(.eyebrow){max-width:680px;color:#e6dfd3;line-height:1.85}
.about-page .actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:24px}
.about-page .button{display:inline-block;padding:13px 21px;border-radius:999px;background:#c5a059;color:#1a3322;text-decoration:none;font:800 13px Manrope,sans-serif}
.about-page .text-link{color:inherit;font-weight:800;text-underline-offset:4px}
.about-page .about-intro,.about-page .experience-grid,.about-page .local-approach,.about-page .about-next{max-width:1160px;margin:auto;padding:clamp(42px,6vw,76px) 24px}
.about-page .about-intro{max-width:900px}
.about-page p,.about-page li{color:#586258;line-height:1.85}
.about-page .experience-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.about-page .section-heading{grid-column:1/-1;max-width:760px}
.about-page .experience{overflow:hidden;border:1px solid #e6dfd3;border-radius:16px;background:#fff}
.about-page .experience img{display:block;width:100%;height:220px;object-fit:cover}
.about-page .experience div{padding:20px}
.about-page h3{color:#1a3322;font:700 17px Manrope,sans-serif}
.about-page .experience a{color:#1a3322;font-weight:800;text-underline-offset:4px}
.about-page .local-approach{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(260px,.9fr);gap:clamp(28px,5vw,60px);align-items:center;background:#f4efe6;max-width:none;padding-left:max(24px,calc((100% - 1112px)/2));padding-right:max(24px,calc((100% - 1112px)/2))}
.about-page .local-approach img{width:100%;height:420px;object-fit:cover;border-radius:16px}
.about-page li{margin:8px 0}
.about-page .about-next{text-align:center;max-width:820px}
.about-page .about-next .actions{justify-content:center}
@media(max-width:760px){.about-page .about-hero,.about-page .local-approach{grid-template-columns:1fr}.about-page .about-hero{padding:48px 22px}.about-page .about-hero img{height:260px}.about-page .experience-grid{grid-template-columns:1fr}.about-page .local-approach{padding:42px 22px}.about-page .local-approach img{height:280px}}
</style>
