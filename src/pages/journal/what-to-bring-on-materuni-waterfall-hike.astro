    line-height: 1.65;
    margin: 0 0 24px;
  }
  .cta-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .gold-button {
    background: #C5A059;
    color: #1A3322 !important;
    font: 700 13px/1 "Manrope", sans-serif;
    padding: 14px 26px;
    border-radius: 2px;
    display: inline-flex;
    align-items: center;
    text-decoration: none !important;
  }
  .outline-button {
    background: transparent;
    border: 1px solid #FAF7F2;
