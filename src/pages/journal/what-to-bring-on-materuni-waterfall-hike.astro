  }
  .article-body ul {
    margin: 0 0 28px;
    padding-left: 22px;
  }
  .article-body li {
    margin-bottom: 10px;
  }
  .divider {
    border: 0;
    border-top: 1px solid #E6DFD3;
    margin: 40px 0;
  }
  .in-content-media {
