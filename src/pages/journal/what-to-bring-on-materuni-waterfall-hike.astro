    background: #FFFFFF;
    border: 1px solid #E6DFD3;
    padding: 18px 22px;
  }
  .faq-card summary {
    font: 600 18px/1.3 "Cormorant Garamond", Georgia, serif;
    color: #1A3322;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .faq-card summary::-webkit-details-marker {
    display: none;
  }
  .faq-card .chevron {
    font-size: 20px;
    color: #C5A059;
    font-weight: 300;
  }
  .faq-card[open] .chevron {
    transform: rotate(45deg);
  }
  .faq-body {
