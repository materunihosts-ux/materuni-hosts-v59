    margin: 48px 0;
    border-radius: 4px;
  }
  .booking-cta-card .eyebrow {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C5A059;
    font-weight: 700;
    display: block;
    margin-bottom: 10px;
  }
  .booking-cta-card h3 {
    font: 600 clamp(24px, 3.2vw, 34px)/1.2 "Cormorant Garamond", Georgia, serif;
    color: #FAF7F2;
    margin: 0 0 12px;
  }
  .booking-cta-card p {
    color: #E6DFD3;
