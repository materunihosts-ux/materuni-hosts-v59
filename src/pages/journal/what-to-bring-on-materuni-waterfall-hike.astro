    background: #1A3322;
    color: #FAF7F2;
    padding: clamp(32px, 5vw, 48px);
    margin: 48px 0;
    border-radius: 4px;
  }
  .booking-cta-card .eyebrow {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C5A059;
    font-weight: 700;
    display: block;
    margin-bottom: 10px;
  }
  .booking-cta-card h3 {
    font: 600 clamp(24px, 3.2vw, 34px)/1.2 "Cormorant Garamond", Georgia, serif;
    color: #FAF7F2;
    margin: 0 0 12px;
  }
  .booking-cta-card p {
    color: #E6DFD3;
    font-size: 15px;
    line-height: 1.65;
    margin: 0 0 24px;
  }
  .cta-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .gold-button {
    background: #C5A059;
    color: #1A3322 !important;
    font: 700 13px/1 "Manrope", sans-serif;
    padding: 14px 26px;
    border-radius: 2px;
    display: inline-flex;
    align-items: center;
    text-decoration: none !important;
  }
  .outline-button {
    background: transparent;
    border: 1px solid #FAF7F2;
    color: #FAF7F2 !important;
    font: 700 13px/1 "Manrope", sans-serif;
