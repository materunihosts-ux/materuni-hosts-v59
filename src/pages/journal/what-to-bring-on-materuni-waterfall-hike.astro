    margin-bottom: 12px;
  }
  .article-header h1 {
    font: 600 clamp(32px, 4.5vw, 50px)/1.15 "Cormorant Garamond", Georgia, serif;
    color: #1A3322;
    margin: 0 0 20px;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: #6D716B;
    border-top: 1px solid #E6DFD3;
    padding-top: 16px;
  }
  .meta-authors strong {
