  }
  .article-featured-media {
    margin: 0 0 44px;
    border-radius: 4px;
    overflow: hidden;
  }
  .featured-img {
    width: 100%;
    height: auto;
    display: block;
  }
  figcaption {
    font-size: 13px;
    color: #6D716B;
    margin-top: 10px;
    font-style: italic;
  }
  .article-body {
    font-size: 17px;
    line-height: 1.8;
