    color: #6D716B;
    margin-top: 10px;
    font-style: italic;
  }
  .article-body {
    font-size: 17px;
    line-height: 1.8;
    color: #242421;
  }
  .article-body p {
    margin: 0 0 24px;
  }
  .article-body h2 {
    font: 600 clamp(24px, 3vw, 34px)/1.2 "Cormorant Garamond", Georgia, serif;
    color: #1A3322;
    margin: 40px 0 16px;
  }
  .article-body a {
    color: #80652F;
    text-decoration: underline;
  }
  .divider {
    border: 0;
    border-top: 1px solid #E6DFD3;
