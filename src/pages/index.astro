---
import SiteLayout from "../layouts/SiteLayout.astro";
const experiences=[
{name:"Waterfalls & Coffee Tour",price:65,tag:"First-time visitors",image:"waterfall_image/1791601414950-ew7ak42gjka.jpg",desc:"A well-rounded introduction to Materuni: follow a guided forest trail to the 95-metre waterfall, then enjoy a hands-on Chagga coffee experience with local hosts.",items:["Guided rainforest waterfall hike","Bean-to-cup coffee with local hosts","Traditional songs, dance & banana brew","Home-cooked local lunch"]},
{name:"Coffee & Chagga Culture Tour",price:50,tag:"Best value",image:"coffee_image/1791601540965-5mt58f2ipoe.jpg",desc:"A culture-led visit centred on the journey from coffee bean to cup, with time to learn about village life and Chagga traditions.",items:["Roast, grind and brew coffee","Guided village nature walk","Live Chagga dancing","Local lunch & banana brew"]},
{name:"Cooking & Culture",price:70,tag:"For food lovers",image:"cooking_image/1791601646297-7th6jahyw0w.jpg",desc:"Step into the kitchen with local hosts, learn traditional Chagga cooking methods and take part rather than simply watch.",items:["Traditional firewood cooking","Prepare local dishes with hosts","Organic coffee-making","Village walk, dance & banana brew"]},
{name:"Waterfall Hike & Cultural Day Trip",price:75,tag:"Signature day trip",image:"culturalday_image/1791604657693-kcwbk80tcfs.jpg",desc:"For guests who want to give the day more room: combine the waterfall hike with coffee, cultural activities and time to enjoy Materuni at an unhurried pace.",items:["Rainforest hike to Materuni Waterfall","Time to enjoy the waterfall","Coffee experience with village hosts","Local lunch & traditional dance"]},
{name:"Overnight Camping",price:110,tag:"Overnight experience",image:"camping_image/1791601872981-zmji0mykwhd.jpg",desc:"Stay longer and experience Materuni beyond a day visit, with an overnight camp, local food, storytelling and time in the village.",items:["Waterfall hike & village experience","Traditional cooking class","Camping gear setup & overnight stay","Campfire storytelling, dinner & breakfast"]},
{name:"Ultimate",price:135,tag:"Ultimate experience",image:"ultimate_image/1791604660208-7c4yvzvsaf9.jpg",desc:"A multi-experience stay bringing together the waterfall, coffee-making, Chagga cooking and overnight camping in one visit.",items:["Scenic waterfall hike","Hands-on Chagga cooking class","Organic coffee tour","Camping, campfire, dance & meals"]}
];
const base="https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/";
---
<SiteLayout preloadImage={base + "hero_image/1791600514716-b2bclfcnhhh.jpg"}>
<section class="hero"><div class="hero-copy"><span class="eyebrow">MATERUNI VILLAGE · MOSHI · KILIMANJARO, TANZANIA</span><h1 data-site-content="hero_title">Come closer to the heart of Chagga life.</h1><p data-site-content="hero_intro">Follow a forest trail to the waterfall, learn the art of Chagga coffee-making and share the flavours and stories of village life. In Materuni, the most memorable moments are often the ones shared with local people.</p><div class="actions"><a class="button light" href="/experiences">Explore experiences</a><a class="button secondary" href="/booking">Check availability</a></div></div><div class="hero-image" data-site-image="hero_image" role="img" aria-label="Materuni rainforest and village landscape"></div></section>
<div class="trust-strip"><span>LOCAL CHAGGA HOSTS</span><span>AUTHENTIC VILLAGE EXPERIENCES</span><span>CLEAR PER-PERSON PRICING</span><span>A PERSONAL LOCAL WELCOME</span></div>
<section class="section"><div class="section-head"><span class="eyebrow">FIND YOUR MATERUNI MOMENT</span><h2 data-site-content="experiences_title">Six ways to experience the village</h2><p data-site-content="experiences_intro">From a focused coffee visit to a full day outdoors or an overnight stay, choose the pace and experiences that suit your time in the village.</p></div><div class="cards">{experiences.map((e)=><article class="experience-card"><img src={base+e.image} data-site-image={e.image.split("/")[0]} alt={e.name} loading="lazy" decoding="async" width="640" height="420"><div class="card-body"><div class="card-top"><span class="pill">{e.tag}</span><span class="price">${e.price}<small>PER PERSON</small></span></div><h3>{e.name}</h3><p>{e.desc}</p><ul>{e.items.slice(0,3).map(item=><li>{item}</li>)}</ul><a class="button" href={"/booking?experience="+encodeURIComponent(e.name)}>Check availability</a></div></article>)}</div></section>
<section class="section" style="background:#f0eadf"><div class="split"><img src={base+"story_image/1791601761441-q3iog8mni3r.jpg"} data-site-image="story_image" alt="Local coffee experience with Materuni hosts" loading="lazy" decoding="async" width="640" height="720"><div><span class="eyebrow">MORE THAN A TOUR</span><h2 data-site-content="story_title">A village experience, shared by local hosts.</h2><p data-site-content="story_desc">Materuni is best discovered at a human pace. Learn by doing, listen to stories, taste food prepared in the village and spend time with the people who call this place home.</p><div class="feature-list"><div><strong>Rooted in culture</strong>Meet Chagga traditions through everyday life.</div><div><strong>Made for participation</strong>Learn by doing: roast and prepare coffee, explore village paths and join in where your chosen experience allows.</div><div><strong>Clear inclusions</strong>Know what is part of your experience.</div><div><strong>Personal contact</strong><span data-site-content="story_desc2">Speak directly with your local host.</span></div></div><a class="button" href="/sustainability">Our approach</a></div></div></section>
<section class="band"><span class="eyebrow">YOUR MATERUNI STORY STARTS HERE</span><h2>Make room for a real connection.</h2><p>Share your preferred date, group size and the experience you have in mind. We will check the calendar, discuss practical details and help you prepare for your visit.</p><div class="actions" style="justify-content:center"><a class="button light" href="/booking">Check dates & book</a><a class="button secondary" href="https://wa.me/255612068540" target="_blank" rel="noopener">Chat on WhatsApp</a></div></section>
<script>
const siteContentEndpoint="https://sskmzswoeljxwojcszta.supabase.co/rest/v1/site_content?select=id,content&id=in.(hero_image,story_image,waterfall_image,coffee_image,cooking_image,culturalday_image,camping_image,ultimate_image,hero_title,hero_intro,experiences_title,experiences_intro,story_title,story_desc,story_desc2)";
const siteContentKey="sb_publishable_G9ru4P_yKzievqiXjXEEbQ_p28cB_NZ";
fetch(siteContentEndpoint,{headers:{apikey:siteContentKey,Authorization:"Bearer "+siteContentKey}})
 .then(response=>response.ok?response.json():[])
 .then(rows=>{
  if(!Array.isArray(rows))return;
  const content=new Map(rows.filter(row=>typeof row.content==="string"&&/^https:\/\//i.test(row.content)).map(row=>[row.id,row.content]));
  document.querySelectorAll("[data-site-content]").forEach(node=>{const value=content.get(node.dataset.siteContent);if(value)node.textContent=value});
  document.querySelectorAll("[data-site-image]").forEach(node=>{
   const url=content.get(node.dataset.siteImage);if(!url)return;
   if(node.tagName==="IMG")node.src=url;
   else node.style.backgroundImage="linear-gradient(0deg,rgba(14,35,25,.22),rgba(14,35,25,.04)),url("+JSON.stringify(url)+")";
  });
 }).catch(()=>{});
</script>
</SiteLayout>