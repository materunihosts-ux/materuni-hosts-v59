---
import SiteLayout from "../layouts/SiteLayout.astro";
const experiences=[
{key:"Waterfall & Chagga Culture",name:"Waterfalls & Coffee Tour",price:65,tag:"First-time visitors",image:"waterfall_image/1791601414950-ew7ak42gjka.jpg",desc:"A well-rounded introduction to Materuni: follow a guided forest trail to the 95-metre waterfall, then enjoy a hands-on Chagga coffee experience with local hosts.",items:["Guided rainforest waterfall hike","Bean-to-cup coffee with local hosts","Traditional songs, dance & banana brew","Home-cooked local lunch"]},
{key:"Traditional Coffee Experience",name:"Coffee & Chagga Culture Tour",price:50,tag:"Best value",image:"coffee_image/1791601540965-5mt58f2ipoe.jpg",desc:"A culture-led visit centred on the journey from coffee bean to cup, with time to learn about village life and Chagga traditions.",items:["Roast, grind and brew coffee","Guided village nature walk","Live Chagga dancing","Local lunch & banana brew"]},
{key:"Traditional Chagga Cooking Class",name:"Cooking & Culture",price:70,tag:"For food lovers",image:"cooking_image/1791601646297-7th6jahyw0w.jpg",desc:"Step into the kitchen with local hosts, learn traditional Chagga cooking methods and take part rather than simply watch.",items:["Traditional firewood cooking","Prepare local dishes with hosts","Organic coffee-making","Village walk, dance & banana brew"]},
{key:"Materuni Waterfall Hike & Cultural Day Trip",name:"Waterfall Hike & Cultural Day Trip",price:75,tag:"Signature day trip",image:"culturalday_image/1791604657693-kcwbk80tcfs.jpg",desc:"For guests who want to give the day more room: combine the waterfall hike with coffee, cultural activities and time to enjoy Materuni at an unhurried pace.",items:["Rainforest hike to Materuni Waterfall","Time to enjoy the waterfall","Coffee experience with village hosts","Local lunch & traditional dance"]},
{key:"Camping & Village Life",name:"Overnight Camping",price:110,tag:"Overnight experience",image:"camping_image/1791601872981-zmji0mykwhd.jpg",desc:"Stay longer and experience Materuni beyond a day visit, with an overnight camp, local food, storytelling and time in the village.",items:["Waterfall hike & village experience","Traditional cooking class","Camping gear setup & overnight stay","Campfire storytelling, dinner & breakfast"]},
{key:"The Ultimate Kilimanjaro Foothills & Materuni Experience",name:"Ultimate",price:135,tag:"Ultimate experience",image:"ultimate_image/1791604660208-7c4yvzvsaf9.jpg",desc:"A multi-experience stay bringing together the waterfall, coffee-making, Chagga cooking and overnight camping in one visit.",items:["Scenic waterfall hike","Hands-on Chagga cooking class","Organic coffee tour","Camping, campfire, dance & meals"]}
];
const base="https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/";
---
<SiteLayout title="Materuni Hosts | Authentic Chagga Experiences in Materuni" description="Discover Materuni Waterfalls, traditional Chagga coffee, village culture, cooking and camping with local hosts in Materuni Village near Moshi, Tanzania." preloadImage={base + "hero_image/1791600514716-b2bclfcnhhh.jpg"}>
<section class="hero"><div class="hero-copy"><span class="eyebrow">MATERUNI VILLAGE · MOSHI · KILIMANJARO, TANZANIA</span><h1 data-site-content="hero_title">Come closer to the heart of Chagga life.</h1><p data-site-content="hero_intro">Follow a forest trail to the waterfall, learn the art of Chagga coffee-making and share the flavours and stories of village life. In Materuni, the most memorable moments are often the ones shared with local people.</p><div class="actions"><a class="button light" href="/experiences">Explore experiences</a><a class="button secondary" href="/booking">Check availability</a></div></div><div class="hero-image" data-site-image="hero_image" role="img" aria-label="Materuni rainforest and village landscape"></div></section>
<div class="trust-strip"><span>LOCAL CHAGGA HOSTS</span><span>AUTHENTIC VILLAGE EXPERIENCES</span><span>CLEAR PER-PERSON PRICING</span><span>A PERSONAL LOCAL WELCOME</span></div>
<section class="section"><div class="section-head"><span class="eyebrow">FIND YOUR MATERUNI MOMENT</span><h2 data-site-content="experiences_title">Six ways to experience the village</h2><p data-site-content="experiences_intro">From a focused coffee visit to a full day outdoors or an overnight stay, choose the pace and experiences that suit your time in the village.</p></div><div class="cards">{experiences.map((e)=><article class="experience-card" data-catalog-key={e.key}><img src={base+e.image} data-site-image={e.image.split("/")[0]} alt={e.name} loading="lazy" decoding="async" width="640" height="420"><div class="card-body"><div class="card-top"><span class="pill">{e.tag}</span><span class="price" data-price-usd={e.price}>${e.price}<small>PER PERSON</small></span></div><h3>{e.name}</h3><p>{e.desc}</p><ul>{e.items.slice(0,3).map(item=><li>{item}</li>)}</ul><a class="button" href={"/booking?experience="+encodeURIComponent(e.name)}>Check availability</a></div></article>)}</div></section>
<section class="section" style="background:#f0eadf"><div class="split"><img src={base+"story_image/1791601761441-q3iog8mni3r.jpg"} data-site-image="story_image" alt="Local coffee experience with Materuni hosts" loading="lazy" decoding="async" width="640" height="720"><div><span class="eyebrow">MORE THAN A TOUR</span><h2 data-site-content="story_title">A village experience, shared by local hosts.</h2><p data-site-content="story_desc">Materuni is best discovered at a human pace. Learn by doing, listen to stories, taste food prepared in the village and spend time with the people who call this place home.</p><div class="feature-list"><div><strong>Rooted in culture</strong>Meet Chagga traditions through everyday life.</div><div><strong>Made for participation</strong>Learn by doing: roast and prepare coffee, explore village paths and join in where your chosen experience allows.</div><div><strong>Clear inclusions</strong>Know what is part of your experience.</div><div><strong>Personal contact</strong><span data-site-content="story_desc2">Speak directly with your local host.</span></div></div><a class="button" href="/sustainability">Our approach</a></div></div></section>
<section class="band"><span class="eyebrow">YOUR MATERUNI STORY STARTS HERE</span><h2>Make room for a real connection.</h2><p>Share your preferred date, group size and the experience you have in mind. We will check the calendar, discuss practical details and help you prepare for your visit.</p><div class="actions" style="justify-content:center"><a class="button light" href="/booking">Check dates & book</a><a class="button secondary" href="https://wa.me/255612068540" target="_blank" rel="noopener">Chat on WhatsApp</a></div></section>
<script>
// @ts-nocheck
const siteContentEndpoint="https://sskmzswoeljxwojcszta.supabase.co/rest/v1/site_content?select=id,content&id=in.(hero_image,story_image,waterfall_image,coffee_image,cooking_image,culturalday_image,camping_image,ultimate_image,hero_title,hero_intro,experiences_title,experiences_intro,story_title,story_desc,story_desc2)";
const siteContentKey="sb_publishable_G9ru4P_yKzievqiXjXEEbQ_p28cB_NZ";
const languageContentUrl="https://sskmzswoeljxwojcszta.supabase.co/rest/v1/site_settings?select=setting_value&setting_key=eq.language_content";
const applyHomepageLanguage=async()=>{
 const locale=(localStorage.getItem("materuni-language")||"en").toLowerCase();
 if(!["es","fr","de"].includes(locale))return;
 try{
  const response=await fetch(languageContentUrl,{headers:{apikey:siteContentKey,Authorization:"Bearer "+siteContentKey},cache:"no-store"});
  if(!response.ok)return;
  const rows=await response.json(),saved=rows?.[0]?.setting_value;
  const translations=typeof saved==="string"?JSON.parse(saved):saved;
  const copy=translations?.[locale];
  if(!copy||typeof copy!=="object")return;
  Object.entries(copy).forEach(([key,value])=>{
   if(typeof value!=="string"||!value.trim())return;
   const node=document.querySelector('[data-site-content="'+key+'"]');if(node)node.textContent=value;
  });
 }catch(error){console.warn("Homepage translations unavailable; showing English copy.",error)}
};

fetch(siteContentEndpoint,{headers:{apikey:siteContentKey,Authorization:"Bearer "+siteContentKey}})
 .then(response=>response.ok?response.json():[])
 .then(rows=>{
  if(!Array.isArray(rows))return;
  const content=new Map(rows.filter(row=>typeof row.content==="string").map(row=>[row.id,row.content]));
  document.querySelectorAll("[data-site-content]").forEach(node=>{const value=content.get(node.dataset.siteContent);if(value)node.textContent=value});
  document.querySelectorAll("[data-site-image]").forEach(node=>{
   const url=content.get(node.dataset.siteImage);if(!url||!/^https:\/\//i.test(url))return;
   if(node.tagName==="IMG")node.src=url;
   else node.style.backgroundImage="linear-gradient(0deg,rgba(14,35,25,.22),rgba(14,35,25,.04)),url("+JSON.stringify(url)+")";
  });
 }).catch(()=>{});
applyHomepageLanguage();
document.getElementById("site-language")?.addEventListener("change",applyHomepageLanguage);

fetch("https://sskmzswoeljxwojcszta.supabase.co/rest/v1/experience_catalog?select=experience_key,display_name,price_usd,short_description,full_description,image_url,duration_label,inclusions,exclusions,is_active,sort_order&order=sort_order.asc",{headers:{apikey:siteContentKey,Authorization:"Bearer "+siteContentKey},cache:"no-store"})
 .then(r=>r.ok?r.json():Promise.reject(new Error("Catalogue unavailable")))
 .then(tours=>{
  if(!Array.isArray(tours))return;
  const root=document.querySelector(".cards");
  if(!root)return;
  const makeList=(values)=>{
   const list=document.createElement("ul");
   (Array.isArray(values)?values:[]).forEach(value=>{if(typeof value!=="string"||!value.trim())return;const li=document.createElement("li");li.textContent=value;list.append(li)});
   return list;
  };
  const addDetails=(body,tour)=>{
   const inclusions=Array.isArray(tour.inclusions)?tour.inclusions:[];
   if(inclusions.length){const heading=document.createElement("strong");heading.textContent="WHAT'S INCLUDED";heading.className="catalog-detail-heading";body.append(heading,makeList(inclusions))}
   const exclusions=Array.isArray(tour.exclusions)?tour.exclusions:[];
   if(exclusions.length){const heading=document.createElement("strong");heading.textContent="WHAT'S NOT INCLUDED";heading.className="catalog-detail-heading";body.append(heading,makeList(exclusions))}
  };
  const existing=new Map();
  root.querySelectorAll("[data-catalog-key]").forEach(card=>existing.set(card.dataset.catalogKey,card));
  const active=tours.filter(t=>t.is_active);
  const activeKeys=new Set(active.map(t=>t.experience_key));
  existing.forEach((card,key)=>{if(!activeKeys.has(key))card.remove()});
  active.forEach(t=>{
   let card=existing.get(t.experience_key);
   if(!card){
    card=document.createElement("article");card.className="experience-card";card.dataset.catalogKey=t.experience_key;
    if(t.image_url&&/^https:\/\//i.test(t.image_url)){const img=document.createElement("img");img.src=t.image_url;img.alt=t.display_name||"Materuni experience";img.loading="lazy";img.decoding="async";img.width=640;img.height=420;card.append(img)}
    const body=document.createElement("div");body.className="card-body";
    const top=document.createElement("div");top.className="card-top";
    const pill=document.createElement("span");pill.className="pill";pill.textContent=t.duration_label||"Local experience";
    const price=document.createElement("span");price.className="price";price.dataset.priceUsd=String(t.price_usd);price.append(document.createTextNode("$"+Number(t.price_usd).toFixed(0)));const small=document.createElement("small");small.textContent="PER PERSON";price.append(small);top.append(pill,price);
    const title=document.createElement("h3");title.textContent=t.display_name||"Materuni experience";
    const desc=document.createElement("p");desc.textContent=t.full_description||t.short_description||"Ask our local hosts for details.";
    body.append(top,title,desc);addDetails(body,t);
    const link=document.createElement("a");link.className="button";link.href="/booking?experience="+encodeURIComponent(t.experience_key);link.textContent="Check availability";body.append(link);card.append(body);root.append(card);
    return;
   }
   const title=card.querySelector("h3"),price=card.querySelector(".price"),desc=card.querySelector(".card-body>p"),img=card.querySelector("img"),pill=card.querySelector(".pill"),body=card.querySelector(".card-body"),link=card.querySelector("a.button");
   if(title)title.textContent=t.display_name||"Materuni experience";
   if(price){price.dataset.priceUsd=String(t.price_usd);price.replaceChildren(document.createTextNode("$"+Number(t.price_usd).toFixed(0)));const small=document.createElement("small");small.textContent="PER PERSON";price.append(small)}
   if(desc&&(t.full_description||t.short_description))desc.textContent=t.full_description||t.short_description;
   if(img&&t.image_url&&/^https:\/\//i.test(t.image_url))img.src=t.image_url;
   if(pill&&t.duration_label)pill.textContent=t.duration_label;
   body.querySelectorAll(".catalog-detail-heading, .catalog-detail-heading + ul").forEach(node=>node.remove());
   addDetails(body,t);
   if(link)link.href="/booking?experience="+encodeURIComponent(t.experience_key);
  });
 })
 .catch(error=>console.warn("Using the built-in homepage catalogue because the live catalogue could not be loaded.",error));
</script>
</SiteLayout>