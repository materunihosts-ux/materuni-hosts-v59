---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image, getImage } from "astro:assets";
import { supabaseUrl } from "../lib/supabase-public";

const base = `${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const heroSource = base + "hero_image/1791995544192-materuni-waterfall.jpg";
const optimizedHero = await getImage({ src: heroSource, width: 1600, height: 1000, format: "webp", quality: 80 });

// Curated 6 experiences with equal visual importance (authoritative pricing aligned with Supabase catalog)
// Homepage catalogue fallback; prices match the published Materuni Hosts catalogue.
const curatedExperiences = [
 {key:"waterfall",detailsHref:"/materuni-waterfall-tour",catalogKey:"Waterfall & Chagga Culture",name:"Materuni Waterfall & Chagga Village Experience",tagline:"Waterfall walk · village heritage",price:40,label:"Day visit",image:"waterfall_image/1792472007095-optimized.webp",alt:"Materuni Waterfall among the green slopes of Mount Kilimanjaro",desc:"Explore Materuni Waterfall with a local host, discover Chagga village life and enjoy traditional coffee making.",highlights:["Walk to Materuni Waterfall","Discover Chagga village life","Enjoy traditional coffee making"]},
 {key:"coffee",detailsHref:"/materuni-coffee-tour",catalogKey:"Traditional Coffee Experience",name:"Traditional Chagga Coffee Experience",tagline:"From coffee growing to a fresh cup",price:36,label:"Day visit",image:"coffee_image/1792472054273-optimized.webp",alt:"Chagga coffee being prepared by hand in Materuni Village",desc:"Discover Chagga coffee traditions in Materuni through local growing stories, roasting, grinding, brewing and tasting.",highlights:["Learn about local coffee-growing traditions","Take part in roasting and grinding","Brew and taste traditional Chagga coffee"]},
 {key:"cooking",detailsHref:"/day-trips",catalogKey:"Traditional Chagga Cooking Class",name:"Traditional Chagga Cooking Class",tagline:"Cook · learn · share local food",price:49,label:"Day visit",image:"cooking_image/1792089297987-cooking-class.jpg",alt:"Traditional Chagga cooking class in Materuni Village",desc:"Join a hands-on Chagga cooking session with a local host. Dishes and ingredients are confirmed before booking.",highlights:["Join a hands-on cooking session","Discuss dishes and ingredients with your host","Confirm the menu before booking"]},
 {key:"moshi",detailsHref:"/moshi-day-trips",catalogKey:"Materuni & Moshi Town Tour",name:"Materuni & Moshi Town Cultural Experience",tagline:"Village life · town history",price:52,label:"Day visit",image:"story_image/1791995912146-materuni-community.jpg",alt:"Materuni Hosts community scene in Materuni Village",desc:"Combine a locally hosted Materuni experience with a guided visit to Moshi town and its everyday culture.",highlights:["Discover Materuni Village","Visit Moshi town with a local guide","Explore everyday town culture"]},
 {key:"rau",detailsHref:"/experiences",catalogKey:"Materuni & Rau Forest Experience",name:"Materuni & Rau Forest Nature Experience",tagline:"Village culture · forest nature",price:58,label:"Day visit",image:"story_image/1791601761441-q3iog8mni3r.jpg",alt:"Forest vegetation in the Kilimanjaro region of Tanzania",desc:"Combine a Materuni village experience with a guided nature walk in Rau Forest. The Rau Forest entrance fee is included in the published package price.",highlights:["Guided nature walk in Rau Forest","Learn about the forest environment","Rau Forest entrance fee included"]},
 {key:"camping",detailsHref:"/camping",catalogKey:"Camping & Village Life",name:"Materuni Overnight Village Experience",tagline:"A slower village stay",price:90,label:"1 night",image:"camping_image/1792122487239-camping.jpg",alt:"Overnight village camping area in Materuni",desc:"Enjoy an overnight village experience in Materuni. Accommodation arrangements, meals and activities are confirmed by your host.",highlights:["Overnight village experience in Materuni","Accommodation and meal arrangements confirmed by host","Agree the activities for your stay before booking"]}
];

// Host profiles for Meet Your Hosts section


// 4-step guest journey
// A clear outline of the visit; meeting and transport details are agreed with the host.
const daySteps = [
 {step:"01",title:"Plan your visit",text:"Choose an experience and share your preferred date, group size and any practical needs with your host."},
 {step:"02",title:"Arrive in Materuni",text:"Agree your meeting point and arrival arrangements with your host before travelling to the village."},
 {step:"03",title:"Discover village life",text:"Enjoy the experience you selected, from the waterfall and local food to Chagga coffee traditions."},
 {step:"04",title:"Confirm your return",text:"Before your visit, agree the timing and transport arrangements that suit your plans."}
];

// Journal posts
const journalPosts = [
 {title:"How to Get to Materuni Village from Moshi, Arusha and KIA",excerpt:"Route options, road conditions and practical planning tips for reaching Materuni Village.",slug:"how-to-get-to-materuni",category:"Getting here",readTime:"5 min read",image:"hero_image/1791995544192-materuni-waterfall.jpg",alt:"Materuni Waterfall seen from the forest trail"},
 {title:"How Traditional Chagga Coffee is Made from Bean to Cup",excerpt:"Learn about coffee-growing traditions and the roasting, grinding and brewing steps shared in Materuni.",slug:"how-traditional-chagga-coffee-is-made",category:"Culture & food",readTime:"4 min read",image:"coffee_image/1791998412318-materuni-tour.jpg",alt:"Chagga coffee being prepared in Materuni"},
 {title:"What to Bring on the Materuni Waterfall Hike",excerpt:"Practical footwear, clothing and packing advice before you visit the Materuni waterfall trail.",slug:"what-to-bring-on-materuni-waterfall-hike",category:"Planning",readTime:"4 min read",image:"story_image/1791601761441-q3iog8mni3r.jpg",alt:"Green forest trail in the Kilimanjaro region"}
];

// 6 FAQs
const faqs = [
 {q:"Where is Materuni Village?",a:"Materuni Village is in Materuni Juu, Moshi Rural, in Tanzania's Kilimanjaro Region. Contact your host before travelling to confirm the meeting point and directions."},
 {q:"How do I get to Materuni from Moshi?",a:"You can discuss self-arranged transport or a separate transfer with your host. Road and travel conditions vary, so confirm the route and expected journey time for your date."},
 {q:"Is the Materuni Waterfall walk suitable for everyone?",a:"The route includes natural, uneven trail surfaces and conditions can change with the weather. Tell your host about mobility needs or concerns before booking so you can discuss suitability."},
 {q:"What should I wear and bring?",a:"Wear comfortable walking shoes with grip and bring weather-appropriate clothing. If you plan to enter the waterfall pool, ask your host about current conditions and bring swimwear and a towel."},
 {q:"What is included in the experience price?",a:"Inclusions vary by experience. Check the details for your selected activity and ask your host to confirm what is included, what is arranged separately and the final price before payment."},
 {q:"Does sending a booking request confirm my visit?",a:"No. Sending the form is a request only. Your host will reply to confirm availability, timing, arrangements and payment details before your visit is confirmed."}
];
---

<SiteLayout
  title="Materuni Village Tours & Chagga Experiences | Materuni Hosts"
  description="Visit Materuni Village near Moshi, Tanzania. Explore the Materuni Waterfall, Chagga coffee traditions, local food and village experiences with Materuni Hosts."
  preloadImage={optimizedHero.src}
>
  <!-- 1. PREMIUM CINEMATIC HERO SECTION -->
  <section class="premium-hero" aria-labelledby="hero-heading">
    <div class="hero-bg" style={`background-image: linear-gradient(180deg, rgba(20,45,32,0.70) 0%, rgba(20,45,32,0.85) 100%), url(${optimizedHero.src})`}></div>
    <div class="hero-content">
      <span class="hero-badge">MATERUNI VILLAGE · KILIMANJARO · TANZANIA</span>
      <h1 id="hero-heading">Materuni Village Tours &amp; Chagga Cultural Experiences</h1>
      <p class="hero-sub">Meaningful cultural encounters, beautiful landscapes and genuine connections with the people who call Materuni home.</p>
      <div class="hero-cta-group">
        <a class="gold-button" href="#experiences">Join a Village Experience</a>
        <a class="hero-outline-button" href="/about-us">Discover Materuni</a>
      </div>
      <div class="hero-social-proof">
        <span>Read independent guest feedback on <a href="https://www.tripadvisor.com/34765809" target="_blank" rel="noopener noreferrer" class="proof-link">TripAdvisor</a> &amp; <a href="https://g.page/r/CXy6M_Suiip9EBM/review" target="_blank" rel="noopener noreferrer" class="proof-link">Google</a></span>
      </div>
    </div>
  </section>

  <!-- QUICK BOOKING STRIP: clear next step without interrupting the editorial hero -->
  <section class="mh-quick-plan" aria-label="Plan your Materuni experience">
    <div class="mh-quick-plan-inner">
      <div class="mh-quick-plan-intro">
        <span class="mh-quick-plan-kicker">YOUR VISIT, MADE SIMPLE</span>
        <h2>Make a little room for Materuni.</h2>
        <p>Choose an experience, check a date and send a booking request directly to your local hosts.</p>
      </div>
      <div class="mh-quick-plan-steps" aria-label="Booking steps">
        <div class="mh-quick-plan-step"><span>01</span><strong>Choose</strong><small>Find your experience</small></div>
        <div class="mh-quick-plan-rule" aria-hidden="true"></div>
        <div class="mh-quick-plan-step"><span>02</span><strong>Check</strong><small>See available dates</small></div>
        <div class="mh-quick-plan-rule" aria-hidden="true"></div>
        <div class="mh-quick-plan-step"><span>03</span><strong>Connect</strong><small>Send your request</small></div>
      </div>
      <a class="mh-quick-plan-button" href="/booking?source=homepage">Plan your visit <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <!-- 2. SHORT, COMPELLING BRAND INTRODUCTION -->
  <section class="brand-intro-section" aria-labelledby="brand-intro-heading">
    <div class="brand-intro-container">
      <span class="eyebrow">MATERUNI VILLAGE · LOCAL CULTURE</span>
      <h2 id="brand-intro-heading">Rooted in Materuni. Inspired by Africa.</h2>
      <p class="brand-intro-lead">
        Materuni Village sits in the foothills of Mount Kilimanjaro, near Moshi in northern Tanzania. Materuni Hosts invites visitors to discover the village through local hospitality, Chagga heritage and everyday life.
      </p>
      <p class="brand-intro-body">
        Choose a walk to Materuni Waterfall, learn about Chagga coffee traditions, prepare local food, or spend a night in the village. Each experience offers a different way to connect with the place and the people who call it home.
      </p>
      <div class="intro-pillars-grid">
        <div class="intro-pillar">
          <div class="pillar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Local Perspectives</h3>
          <p>Hear about Materuni through local perspectives, village stories and the traditions connected with everyday life.</p>
        </div>
        <div class="intro-pillar">
          <div class="pillar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3>Time to Explore</h3>
          <p>Choose a day visit or overnight stay, then discuss the pace and practical details with your host.</p>
        </div>
        <div class="intro-pillar">
          <div class="pillar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h3>Living Chagga Heritage</h3>
          <p>Discover coffee, food, farming and cultural traditions through the experiences available in Materuni.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. CURATED LOCAL EXPERIENCES COLLECTION -->
  <section class="home-section" id="experiences" aria-labelledby="experiences-heading">
    <div class="section-header">
      <span class="eyebrow">CURATED EXPERIENCES</span>
      <h2 id="experiences-heading">Explore Materuni Village Experiences</h2>
      <p>Choose a waterfall walk, Chagga coffee experience, cooking class, town visit, forest outing or overnight stay. Each activity has its own details and price.</p>
    </div>
    <div class="curated-grid">
      {curatedExperiences.map((exp) => (
        <article class="boutique-card" id={`exp-${exp.key}`} data-home-experience-key={exp.catalogKey}>
          <div class="boutique-card-media">
            <Image src={base + exp.image} alt={exp.alt} width={640} height={420} format="webp" quality={78} loading="lazy" decoding="async" class="boutique-photo" data-home-image />
            <span class="card-duration-badge">{exp.label}</span>
          </div>
          <div class="boutique-card-content">
            <div class="card-meta-top"><span class="card-tagline">{exp.tagline}</span><span class="card-price-display" data-home-price>${exp.price} <small>PER PERSON</small></span></div>
            <h3 data-home-name>{exp.name}</h3><p class="card-desc" data-home-description>{exp.desc}</p>
            <div class="experience-highlight-block"><strong>Experience highlights</strong><ul>{exp.highlights.map((item) => <li>{item}</li>)}</ul></div>
            <div class="boutique-card-actions">
              <a class="gold-button" href={`/booking?experience=${exp.key}`}>Request this experience</a>
              <a class="card-secondary-link" href={exp.detailsHref}>Experience details &amp; practical information →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="section-center-cta">
      <a class="view-all-button" href="/experiences">Explore experience details &amp; group discounts</a>
    </div>
  </section>

  <!-- 4. MEET YOUR LOCAL HOSTS -->
  <section class="home-section bg-warm" id="hosts" aria-labelledby="hosts-heading">
    <div class="section-header">
      <span class="eyebrow">LOCAL HOSPITALITY</span>
      <h2 id="hosts-heading">Meet Your Local Hosts</h2>
      <p>Discover Materuni through local hospitality, village stories and the traditions connected with everyday life.</p>
    </div>
    <div class="hosts-grid">
      <article class="host-boutique-card">
        <div class="host-avatar-wrap">
          <Image src={base + "story_image/1791995912146-materuni-community.jpg"} alt="Materuni community scene" width={640} height={420} format="webp" quality={78} loading="lazy" decoding="async" class="host-avatar" />
        </div>
        <h3>Local hosts in Materuni</h3>
        <span class="host-boutique-role">Village hospitality &amp; living heritage</span>
        <p class="host-boutique-bio">Meet local hosts through the traditions, food, coffee and everyday stories of Materuni. The person you meet depends on the experience and arrangements for your visit.</p>
      </article>
    </div>
    <div class="hosts-editorial-cta">
      <p>
        We believe a visit is more meaningful when you take time to learn about the place, its people and the traditions that shape village life.
      </p>
      <a class="gold-button" href="/about-us">Read our story</a>
    </div>
  </section>

  <!-- 5. DISCOVER THE CHAGGA CULTURE -->
  <section class="home-section" aria-labelledby="culture-heading">
    <div class="section-header">
      <span class="eyebrow">LIVING HERITAGE</span>
      <h2 id="culture-heading">Discover the Chagga Culture</h2>
      <p>Centuries of harmony between highland farming, community cooperation, and volcanic mountain ecology.</p>
    </div>
    <div class="editorial-feature-grid">
      <div class="feature-card">
        <div class="feature-number">01</div>
        <h3>The Kihamba Farming System</h3>
        <p>
          The <em>Kihamba</em> is a Chagga home-garden agroforestry system found on the slopes of Kilimanjaro. Learn how crops and trees are grown together and ask your host about the plants and farming practices you see in Materuni.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-number">02</div>
        <h3>The Rhythmic Coffee Ceremony</h3>
        <p>
          A Chagga coffee experience can introduce you to the steps of preparing coffee, including roasting, grinding and brewing. Your host can explain the methods and traditions connected with coffee in Materuni.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-number">03</div>
        <h3>Highland Gastronomy &amp; Mbege</h3>
        <p>
          Discover Chagga food traditions and ingredients such as cooking bananas and locally grown produce. Ask your host whether a tasting of <em>mbege</em>, a traditional banana-and-millet drink, is available during your visit.
        </p>
      </div>
    </div>
  </section>

  <!-- 6. MATERUNI NATURE AND LANDSCAPES -->
  <section class="home-section bg-warm" aria-labelledby="nature-heading">
    <div class="section-header">
      <span class="eyebrow">KILIMANJARO FOOTHILLS</span>
      <h2 id="nature-heading">Materuni Waterfall &amp; Forest Landscapes</h2>
      <p>Explore the green foothills of Mount Kilimanjaro, village paths and the forest setting around Materuni Waterfall.</p>
    </div>
    <div class="split-nature-layout">
      <div class="nature-image-container">
        <Image
          src={base + "waterfall_image/1791998303073-materuni-waterfall-hike.jpg"}
          alt="Materuni Waterfall cascading into a natural pool in the green Kilimanjaro foothills"
          width={800}
          height={550}
          format="webp"
          quality={78}
          loading="lazy"
          decoding="async"
          class="nature-cover"
        />
      </div>
      <div class="nature-copy-container">
        <h3>A Waterfall in the Kilimanjaro Foothills</h3>
        <p>
          Materuni Village lies in the foothills of Mount Kilimanjaro. A visit can include a walk through the surrounding green landscape to Materuni Waterfall. Trail conditions and visibility can vary with the weather.
        </p>
        <ul class="nature-highlights-list">
          <li>
            <strong>Materuni Waterfall:</strong> Visit the waterfall on a guided walk from the village.
          </li>
          <li>
            <strong>Forest paths:</strong> Explore the green landscape around Materuni and learn about the local environment.
          </li>
          <li>
            <strong>Kilimanjaro setting:</strong> Experience the village in the foothills of the mountain; views depend on weather and cloud cover.
          </li>
        </ul>
        <div class="nature-action-wrap">
          <a class="gold-button" href="/day-trips">Explore Day Trips</a>
          <a class="hero-outline-button dark" href="/travel-guide">Read Travel Guide</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. HOW YOUR EXPERIENCE UNFOLDS -->
  <section class="home-section" aria-labelledby="journey-heading">
    <div class="section-header">
      <span class="eyebrow">THE GUEST JOURNEY</span>
      <h2 id="journey-heading">How Your Experience Unfolds</h2>
      <p>Agree the practical details with your host before travelling, then enjoy the experience you selected in Materuni.</p>
    </div>
    <div class="journey-steps-grid">
      {daySteps.map((s) => (
        <div class="journey-step-card">
          <div class="journey-step-num">{s.step}</div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
    <div class="section-center-cta">
      <a class="gold-button" href="/itinerary">Build a custom itinerary</a>
    </div>
  </section>

  <!-- 8. GUEST FEEDBACK -->
  <section class="home-section bg-warm" aria-labelledby="reviews-heading">
    <div class="section-header">
      <span class="eyebrow">GUEST FEEDBACK</span>
      <h2 id="reviews-heading">Hear from travellers who visited Materuni</h2>
      <p>Read independent guest feedback on our public review platforms before choosing your experience.</p>
    </div>
    <div class="reviews-action-strip">
      <a class="gold-button" href="https://www.tripadvisor.com/34765809" target="_blank" rel="noopener noreferrer">
        Read guest feedback on TripAdvisor ↗
      </a>
      <a class="hero-outline-button dark" href="https://g.page/r/CXy6M_Suiip9EBM/review" target="_blank" rel="noopener noreferrer">
        View or leave a Google Review ↗
      </a>
      <a class="card-secondary-link" href="/reviews">
        Explore guest feedback →
      </a>
    </div>
  </section>

  <!-- 9. RESPONSIBLE COMMUNITY TOURISM -->
  <section class="home-section" aria-labelledby="sustainability-heading">
    <div class="section-header">
      <span class="eyebrow">COMMUNITY FIRST</span>
      <h2 id="sustainability-heading">Responsible Community Tourism</h2>
      <p>Visitors can help make each visit respectful by learning about local customs, caring for the environment and following guidance from their hosts.</p>
    </div>
    <div class="sustainability-pillars-grid">
      <div class="sustainability-card">
        <div class="sustainability-number">01</div>
        <h3>Respect Local Hosts</h3>
        <p>
          Ask questions, listen to local perspectives and follow the arrangements explained by your host. We aim to make each visit welcoming and respectful.
        </p>
      </div>
      <div class="sustainability-card">
        <div class="sustainability-number">02</div>
        <h3>Learn About Chagga Heritage</h3>
        <p>
          Discover coffee, food, farming and cultural traditions through the activities available during your visit.
        </p>
      </div>
      <div class="sustainability-card">
        <div class="sustainability-number">03</div>
        <h3>Care for the Environment</h3>
        <p>
          Stay on agreed paths, avoid leaving litter and follow local guidance around water, farms and forest areas.
        </p>
      </div>
    </div>
    <div class="section-center-cta">
      <a class="gold-button" href="/sustainability">Read our community approach</a>
    </div>
  </section>

  <!-- 10. EDITORIAL TRAVEL JOURNAL -->
  <section class="home-section bg-warm" aria-labelledby="journal-heading">
    <div class="section-header">
      <span class="eyebrow">MATERUNI JOURNAL</span>
      <h2 id="journal-heading">Stories &amp; Practical Guides from the Slopes</h2>
      <p>Find practical information about reaching Materuni, preparing for the waterfall walk and learning about Chagga coffee traditions.</p>
    </div>
    <div class="journal-grid">
      {journalPosts.map((post) => (
        <article class="journal-card">
          <a class="journal-media-link" href={`/journal/${post.slug}`} aria-label={post.title}>
            <Image
              src={base + post.image}
              alt={post.alt}
              width={640}
              height={380}
              format="webp"
              quality={78}
              loading="lazy"
              decoding="async"
              class="journal-cover"
            />
          </a>
          <div class="journal-body">
            <div class="journal-meta">
              <span class="pill-cat">{post.category}</span>
              <span class="read-time">{post.readTime}</span>
            </div>
            <h3><a href={`/journal/${post.slug}`}>{post.title}</a></h3>
            <p>{post.excerpt}</p>
            <a class="read-more-link" href={`/journal/${post.slug}`}>Read article →</a>
          </div>
        </article>
      ))}
    </div>
    <div class="section-center-cta">
      <a class="gold-button" href="/journal">Explore all Journal posts</a>
    </div>
  </section>

  <!-- 11. FREQUENTLY ASKED QUESTIONS -->
  <section class="home-section" aria-labelledby="faq-heading">
    <div class="section-header">
      <span class="eyebrow">GOOD TO KNOW</span>
      <h2 id="faq-heading">Frequently Asked Questions</h2>
      <p>Everything you need to know before joining us in Materuni Village.</p>
    </div>
    <div class="faq-accordion-wrap">
      {faqs.map((faq) => (
        <details class="faq-boutique-item">
          <summary><span>{faq.q}</span></summary>
          <div class="faq-boutique-answer"><p>{faq.a}</p></div>
        </details>
      ))}
    </div>
    <div class="section-center-cta">
      <a class="card-secondary-link" href="/faq">Have more questions? Read our full FAQ →</a>
    </div>
  </section>

  <!-- 12. PREMIUM BOOKING CTA & VILLAGE MAP -->
  <section class="home-section bg-warm" id="booking-cta" aria-labelledby="booking-cta-heading">
    <div class="booking-cta-container">
      <div class="booking-cta-copy">
        <span class="eyebrow">FIND MATERUNI</span>
        <h2 id="booking-cta-heading">Plan Your Visit to Materuni Village</h2>
        <p>
          Send a booking request online and our local hosting team will contact you to discuss availability, timings and any transport arrangements.
        </p>
        <div class="booking-cta-actions">
          <a class="gold-button" href="/booking">Send a booking request</a>
          <a class="hero-outline-button dark" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%20would%20like%20to%20plan%20a%20visit." target="_blank" rel="noopener noreferrer">
            Chat on WhatsApp
          </a>
        </div>
        <p class="peace-of-mind-note">
          Materuni Village, Materuni Juu &nbsp;·&nbsp; Moshi Rural &nbsp;·&nbsp; Kilimanjaro, Tanzania
        </p>
      </div>

      <div class="materuni-map-card"><div class="materuni-map-paper">
