---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image, getImage } from "astro:assets";
import { supabaseUrl } from "../lib/supabase-public";
const experiences=[
{key:"Camping & Village Life",name:"Materuni Camping",price:110,tag:"Flagship overnight stay",image:"camping_image/1791601872981-zmji0mykwhd.jpg",desc:"Make Materuni your home for a night. Sleep beneath the Kilimanjaro foothills and share a slower, more personal village experience with local Chagga hosts, from the forest trail and coffee traditions to home-cooked food and evening storytelling.",items:["Overnight camping and gear setup","Waterfall and village experience","Chagga cooking, local dinner and breakfast","Campfire stories and time with local hosts"]},
{key:"Waterfall & Chagga Culture",name:"Materuni Waterfall & Chagga Culture",price:75,tag:"First-time visitors",image:"waterfall_image/1791601414950-ew7ak42gjka.jpg",desc:"A well-rounded introduction to Materuni: follow a guided forest trail to the 95-metre waterfall, then enjoy a hands-on Chagga coffee experience with local hosts.",items:["Guided rainforest waterfall hike","Bean-to-cup coffee with local hosts","Traditional songs, dance & banana brew","Home-cooked local lunch"]},
{key:"Traditional Coffee Experience",name:"Traditional Coffee Experience",price:65,tag:"Best value",image:"coffee_image/1791601540965-5mt58f2ipoe.jpg",desc:"A culture-led visit centred on the journey from coffee bean to cup, with time to learn about village life and Chagga traditions.",items:["Roast, grind and brew coffee","Guided village nature walk","Live Chagga dancing","Local lunch & banana brew"]},
{key:"Traditional Chagga Cooking Class",name:"Traditional Chagga Cooking Class",price:85,tag:"For food lovers",image:"cooking_image/1791601646297-7th6jahyw0w.jpg",desc:"Step into the kitchen with local hosts, learn traditional Chagga cooking methods and take part rather than simply watch.",items:["Traditional firewood cooking","Prepare local dishes with hosts","Organic coffee-making","Village walk, dance & banana brew"]},
{key:"The Ultimate Kilimanjaro Foothills & Materuni Experience",name:"Ultimate",price:135,tag:"Ultimate experience",image:"ultimate_image/1791604660208-7c4yvzvsaf9.jpg",desc:"A multi-experience stay bringing together the waterfall, coffee-making, Chagga cooking and overnight camping in one visit.",items:["Scenic waterfall hike","Hands-on Chagga cooking class","Organic coffee tour","Camping, campfire, dance & meals"]}];
const base=`${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const heroSource = base + "hero_image/1791600514716-b2bclfcnhhh.jpg";
const optimizedHero = await getImage({ src: heroSource, width: 1200, height: 800, format: "webp", quality: 76 });
---
<SiteLayout title="Materuni Waterfall & Chagga Coffee Tours | Materuni Hosts" description="Discover Materuni Waterfall hikes, Chagga coffee traditions, village culture and camping near Moshi, Tanzania, with a warm welcome from local hosts." preloadImage={optimizedHero.src}>
<section class="hero"><div class="hero-copy"><span class="eyebrow">MATERUNI VILLAGE · MOSHI · KILIMANJARO, TANZANIA</span><h1 data-i18n="home_hero_title" data-site-content="hero_title">Spend a night in a Chagga village on Kilimanjaro’s slopes</h1><p data-i18n="home_hero_intro" data-site-content="hero_intro">Make a night in Materuni the heart of your Kilimanjaro journey. Follow village paths, discover Chagga coffee and food traditions, and share an unhurried evening with local hosts.</p><div class="actions"><a class="button light" href="/booking?source=homepage&experience=Camping%20%26%20Village%20Life" data-i18n="home_hero_book">Book Materuni Camping</a><a class="button secondary" href="/camping" data-i18n="home_hero_cta">Explore Materuni Camping</a><a class="button secondary" href="/day-trips" data-i18n="home_hero_secondary">Explore day trips</a></div></div><div class="hero-image" data-site-image="hero_image"><img class="hero-photo" src={optimizedHero.src} width="1200" height="800" alt="Materuni landscape in the green foothills of Mount Kilimanjaro" fetchpriority="high" loading="eager" decoding="async" /></div></section>
<div class="trust-strip">
<span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20.5 10a8.5 8.5 0 1 1-17 0 8.5 8.5 0 0 1 17 0Z"/><path d="M3.5 10h17M12 1.5c2.2 2.3 3.3 5.1 3.3 8.5s-1.1 6.2-3.3 8.5c-2.2-2.3-3.3-5.1-3.3-8.5S9.8 3.8 12 1.5Z"/></svg>LOCAL CHAGGA HOSTS</span>
<span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M16 20v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20M9 10.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM16 3a4 4 0 0 1 0 7.7M18 14.5a4 4 0 0 1 4 4V20"/></svg>AUTHENTIC VILLAGE EXPERIENCES</span>
<span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2 19 5v6c0 5-3 8-7 11-4-3-7-6-7-11V5l7-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>CLEAR PER-PERSON PRICING</span>
<span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20.8 8.8c0 5.3-8.8 11-8.8 11s-8.8-5.7-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/><path d="M8.5 10.5h7"/></svg>A PERSONAL LOCAL WELCOME</span>
</div>
<style>
.catalog-product-tagline{display:block;margin:.35rem 0 .15rem;color:#a27b3e;font-size:.75rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}
.catalog-best-for{font-size:.72rem!important;font-weight:700;color:#1a3322!important;letter-spacing:.03em}
.catalog-detail-heading{display:block;margin:.85rem 0 .2rem;color:#1a3322;font-size:.68rem;letter-spacing:.12em}
.shared-standard{margin:32px 0 0;padding:24px 28px;background:#f4efe6;border:1px solid #e6dfd3;border-radius:16px}
.shared-standard h3{margin:0 0 14px;color:#1a3322;font:600 clamp(22px,3vw,30px) "Cormorant Garamond",serif}
.shared-standard ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 24px;margin:0;padding-left:18px;color:#425347;font-size:13px;line-height:1.7}
@media(max-width:620px){.shared-standard{padding:20px}.shared-standard ul{grid-template-columns:1fr}}
</style>
<section class="section"><div class="section-head"><span class="eyebrow" data-i18n="home_section_eyebrow">THE SIGNATURE MATERUNI STAY</span><h2 data-i18n="home_section_title">One camping experience. Many ways to connect.</h2><p data-i18n="home_section_intro">Materuni Camping is our main experience: an overnight stay enriched by the waterfall, Chagga coffee, local cooking, village culture and time around the campfire. You can also ask your host about shorter visits and extra activities.</p></div><div class="cards">{experiences.map((e)=><article class="experience-card" id={e.key === "Camping & Village Life" ? "camping" : undefined} data-catalog-key={e.key}><Image src={base+e.image} data-site-image={e.image.split("/")[0]} alt={e.name} loading="lazy" decoding="async" width={640} height={420} format="webp" quality={76} /><div class="card-body"><div class="card-top"><span class="pill">{e.tag}</span><span class="price">${e.price}<small>PER PERSON</small></span></div><h3>{e.name}</h3><p>{e.desc}</p><ul>{e.items.slice(0,3).map(item=><li>{item}</li>)}</ul><a class="button" href={"/booking?experience="+encodeURIComponent(e.key)} aria-label={"Check availability for "+e.name}>Check availability</a></div></article>)}</div><p style="max-width:900px;margin:28px auto 0;text-align:center;color:#526054;line-height:1.8">Planning a waterfall visit? Explore our <a href="/materuni-waterfall-tour" style="color:#1a3322;font-weight:800;text-decoration:underline;text-underline-offset:4px">Materuni Waterfall Tours with local hosts</a>, including the guided forest walk and Chagga cultural experience.</p></section>
<section class="section" style="background:#f0eadf"><div class="split"><Image src={base+"story_image/1791601761441-q3iog8mni3r.jpg"} data-site-image="story_image" alt="Local coffee experience with Materuni hosts" loading="lazy" decoding="async" width={640} height={720} format="webp" quality={62} /><div><span class="eyebrow" data-i18n="home_story_eyebrow">COMMUNITY · CULTURE · CONSERVATION</span><h2 data-i18n="home_story_title" data-site-content="story_title">A stay shaped by the people and place of Materuni.</h2><p data-i18n="home_story_intro" data-site-content="story_desc">We believe travel should create meaningful connections and respect the places that welcome us. Through community-based hosting, guests are invited to discover Chagga heritage, local food and everyday village life while travelling thoughtfully in the Kilimanjaro foothills.</p><div class="feature-list"><div><strong data-i18n="story_community_title">Community at the centre</strong><span data-i18n="story_community_body">Meet local hosts and experience Materuni through local knowledge and participation.</span></div><div><strong data-i18n="story_culture_title">Living Chagga culture</strong><span data-i18n="story_culture_body">Explore coffee traditions, food, stories and cultural practices with respect.</span></div><div><strong data-i18n="story_environment_title">Care for the environment</strong><span data-i18n="story_environment_body">Enjoy the forest and mountain setting responsibly, leaving nature as you found it.</span></div><div><strong data-i18n="story_sustainability_title">Thoughtful sustainability</strong><span data-i18n="story_sustainability_body">Choose slower, more meaningful experiences that value local people, culture and the environment.</span></div></div><a class="button" href="/sustainability" data-i18n="home_story_cta">Our approach</a></div></div></section>
<section class="section review-invite-section" aria-labelledby="guest-review-title">
 <div class="review-invite-panel">
  <span class="eyebrow" data-i18n="guest_story_eyebrow">GUEST STORIES · REAL EXPERIENCES</span>
  <h2 id="guest-review-title" data-i18n="guest_story_title">Travel stories are best told by the people who lived them.</h2>
  <p data-i18n="guest_story_body">See the latest public feedback from guests who have visited Materuni, or share your own experience after travelling with us. We publish genuine guest feedback, never invented testimonials or ratings.</p>
  <div class="actions">
   <a class="button review-profile-link" href="https://g.page/r/CXy6M_Suiip9EBM/review" data-social-key="google_review_url" hidden aria-hidden="true" target="_blank" rel="noopener noreferrer" data-i18n="guest_story_reviews" aria-label="View Materuni Hosts Google reviews">Read guest reviews ↗</a>
   <a class="button button-secondary" href="/reviews" data-i18n="guest_story_how">How guest reviews help</a>
  </div>
 </div>
</section>
<section class="section location-section" id="materuni-location" aria-labelledby="materuni-location-title">
<style>
.location-section{background:#FAF7F2}
.location-section .location-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:clamp(28px,5vw,64px);align-items:center}
.location-section .location-copy{max-width:480px}
.location-section .location-map{position:relative;min-height:360px;border:1px solid #E6DFD3;border-radius:18px;overflow:hidden;background:#E6DFD3;box-shadow:0 14px 38px rgba(36,36,33,.09)}
.location-section .location-map iframe{display:block;width:100%;height:390px;border:0}
.location-section .location-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.location-section .location-note{font-size:13px;line-height:1.7;color:#55564f;margin-top:14px}
@media(max-width:760px){.location-section .location-grid{grid-template-columns:1fr}.location-section .location-map{min-height:290px}.location-section .location-map iframe{height:320px}}
</style>
<div class="location-grid">
<div class="location-copy">
<span class="eyebrow">FIND YOUR WAY TO US</span>
<h2 id="materuni-location-title">Find Materuni Hosts in Materuni Village.</h2>
<p>Our home is in Materuni Village, in the green foothills of Mount Kilimanjaro, near Moshi in northern Tanzania. Use the map to locate the village and plan your journey to our community-based camping experience.</p>
<div class="location-actions"><a class="button map-directions-button" href="https://www.google.com/maps/dir/?api=1&destination=Materuni%20Hosts%20-%20Waterfall%20Tours%20%26%20Village%20Camping%2C%20Materuni%20Village%2C%20Moshi%2C%20Tanzania" target="_blank" rel="noopener noreferrer" aria-label="Open Materuni Hosts location in Google Maps"><span aria-hidden="true">↗</span> Get directions on Google Maps</a><a class="button location-whatsapp-button" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20please%20share%20your%20arrival%20details." target="_blank" rel="noopener noreferrer">Ask your local host</a></div>
<p class="location-note">Use Get directions for the Materuni Hosts location pin. Please contact your host before travelling to confirm your arrival and meeting arrangements.</p>
</div>
<div class="location-map"><iframe loading="lazy" title="Materuni Hosts location in Materuni Village, Moshi, Tanzania" src="https://www.google.com/maps?q=Materuni%20Hosts%20-%20Waterfall%20Tours%20%26%20Village%20Camping%2C%20Materuni%20Village%2C%20Moshi%2C%20Tanzania&amp;output=embed" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
</div>
</section>
<section class="band"><span class="eyebrow">YOUR MATERUNI STORY STARTS HERE</span><h2>Make room for a real connection.</h2><p>Share your preferred date, group size and the experience you have in mind. We will check the calendar, discuss practical details and help you prepare for your visit.</p><div class="actions" style="justify-content:center"><a class="button light" href="/booking">Check dates & book</a><a class="button secondary" href="https://wa.me/255612068540" target="_blank" rel="noopener">Chat on WhatsApp</a></div></section>
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../lib/supabase-public";
const mediaBase=`${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const siteContentEndpoint=`${supabaseUrl}/rest/v1/site_content?select=id,content&id=in.(hero_image,story_image,waterfall_image,coffee_image,cooking_image,culturalday_image,camping_image,ultimate_image,hero_title,hero_intro,experiences_title,experiences_intro,story_title,story_desc,story_desc2)`;
const siteContentKey=publishableKey;
const languageContentUrl=`${supabaseUrl}/rest/v1/site_settings?select=setting_value&setting_key=eq.language_content`;
const applyHomepageLanguage=async()=>{
 const locale=(localStorage.getItem("materuni-language")||"en").toLowerCase();
 if(!["es","fr","de"].includes(locale))return;
 try{
  const response=await fetch(languageContentUrl,{headers:{apikey:siteContentKey,Authorization:"Bearer "+siteContentKey},cache:"no-store"});
  if(!response.ok)return;
  const rows=await response.json(),saved=rows?.[0]?.setting_value;
  const translations=typeof saved==="string"?JSON.parse(saved):saved;
  const copy=translations?.[locale];
  if(!copy||typeof copy!=="object")return;
  Object.entries(copy).forEach(([key,value])=>{
   if(typeof value!=="string"||!value.trim())return;
   const node=document.querySelector('[data-site-content="'+key+'"]');if(node)node.textContent=value;
  });
 }catch(error){console.warn("Homepage translations unavailable; showing English copy.",error)}
};

fetch(siteContentEndpoint,{headers:{apikey:siteContentKey,Authorization:"Bearer "+siteContentKey}})
 .then(response=>response.ok?response.json():[])
 .then(rows=>{
  if(!Array.isArray(rows))return;
  const content=new Map(rows.filter(row=>typeof row.content==="string").map(row=>[row.id,row.content]));
  document.querySelectorAll("[data-site-content]").forEach(node=>{const value=content.get(node.dataset.siteContent);if(value)node.textContent=value});
  document.querySelectorAll("[data-site-image]").forEach(node=>{
   const url=content.get(node.dataset.siteImage);if(!url||!/^https:\/\//i.test(url))return;
   if(node.tagName==="IMG")node.src=url;
   else node.style.backgroundImage="linear-gradient(0deg,rgba(14,35,25,.22),rgba(14,35,25,.04)),url("+JSON.stringify(url)+")";
  });
 }).catch(()=>{});
applyHomepageLanguage();
document.getElementById("site-language")?.addEventListener("change",applyHomepageLanguage);

fetch(`${supabaseUrl}/rest/v1/experience_catalog?select=experience_key,display_name,price_usd,short_description,full_description,image_url,duration_label,inclusions,exclusions,product_tagline,best_for,signature_moments,unique_amenities,is_active,sort_order&order=sort_order.asc`,{headers:{apikey:siteContentKey,Authorization:"Bearer "+siteContentKey},cache:"no-store"})
 .then(r=>r.ok?r.json():Promise.reject(new Error("Catalogue unavailable")))
 .then(tours=>{
  if(!Array.isArray(tours))return;
  const root=document.querySelector(".cards");
  if(!root)return;
  const imageFallbacks={
    "Camping & Village Life":mediaBase+"camping_image/1791601872981-zmji0mykwhd.jpg",
    "Waterfall & Chagga Culture":mediaBase+"waterfall_image/1791601414950-ew7ak42gjka.jpg",
    "Traditional Coffee Experience":mediaBase+"coffee_image/1791601540965-5mt58f2ipoe.jpg",
    "Traditional Chagga Cooking Class":mediaBase+"cooking_image/1791601646297-7th6jahyw0w.jpg",
    "The Ultimate Kilimanjaro Foothills & Materuni Experience":mediaBase+"ultimate_image/1791604660208-7c4yvzvsaf9.jpg"
   };
   const makeList=(values)=>{
   const list=document.createElement("ul");
   (Array.isArray(values)?values:[]).forEach(value=>{if(typeof value!=="string"||!value.trim())return;const li=document.createElement("li");li.textContent=value;list.append(li)});
   return list;
  };
  const addDetails=(body,tour)=>{
   if(tour.product_tagline){const identity=document.createElement("span");identity.className="catalog-product-tagline";identity.textContent=tour.product_tagline;body.append(identity)}
   if(tour.best_for){const best=document.createElement("p");best.className="catalog-best-for";best.textContent="BEST FOR · "+tour.best_for;body.append(best)}
   const moments=Array.isArray(tour.signature_moments)?tour.signature_moments:[];
   if(moments.length){const heading=document.createElement("strong");heading.textContent="SIGNATURE MOMENTS";heading.className="catalog-detail-heading";body.append(heading,makeList(moments.slice(0,3)))}
   const amenities=Array.isArray(tour.unique_amenities)?tour.unique_amenities:[];
   if(amenities.length){const heading=document.createElement("strong");heading.textContent="YOUR UNIQUE EXPERIENCE";heading.className="catalog-detail-heading";body.append(heading,makeList(amenities))}
   const exclusions=Array.isArray(tour.exclusions)?tour.exclusions:[];
   if(exclusions.length){const heading=document.createElement("strong");heading.textContent="NOT INCLUDED";heading.className="catalog-detail-heading";body.append(heading,makeList(exclusions))}
  };
  const existing=new Map();
  root.querySelectorAll("[data-catalog-key]").forEach(card=>existing.set(card.dataset.catalogKey,card));
  const active=tours.filter(t=>t.is_active).sort((a,b)=>Number(b.experience_key==="Camping & Village Life")-Number(a.experience_key==="Camping & Village Life") || Number(a.sort_order||0)-Number(b.sort_order||0));
  const activeKeys=new Set(active.map(t=>t.experience_key));
  existing.forEach((card,key)=>{if(!activeKeys.has(key))card.remove()});
  active.forEach(t=>{
   let card=existing.get(t.experience_key);
   if(!card){
    card=document.createElement("article");card.className="experience-card";card.dataset.catalogKey=t.experience_key;
    {const img=document.createElement("img");img.src=t.image_url&&/^https:\/\//i.test(t.image_url)?t.image_url:(imageFallbacks[t.experience_key]||mediaBase+"hero_image/1791600514716-b2bclfcnhhh.jpg");img.alt=t.display_name||"Materuni experience";img.loading="lazy";img.decoding="async";img.width=640;img.height=420;img.style.width="100%";img.style.aspectRatio="8/5";img.style.objectFit="cover";card.append(img)}
    const body=document.createElement("div");body.className="card-body";
    const top=document.createElement("div");top.className="card-top";
    const pill=document.createElement("span");pill.className="pill";pill.textContent=t.duration_label||"Local experience";
    const price=document.createElement("span");price.className="price";price.append(document.createTextNode("$"+Number(t.price_usd).toFixed(0)));const small=document.createElement("small");small.textContent="PER PERSON";price.append(small);top.append(pill,price);
    const title=document.createElement("h3");title.textContent=t.display_name||"Materuni experience";
    const desc=document.createElement("p");desc.textContent=t.full_description||t.short_description||"Ask our local hosts for details.";
    body.append(top,title,desc);addDetails(body,t);
    const link=document.createElement("a");link.className="button";link.href="/booking?experience="+encodeURIComponent(t.experience_key);link.textContent="Check availability";body.append(link);card.append(body);root.append(card);
    return;
   }
   const title=card.querySelector("h3"),price=card.querySelector(".price"),desc=card.querySelector(".card-body>p"),img=card.querySelector("img"),pill=card.querySelector(".pill"),body=card.querySelector(".card-body"),link=card.querySelector("a.button");
   if(title)title.textContent=t.display_name||"Materuni experience";
   if(price){price.replaceChildren(document.createTextNode("$"+Number(t.price_usd).toFixed(0)));const small=document.createElement("small");small.textContent="PER PERSON";price.append(small)}
   if(desc&&(t.full_description||t.short_description))desc.textContent=t.full_description||t.short_description;
   if(img)img.src=t.image_url&&/^https:\/\//i.test(t.image_url)?t.image_url:(imageFallbacks[t.experience_key]||mediaBase+"hero_image/1791600514716-b2bclfcnhhh.jpg");
   if(pill&&t.duration_label)pill.textContent=t.duration_label;
   body.querySelectorAll(".catalog-product-tagline,.catalog-best-for,.catalog-detail-heading, .catalog-detail-heading + ul").forEach(node=>node.remove());
   const legacyList=body.querySelector("ul");if(legacyList)legacyList.remove();
   addDetails(body,t);
   if(link){link.href="/booking?experience="+encodeURIComponent(t.experience_key);link.setAttribute("aria-label","Check availability for "+(t.display_name||"this experience"));}
  });
 })
 .catch(error=>console.warn("Using the built-in homepage catalogue because the live catalogue could not be loaded.",error));

fetch(`${supabaseUrl}/rest/v1/site_settings?select=setting_value&setting_key=eq.experience_shared_inclusions`,{headers:{apikey:siteContentKey,Authorization:"Bearer "+siteContentKey},cache:"no-store"})
 .then(response=>response.ok?response.json():[])
 .then(rows=>{
  const raw=rows?.[0]?.setting_value;if(!raw)return;
  const items=typeof raw==="string"?JSON.parse(raw):raw;if(!Array.isArray(items)||!items.length)return;
  const cards=document.querySelector(".cards");if(!cards)return;
  const section=document.createElement("div");section.className="shared-standard";
  const heading=document.createElement("h3");heading.textContent="Included in every Materuni Hosts experience";
  const list=document.createElement("ul");
  items.forEach(item=>{if(typeof item!=="string"||!item.trim())return;const li=document.createElement("li");li.textContent=item;list.append(li)});
  section.append(heading,list);cards.insertAdjacentElement("afterend",section);
 }).catch(error=>console.warn("Shared experience inclusions unavailable.",error));
</script>
