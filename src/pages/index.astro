---
import SiteLayout from "../layouts/SiteLayout.astro";
const experiences=[
{name:"Waterfalls & Coffee Tour",price:65,tag:"First-time visitors",image:"waterfall_image/1791601414950-ew7ak42gjka.jpg",desc:"A beautiful balance of rainforest, the 95m waterfall and a hands-on Chagga coffee experience.",items:["Guided rainforest waterfall hike","Bean-to-cup coffee with local hosts","Traditional songs, dance & banana brew","Home-cooked local lunch"]},
{name:"Coffee & Chagga Culture Tour",price:50,tag:"Best value",image:"coffee_image/1791601540965-5mt58f2ipoe.jpg",desc:"Slow down, meet local hosts and discover how organic Arabica coffee is made in the village.",items:["Roast, grind and brew coffee","Guided village nature walk","Live Chagga dancing","Local lunch & banana brew"]},
{name:"Cooking & Culture",price:70,tag:"For food lovers",image:"cooking_image/1791601646297-7th6jahyw0w.jpg",desc:"A hands-on introduction to traditional Chagga food, cooking methods and village culture.",items:["Traditional firewood cooking","Prepare local dishes with hosts","Organic coffee-making","Village walk, dance & banana brew"]},
{name:"Waterfall Hike & Cultural Day Trip",price:75,tag:"Signature day trip",image:"culturalday_image/1791604657693-kcwbk80tcfs.jpg",desc:"Our fuller one-day combination for guests who want waterfall adventure and a deeper taste of Chagga culture.",items:["Rainforest hike to Materuni Waterfall","Time to enjoy the waterfall","Coffee experience with village hosts","Local lunch & traditional dance"]},
{name:"Overnight Camping",price:110,tag:"Overnight experience",image:"camping_image/1791601872981-zmji0mykwhd.jpg",desc:"Trade a quick visit for a slower night of nature, local food, storytelling and village life.",items:["Waterfall hike & village experience","Traditional cooking class","Camping gear setup & overnight stay","Campfire storytelling, dinner & breakfast"]},
{name:"Ultimate",price:135,tag:"Ultimate experience",image:"ultimate_image/1791604660208-7c4yvzvsaf9.jpg",desc:"The complete Materuni experience, bringing together waterfall, coffee, cooking, camping and Chagga culture.",items:["Scenic waterfall hike","Hands-on Chagga cooking class","Organic coffee tour","Camping, campfire, dance & meals"]}
];
const base="https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/";
---
<SiteLayout preloadImage={base + "hero_image/1791600514716-b2bclfcnhhh.jpg"}>
<section class="hero"><div class="hero-copy"><span class="eyebrow">MATERUNI VILLAGE · MOSHI · TANZANIA</span><h1>Come closer to the heart of Chagga life.</h1><p>Walk beneath the rainforest canopy, make coffee with local hosts, share traditional food and experience the warmth of Materuni village at the foothills of Kilimanjaro.</p><div class="actions"><a class="button light" href="/experiences">Explore experiences</a><a class="button secondary" href="/booking">Check availability</a></div></div><div class="hero-image" role="img" aria-label="Materuni rainforest and village landscape"></div></section>
<div class="trust-strip"><span>LOCAL CHAGGA HOSTS</span><span>AUTHENTIC VILLAGE EXPERIENCES</span><span>CLEAR PER-PERSON PRICING</span><span>SMALL-GROUP FEEL</span></div>
<section class="section"><div class="section-head"><span class="eyebrow">FIND YOUR MATERUNI MOMENT</span><h2>Six ways to experience the village</h2><p>Choose the day that feels right for you. Every package is rooted in local culture, nature and genuine connection.</p></div><div class="cards">{experiences.map((e)=><article class="experience-card"><img src={base+e.image} alt={e.name} loading="lazy" decoding="async" width="640" height="420"><div class="card-body"><div class="card-top"><span class="pill">{e.tag}</span><span class="price">${e.price}<small>PER PERSON</small></span></div><h3>{e.name}</h3><p>{e.desc}</p><ul>{e.items.slice(0,3).map(item=><li>{item}</li>)}</ul><a class="button" href={"/booking?experience="+encodeURIComponent(e.name)}>Check availability</a></div></article>)}</div></section>
<section class="section" style="background:#f0eadf"><div class="split"><img src={base+"story_image/1791601761441-q3iog8mni3r.jpg"} alt="Local coffee experience with Materuni hosts" loading="lazy" decoding="async" width="640" height="720"><div><span class="eyebrow">MORE THAN A TOUR</span><h2>A village experience, shared by local hosts.</h2><p>Materuni is best discovered at a human pace. Learn by doing, listen to stories, taste food prepared in the village and spend time with the people who call this place home.</p><div class="feature-list"><div><strong>Rooted in culture</strong>Meet Chagga traditions through everyday life.</div><div><strong>Made to participate</strong>Roast, grind, cook, walk and discover.</div><div><strong>Clear inclusions</strong>Know what is part of your experience.</div><div><strong>Personal contact</strong>Speak directly with your local host.</div></div><a class="button" href="/sustainability">Our approach</a></div></div></section>
<section class="band"><span class="eyebrow">YOUR MATERUNI STORY STARTS HERE</span><h2>Make room for a real connection.</h2><p>Tell us when you would like to visit, how many people are travelling and which experience caught your eye. We will help you plan the details.</p><div class="actions" style="justify-content:center"><a class="button light" href="/booking">Check dates & book</a><a class="button secondary" href="https://wa.me/255612068540" target="_blank" rel="noopener">Chat on WhatsApp</a></div></section>
</SiteLayout>