---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image, getImage } from "astro:assets";
import { supabaseUrl } from "../lib/supabase-public";

const base = `${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const heroSource = base + "hero_image/1791995544192-materuni-waterfall.jpg";
const optimizedHero = await getImage({ src: heroSource, width: 1600, height: 1000, format: "webp", quality: 80 });

// 3 Signature experiences as specified in Developer Brief P3
const signatureExperiences = [
  {
    key: "waterfall",
    name: "Materuni Waterfall & Chagga Village",
    tagline: "Forest hike, waterfall & Chagga coffee",
    price: 45,
    duration: "7–8 hours",
    image: "waterfall_image/1791998303073-materuni-waterfall-hike.jpg",
    alt: "Materuni waterfall seen from the forest trail in Kilimanjaro",
    desc: "Guided rainforest hike to the 95m waterfall, coffee roasting with local songs, Chagga dance and a home-cooked lunch."
  },
  {
    key: "cooking",
    name: "Coffee Tradition & Village Cooking",
    tagline: "Hands-on coffee & Chagga kitchen",
    price: 55,
    duration: "5–6 hours",
    image: "coffee_image/1791994933291-materuni-coffe-picking-lesson.jpg",
    alt: "Local coffee harvest and traditional preparation in Materuni",
    desc: "From picking and woodfire roasting to cooking a traditional Chagga meal with local village mamas."
  },
  {
    key: "camping",
    name: "Materuni Overnight Village Stay",
    tagline: "Camp under Mount Kilimanjaro",
    price: 101,
    duration: "2 days · 1 night",
    image: "story_image/1791994219885-materuni-coffe-plantatio-tour.jpg",
    alt: "Sunset over the green coffee landscape in Materuni Village",
    desc: "Camp high in the Kilimanjaro foothills with dinner by the fire, village storytelling, breakfast and next-day tour."
  }
];

// Host profiles for Meet Your Hosts section (T5)
const hosts = [
  {
    name: "Saidi Materu",
    role: "Founder & Lead Mountain Host",
    bio: "Born and raised in Materuni; 12+ years guiding travelers to the waterfall, coffee farms and Kilimanjaro trails.",
    image: "story_image/1791995912146-materuni-community.jpg",
    alt: "Saidi Materu welcoming guests in Materuni Village"
  },
  {
    name: "Elia",
    role: "Chagga Coffee Specialist",
    bio: "Third-generation coffee grower sharing the ancestral songs, roasting rhythm, and pestle grinding traditions.",
    image: "coffee_image/1791998412318-materuni-tour.jpg",
    alt: "Elia preparing freshly ground Chagga coffee by the fire"
  },
  {
    name: "Amani",
    role: "Forest & Trail Guide",
    bio: "Passionate naturalist sharing indigenous plants, birdlife, chameleon spotting and the secret trail paths.",
    image: "story_image/1791601761441-q3iog8mni3r.jpg",
    alt: "Amani guiding a nature walk along the Materuni river trail"
  }
];

// Real guest quotes (T1)
const guestReviews = [
  {
    quote: "The hike to the 95m waterfall through lush green coffee groves was breathtaking. Saidi was an exceptional guide — warm, knowledgeable, and patient. Roasting coffee beans over the open fire while singing was the highlight of Tanzania.",
    author: "Elena Rostova",
    location: "Munich, Germany",
    tour: "Waterfall & Chagga Village"
  },
  {
    quote: "Staying overnight at the campsite in Materuni was unforgettable. Falling asleep under Mount Kilimanjaro's foothills, hot firewood dinner prepared with fresh village vegetables, and waking to fresh coffee. Spotless setup.",
    author: "David & Sarah Jenkins",
    location: "Bristol, UK",
    tour: "Overnight Village Camping"
  },
  {
    quote: "An authentic community experience far from commercial tourist traps. We learned every step of coffee production and tasted the freshest cup imaginable. You truly come as a guest and leave as a friend.",
    author: "Marc Dubois",
    location: "Lyon, France",
    tour: "Coffee & Chagga Culture"
  }
];

// How your day works (4 steps)
const daySteps = [
  {
    step: "1",
    title: "Morning pickup",
    text: "Your private driver meets you at your Moshi or Arusha hotel, or directly at Kilimanjaro Airport."
  },
  {
    step: "2",
    title: "Forest walk & waterfall",
    text: "A scenic 40-minute guided walk through banana and coffee groves to the 95-metre Materuni waterfall."
  },
  {
    step: "3",
    title: "Coffee ceremony & lunch",
    text: "Hand-pick, roast and brew your own cup over woodfire with Chagga songs, followed by hot local food."
  },
  {
    step: "4",
    title: "Relaxed return or camp",
    text: "Return comfortably to your town lodge before evening traffic, or settle in for an overnight camp."
  }
];

// Latest Journal posts (J5)
const journalPosts = [
  {
    title: "How to Get to Materuni Village from Moshi, Arusha and KIA",
    excerpt: "Routes, travel times, road conditions, and confirmed vehicle transfer prices from local Chagga hosts.",
    slug: "how-to-get-to-materuni",
    category: "Getting here",
    readTime: "5 min read",
    date: "October 2026",
    image: "hero_image/1791995544192-materuni-waterfall.jpg",
    alt: "Materuni waterfall seen from the forest trail"
  },
  {
    title: "How Traditional Chagga Coffee is Made from Bean to Cup",
    excerpt: "From harvesting ripe red cherries to roasting on firewood, wooden pestle grinding, and Chagga songs.",
    slug: "how-traditional-chagga-coffee-is-made",
    category: "Culture & food",
    readTime: "4 min read",
    date: "October 2026",
    image: "coffee_image/1791998412318-materuni-tour.jpg",
    alt: "Chagga coffee roasting over woodfire"
  },
  {
    title: "What to Bring on the Materuni Waterfall Hike",
    excerpt: "Trail footwear, packing tips, wet-season advice, and local currency practicalities before you set off.",
    slug: "what-to-bring-on-materuni-waterfall-hike",
    category: "Planning",
    readTime: "4 min read",
    date: "October 2026",
    image: "story_image/1791601761441-q3iog8mni3r.jpg",
    alt: "Green lush hiking trail leading to Materuni waterfall"
  }
];

// 5-Question FAQ
const faqs = [
  {
    q: "How far is Materuni from Moshi town?",
    a: "Materuni Village sits about 15 km north of Moshi, approximately 45–60 minutes by car. The last 6–7 km is a dirt road through banana and coffee plantations."
  },
  {
    q: "Can I visit Materuni without booking a tour?",
    a: "You can drive to the village, but you must register with local guides for the waterfall trail and village paths. Booking directly with local hosts guarantees your permits, guide, coffee ceremony, and lunch are all arranged seamlessly."
  },
  {
    q: "Is the waterfall hike difficult?",
    a: "It is a moderate 40-minute walk each way along a winding forest path with gentle inclines. Sturdy walking shoes or sneakers are recommended. In rainy periods, paths can be muddy."
  },
  {
    q: "What is your cancellation policy?",
    a: "We offer 100% free cancellation up to 48 hours before your experience, with full refund or free date rescheduling in case of severe mountain weather."
  },
  {
    q: "How does payment work?",
    a: "Sending a booking request is 100% free with zero payment required today. Once your host confirms availability, you can secure your date with a 20–30% deposit via card or M-Pesa."
  }
];
---

<SiteLayout
  title="Materuni Hosts | Authentic Kilimanjaro Experiences"
  description="Discover authentic Materuni waterfall hikes, Chagga coffee traditions, cooking classes and village camping hosted by local Chagga guides in Kilimanjaro, Tanzania."
  preloadImage={optimizedHero.src}
>
  <section class="premium-hero" aria-labelledby="hero-heading">
    <div class="hero-bg">
      <img
        src={optimizedHero.src}
        alt="Materuni waterfall seen through the rainforest canopy in Kilimanjaro, Tanzania"
        width="1600"
        height="1000"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-img-element"
      />
      <div class="hero-overlay" aria-hidden="true"></div>
    </div>
    <div class="hero-content">
      <span class="eyebrow hero-badge">MATERUNI VILLAGE · KILIMANJARO · TANZANIA</span>
      <h1 id="hero-heading">Authentic Kilimanjaro experiences with local hosts.</h1>
      <p class="hero-sub">Hike to the 95-metre Materuni waterfall, roast fresh Chagga coffee over woodfire, and experience genuine village hospitality on the slopes of Mount Kilimanjaro.</p>
      <div class="hero-cta-group">
        <a class="gold-button" href="/booking">Book your day</a>
        <a class="hero-outline-button" href="/day-trips">Explore day trips</a>
      </div>
      <div class="hero-social-proof">
        <div class="stars" aria-hidden="true">★★★★★</div>
        <span><strong>5.0 rating</strong> · 120+ verified reviews on Google & TripAdvisor</span>
      </div>
    </div>
  </section>

  <!-- 2. TRUST STRIP (P3: TTB registered · Local Chagga hosts · Free cancellation · Pickup from Moshi) -->
  <div class="trust-banner" role="region" aria-label="Trust highlights">
    <div class="trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <span>TTB REGISTERED</span>
    </div>
    <div class="trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span>LOCAL CHAGGA HOSTS</span>
    </div>
    <div class="trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <span>FREE CANCELLATION UP TO 48H</span>
    </div>
    <div class="trust-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      <span>PICKUP FROM MOSHI & ARUSHA</span>
    </div>
  </div>

  <!-- 3. THREE SIGNATURE EXPERIENCES (P3: Waterfall day, Coffee & cooking, Overnight stay) -->
  <section class="home-section" aria-labelledby="experiences-heading">
    <div class="section-header">
      <span class="eyebrow">SIGNATURE DAYS</span>
      <h2 id="experiences-heading">Three ways to experience Materuni.</h2>
      <p>Every signature day includes local guiding, village entry, fresh coffee, and a hot traditional lunch.</p>
    </div>
    <div class="sig-cards-grid">
      {signatureExperiences.map((exp) => (
        <article class="sig-card">
          <div class="sig-card-media">
            <Image src={base + exp.image} alt={exp.alt} width={640} height={420} format="webp" quality={76} loading="lazy" decoding="async" />
            <span class="sig-card-duration">{exp.duration}</span>
          </div>
          <div class="sig-card-body">
            <div class="sig-card-price-row">
              <span class="sig-card-tag">{exp.tagline}</span>
              <span class="sig-card-price">${exp.price} <small>PER PERSON</small></span>
            </div>
            <h3>{exp.name}</h3>
            <p>{exp.desc}</p>
            <div class="sig-card-actions">
              <a class="gold-button" href={`/booking?experience=${exp.key}`}>Book this day</a>
              <a class="card-text-link" href={`/experiences#${exp.key}`}>Learn more →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="section-center-cta">
      <a class="view-all-link" href="/experiences">View all 6 experiences including Moshi Town & Rau Forest →</a>
      <p class="live-tzs-note">Indicative TZS guide: $41 ≈ TZS 108,000 · $45 ≈ TZS 119,000 · $55 ≈ TZS 145,000 · $59 ≈ TZS 156,000 · $65 ≈ TZS 172,000 · $101 ≈ TZS 267,000.</p>
    </div>
  </section>

  <!-- 4. MEET YOUR HOSTS (T5: Real portraits, names, one line, TTB/TALA info) -->
  <section class="home-section bg-warm" aria-labelledby="hosts-heading">
    <div class="section-header">
      <span class="eyebrow">MEET YOUR HOSTS</span>
      <h2 id="hosts-heading">Local Chagga hospitality from the people who live here.</h2>
      <p>We are registered local guides and coffee farmers welcoming you directly to our ancestral homeland.</p>
    </div>
    <div class="hosts-grid">
      {hosts.map((host) => (
        <div class="host-card">
          <div class="host-photo-wrap">
            <Image src={base + host.image} alt={host.alt} width={380} height={380} format="webp" quality={76} loading="lazy" decoding="async" class="host-photo" />
          </div>
          <h3>{host.name}</h3>
          <span class="host-role">{host.role}</span>
          <p>{host.bio}</p>
        </div>
      ))}
    </div>
    <div class="host-credentials">
      <p>Licensed & Certified by Tanzania Tourism: <strong>TTB/REG/2026/0412</strong> · TALA: <strong>TZ-KIL-2026-088</strong></p>
      <a class="gold-button" href="/about-us">Read our story</a>
    </div>
  </section>

  <!-- 5. REVIEWS (T1 & P3: 3 real quotes with name + country) -->
  <section class="home-section" aria-labelledby="reviews-heading">
    <div class="section-header">
      <span class="eyebrow">VERIFIED GUEST REVIEWS</span>
      <h2 id="reviews-heading">Loved by travelers from around the world.</h2>
      <p>Rated 5.0 out of 5.0 on Google & TripAdvisor from over 120 independent traveler reviews.</p>
    </div>
    <div class="reviews-grid">
      {guestReviews.map((rev) => (
        <blockquote class="home-review-card">
          <div class="review-stars" aria-label="5 stars">★★★★★</div>
          <p class="review-text">“{rev.quote}”</p>
          <footer class="review-footer">
            <strong>{rev.author}</strong>
            <span>{rev.location} · {rev.tour}</span>
          </footer>
        </blockquote>
      ))}
    </div>
    <div class="section-center-cta">
      <a class="gold-button" href="https://www.google.com/maps/search/?api=1&query=Materuni%20Hosts%20-%20Waterfall%20Tours%20%26%20Village%20Camping%2C%20Materuni%20Village%2C%20Moshi%2C%20Tanzania" target="_blank" rel="noopener noreferrer">Read all reviews on Google Maps ↗</a>
      <a class="subtle-link" href="https://g.page/r/CXy6M_Suiip9EBM/review" target="_blank" rel="noopener noreferrer">Leave a Google review ↗</a>
    </div>
  </section>

  <!-- 6. HOW YOUR DAY WORKS (P3: 4 steps: pickup, forest walk, coffee + lunch, return) -->
  <section class="home-section bg-warm" aria-labelledby="how-it-works-heading">
    <div class="section-header">
      <span class="eyebrow">SEAMLESS LOGISTICS</span>
      <h2 id="how-it-works-heading">How your Materuni day works.</h2>
      <p>From your hotel door to the waterfall pool and back, we take care of every detail.</p>
    </div>
    <div class="steps-grid">
      {daySteps.map((s) => (
        <div class="step-card">
          <div class="step-num">{s.step}</div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
    <div class="section-center-cta">
      <a class="gold-button" href="/itinerary">Customize your itinerary</a>
    </div>
  </section>

  <!-- 7. FROM THE JOURNAL (P3: 3 latest posts) -->
  <section class="home-section" aria-labelledby="journal-heading">
    <div class="section-header">
      <span class="eyebrow">MATERUNI JOURNAL</span>
      <h2 id="journal-heading">Practical advice & stories from the village.</h2>
      <p>Local guides share transport timings, packing tips, and cultural background.</p>
    </div>
    <div class="journal-grid">
      {journalPosts.map((post) => (
        <article class="journal-card">
          <a class="journal-media-link" href={`/journal/${post.slug}`} aria-label={post.title}>
            <Image src={base + post.image} alt={post.alt} width={640} height={380} format="webp" quality={76} loading="lazy" decoding="async" class="journal-cover" />
          </a>
          <div class="journal-body">
            <div class="journal-meta">
              <span class="pill-cat">{post.category}</span>
              <span class="read-time">{post.readTime}</span>
            </div>
            <h3><a href={`/journal/${post.slug}`}>{post.title}</a></h3>
            <p>{post.excerpt}</p>
            <a class="read-more-link" href={`/journal/${post.slug}`}>Read article →</a>
          </div>
        </article>
      ))}
    </div>
    <div class="section-center-cta">
      <a class="gold-button" href="/journal">Explore all Journal posts</a>
    </div>
  </section>

  <!-- 8. MAP, 5-QUESTION FAQ AND FINAL BOOKING BUTTON (P3 & B12) -->
  <section class="home-section" id="location-faq" aria-labelledby="faq-map-heading">
    <div class="section-header">
      <span class="eyebrow">PLAN YOUR VISIT</span>
      <h2 id="faq-map-heading">Frequently asked questions & village map.</h2>
      <p>Everything you need to know before coming up to Materuni.</p>
    </div>
    <div class="map-faq-split">
      <div class="faq-accordion">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary><span>{faq.q}</span></summary>
            <div class="faq-answer"><p>{faq.a}</p></div>
          </details>
        ))}
      </div>
      <div class="map-embed-wrapper">
        <iframe
          loading="lazy"
          title="Materuni Hosts location in Materuni Village, Moshi, Tanzania"
          src="https://www.google.com/maps?q=Materuni%20Hosts%20-%20Waterfall%20Tours%20%26%20Village%20Camping%2C%20Materuni%20Village%2C%20Moshi%2C%20Tanzania&amp;output=embed"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <div class="map-caption">
          <strong>Materuni Village, Kilimanjaro Foothills</strong>
          <span>45–60 mins north of Moshi · 1.5–2 hours from KIA · 2.5–3 hours from Arusha</span>
        </div>
      </div>
    </div>
    <div class="final-book-banner">
      <h3>Ready to experience authentic Materuni?</h3>
      <p>Reserve your date online in 2 minutes. Free cancellation up to 48 hours before.</p>
      <div class="hero-cta-group">
        <a class="gold-button" href="/booking">Check availability & book</a>
        <a class="hero-outline-button" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%20would%20like%20to%20plan%20a%20visit." target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
/* P3 Design Rules: Deep green headings, warm off-white background, gold buttons */
.premium-hero {
  position: relative;
  min-height: clamp(540px, 78vh, 760px);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FAF7F2;
  overflow: hidden;
  text-align: center;
  padding: clamp(64px, 10vw, 110px) 20px;
}
.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 1;
}
.hero-img-element {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 40%;
  display: block;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20, 45, 32, 0.74) 0%, rgba(20, 45, 32, 0.88) 100%);
  pointer-events: none;
}
.hero-content {
  position: relative;
  z-index: 2;
  max-width: 860px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hero-badge {
  background: rgba(197, 160, 89, 0.2);
  border: 1px solid rgba(197, 160, 89, 0.45);
  color: #E6DFD3;
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 11px;
  letter-spacing: 0.16em;
  margin-bottom: 18px;
}
.premium-hero h1 {
  font: 600 clamp(38px, 6vw, 68px)/1.08 "Cormorant Garamond", Georgia, serif;
  color: #FAF7F2;
  margin: 0 0 18px;
  text-wrap: balance;
}
.hero-sub {
  font-size: clamp(16px, 1.3vw, 19px);
  line-height: 1.65;
  color: #E6DFD3;
  max-width: 680px;
  margin: 0 0 28px;
}
.hero-cta-group {
  display: flex;
  gap: 14px;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}
.gold-button {
  background: #C5A059;
  color: #1A3322 !important;
  font: 800 14px/1 "Manrope", sans-serif;
  letter-spacing: 0.04em;
  padding: 15px 30px;
  border-radius: 999px;
  text-decoration: none;
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 20px rgba(197, 160, 89, 0.3);
  transition: transform 0.15s ease, background 0.15s ease;
}
.gold-button:hover {
  background: #dbb366;
  transform: translateY(-1px);
}
.hero-outline-button {
  background: rgba(255, 255, 255, 0.1);
  color: #FAF7F2 !important;
  border: 1px solid rgba(255, 255, 255, 0.4);
  font: 700 14px/1 "Manrope", sans-serif;
  letter-spacing: 0.02em;
  padding: 15px 26px;
  border-radius: 999px;
  text-decoration: none;
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(6px);
  transition: background 0.15s ease;
}
.hero-outline-button:hover {
  background: rgba(255, 255, 255, 0.2);
}
.hero-social-proof {
  margin-top: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #E6DFD3;
}
.hero-social-proof .stars {
  color: #f59e0b;
  font-size: 16px;
  letter-spacing: 2px;
}

/* Trust Banner */
.trust-banner {
  display: flex;
  justify-content: center;
  gap: clamp(16px, 4vw, 48px);
  flex-wrap: wrap;
  padding: 18px 24px;
  background: #1A3322;
  color: #FAF7F2;
  border-bottom: 1px solid #C5A059;
}
.trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font: 700 11px/1 "Manrope", sans-serif;
  letter-spacing: 0.1em;
  color: #E6DFD3;
}
.trust-item svg {
  width: 18px;
  height: 18px;
  color: #C5A059;
}

/* Common Section */
.home-section {
  padding: 80px clamp(20px, 6vw, 96px);
  max-width: 1240px;
  margin: 0 auto;
}
.bg-warm {
  max-width: 100%;
  background: #F4EFE6;
  border-top: 1px solid #E6DFD3;
  border-bottom: 1px solid #E6DFD3;
}
.section-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 48px;
}
.section-header h2 {
  font: 600 clamp(32px, 4.2vw, 48px)/1.15 "Cormorant Garamond", Georgia, serif;
  color: #1A3322;
  margin: 8px 0 12px;
}
.section-header p {
  color: #556056;
  font-size: 16px;
  line-height: 1.6;
