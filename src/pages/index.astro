---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image, getImage } from "astro:assets";
import { supabaseUrl } from "../lib/supabase-public";

const base = `${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const heroSource = base + "hero_image/1791995544192-materuni-waterfall.jpg";
const optimizedHero = await getImage({ src: heroSource, width: 1600, height: 1000, format: "webp", quality: 80 });

// Curated 6 experiences with equal visual importance (authoritative pricing aligned with Supabase catalog)
const curatedExperiences = [
  {
    key: "waterfall",
    name: "Materuni Waterfall & Chagga Village Experience",
    tagline: "Forest hike, waterfall & Chagga coffee",
    price: 45,
    duration: "7–8 hours",
    image: "waterfall_image/1791998303073-materuni-waterfall-hike.jpg",
    alt: "Materuni waterfall cascading into the lush forest pool in Kilimanjaro",
    desc: "A guided rainforest hike to the thunderous 95-metre waterfall, followed by traditional coffee roasting with local songs, Chagga dance, and a hot village lunch.",
    inclusions: [
      "Professional local Chagga guide",
      "Village and waterfall entrance fees",
      "Traditional coffee roasting & tasting",
      "Hot home-cooked Chagga lunch",
      "Complimentary Mbege tasting"
    ],
    exclusions: "Transport to Materuni (arranged separately on request), tips, personal purchases.",
    prep: "Sturdy walking shoes with reliable grip, light rain jacket, swimwear if swimming."
  },
  {
    key: "coffee",
    name: "Traditional Chagga Coffee Experience",
    tagline: "From coffee harvest to freshly brewed cup",
    price: 41,
    duration: "4–5 hours",
    image: "coffee_image/1791998412318-materuni-tour.jpg",
    alt: "Traditional Chagga coffee roasting over open woodfire in Materuni",
    desc: "Discover centuries-old coffee growing traditions. Pick ripe cherries, roast beans over firewood embers, and grind with heavy wooden pestles while singing local harvest songs.",
    inclusions: [
      "Local coffee specialist host",
      "Village entrance permits",
      "Hands-on roasting, grinding & brewing",
      "Freshly prepared coffee tasting",
      "Traditional Chagga village lunch"
    ],
    exclusions: "Transport to Materuni, personal purchases of roasted coffee beans, tips.",
    prep: "Comfortable casual clothes, appetite for fresh coffee and lively singing."
  },
  {
    key: "cooking",
    name: "Traditional Chagga Cooking Class",
    tagline: "Hands-on village cooking with local mamas",
    price: 55,
    duration: "5–6 hours",
    image: "coffee_image/1791994933291-materuni-coffe-picking-lesson.jpg",
    alt: "Fresh harvest and cooking preparation in Materuni Village kitchen",
    desc: "Join local village mamas over firewood hearths. Prepare authentic Chagga dishes using fresh green bananas, yams, and homegrown vegetables, then share the feast together.",
    inclusions: [
      "Hands-on cooking workshop with village hosts",
      "All fresh farm ingredients & cooking gear",
      "Shared family feast of dishes prepared",
      "Traditional coffee tasting",
      "Bottled drinking water"
    ],
    exclusions: "Transport to Materuni, personal beverages, tips.",
    prep: "Willingness to chop, stir and cook over woodfire; aprons and utensils provided."
  },
  {
    key: "moshi",
    name: "Materuni & Moshi Town Cultural Experience",
    tagline: "Mountain waterfall & historic market town",
    price: 59,
    duration: "7–8 hours",
    image: "story_image/1791995912146-materuni-community.jpg",
    alt: "Saidi Materu and community members welcoming visitors in Materuni",
    desc: "Combine the morning Materuni waterfall walk and coffee ceremony with an afternoon guided walking tour of Moshi town, historic colonial streets, and bustling local markets.",
    inclusions: [
      "Local guides in Materuni and Moshi town",
      "Village and waterfall entry fees",
      "Traditional coffee ceremony & lunch",
      "Guided Moshi historical walking tour",
      "Local market exploration & orientation"
    ],
    exclusions: "Transport between locations (arranged on request), market shopping, tips.",
    prep: "Comfortable footwear suitable for both forest trail and city walking."
  },
  {
    key: "rau",
    name: "Materuni & Rau Forest Nature Experience",
    tagline: "Waterfall, coffee & ancient groundwater forest",
    price: 65,
    duration: "7–8 hours",
    image: "story_image/1791601761441-q3iog8mni3r.jpg",
    alt: "Lush green trail through the forest canopy in northern Tanzania",
    desc: "Pair the mountain waterfall and coffee ceremony with an afternoon nature trek through the protected Rau Forest reserve, known for black-and-white colobus monkeys and giant Mvule trees.",
    inclusions: [
      "Local guides for Materuni and Rau Forest",
      "Materuni & Rau Forest entrance permits",
      "Traditional coffee ceremony & lunch",
      "Guided Rau Forest ecology walk",
      "Ancient sacred Mvule tree exploration"
    ],
    exclusions: "Private transfer between locations (arranged on request), tips.",
    prep: "Walking shoes, camera or binoculars for bird and colobus monkey spotting."
  },
  {
    key: "camping",
    name: "Materuni Overnight Village Experience",
    tagline: "Camp in the foothills beneath Mount Kilimanjaro",
    price: 101,
    duration: "2 days · 1 night",
    image: "story_image/1791994219885-materuni-coffe-plantatio-tour.jpg",
    alt: "Sunset over the green coffee landscape in Materuni Village",
    desc: "Slow down and experience village life after the day visitors leave. Enjoy a spotless tent setup, campfire dinner with local storytelling, stargazing, and morning mountain breakfast.",
    inclusions: [
      "Full tent accommodation & campsite setup",
      "Campfire dinner & hot village breakfast",
      "Guided 95m waterfall hike & coffee tour",
      "Authentic lunch on arrival day",
      "Evening stories with local Chagga hosts"
    ],
    exclusions: "Personal sleeping bag and toiletries, transport to camp, tips.",
    prep: "Warm clothing for cool mountain nights, flashlight or headlamp."
  }
];

// Host profiles for Meet Your Hosts section
const hosts = [
  {
    name: "Saidi Materu",
    role: "Founder & Lead Mountain Host",
    bio: "Born and raised in Materuni Village. Saidi has guided travelers along waterfall paths, coffee farms, and Kilimanjaro foothills for over 12 years with deep pride in Chagga culture.",
    image: "story_image/1791995912146-materuni-community.jpg",
    alt: "Saidi Materu welcoming guests in Materuni Village"
  },
  {
    name: "Elia",
    role: "Chagga Coffee Specialist",
    bio: "A third-generation coffee farmer who preserves ancestral roasting rhythms, wooden pestle grinding techniques, and the joyous songs passed down by village elders.",
    image: "coffee_image/1791998412318-materuni-tour.jpg",
    alt: "Elia preparing freshly ground Chagga coffee by the fire"
  },
  {
    name: "Amani",
    role: "Forest & Trail Guide",
    bio: "A lifelong naturalist sharing deep knowledge of Kilimanjaro's indigenous plants, waterfall geology, bird species, and chameleon spotting along the rainforest trail.",
    image: "story_image/1791601761441-q3iog8mni3r.jpg",
    alt: "Amani guiding a nature walk along the Materuni trail"
  }
];

// 4-step guest journey
const daySteps = [
  {
    step: "01",
    title: "Warm Arrival & Pickup",
    text: "Meet your driver at your Moshi, KIA or Arusha hotel, or receive a warm welcome directly at our Materuni Village trailhead."
  },
  {
    step: "02",
    title: "Waterfall Forest Hike",
    text: "A scenic 40-minute guided walk through banana groves and cloud forest canopy to the thunderous 95-metre Materuni waterfall."
  },
  {
    step: "03",
    title: "Coffee Songs & Feast",
    text: "Roast fresh Arabica beans over woodfire with traditional Chagga songs, followed by a hot home-cooked feast with local mamas."
  },
  {
    step: "04",
    title: "Sunset Return or Camp",
    text: "Return comfortably to your town lodge before evening, or relax around the evening campfire for an overnight village stay."
  }
];

// Journal posts
const journalPosts = [
  {
    title: "How to Get to Materuni Village from Moshi, Arusha and KIA",
    excerpt: "Routes, travel times, road conditions, and confirmed vehicle transfer prices from local Chagga hosts.",
    slug: "how-to-get-to-materuni",
    category: "Getting here",
    readTime: "5 min read",
    image: "hero_image/1791995544192-materuni-waterfall.jpg",
    alt: "Materuni waterfall seen from the forest trail"
  },
  {
    title: "How Traditional Chagga Coffee is Made from Bean to Cup",
    excerpt: "From harvesting ripe red cherries to roasting on firewood, wooden pestle grinding, and Chagga songs.",
    slug: "how-traditional-chagga-coffee-is-made",
    category: "Culture & food",
    readTime: "4 min read",
    image: "coffee_image/1791998412318-materuni-tour.jpg",
    alt: "Chagga coffee roasting over woodfire"
  },
  {
    title: "What to Bring on the Materuni Waterfall Hike",
    excerpt: "Trail footwear, packing tips, wet-season advice, and local currency practicalities before you set off.",
    slug: "what-to-bring-on-materuni-waterfall-hike",
    category: "Planning",
    readTime: "4 min read",
    image: "story_image/1791601761441-q3iog8mni3r.jpg",
    alt: "Green lush hiking trail leading to Materuni waterfall"
  }
];

// 6 FAQs
const faqs = [
  {
    q: "How far is Materuni from Moshi, and how do I get there?",
    a: "Materuni Village sits about 15 km north of Moshi in the Kilimanjaro foothills, approximately 45–60 minutes by car. We offer door-to-door private transfers from Moshi ($25 per vehicle), Kilimanjaro Airport / KIA ($50), and Arusha ($80) for up to 6 guests."
  },
  {
    q: "Is the waterfall hike difficult for children or seniors?",
    a: "It is a moderate 40-minute walk each way along a winding forest path with gentle inclines. Sturdy walking shoes or sneakers are recommended. We keep an unhurried pace suited to every guest in your private group."
  },
  {
    q: "What should I wear and pack for the day?",
    a: "Wear comfortable walking shoes with grip, lightweight breathable clothing, sun protection, and a light rain jacket. If you wish to take a refreshing dip in the waterfall pool, bring swimwear and a towel."
  },
  {
    q: "Are prices transparent with all fees included?",
    a: "Yes. Every tour price includes professional local guiding, village and waterfall entry permits, hands-on coffee processing, and a hot traditional Chagga lunch. There are no surprise park fees or mandatory extras."
  },
  {
    q: "How does booking and payment work?",
    a: "Submitting a booking request on our website is 100% free with zero payment required upfront. Saidi Materu reviews your date and confirms availability within 3–6 hours. You only pay after reviewing confirmed details."
  },
  {
    q: "What is your cancellation and weather policy?",
    a: "We offer 100% free cancellation and full refund up to 48 hours before your experience, as well as complimentary date rescheduling if severe mountain weather affects trail safety."
  }
];
---

<SiteLayout
  title="Materuni Hosts | Authentic Kilimanjaro Experiences"
  description="Discover authentic Materuni waterfall hikes, Chagga coffee traditions, cooking classes, village tours and overnight camping hosted by local Chagga guides in Kilimanjaro, Tanzania."
  preloadImage={optimizedHero.src}
>
  <!-- 1. PREMIUM CINEMATIC HERO SECTION -->
  <section class="premium-hero" aria-labelledby="hero-heading">
    <div class="hero-bg" style={`background-image: linear-gradient(180deg, rgba(20,45,32,0.70) 0%, rgba(20,45,32,0.85) 100%), url(${optimizedHero.src})`}></div>
    <div class="hero-content">
      <span class="hero-badge">MATERUNI VILLAGE · KILIMANJARO · TANZANIA</span>
      <h1 id="hero-heading">Discover Materuni Through Local Eyes.</h1>
      <p class="hero-sub">Meaningful cultural encounters, beautiful landscapes and genuine connections with the people who call Materuni home.</p>
      <div class="hero-cta-group">
        <a class="gold-button" href="#experiences">Explore Experiences</a>
        <a class="hero-outline-button" href="#hosts">Meet Your Hosts</a>
      </div>
      <div class="hero-social-proof">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>Independent traveler reviews on <a href="https://www.tripadvisor.com/34765809" target="_blank" rel="noopener noreferrer" class="proof-link">TripAdvisor</a> &amp; <a href="https://g.page/r/CXy6M_Suiip9EBM/review" target="_blank" rel="noopener noreferrer" class="proof-link">Google</a></span>
      </div>
    </div>
  </section>

  <!-- QUICK BOOKING STRIP: clear next step without interrupting the editorial hero -->
  <section class="mh-quick-plan" aria-label="Plan your Materuni experience">
    <div class="mh-quick-plan-inner">
      <div class="mh-quick-plan-intro">
        <span class="mh-quick-plan-kicker">YOUR VISIT, MADE SIMPLE</span>
        <h2>Make a little room for Materuni.</h2>
        <p>Choose an experience, check a date and send a booking request directly to your local hosts.</p>
      </div>
      <div class="mh-quick-plan-steps" aria-label="Booking steps">
        <div class="mh-quick-plan-step"><span>01</span><strong>Choose</strong><small>Find your experience</small></div>
        <div class="mh-quick-plan-rule" aria-hidden="true"></div>
        <div class="mh-quick-plan-step"><span>02</span><strong>Check</strong><small>See available dates</small></div>
        <div class="mh-quick-plan-rule" aria-hidden="true"></div>
        <div class="mh-quick-plan-step"><span>03</span><strong>Connect</strong><small>Send your request</small></div>
      </div>
      <a class="mh-quick-plan-button" href="/booking?source=homepage">Plan your visit <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <!-- 2. SHORT, COMPELLING BRAND INTRODUCTION -->
  <section class="brand-intro-section" aria-labelledby="brand-intro-heading">
    <div class="brand-intro-container">
      <span class="eyebrow">AUTHENTIC BOUTIQUE HOSPITALITY</span>
      <h2 id="brand-intro-heading">Rooted in Materuni, Hosted with Pride</h2>
      <p class="brand-intro-lead">
        High on the fertile volcanic slopes of Mount Kilimanjaro, Materuni Village is our ancestral home. We are a collective of village-born Chagga guides, coffee farmers, and local families.
      </p>
      <p class="brand-intro-body">
        Rather than treating Materuni as a rushed commercial day excursion, we welcome you to unhurried, personal encounters. We open our rainforest waterfall trails, woodfire coffee hearths, and family kitchens with warmth and integrity — so you arrive as a guest, and leave as a friend.
      </p>
      <div class="intro-pillars-grid">
        <div class="intro-pillar">
          <div class="pillar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Village-Born Hosts</h3>
          <p>Every walk and ceremony is led by residents who grew up here, sharing genuine Chagga traditions and lived heritage.</p>
        </div>
        <div class="intro-pillar">
          <div class="pillar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3>Unhurried Pacing</h3>
          <p>Small private groups, uncrowded timings, and ample time to listen, taste, learn, and absorb the peaceful mountain atmosphere.</p>
        </div>
        <div class="intro-pillar">
          <div class="pillar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h3>Direct Village Benefit</h3>
          <p>Meet the local guides, coffee-growing families, and cooking hosts who bring each experience to life.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. CURATED LOCAL EXPERIENCES COLLECTION -->
  <section class="home-section" id="experiences" aria-labelledby="experiences-heading">
    <div class="section-header">
      <span class="eyebrow">CURATED EXPERIENCES</span>
      <h2 id="experiences-heading">Six Meaningful Ways to Experience Materuni</h2>
      <p>All genuine experiences are presented with equal care. Every package includes professional local guiding, village entry, coffee traditions, and a hot home-cooked lunch.</p>
    </div>
    <div class="curated-grid">
      {curatedExperiences.map((exp) => (
        <article class="boutique-card" id={`exp-${exp.key}`}>
          <div class="boutique-card-media">
            <Image
              src={base + exp.image}
              alt={exp.alt}
              width={640}
              height={420}
              format="webp"
              quality={78}
              loading="lazy"
              decoding="async"
              class="boutique-photo"
            />
            <span class="card-duration-badge">{exp.duration}</span>
          </div>
          <div class="boutique-card-content">
            <div class="card-meta-top">
              <span class="card-tagline">{exp.tagline}</span>
              <span class="card-price-display">${exp.price} <small>PER PERSON</small></span>
            </div>
            <h3>{exp.name}</h3>
            <p class="card-desc">{exp.desc}</p>
            
            <div class="card-inclusions-block">
              <strong>What's included:</strong>
              <ul>
                {exp.inclusions.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>

            <div class="card-prep-block">
              <span class="prep-label">Not included:</span> {exp.exclusions}
            </div>

            <div class="card-prep-block">
              <span class="prep-label">Guest preparation:</span> {exp.prep}
            </div>

            <div class="boutique-card-actions">
              <a class="gold-button" href={`/booking?experience=${exp.key}`}>Book this experience</a>
              <a class="card-secondary-link" href={`/experiences#${exp.key}`}>View details →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="section-center-cta">
      <p class="indicative-rate-note">
        Indicative TZS guide: $41 ≈ TZS 108,000 · $45 ≈ TZS 119,000 · $55 ≈ TZS 145,000 · $59 ≈ TZS 156,000 · $65 ≈ TZS 172,000 · $101 ≈ TZS 267,000. Confirmed at prevailing exchange rate before payment.
      </p>
      <a class="view-all-button" href="/experiences">Explore experience details &amp; group discounts</a>
    </div>
  </section>

  <!-- 4. MEET YOUR LOCAL HOSTS -->
  <section class="home-section bg-warm" id="hosts" aria-labelledby="hosts-heading">
    <div class="section-header">
      <span class="eyebrow">LOCAL HOSPITALITY</span>
      <h2 id="hosts-heading">Meet Your Local Hosts</h2>
      <p>Experience Materuni through the people who actually live here. No outsourced staff or generic commercial agents.</p>
    </div>
    <div class="hosts-grid">
      {hosts.map((host) => (
        <div class="host-boutique-card">
          <div class="host-avatar-wrap">
            <Image
              src={base + host.image}
              alt={host.alt}
              width={340}
              height={340}
              format="webp"
              quality={78}
              loading="lazy"
              decoding="async"
              class="host-avatar"
            />
          </div>
          <h3>{host.name}</h3>
          <span class="host-boutique-role">{host.role}</span>
          <p class="host-boutique-bio">{host.bio}</p>
        </div>
      ))}
    </div>
    <div class="hosts-editorial-cta">
      <p>
        We believe that genuine travel begins with authentic personal connections. When you walk our paths, you are guided by neighbours, family, and lifelong stewards of this mountain.
      </p>
      <a class="gold-button" href="/about-us">Read our story</a>
    </div>
  </section>

  <!-- 5. DISCOVER THE CHAGGA CULTURE -->
  <section class="home-section" aria-labelledby="culture-heading">
    <div class="section-header">
      <span class="eyebrow">LIVING HERITAGE</span>
      <h2 id="culture-heading">Discover the Chagga Culture</h2>
      <p>Centuries of harmony between highland farming, community cooperation, and volcanic mountain ecology.</p>
    </div>
    <div class="editorial-feature-grid">
      <div class="feature-card">
        <div class="feature-number">01</div>
        <h3>The Kihamba Farming System</h3>
        <p>
          For generations, the Chagga people developed the ingenious <em>Kihamba</em> agroforestry system — cultivating shade-grown Arabica coffee, indigenous banana varieties, and beans beneath towering forest trees, irrigated by ancient mountain stone furrows.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-number">02</div>
        <h3>The Rhythmic Coffee Ceremony</h3>
        <p>
          Coffee in Materuni is far more than a beverage; it is a community celebration. From peeling and woodfire roasting to pounding in giant wooden pestles, the rhythm is kept alive by joyous ancestral songs welcoming every visitor into the circle.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-number">03</div>
        <h3>Highland Gastronomy &amp; Mbege</h3>
        <p>
          Taste the wholesome flavours of authentic Chagga cuisine: slow-cooked dishes made from green cooking bananas (*machalari*), mountain yams, fresh vegetables, and an optional tasting of *mbege*, the traditional ceremonial banana-millet brew.
        </p>
      </div>
    </div>
  </section>

  <!-- 6. MATERUNI NATURE AND LANDSCAPES -->
  <section class="home-section bg-warm" aria-labelledby="nature-heading">
    <div class="section-header">
      <span class="eyebrow">KILIMANJARO FOOTHILLS</span>
      <h2 id="nature-heading">Materuni Nature &amp; Landscapes</h2>
      <p>Pristine mountain streams, lush rainforest canopies, and sweeping views across the valley.</p>
    </div>
    <div class="split-nature-layout">
      <div class="nature-image-container">
        <Image
          src={base + "waterfall_image/1791998303073-materuni-waterfall-hike.jpg"}
          alt="The dramatic 95-metre Materuni waterfall pouring into the clear pool"
          width={800}
          height={550}
          format="webp"
          quality={78}
          loading="lazy"
          decoding="async"
          class="nature-cover"
        />
      </div>
      <div class="nature-copy-container">
        <h3>Where Glacial Melt Meets Cloud Forest</h3>
        <p>
          At an elevation of 1,800 metres on the southern slopes of Mount Kilimanjaro, Materuni sits in a lush microclimate fed by pure mountain springs. The 95-metre Materuni waterfall is one of the highest and most awe-inspiring in the entire Kilimanjaro region.
        </p>
        <ul class="nature-highlights-list">
          <li>
            <strong>95-Metre Waterfall:</strong> Clean mountain water cascading down volcanic cliffs into a natural forest pool.
          </li>
          <li>
            <strong>Montane Rainforest:</strong> Giant ferns, ancient trees, wild chameleons, and colorful native birdlife.
          </li>
          <li>
            <strong>Kilimanjaro Vistas:</strong> Clear morning panoramas looking up toward the majestic snow-capped summit.
          </li>
        </ul>
        <div class="nature-action-wrap">
          <a class="gold-button" href="/day-trips">Explore Day Trips</a>
          <a class="hero-outline-button dark" href="/travel-guide">Read Travel Guide</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. HOW YOUR EXPERIENCE UNFOLDS -->
  <section class="home-section" aria-labelledby="journey-heading">
    <div class="section-header">
      <span class="eyebrow">THE GUEST JOURNEY</span>
      <h2 id="journey-heading">How Your Experience Unfolds</h2>
      <p>Thoughtful logistics, unhurried pacing, and attentive care from start to finish.</p>
    </div>
    <div class="journey-steps-grid">
      {daySteps.map((s) => (
        <div class="journey-step-card">
          <div class="journey-step-num">{s.step}</div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
    <div class="section-center-cta">
      <a class="gold-button" href="/itinerary">Build a custom itinerary</a>
    </div>
  </section>

  <!-- 8. GUEST FEEDBACK -->
  <section class="home-section bg-warm" aria-labelledby="reviews-heading">
    <div class="section-header">
      <span class="eyebrow">GUEST FEEDBACK</span>
      <h2 id="reviews-heading">Hear from travellers who visited Materuni</h2>
      <p>Read independent guest feedback on our public review platforms before choosing your experience.</p>
    </div>
    <div class="reviews-action-strip">
      <a class="gold-button" href="https://www.tripadvisor.com/34765809" target="_blank" rel="noopener noreferrer">
        Read guest feedback on TripAdvisor ↗
      </a>
      <a class="hero-outline-button dark" href="https://g.page/r/CXy6M_Suiip9EBM/review" target="_blank" rel="noopener noreferrer">
