---
import SiteLayout from "../layouts/SiteLayout.astro";
const faqs = [
  ["Where is Materuni Village?", "Materuni Village is in the Kilimanjaro region of northern Tanzania, near Moshi, on the lower slopes of Mount Kilimanjaro."],
  ["Which experiences can I book?", "Our six featured experiences are Waterfalls & Coffee Tour ($65), Coffee & Chagga Culture Tour ($50), Cooking & Culture ($70), Waterfall Hike & Cultural Day Trip ($75), Overnight Camping ($110) and Ultimate ($135), all priced per person."],
  ["How do I make a booking?", "Choose an experience, select a date and an available time on the booking page, then send your request. A booking request is not a confirmed reservation. Our local host will contact you to confirm the details."],
  ["When do I pay?", "There is no live card payment on the website at this stage. After your request is reviewed and arrangements are confirmed, our team will send the payment instructions."],
  ["Are the prices per person?", "Yes. The published prices are per person. Your total estimate depends on the number of guests and the experiences selected."],
  ["Is transport from Moshi included?", "Transport and pickup arrangements must be confirmed separately when you enquire. Please share your hotel or pickup point in the booking form."],
  ["Can I combine more than one experience?", "Yes. Use the itinerary builder to select several experiences and send your suggested plan to a local host. We will review the timing and confirm a practical sequence."],
  ["Are meals included?", "Meal inclusions depend on the package. Please check the inclusions shown on each experience card and tell us about dietary requirements before your visit."],
  ["What should I tell you about accessibility or dietary needs?", "Please add mobility, dietary, children’s or other special requirements to the booking notes. We will discuss what can be arranged before confirming."],
  ["Can I change or cancel a booking?", "Contact us as soon as possible through WhatsApp or email with your booking reference. Our team will review your request and confirm the available options."]
];
---
<SiteLayout title="Frequently Asked Questions | Materuni Hosts" description="Booking, prices, transport and practical information for Materuni Village experiences near Moshi, Tanzania.">
<section class="page-hero"><span class="eyebrow">GOOD TO KNOW BEFORE YOU VISIT</span><h1>Frequently asked questions.</h1><p>Clear answers to help you plan an authentic Materuni experience with local hosts.</p></section>
<section class="section faq-section">
  <div class="faq-intro"><span class="eyebrow">PLAN WITH CONFIDENCE</span><h2>Everything you need to know.</h2><p>If you need help with something not covered here, speak directly with a local host.</p><a class="button" href="https://wa.me/255612068540" target="_blank" rel="noopener noreferrer">Ask us on WhatsApp</a></div>
  <div class="faq-list">{faqs.map(([question,answer])=><details class="faq-item"><summary>{question}</summary><p>{answer}</p></details>)}</div>
</section>
<section class="band"><h2>Still planning your visit?</h2><p>Tell us what you would like to experience and we will help you shape a practical plan.</p><div class="actions" style="justify-content:center"><a class="button button-light" href="/itinerary">Build your itinerary</a><a class="button secondary" href="/booking">Check availability</a></div></section>
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(([question,answer])=>({"@type":"Question","name":question,"acceptedAnswer":{"@type":"Answer","text":answer}}))})} />
</SiteLayout>
