---
import SiteLayout from "../layouts/SiteLayout.astro";

const accommodationImage = "https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/camping_image/1792122487239-camping.jpg";
const overnightSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Materuni Overnight Village Experience",
  "description": "An overnight village experience in Materuni with local hosting. Accommodation type, meals and activities are confirmed by the host before booking.",
  "touristType": ["Cultural travelers", "Nature lovers"],
  "provider": { "@type": "TourOperator", "name": "Materuni Hosts", "url": "https://materunihosts.com/" },
  "offers": {
    "@type": "Offer",
    "price": "90.00",
    "priceCurrency": "USD",
    "url": "https://materunihosts.com/booking?source=accommodation&experience=overnight",
    "description": "Published price per person in USD. Confirm accommodation arrangements, meals, activities and availability with your host."
  },
  "url": "https://materunihosts.com/accommodation"
};
---
<SiteLayout title="Accommodation in Materuni | Village Camping & Overnight Stays" description="Find an overnight village stay in Materuni near Moshi, Kilimanjaro. Ask Materuni Hosts to confirm facilities, meals and arrangements before booking.">
<LocalBusinessSchema />
<main class="landing">
<section class="hero hero-media" aria-labelledby="accommodation-title"><div class="hero-copy"><p class="eyebrow">OVERNIGHT VILLAGE EXPERIENCE · MATERUNI · TANZANIA</p><h1 id="accommodation-title">Stay overnight in Materuni Village.</h1><p>Spend more time in Materuni with a locally hosted overnight village experience. Accommodation type, meals and activities are confirmed with your host before booking.</p><a class="button" href="/booking?source=accommodation&experience=overnight">Ask about overnight availability</a></div><img src={accommodationImage} alt="Outdoor overnight setup in Materuni; exact accommodation arrangements are confirmed with the host" width="1200" height="800" loading="eager" fetchpriority="high" decoding="async" /></section>
<section><h2>What to confirm before your overnight visit</h2><p>Overnight arrangements are coordinated with your local host. The accommodation type, sleeping arrangements, facilities, meals and activities may vary, so confirm the details for your requested date before making payment.</p><ul><li><strong>Accommodation:</strong> Confirm the type of stay and sleeping arrangements.</li><li><strong>Facilities:</strong> Ask which washroom and other facilities will be available.</li><li><strong>Meals:</strong> Confirm which meals are included and share any dietary requirements or allergies.</li><li><strong>Activities:</strong> Agree the planned village activities, timing and any optional experiences.</li></ul></section>
<section><h2>Published overnight experience price</h2><p>The <strong>Materuni Overnight Village Experience is USD $90 per person</strong>. This price is published in USD only; ask your host to confirm any local-currency amount before payment. The published experience includes a local guide, Materuni village and waterfall entrance fees, a traditional Chagga coffee experience, local lunch, drinking water and an overnight village experience with local hosting. The exact accommodation type, meals and activities are confirmed by your host.</p><p>Transport is arranged separately from the published experience price. If you need a pickup, share your pickup point, date, group size and luggage needs. Your host will confirm whether a transfer can be arranged and provide a separate quote before you decide.</p></section>
<section><h2>Combine your stay with Materuni experiences</h2><p>Use your overnight visit to make time for the <a href="/materuni-waterfall-tour">Materuni Waterfall tour</a>, Chagga coffee traditions and village activities. You can also explore the main <a href="/camping">Materuni camping experience</a> page for package details.</p></section>
<section><h2>Request dates and details</h2><p>Send your preferred dates, group size and accommodation questions. Your host will reply to confirm availability and the arrangements for your visit. A booking request is not a confirmed reservation until your host replies.</p><a class="button" href="/booking?source=accommodation&experience=overnight">Request overnight details</a></section>
</main>
<style>
.landing{color:#242421}.landing .hero{padding:clamp(58px,9vw,112px) clamp(22px,8vw,110px);background:#1a3322;color:#faf7f2}.landing .hero-media{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.9fr);gap:clamp(24px,5vw,64px);align-items:center}.landing .hero-media .hero-copy{min-width:0}.landing .hero-media img{display:block;width:100%;height:clamp(250px,34vw,430px);object-fit:cover;object-position:center 48%;border-radius:12px;box-shadow:0 18px 42px #0003}.landing .hero h1{max-width:850px;margin:12px 0;font:600 clamp(42px,7vw,76px)/1.02 "Cormorant Garamond",serif;color:#faf7f2}.landing .hero p:not(.eyebrow){max-width:700px;color:#e6dfd3;line-height:1.85}.eyebrow{color:#c5a059;font:800 11px Manrope,sans-serif;letter-spacing:.16em}@media(max-width:720px){.landing .hero-media{grid-template-columns:1fr}.landing .hero-media img{height:260px}}.landing section:not(.hero){max-width:950px;margin:auto;padding:42px 24px}.landing h2{font:600 clamp(30px,4vw,44px)/1.1 "Cormorant Garamond",serif;color:#1a3322}.landing p{line-height:1.85;color:#586258}.button{display:inline-block;padding:14px 22px;border-radius:999px;background:#c5a059;color:#1a3322;text-decoration:none;font:800 13px Manrope,sans-serif}
</style>
</SiteLayout>
