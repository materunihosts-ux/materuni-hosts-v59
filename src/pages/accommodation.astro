---
import SiteLayout from "../layouts/SiteLayout.astro";
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import { supabaseUrl } from "../lib/supabase-public";
const accommodationImage = `${supabaseUrl}/storage/v1/object/public/materuni-images/camping_image/1792122487239-camping.jpg`;
---
<SiteLayout title="Accommodation in Materuni | Village Camping & Overnight Stays" description="Looking for accommodation in Materuni? Discover an overnight village camping experience with Materuni Hosts near Moshi, Kilimanjaro, and confirm facilities before booking.">
<LocalBusinessSchema />
<main class="landing">
<section class="hero hero-media" aria-labelledby="accommodation-title"><div class="hero-copy"><p class="eyebrow">OVERNIGHT STAYS · MATERUNI VILLAGE · MOSHI</p><h1 id="accommodation-title">Accommodation in Materuni Village</h1><p>Stay closer to village life with an overnight camping experience hosted in Materuni. Materuni Hosts focuses on a simple outdoor stay, local food and cultural experiences in the foothills of Kilimanjaro.</p><a class="button" href="/booking?source=accommodation&experience=Camping%20%26%20Village%20Life">Ask about overnight availability</a></div><img src={accommodationImage} alt="Outdoor camping setup illustrating the overnight stay; exact tent and facilities are confirmed with the host" width="1200" height="800" loading="eager" fetchpriority="high" decoding="async" /></section>
<section><h2>Is Materuni camping the right stay for you?</h2><p>This option is an outdoor camping experience rather than a hotel room or luxury lodge. It suits travellers who want to spend longer in the village and combine an overnight stay with local experiences. Please discuss your comfort needs and expectations with your host before requesting a booking.</p></section>
<section><h2>Confirm the accommodation details before you travel</h2><p>Facilities and equipment can affect your stay, so ask your host to confirm the exact camping arrangement for your selected date. In particular, confirm tent and bedding provision, toilet and shower access, meals, what to pack, weather conditions and arrival time.</p><p>Do not assume that private bathrooms, permanent rooms, electricity, hot showers or specific tent types are included unless your host confirms them in writing.</p></section>
<section><h2>Combine your stay with Materuni experiences</h2><p>Use your overnight visit to make time for the <a href="/materuni-waterfall-tour">Materuni Waterfall tour</a>, Chagga coffee traditions and village activities. You can also explore the main <a href="/camping">Materuni camping experience</a> page for package details.</p></section>
<section><h2>Request dates and details</h2><p>Send your preferred dates, number of guests and accommodation questions. Your host will check availability and explain the setup and final arrangements before payment.</p><a class="button" href="/booking?source=accommodation&experience=Camping%20%26%20Village%20Life">Request accommodation details</a></section>
</main>
<style>
.landing{color:#242421}.landing .hero{padding:clamp(58px,9vw,112px) clamp(22px,8vw,110px);background:#1a3322;color:#faf7f2}.landing .hero-media{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.9fr);gap:clamp(24px,5vw,64px);align-items:center}.landing .hero-media .hero-copy{min-width:0}.landing .hero-media img{display:block;width:100%;height:clamp(250px,34vw,430px);object-fit:cover;object-position:center 48%;border-radius:12px;box-shadow:0 18px 42px #0003}.landing .hero h1{max-width:850px;margin:12px 0;font:600 clamp(42px,7vw,76px)/1.02 "Cormorant Garamond",serif;color:#faf7f2}.landing .hero p:not(.eyebrow){max-width:700px;color:#e6dfd3;line-height:1.85}.eyebrow{color:#c5a059;font:800 11px Manrope,sans-serif;letter-spacing:.16em}@media(max-width:720px){.landing .hero-media{grid-template-columns:1fr}.landing .hero-media img{height:260px}}.landing section:not(.hero){max-width:950px;margin:auto;padding:42px 24px}.landing h2{font:600 clamp(30px,4vw,44px)/1.1 "Cormorant Garamond",serif;color:#1a3322}.landing p{line-height:1.85;color:#586258}.button{display:inline-block;padding:14px 22px;border-radius:999px;background:#c5a059;color:#1a3322;text-decoration:none;font:800 13px Manrope,sans-serif}
</style>
</SiteLayout>
