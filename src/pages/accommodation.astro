---
import SiteLayout from "../layouts/SiteLayout.astro";
import { supabaseUrl } from "../lib/supabase-public";
const accommodationImage = `${supabaseUrl}/storage/v1/object/public/materuni-images/camping_image/1792122487239-camping.jpg`;
---
<SiteLayout title="Accommodation in Materuni | Village Camping & Overnight Stays" description="Looking for accommodation in Materuni? Discover an overnight village camping experience with Materuni Hosts near Moshi, Kilimanjaro, and confirm facilities before booking.">

<main class="landing">
<section class="hero hero-media" aria-labelledby="accommodation-title"><div class="hero-copy"><p class="eyebrow">OVERNIGHT STAYS · MATERUNI VILLAGE · MOSHI</p><h1 id="accommodation-title">Accommodation in Materuni Village</h1><p>Stay longer in Materuni with an overnight village experience hosted by local people. Share your preferred dates and group size so your host can confirm the available accommodation setup, meal arrangements and activities.</p><a class="button" href="/booking?source=accommodation&experience=Camping%20%26%20Village%20Life">Ask about overnight availability</a></div><img src={accommodationImage} alt="Outdoor camping setup illustrating the overnight stay; exact tent and facilities are confirmed with the host" width="1200" height="800" loading="eager" fetchpriority="high" decoding="async" /></section>
<section><h2>About the overnight village experience</h2><p>The overnight experience gives visitors more time to enjoy Materuni Village and its local culture. Accommodation setup, available facilities, meal arrangements and activities can vary; your host will explain the confirmed arrangements for your dates before you decide.</p><p>Please share your arrival date, number of guests, any dietary requirements and the type of stay you have in mind. This helps the host confirm what can be arranged for your visit.</p></section>
<section><h2>Overnight experience price & transport</h2><p>The Materuni Overnight Village Experience is $90 per person. For groups of four or more, contact your host to discuss group arrangements; any quotation is confirmed before booking.</p><p>Transport to Materuni is not included in the experience price. Share your pickup point and your host will confirm availability and any separate transport quotation before you decide.</p></section>
<section><h2>Combine your stay with Materuni experiences</h2><p>Use your overnight visit to make time for the <a href="/materuni-waterfall-tour">Materuni Waterfall tour</a>, Chagga coffee traditions and village activities. You can also explore the main <a href="/camping">Materuni camping experience</a> page for package details.</p></section>
<section><h2>Request dates and details</h2><p>Send your preferred dates, number of guests and accommodation questions. Your request is not a confirmed reservation; a local host will check availability and reply with the arrangements for your dates.</p><a class="button" href="/booking?source=accommodation&experience=Camping%20%26%20Village%20Life">Request accommodation details</a></section>
</main>
<style>
.landing{color:#242421}.landing .hero{padding:clamp(58px,9vw,112px) clamp(22px,8vw,110px);background:#1a3322;color:#faf7f2}.landing .hero-media{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.9fr);gap:clamp(24px,5vw,64px);align-items:center}.landing .hero-media .hero-copy{min-width:0}.landing .hero-media img{display:block;width:100%;height:clamp(250px,34vw,430px);object-fit:cover;object-position:center 48%;border-radius:12px;box-shadow:0 18px 42px #0003}.landing .hero h1{max-width:850px;margin:12px 0;font:600 clamp(42px,7vw,76px)/1.02 "Cormorant Garamond",serif;color:#faf7f2}.landing .hero p:not(.eyebrow){max-width:700px;color:#e6dfd3;line-height:1.85}.eyebrow{color:#c5a059;font:800 11px Manrope,sans-serif;letter-spacing:.16em}@media(max-width:720px){.landing .hero-media{grid-template-columns:1fr}.landing .hero-media img{height:260px}}.landing section:not(.hero){max-width:950px;margin:auto;padding:42px 24px}.landing h2{font:600 clamp(30px,4vw,44px)/1.1 "Cormorant Garamond",serif;color:#1a3322}.landing p{line-height:1.85;color:#586258}.button{display:inline-block;padding:14px 22px;border-radius:999px;background:#c5a059;color:#1a3322;text-decoration:none;font:800 13px Manrope,sans-serif}
</style>
</SiteLayout>
