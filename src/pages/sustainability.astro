---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import { supabaseUrl } from "../lib/supabase-public";
const mediaBase=`${supabaseUrl}/storage/v1/object/public/materuni-images/`;
---
<SiteLayout title="Responsible Tourism in Materuni | Materuni Hosts" description="Learn about respectful village visits, Chagga cultural exchange and care for the natural environment when exploring Materuni Village near Moshi, Tanzania.">
<section class="page-hero"><span class="eyebrow">OUR APPROACH</span><h1 id="approach-title">Good travel begins with respect for place.</h1><p id="approach-intro">A visit to Materuni should feel personal, respectful and grounded in the place itself. Our approach is to create space for guests to learn from local hosts, take part in everyday traditions and enjoy the landscape without treating the village as a backdrop.</p></section>
<section class="section"><div class="split"><Image src={mediaBase+"story_image/1791995912146-materuni-community.jpg"} alt="Materuni community life and local hosts" loading="lazy" decoding="async" width={700} height={520} format="webp" quality={76} /><div><span class="eyebrow">ROOTED IN MATERUNI</span><h2 id="approach-section-title">Local culture is not a performance. It is a living way of life.</h2><p id="approach-section-intro">Rather than rushing from one photo stop to the next, we invite guests to slow down: learn how coffee is prepared, share food, ask questions and hear about the customs and stories that give Materuni its character. Each visit is an opportunity for exchange, with respect for the people and places involved.</p><div class="feature-list"><div><strong>Local connection</strong>Make time for conversation and learning with people who know Materuni.</div><div><strong>Cultural respect</strong>Approach food, traditions and daily life with curiosity; ask before taking photographs.</div><div><strong>Care for nature</strong>Stay mindful on forest paths, follow your guide’s advice and leave no litter behind.</div><div><strong>Honest information</strong>Understand what each experience includes, what costs extra and what needs confirmation before you travel.</div></div></div></div></section>
<section class="band"><h2 id="approach-cta-title">Come as a guest. Leave as a friend.</h2><p id="approach-cta-text">Discover Materuni at a thoughtful pace, with a warm welcome from local hosts.</p><a class="button light" href="/experiences">Explore our experiences</a></section>
<script>
import { supabaseUrl, publishableKey as approachKey } from "../lib/supabase-public";
const approachUrl=`${supabaseUrl}/rest/v1/site_settings?select=setting_key,setting_value&setting_key=eq.approach_content`;
fetch(approachUrl,{headers:{apikey:approachKey,Authorization:"Bearer "+approachKey}})
 .then(response=>response.ok?response.json():[])
 .then(rows=>{
  if(!rows?.[0]?.setting_value)return;
  let data;try{data=JSON.parse(rows[0].setting_value)}catch{return}
  const fields={title:"approach-title",intro:"approach-intro",sectionTitle:"approach-section-title",sectionIntro:"approach-section-intro",ctaTitle:"approach-cta-title",ctaText:"approach-cta-text"};
  for(const [key,id] of Object.entries(fields)){const node=document.getElementById(id);if(node&&typeof data[key]==="string"&&data[key].length<=1200)node.textContent=data[key]}
 }).catch(()=>{});
</script>
</SiteLayout>