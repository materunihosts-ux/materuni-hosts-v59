---
import SiteLayout from "../layouts/SiteLayout.astro";
import { googleGuestReviews } from "../data/google-reviews";

const googleProfile = "https://www.google.com/maps/search/?api=1&query=Materuni%20Hosts%2C%20Materuni%20Village%2C%20Materuni%20Juu%2C%20Moshi%20Rural%2C%20Tanzania";
const googleReviewLink = "https://g.page/r/CXy6M_Suiip9EBM/review";
const guestReviews = googleGuestReviews;
---
<SiteLayout
  title="Guest Reviews | Materuni Hosts, Materuni Village"
  description="Read genuine guest feedback about Materuni Hosts waterfall, Chagga coffee and village experiences. Three Google reviews are shown with links to their original source."
>
  <section class="reviews-hero" aria-labelledby="reviews-title">
    <span class="eyebrow">GUEST EXPERIENCES · MATERUNI VILLAGE</span>
    <h1 id="reviews-title">Kind words from guests who have visited Materuni.</h1>
    <p>These comments are excerpts from reviews published on our Google Business Profile. Read each review in its original context on Google.</p>
    <div class="rating-summary" aria-label="Google rating: 5 out of 5 from 3 reviews">
      <span class="rating-stars" aria-hidden="true">★★★★★</span>
      <strong>5.0 / 5</strong>
      <span>3 Google reviews</span>
    </div>
    <a class="button" href={googleProfile} target="_blank" rel="noopener noreferrer">Read all Google reviews</a>
  </section>

  <section class="review-section" aria-label="Guest reviews">
    <div class="review-grid">
      {guestReviews.map((review) => (
        <article class="review-card">
          <div class="review-card-top">
            <span class="rating-stars" aria-label="5 out of 5 stars">★★★★★</span>
            <span class="review-language">{review.language}</span>
          </div>
          <blockquote lang={review.language === "Español" ? "es" : "en"}>“{review.quote}”</blockquote>
          <p class="review-detail">{review.detail}</p>
          <div class="review-author">
            <strong>{review.name}</strong>
            <span>{review.date}</span>
          </div>
          <a class="review-source" href={googleProfile} target="_blank" rel="noopener noreferrer">View original on Google ↗</a>
        </article>
      ))}
    </div>
    <p class="source-note">Review excerpts are reproduced from the public Google Business Profile. Guest wording is kept in its original language; short context notes are editorial summaries, not additional guest quotations.</p>
  </section>

  <section class="review-actions" aria-label="Review and booking links">
    <div>
      <h2>Visited Materuni with us?</h2>
      <p>Your honest feedback helps future visitors make an informed choice. Reviews should reflect your own experience; no incentive is offered.</p>
      <div class="actions">
        <a class="button" href={googleReviewLink} target="_blank" rel="noopener noreferrer">Write a Google review</a>
        <a class="button button-secondary" href="https://www.tripadvisor.com/34765809" target="_blank" rel="noopener noreferrer">View TripAdvisor listing</a>
      </div>
    </div>
  </section>

  <style>
    .reviews-hero{background:#1A3322;color:#FAF7F2;padding:clamp(48px,8vw,96px) clamp(22px,8vw,112px);text-align:center}
    .reviews-hero .eyebrow{color:#C5A059;letter-spacing:.13em;font-size:11px;font-weight:700}
    .reviews-hero h1{max-width:850px;margin:16px auto;font:600 clamp(38px,5.5vw,66px)/1.04 "Cormorant Garamond",serif;color:#FAF7F2}
    .reviews-hero>p{max-width:650px;margin:0 auto 22px;color:#E6DFD3;line-height:1.8}
    .rating-summary{display:flex;justify-content:center;align-items:center;gap:10px;flex-wrap:wrap;margin:20px 0 26px;color:#FAF7F2;font-size:14px}
    .rating-stars{color:#C5A059;letter-spacing:2px;font-size:18px;white-space:nowrap}
    .rating-summary strong{font-size:17px}
    .reviews-hero .button,.review-actions .button{display:inline-flex;align-items:center;justify-content:center;padding:13px 20px;border-radius:6px;background:#C5A059;color:#242421;text-decoration:none;font-weight:700}
    .review-section{padding:clamp(36px,6vw,72px) 22px}
    .review-grid{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
    .review-card{display:flex;flex-direction:column;min-width:0;padding:24px;background:#FAF7F2;border:1px solid #E6DFD3;border-radius:10px}
    .review-card-top{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .review-language{font-size:11px;color:#657066;text-transform:uppercase;letter-spacing:.08em}
    .review-card blockquote{margin:22px 0 14px;color:#242421;font:500 22px/1.42 "Cormorant Garamond",serif}
    .review-detail{margin:0 0 24px;color:#586258;font-size:13px;line-height:1.7}
    .review-author{display:flex;flex-direction:column;gap:4px;margin-top:auto;padding-top:16px;border-top:1px solid #E6DFD3}
    .review-author strong{color:#1A3322;font-size:14px}
    .review-author span{color:#657066;font-size:12px}
    .review-source{display:inline-block;margin-top:16px;color:#1A3322;font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:3px}
    .source-note{max-width:900px;margin:22px auto 0;text-align:center;color:#657066;font-size:12px;line-height:1.7}
    .review-actions{background:#E6DFD3;padding:38px 22px}
    .review-actions>div{max-width:850px;margin:0 auto;text-align:center}
    .review-actions h2{margin:0 0 8px;color:#1A3322;font:600 34px/1.1 "Cormorant Garamond",serif}
    .review-actions p{color:#586258;line-height:1.7}
    .actions{display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin-top:20px}
    .review-actions .button-secondary{background:transparent;border:1px solid #1A3322;color:#1A3322}
    @media(max-width:850px){.review-grid{grid-template-columns:1fr 1fr}}
    @media(max-width:560px){.review-grid{grid-template-columns:1fr}.review-card{padding:22px}}
  </style>
</SiteLayout>
