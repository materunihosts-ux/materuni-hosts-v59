---
import SiteLayout from "../layouts/SiteLayout.astro";
import { supabaseUrl } from "../lib/supabase-public";
const reviewsPreview = `${supabaseUrl}/storage/v1/object/public/materuni-images/story_image/1791995912146-materuni-community.jpg`;
---
<SiteLayout title="Materuni Hosts Reviews | Guest Feedback & Google Reviews" description="Explore independent guest feedback for Materuni Hosts, find our Google and TripAdvisor profiles, and share your own experience in Materuni Village, Tanzania." preloadImage={reviewsPreview}>
<section class="media-hero" aria-labelledby="reviews-title"><div><span class="eyebrow">GUEST STORIES</span><h1 id="reviews-title">What our guests say</h1><p>Find independent feedback from travellers who have visited Materuni and experienced local Chagga culture.</p></div><img src={reviewsPreview} alt="Materuni community life and local hosts" width="1200" height="900" loading="eager" fetchpriority="high" decoding="async" /></section>
<section class="section">
  <div class="reviews-intro-wrap">
    <span class="eyebrow">VERIFIED REVIEWS</span>
    <h2>Independent guest feedback</h2>
    <p>Read guest feedback on our external profiles. Reviews are hosted by the platforms where travellers submitted them.</p>
  </div>
  <div class="reviews-external-note"><p>We do not publish unverified testimonials on this website. For independent guest feedback, visit our official review profiles.</p></div>
  <div class="actions" style="justify-content:center;margin:36px 0 24px">
    <a class="button" href="https://www.google.com/maps/search/?api=1&query=Materuni%20Hosts%20-%20Waterfall%20Tours%20%26%20Village%20Camping%2C%20Materuni%20Village%2C%20Moshi%2C%20Tanzania" data-review-link="google-profile" target="_blank" rel="noopener noreferrer">Find us & read reviews on Google Maps ↗</a>
    <a class="button button-secondary" href="https://g.page/r/CXy6M_Suiip9EBM/review" data-review-link="google-write" target="_blank" rel="noopener noreferrer">Leave a Google review ↗</a>
    <a class="button button-secondary" href="https://www.tripadvisor.com/34765809" data-review-link="tripadvisor" target="_blank" rel="noopener noreferrer">Find us on TripAdvisor ↗</a>
    <a class="button button-secondary" href="/booking">Plan your visit</a>
  </div>
</section>
<style>
.hero-rating-badge{display:inline-flex;align-items:center;gap:10px;margin-top:16px;padding:8px 16px;background:rgba(255,255,255,0.12);border:1px solid rgba(197,160,89,0.5);border-radius:999px;font-size:13px;color:#FAF7F2}
.hero-rating-badge .stars{color:#f59e0b;letter-spacing:2px;font-size:14px}
.hero-rating-badge strong{color:#FAF7F2}
.hero-rating-badge span:last-child{color:#E6DFD3;border-left:1px solid rgba(255,255,255,0.25);padding-left:10px;font-size:12px}
.reviews-intro-wrap{text-align:center;max-width:700px;margin:0 auto 36px}
.reviews-intro-wrap h2{margin:8px 0;font:600 clamp(28px,4vw,40px) "Cormorant Garamond",serif;color:#1A3322}
.reviews-intro-wrap p{color:#657066;font-size:14px;line-height:1.75}
.reviews-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:20px;max-width:1200px;margin:0 auto}
.review-card{display:flex;flex-direction:column;justify-content:space-between;padding:24px;background:#FAF7F2;border:1px solid #E6DFD3;border-radius:14px;box-shadow:0 8px 24px rgba(26,51,34,0.04)}
.review-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.review-stars{color:#f59e0b;font-size:15px;letter-spacing:2px}
.review-date{font-size:12px;color:#7A756B;font-weight:600}
.review-body{font-size:14px;line-height:1.75;color:#333D35;font-style:italic;margin:0 0 16px}
.review-author{border-top:1px solid #E6DFD3;padding-top:12px}
.review-author strong{display:block;color:#1A3322;font-size:14px}
.review-author span{display:block;color:#7A756B;font-size:12px;margin-top:2px}
</style>
<script>
import { supabaseUrl, publishableKey } from "../lib/supabase-public";
const headers={apikey:publishableKey,Authorization:"Bearer "+publishableKey};
(async()=>{try{const response=await fetch(`${supabaseUrl}/rest/v1/site_settings?select=setting_key,setting_value&setting_key=in.(google_review_url,tripadvisor_url)`,{headers,cache:"no-store"});if(!response.ok)return;const rows=await response.json();const values=Object.fromEntries((rows as Array<{setting_key:string;setting_value:string}>).map((row)=>[row.setting_key,row.setting_value]));const google=values.google_review_url?.trim();const tripadvisor=values.tripadvisor_url?.trim();document.querySelectorAll<HTMLAnchorElement>('[data-review-link="google"],[data-review-link="google-write"]').forEach((link)=>{if(google)link.href=google});const trip=document.querySelector<HTMLAnchorElement>('[data-review-link="tripadvisor"]');if(trip){if(tripadvisor){trip.href=tripadvisor;trip.hidden=false}else{trip.hidden=true}}}catch(error){console.warn("Review profile links could not be refreshed; built-in links remain available.",error)}})();
</script>
<style>.media-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.9fr);gap:clamp(24px,5vw,64px);align-items:center;padding:clamp(42px,7vw,88px) clamp(22px,7vw,100px);background:#1a3322;color:#faf7f2}.media-hero h1{color:#faf7f2;max-width:13ch;font:600 clamp(38px,5vw,64px)/1.04 "Cormorant Garamond",serif}.media-hero p{color:#e6dfd3;line-height:1.85;max-width:58ch}.media-hero img{display:block;width:100%;height:clamp(240px,34vw,430px);object-fit:cover;object-position:center 45%;border-radius:12px;box-shadow:0 18px 42px #0003}@media(max-width:720px){.media-hero{grid-template-columns:1fr;padding:42px 22px}.media-hero img{height:260px}}</style>
</SiteLayout>