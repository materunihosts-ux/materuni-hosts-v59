---
import SiteLayout from "../layouts/SiteLayout.astro";

const reviewsPreview = "https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/story_image/1791995912146-materuni-community.jpg";
---
<SiteLayout title="Materuni Hosts Reviews | Read Guest Feedback" description="Read independent guest feedback from travellers who have visited Materuni Hosts. Visit the original Google and TripAdvisor profiles and share your experience after your visit." preloadImage={reviewsPreview}>
<section class="media-hero" aria-labelledby="reviews-title"><div><span class="eyebrow">GUEST FEEDBACK · ORIGINAL SOURCES</span><h1 id="reviews-title">Read guest feedback in its original context.</h1><p>We link directly to our Google and TripAdvisor profiles so you can read feedback on the platforms where it was originally published.</p></div><img src={reviewsPreview} alt="Materuni community life and local hosts" width="1200" height="900" loading="eager" fetchpriority="high" decoding="async" /></section>
<section class="section">
  <div class="reviews-intro-wrap">
    <span class="eyebrow">INDEPENDENT REVIEW PLATFORMS</span>
    <h2>Choose where to read guest feedback.</h2>
    <p>Review platforms provide the original dates, reviewer profiles and context. We do not reproduce unverified or reconstructed testimonials on this page.</p>
  </div>
  <div class="review-source-grid">
    <article class="review-source-card">
      <span class="eyebrow">GOOGLE</span>
      <h3>Materuni Hosts on Google</h3>
      <p>Read guest feedback on our Google business profile, or leave an honest review after your visit.</p>
      <div class="actions">
        <a class="button" href="https://www.google.com/maps/search/?api=1&query=Materuni%20Hosts%2C%20Materuni%20Village%2C%20Materuni%20Juu%2C%20Moshi%20Rural%2C%20Tanzania" data-review-link="google-profile" target="_blank" rel="noopener noreferrer">Read Google feedback</a>
        <a class="button button-secondary" href="https://g.page/r/CXy6M_Suiip9EBM/review" data-review-link="google-write" target="_blank" rel="noopener noreferrer">Write a Google review</a>
      </div>
    </article>
    <article class="review-source-card">
      <span class="eyebrow">TRIPADVISOR</span>
      <h3>Materuni Hosts on TripAdvisor</h3>
      <p>Open our TripAdvisor listing to read guest feedback and check the listing details directly.</p>
      <div class="actions">
        <a class="button" href="https://www.tripadvisor.com/34765809" data-review-link="tripadvisor" target="_blank" rel="noopener noreferrer">Read TripAdvisor feedback</a>
      </div>
    </article>
  </div>
  <p class="review-integrity-note">We value honest feedback—positive or critical. Reviews are kept on their original platforms so visitors can verify the source for themselves.</p>
  <div class="actions" style="justify-content:center;margin:36px 0 24px">
    <a class="button button-secondary" href="/booking">Plan your Materuni visit</a>
  </div>
</section>
<style>
.reviews-intro-wrap{text-align:center;max-width:700px;margin:0 auto 36px}
.reviews-intro-wrap h2{margin:8px 0;font:600 clamp(28px,4vw,40px) "Cormorant Garamond",serif;color:#1A3322}
.reviews-intro-wrap p,.review-integrity-note{color:#657066;font-size:14px;line-height:1.75}
.review-source-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;max-width:1000px;margin:0 auto}
.review-source-card{padding:28px;background:#FAF7F2;border:1px solid #E6DFD3;border-radius:14px}
.review-source-card h3{font:600 26px/1.15 "Cormorant Garamond",serif;color:#1A3322;margin:10px 0}
.review-source-card p{font-size:14px;line-height:1.75;color:#586258;margin:0 0 20px}
.review-source-card .actions{display:flex;flex-wrap:wrap;gap:12px}
.review-integrity-note{max-width:760px;margin:28px auto 0;text-align:center}
</style>

<style>.media-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.9fr);gap:clamp(24px,5vw,64px);align-items:center;padding:clamp(42px,7vw,88px) clamp(22px,7vw,100px);background:#1a3322;color:#faf7f2}.media-hero h1{color:#faf7f2;max-width:13ch;font:600 clamp(38px,5vw,64px)/1.04 "Cormorant Garamond",serif}.media-hero p{color:#e6dfd3;line-height:1.85;max-width:58ch}.media-hero img{display:block;width:100%;height:clamp(240px,34vw,430px);object-fit:cover;object-position:center 45%;border-radius:12px;box-shadow:0 18px 42px #0003}@media(max-width:720px){.media-hero{grid-template-columns:1fr;padding:42px 22px}.media-hero img{height:260px}}</style>
</SiteLayout>