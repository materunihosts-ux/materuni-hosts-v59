---
import SiteLayout from "../layouts/SiteLayout.astro";
import { supabaseUrl } from "../lib/supabase-public";
const reviewsPreview = `${supabaseUrl}/storage/v1/object/public/materuni-images/story_image/1791601761441-q3iog8mni3r.jpg`;
---
<SiteLayout title="Guest Reviews | Materuni Hosts" description="Read guest feedback and share your own Materuni Hosts experience." preloadImage={reviewsPreview}>
<section class="page-hero"><span class="eyebrow">GUEST STORIES</span><h1>Good memories are better when shared.</h1><p>We value every guest's experience. Explore our review profile and tell future travellers what your time in Materuni meant to you.</p></section>
<section class="section"><div class="split"><div><span class="eyebrow">YOUR EXPERIENCE MATTERS</span><h2>Help other travellers choose with confidence.</h2><p>We are building this space for genuine guest feedback. We do not publish invented testimonials or ratings. Follow the review link to see the latest feedback on our public profile, or leave your own review after your visit.</p><div class="actions"><a class="button" href="https://www.google.com/search?q=Materuni+Hosts+-+Waterfall+Tours+%26+Village+Camping" target="_blank" rel="noopener noreferrer">Find Materuni Hosts on Google ↗</a><a class="button button-secondary" href="https://g.page/r/CXy6M_Suiip9EBM/review" target="_blank" rel="noopener noreferrer">Leave a Google review ↗</a><a class="button button-secondary" href="https://www.tripadvisor.com/Search?q=Materuni%20Hosts" target="_blank" rel="noopener noreferrer">Find us on TripAdvisor ↗</a><a class="button button-secondary" href="/booking">Plan your visit</a></div></div><div class="booking-panel"><span class="eyebrow">A NOTE TO OUR GUESTS</span><h2>Thank you for travelling locally.</h2><p>Your feedback helps us improve our hosting, experiences and the way we welcome visitors to Materuni Village.</p><p class="tagline">Come as a guest. Leave as a friend.</p><p>We do not display unverified review counts or invented guest quotes. Follow the public links to check the latest independent feedback.</p></div></div></section>
</SiteLayout>