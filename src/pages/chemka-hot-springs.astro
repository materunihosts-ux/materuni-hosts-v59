---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import { supabaseUrl } from "../lib/supabase-public";

const base = `${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const heroImg = `${base}story_image/1791601761441-q3iog8mni3r.jpg`;
const photo1 = `${base}waterfall_image/1791998303073-materuni-waterfall-hike.jpg`;
const photo2 = `${base}story_image/1791995912146-materuni-community.jpg`;
const photo3 = `${base}story_image/1791994219885-materuni-coffe-plantatio-tour.jpg`;

const serviceData = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Chemka Hot Springs Day Trip from Moshi (Kikuletwa)",
  "touristType": ["Swimmers", "Eco-tourists", "Day trippers"],
  "description": "Guided day trip to Chemka Hot Springs (Kikuletwa) from Moshi, Tanzania. Crystal-clear turquoise geothermal water, shade under giant fig trees, and relaxing swimming.",
  "provider": { "@type": "TourOperator", "name": "Materuni Hosts", "url": "https://materunihosts.com/" },
  "offers": {
    "@type": "Offer",
    "price": "60.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://materunihosts.com/booking?experience=chemka"
  },
  "url": "https://materunihosts.com/chemka-hot-springs"
};

const faqs = [
  {
    q: "How warm is the water at Chemka Hot Springs?",
    a: "Despite being called 'hot springs', the water is pleasantly lukewarm—around 27°C to 29°C (80°F to 84°F). It feels incredibly refreshing in the tropical heat of the Kilimanjaro plains and is comfortable for swimming all year round."
  },
  {
    q: "How far is Chemka Hot Springs from Moshi?",
    a: "Chemka is located in the Rundugai area, roughly 35 km southwest of Moshi town. The journey takes approximately 1 hour each way by car. The first part is smooth paved highway, followed by about 20 minutes on a bumpy scenic dirt road through Maasai and Chagga plains."
  },
  {
    q: "Can I combine Chemka with Materuni on the same day?",
    a: "While physically possible, it makes for a very long day of over 4–5 hours on the road. We strongly recommend dedicating one day to Materuni Waterfall & coffee, and a separate half or full day for Chemka so you can truly unwind and relax."
  },
  {
    q: "What should I pack for Chemka Hot Springs?",
    a: "Bring your swimwear (already wearing it underneath is convenient), a dry towel, change of dry clothes, water shoes or flip-flops, sunscreen, sunglasses, insect repellent, and some small cash in Tanzanian Shillings for snacks or local drinks."
  },
  {
    q: "Is Chemka Hot Springs safe for non-swimmers?",
    a: "The springs reach depths of 4 to 8 metres in the centre, but there are shallow edges and large submerged roots to hold onto. Inflatable swim rings and life jackets are readily available for rent on site for a few dollars."
  }
];
---

<SiteLayout
  title="Chemka Hot Springs Tour from Moshi | Kikuletwa Day Trip"
  description="Plan a relaxing Chemka Hot Springs day trip from Moshi with local Materuni hosts. Crystal clear turquoise geothermal pools, private transport, and transparent pricing from $60."
  preloadImage={heroImg}
>
  <LocalBusinessSchema />
  <script type="application/ld+json" set:html={JSON.stringify(serviceData)} />
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))})} />

  <main class="chemka-page">
    <section class="hero-split">
      <div class="hero-text">
        <span class="eyebrow">CHEMKA · KIKULETWA · DAY TRIPS FROM MOSHI</span>
        <h1>Chemka Hot Springs Day Trip from Moshi</h1>
        <p>Immerse yourself in the crystal-clear turquoise waters of Chemka Hot Springs, locally known as Kikuletwa. Surrounded by ancient winding fig trees and lush palm roots, this geothermal oasis hidden in the semi-arid Maasai plains is Tanzania's most scenic natural swimming hole.</p>
        <div class="price-callout">
          <span class="price-from">From <strong>$60 USD</strong> per person</span>
          <span class="price-sub">Includes private vehicle transfer, driver, village entry fees & picnic lunch</span>
        </div>
        <div class="actions">
          <a class="button gold" href="/booking?experience=chemka">Check availability & book</a>
          <a class="button outline" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%20would%20like%20to%20ask%20about%20a%20Chemka%20Hot%20Springs%20day%20trip." target="_blank" rel="noopener noreferrer">Ask a host on WhatsApp</a>
        </div>
      </div>
      <div class="hero-media">
        <Image src={heroImg} alt="Lush natural waterways and trees around Chemka Hot Springs in Kilimanjaro" width={800} height={600} loading="eager" fetchpriority="high" decoding="async" class="hero-img" format="webp" quality={76} />
      </div>
    </section>

    <!-- Photo Gallery: 3 photos (S9 requirement) -->
    <section class="gallery-section">
      <div class="gallery-header">
        <span class="eyebrow">SCENIC GEOTHERMAL OASIS</span>
        <h2>A turquoise oasis hidden under giant fig trees</h2>
        <p>A natural underground volcanic spring fed directly by the melting snows and deep subterranean aquifers of Mount Kilimanjaro.</p>
      </div>
      <div class="gallery-grid">
        <figure class="gallery-item">
          <Image src={photo1} alt="Fresh clear water flowing through natural channels near Mount Kilimanjaro" width={600} height={420} loading="lazy" decoding="async" format="webp" quality={76} />
          <figcaption>Natural groundwater bubbling gently to the surface through limestone fissures.</figcaption>
        </figure>
        <figure class="gallery-item">
          <Image src={photo2} alt="Local community gathering and enjoying the shade by the riverside" width={600} height={420} loading="lazy" decoding="async" format="webp" quality={76} />
          <figcaption>Warm hospitality and picnic facilities sheltered under ancient banyan and wild fig canopies.</figcaption>
        </figure>
        <figure class="gallery-item">
          <Image src={photo3} alt="Expansive green landscapes leading from the foothills towards the plains" width={600} height={420} loading="lazy" decoding="async" format="webp" quality={76} />
          <figcaption>Picturesque views of Mount Kilimanjaro and Mount Meru across the open savanna.</figcaption>
        </figure>
      </div>
    </section>

    <section class="content-section">
      <div class="article-body">
        <h2>What makes Chemka Hot Springs unique?</h2>
        <p>Chemka Hot Springs (also known as Rundugai Springs or Maji Moto) is one of the most remarkable geographical features in the Kilimanjaro Region. Located near the rural village of Rundugai, halfway between Moshi and Arusha, it features a collection of underground geothermal spring pools where mineral-rich water emerges constantly at a gentle 28°C.</p>
        <p>The water is so exceptionally translucent that you can clearly see right down to the submerged limestone caverns and tangled roots six to eight metres below. Schools of small Garra rufa 'doctor fish' swim peacefully in the water, offering a natural and gentle foot spa to swimmers who dip their feet over the wooden edge. A rustic rope swing tied to an overhanging fig branch provides exhilarating jumps directly into the deep, welcoming centre of the pool.</p>

        <h2>Trip itinerary & what your day includes</h2>
        <p>Our Chemka day trip is designed for comfort, safety, and relaxation without the stress of bartering with unlicensed roadside taxis. Here is what you can look forward to:</p>
        <ul>
          <li><strong>Door-to-door morning pickup:</strong> Your private English-speaking driver meets you at 08:30 or 09:00 AM at your Moshi or Arusha lodge in a comfortable, air-conditioned vehicle.</li>
          <li><strong>Scenic drive through Maasai lands:</strong> Watch acacia groves, small roadside markets, and herds of cattle tended by Maasai pastoralists on the 1-hour drive.</li>
          <li><strong>Village council entry permits:</strong> All local government and village conservation fees are handled and fully paid in advance.</li>
          <li><strong>Swimming & rope swing fun:</strong> Spend 3 to 4 hours swimming, sunbathing, swinging from the rope, and lounging in the natural shade.</li>
          <li><strong>Hot Chagga lunch or picnic box:</strong> Enjoy fresh grilled chicken, chips, tropical fruits, and cold bottled water prepared by local cooks.</li>
          <li><strong>Safe return transfer:</strong> After drying off and relaxing, your driver returns you to your Moshi or Arusha accommodation in the mid-afternoon before peak traffic.</li>
        </ul>

        <h2>Chemka tour pricing & group rates</h2>
        <p>We believe in upfront, transparent pricing with zero surprise charges upon arrival. Our Chemka day tour is priced from <strong>$60 USD per person</strong> based on a group of 4 guests. Direct private bookings include the dedicated vehicle, fuel, driver allowances, village gate fees, swimming permits, drinking water, and lunch. For solo travelers or couples, private vehicle day charters are available for $120–$140 total per car. Contact our team to confirm current date availability and tailor your pickup times.</p>
      </div>
    </section>

    <!-- FAQ Block (S9 requirement) -->
    <section class="faq-section">
      <div class="section-header">
        <span class="eyebrow">HELPFUL TRAVEL ADVICE</span>
        <h2>Frequently asked questions about Chemka</h2>
        <p>Practical facts from our local guides to help you prepare for your visit.</p>
      </div>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-card">
            <summary><span>{faq.q}</span></summary>
            <div class="faq-content"><p>{faq.a}</p></div>
          </details>
        ))}
      </div>
    </section>

    <section class="booking-cta">
      <h2>Combine Chemka with Materuni Village</h2>
      <p>Pair your Kilimanjaro trip with our signature <a href="/materuni-waterfall-tour">Materuni Waterfall Hike</a>, traditional <a href="/materuni-coffee-tour">Chagga Coffee Tour</a>, or an overnight stay in <a href="/camping">Materuni Camping</a>.</p>
      <div class="actions">
        <a class="button gold" href="/booking?experience=chemka">Book Chemka day trip</a>
        <a class="button outline" href="/itinerary">Customise multi-day itinerary</a>
      </div>
    </section>
  </main>

  <!-- Sticky Mobile Booking Bar (T6) -->
  <div class="sticky-mobile-booking-bar" role="region" aria-label="Quick booking bar">
    <div class="sticky-price">
      <strong>From $60 USD</strong>
      <small>Per person · Full day</small>
    </div>
    <div class="sticky-actions">
      <a class="sticky-book-btn" href="/booking?experience=chemka">Book Chemka</a>
      <a class="sticky-wa-btn" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%20am%20interested%20in%20a%20Chemka%20tour." target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 11.6a8.45 8.45 0 0 1-12.4 7.45L3.5 20.5l1.5-4.45a8.45 8.45 0 1 1 15.5-4.45Z"/><path d="M8.8 8.2c.25 2.9 2.1 5.2 5.15 6.15l1.2-1.3 2.05 1.05c-.15 1.5-1.2 2.35-2.65 2.35-3.95-.45-7.05-3.65-7.45-7.5 0-1.35.85-2.35 2.2-2.55l1.05 2.15-.95 1.05"/></svg>
      </a>
    </div>
  </div>
</SiteLayout>

<style>
.chemka-page {
  color: #242421;
}
.hero-split {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
  gap: clamp(28px, 5vw, 64px);
  align-items: center;
  padding: clamp(54px, 8vw, 96px) clamp(20px, 6vw, 96px);
  background: #1A3322;
  color: #FAF7F2;
}
.hero-text h1 {
  font: 600 clamp(36px, 5vw, 60px)/1.08 "Cormorant Garamond", Georgia, serif;
  color: #FAF7F2;
  margin: 12px 0 18px;
}
.hero-text p {
  color: #E6DFD3;
  font-size: 16px;
  line-height: 1.75;
  max-width: 620px;
}
.price-callout {
  background: rgba(255, 255, 255, 0.08);
  border-left: 3px solid #C5A059;
  padding: 12px 18px;
  border-radius: 6px;
  margin: 22px 0 26px;
}
.price-from {
  display: block;
  font-size: 15px;
  color: #FAF7F2;
}
.price-from strong {
  color: #C5A059;
  font-size: 20px;
}
.price-sub {
  display: block;
  font-size: 12px;
  color: #C6D0C8;
  margin-top: 4px;
}
.hero-img {
  width: 100%;
  height: clamp(260px, 34vw, 440px);
  object-fit: cover;
  border-radius: 16px;
  box-shadow: 0 16px 40px rgba(0,0,0,0.3);
}
.actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  align-items: center;
}
.button {
  padding: 14px 26px;
  border-radius: 999px;
  font: 800 13px "Manrope", sans-serif;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
}
.button.gold {
  background: #C5A059;
  color: #1A3322 !important;
}
.button.outline {
  background: transparent;
  color: #FAF7F2 !important;
  border: 1px solid rgba(255,255,255,0.4);
}

.gallery-section {
  padding: 72px clamp(20px, 6vw, 96px);
  background: #F4EFE6;
  border-bottom: 1px solid #E6DFD3;
}
.gallery-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 36px;
}
.gallery-header h2 {
  font: 600 clamp(30px, 4vw, 44px) "Cormorant Garamond", Georgia, serif;
  color: #1A3322;
  margin: 8px 0;
}
.gallery-header p {
  color: #556056;
  font-size: 15px;
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  max-width: 1200px;
  margin: 0 auto;
}
.gallery-item {
  margin: 0;
  background: #FAF7F2;
  border: 1px solid #E6DFD3;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 6px 20px rgba(26,51,34,0.05);
}
.gallery-item img {
  width: 100%;
  height: 240px;
  object-fit: cover;
  display: block;
}
.gallery-item figcaption {
  padding: 14px 18px;
  font-size: 12px;
  line-height: 1.5;
  color: #556056;
}

.content-section {
  padding: 72px clamp(20px, 6vw, 96px);
  max-width: 900px;
  margin: 0 auto;
}
.article-body h2 {
  font: 600 clamp(28px, 3.8vw, 38px) "Cormorant Garamond", Georgia, serif;
  color: #1A3322;
  margin: 36px 0 14px;
}
.article-body p, .article-body li {
  font-size: 15px;
  line-height: 1.8;
  color: #425347;
}
.article-body ul {
  padding-left: 20px;
  margin: 16px 0 24px;
}
.article-body li {
  margin-bottom: 10px;
}

.faq-section {
  padding: 64px clamp(20px, 6vw, 96px);
  background: #FAF7F2;
  border-top: 1px solid #E6DFD3;
}
.faq-section .section-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 36px;
}
.faq-section .section-header h2 {
  font: 600 clamp(30px, 4vw, 42px) "Cormorant Garamond", Georgia, serif;
  color: #1A3322;
  margin: 8px 0;
}
.faq-list {
  max-width: 820px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.faq-card {
  background: #fff;
  border: 1px solid #E6DFD3;
  border-radius: 12px;
  padding: 16px 20px;
}
.faq-card summary {
  font: 600 17px/1.3 "Cormorant Garamond", Georgia, serif;
  color: #1A3322;
  cursor: pointer;
  list-style: none;
}
.faq-card summary::-webkit-details-marker {
  display: none;
}
.faq-content {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #E6DFD3;
  color: #556056;
  font-size: 14px;
  line-height: 1.65;
}

.booking-cta {
  padding: 64px 24px;
  text-align: center;
  background: #1A3322;
  color: #FAF7F2;
  margin: 48px clamp(20px, 6vw, 96px);
  border-radius: 18px;
}
.booking-cta h2 {
  font: 600 clamp(28px, 4vw, 42px) "Cormorant Garamond", Georgia, serif;
  color: #FAF7F2;
  margin: 0 0 10px;
}
.booking-cta p {
  color: #E6DFD3;
  font-size: 15px;
  margin: 0 0 24px;
}
.booking-cta a {
  color: #C5A059;
  text-decoration: underline;
}
.booking-cta .actions {
  justify-content: center;
}

@media(max-width: 760px) {
  .hero-split {
    grid-template-columns: 1fr;
  }
  .gallery-grid {
    grid-template-columns: 1fr;
  }
}
</style>
