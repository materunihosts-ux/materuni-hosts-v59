---
import SiteLayout from "../layouts/SiteLayout.astro";
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";

const serviceData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Materuni Day Trips from Moshi",
  "serviceType": "Locally hosted Materuni village and cultural experiences",
  "description": "Day visits to Materuni Village near Moshi, including the waterfall, Chagga coffee traditions, cooking, village culture and Rau Forest nature.",
  "provider": { "@type": "TourOperator", "name": "Materuni Hosts", "url": "https://materunihosts.com/" },
  "areaServed": [
    { "@type": "Place", "name": "Materuni Village, Kilimanjaro Region, Tanzania" },
    { "@type": "City", "name": "Moshi, Kilimanjaro Region, Tanzania" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Materuni day trip experiences",
    "itemListElement": [
      { "@type": "Offer", "name": "Materuni Waterfall & Chagga Village Experience", "price": "40", "priceCurrency": "USD", "url": "https://materunihosts.com/materuni-waterfall-tour" },
      { "@type": "Offer", "name": "Traditional Chagga Coffee Experience", "price": "36", "priceCurrency": "USD", "url": "https://materunihosts.com/materuni-coffee-tour" },
      { "@type": "Offer", "name": "Traditional Chagga Cooking Class", "price": "49", "priceCurrency": "USD", "url": "https://materunihosts.com/day-trips" },
      { "@type": "Offer", "name": "Materuni & Moshi Town Cultural Experience", "price": "52", "priceCurrency": "USD", "url": "https://materunihosts.com/experiences" },
      { "@type": "Offer", "name": "Materuni & Rau Forest Nature Experience", "price": "58", "priceCurrency": "USD", "url": "https://materunihosts.com/experiences", "description": "The Rau Forest entrance fee is included in the published package price." }
    ]
  },
  "url": "https://materunihosts.com/moshi-day-trips"
};
---
<SiteLayout title="Materuni Day Trips from Moshi | Waterfall & Chagga Culture" description="Plan a Materuni day trip from Moshi, Tanzania. Explore the waterfall, Chagga coffee, cooking, village heritage and Rau Forest with local hosts.">
<LocalBusinessSchema />
<script type="application/ld+json" set:html={JSON.stringify(serviceData)} />
<main class="landing">
  <section class="hero hero--split">
    <div class="hero-copy">
      <p class="eyebrow">MATERUNI VILLAGE · NEAR MOSHI · KILIMANJARO, TANZANIA</p>
      <h1>Materuni Day Trips from Moshi with Local Chagga Hosts</h1>
      <p>Discover Materuni Village through a guided waterfall walk, Chagga coffee traditions, local cooking, village heritage and nature experiences. Choose the visit that suits your time and interests, then confirm the practical details with your local host.</p>
      <div class="actions">
        <a class="button" href="/day-trips">Compare Materuni day trips</a>
        <a class="text-link" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%20would%20like%20to%20plan%20a%20Materuni%20day%20trip%20from%20Moshi." target="_blank" rel="noopener noreferrer">Plan by WhatsApp</a>
      </div>
    </div>
    <aside class="destination-panel" aria-label="Materuni day trip options">
      <span class="panel-kicker">EXPLORE MATERUNI</span>
      <strong>One village.</strong>
      <span class="panel-subtitle">Different ways to experience local life</span>
      <div class="panel-rule"></div>
      <ul>
        <li>Materuni Waterfall and forest walk</li>
        <li>Traditional Chagga coffee</li>
        <li>Local cooking and food culture</li>
        <li>Village heritage and hospitality</li>
        <li>Rau Forest nature experience</li>
      </ul>
      <a class="panel-link" href="/experiences">Explore all Materuni experiences →</a>
    </aside>
  </section>
  <section>
    <h2>Choose a Materuni day trip</h2>
    <p>All listed prices are per person in USD. Transport to and from Materuni is arranged separately unless your host confirms otherwise.</p>
    <div class="trip-links">
      <article>
        <h3>Materuni Waterfall & Chagga Village</h3>
        <p class="trip-price">$40 <small>PER PERSON</small></p>
        <p>Walk to Materuni Waterfall with a local guide and discover village life and Chagga traditions.</p>
        <a href="/materuni-waterfall-tour">Explore the Materuni Waterfall experience</a>
      </article>
      <article>
        <h3>Traditional Chagga Coffee Experience</h3>
        <p class="trip-price">$36 <small>PER PERSON</small></p>
        <p>Learn about local coffee growing, roasting, grinding, brewing and tasting in Materuni.</p>
        <a href="/materuni-coffee-tour">Explore the Materuni coffee experience</a>
      </article>
      <article>
        <h3>Traditional Chagga Cooking Class</h3>
        <p class="trip-price">$49 <small>PER PERSON</small></p>
        <p>Join a hands-on cooking session and learn about local ingredients and Chagga food traditions.</p>
        <a href="/day-trips#day-trip-options">Explore the cooking experience</a>
      </article>
      <article>
        <h3>Materuni & Moshi Town Cultural Experience</h3>
        <p class="trip-price">$52 <small>PER PERSON</small></p>
        <p>Combine a Materuni visit with a guided introduction to Moshi town and everyday local culture.</p>
        <a href="/experiences">View experience details</a>
      </article>
      <article>
        <h3>Materuni & Rau Forest Nature Experience</h3>
        <p class="trip-price">$58 <small>PER PERSON</small></p>
        <p>Combine a Materuni village visit with a guided nature walk in Rau Forest. The Rau Forest entrance fee is included in the published package price.</p>
        <a href="/experiences">View experience details</a>
      </article>
    </div>
  </section>
  <section>
    <h2>Planning a Materuni visit from Moshi</h2>
    <p>Share your preferred date, group size, pickup point and the activities that interest you. Your host can confirm the meeting arrangements, route, timing, inclusions and any separately requested transport before payment.</p>
    <p>If you are visiting before or after a Kilimanjaro climb, allow enough time for the Materuni visit and your return to Moshi. Road and trail conditions can vary with the weather.</p>
  </section>
  <section>
    <h2>Book a Materuni day trip</h2>
    <p>Send a booking request to check your preferred date. A request is not a confirmed reservation; your local host will reply with availability and the final arrangements.</p>
    <div class="actions">
      <a class="button" href="/booking?source=moshi-day-trips">Send a booking request</a>
      <a class="text-link" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20please%20help%20me%20plan%20a%20Materuni%20day%20trip%20from%20Moshi." target="_blank" rel="noopener noreferrer">Contact a local host</a>
    </div>
  </section>
</main>
<style>
.landing{color:#242421}.landing .hero{padding:clamp(48px,7vw,88px) clamp(22px,7vw,96px);background:#1a3322;color:#faf7f2}.landing .hero--split{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(250px,.75fr);gap:clamp(28px,5vw,64px);align-items:center}.destination-panel{padding:clamp(24px,4vw,38px);border:1px solid #ffffff2b;border-radius:20px;background:linear-gradient(145deg,#294b36,#12271b);box-shadow:0 22px 48px #0003;color:#faf7f2}.destination-panel .panel-kicker{display:block;color:#c5a059;font:800 10px Manrope,sans-serif;letter-spacing:.16em}.destination-panel strong{display:block;margin-top:20px;font:600 clamp(38px,5vw,56px)/1 "Cormorant Garamond",serif}.destination-panel .panel-subtitle{display:block;color:#e6dfd3;margin-top:4px}.destination-panel .panel-rule{height:1px;background:#ffffff30;margin:24px 0}.destination-panel ul{padding-left:18px;color:#faf7f2}.destination-panel li{color:#faf7f2!important}.destination-panel .panel-link{display:inline-block;margin-top:12px;color:#e6c37c!important}.landing .hero h1{max-width:900px;margin:12px 0;font:600 clamp(42px,7vw,76px)/1.02 "Cormorant Garamond",serif;color:#faf7f2}.landing .hero p:not(.eyebrow){max-width:720px;color:#e6dfd3;line-height:1.85}.eyebrow{color:#c5a059;font:800 11px Manrope,sans-serif;letter-spacing:.16em}.landing section:not(.hero){max-width:1050px;margin:auto;padding:42px 24px}.landing h2{font:600 clamp(30px,4vw,44px)/1.1 "Cormorant Garamond",serif;color:#1a3322}.landing h3{color:#1a3322;font:700 18px Manrope,sans-serif}.landing p,.landing li{line-height:1.85;color:#586258}.landing a:not(.button):not(.text-link){color:#1a3322;font-weight:700}.trip-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.trip-links article{padding:22px;border:1px solid #e6dfd3;border-radius:12px;background:#faf7f2}.trip-links p{font-size:14px}.trip-price{font:600 26px "Cormorant Garamond",serif;color:#1a3322}.trip-price small{font:700 10px Manrope,sans-serif;letter-spacing:.1em;color:#242421}.button{display:inline-block;padding:14px 22px;border-radius:999px;background:#c5a059;color:#242421;text-decoration:none;font:800 13px Manrope,sans-serif}.text-link{color:#faf7f2;font-weight:800}.actions{display:flex;gap:18px;align-items:center;flex-wrap:wrap}@media(max-width:720px){.landing .hero{padding:48px 22px}.landing .hero--split{grid-template-columns:1fr;gap:28px}.actions{align-items:flex-start;flex-direction:column}.trip-links{grid-template-columns:1fr}}
</style>
</SiteLayout>
