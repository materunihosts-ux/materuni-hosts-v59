---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import { experienceItems } from "../data/experiences";

const items = experienceItems;
const defaultExclusions = ["Transport to and from the experience unless separately confirmed","Personal purchases and expenses","Tips and gratuities","Travel insurance","Additional food or drinks not listed under confirmed inclusions"];
const experienceKeys: Record<string,string> = {"Materuni Waterfall & Chagga Village Experience":"Waterfall & Chagga Culture","Traditional Chagga Coffee Experience":"Traditional Coffee Experience","Traditional Chagga Cooking Class":"Traditional Chagga Cooking Class","Materuni & Moshi Town Cultural Experience":"Materuni & Moshi Town Tour","Materuni & Rau Forest Nature Experience":"Materuni & Rau Forest Experience","Materuni Overnight Village Experience":"Camping & Village Life"};
const base="https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/";
const experienceAltByKey: Record<string,string> = {
  "Materuni Waterfall & Chagga Village Experience":"Materuni Waterfall and the surrounding green landscape in Materuni Village",
  "Traditional Chagga Coffee Experience":"Traditional Chagga coffee preparation in Materuni Village",
  "Traditional Chagga Cooking Class":"Traditional Chagga cooking class in Materuni Village",
  "Materuni & Moshi Town Cultural Experience":"Materuni community scene in Materuni Village",
  "Materuni & Rau Forest Nature Experience":"Forest landscape in the Kilimanjaro Region near Moshi",
  "Materuni Overnight Village Experience":"Overnight village stay in Materuni"
};
---
<SiteLayout title="Materuni Village Tours & Experiences | Materuni Hosts" description="Explore Materuni Village near Moshi, Tanzania. Join local hosts for Materuni Waterfall walks, Chagga coffee, cooking, Moshi town and Rau Forest experiences." preloadImage={`${base}waterfall_image/1792472007095-optimized.webp`}>
<section class="page-hero"><span class="eyebrow" data-i18n="home_section_eyebrow">LOCAL CHAGGA EXPERIENCES</span><h1 data-i18n="experiences_hero_title">Materuni Village Experiences: Waterfall, Chagga Coffee &amp; Culture</h1><p data-i18n="experiences_hero_intro">Choose a guided Materuni Waterfall walk, traditional Chagga coffee, a hands-on cooking class, a Moshi town visit, Rau Forest nature or an overnight village stay. Each listing shows its confirmed inclusions; your host confirms any date-dependent details.</p></section>
<section class="section"><div class="cards">{items.map((e)=><article class="experience-card" id={e[0] === "Materuni Overnight Village Experience" ? "camping" : undefined} data-experience-key={experienceKeys[e[0]]}><Image src={base+e[3]} alt={experienceAltByKey[e[0]] || e[0]} loading="lazy" decoding="async" width={640} height={420} format="webp" quality={76} class="experience-photo" /><div class="card-body"><div class="card-top"><span class="pill">{e[2]}</span><span class="price" data-catalog-price>${e[1]}<small data-i18n="exp_per_person">PER PERSON</small></span></div><h3 data-catalog-name>{e[0]}</h3><p data-catalog-description>{e[4]}</p><strong style="font-size:12px;color:#1A3322" data-i18n="exp_experience_label">THE EXPERIENCE</strong><ul>{[...new Set(e[5])].map(x=><li>{x}</li>)}</ul><strong style="font-size:12px;color:#1A3322" data-i18n="exp_included_label">WHAT YOUR EXPERIENCE INCLUDES</strong><ul>{[...new Set(e[6])].map(x=><li>{x}</li>)}</ul><strong data-exclusions-title="true" style="display:block;margin-top:1rem;font-size:12px;color:#1A3322" data-i18n="exp_excluded_label">NOT INCLUDED</strong><ul data-exclusions-list="true">{defaultExclusions.map(x=><li>{x}</li>)}</ul><a class="button" href={"/booking?experience="+encodeURIComponent(experienceKeys[e[0]])} data-i18n="exp_check_availability">Check availability</a></div></article>)}</div><aside class="group-discount-panel" aria-labelledby="group-discount-title"><div class="group-discount-heading"><span class="eyebrow">SAVE MORE AS A GROUP</span><h3 id="group-discount-title">Published group discounts</h3><p>Discounts apply to the published experience price per person. Transport and separately agreed extras are excluded.</p></div><div class="group-discount-grid"><div><strong>1–3 guests</strong><span>Standard rate</span></div><div><strong>4–5 guests</strong><span>5% off per person</span></div><div><strong>6–9 guests</strong><span>8% off per person</span></div><div><strong>10–14 guests</strong><span>10% off per person</span></div><div class="group-custom"><strong>15+ guests</strong><span>Custom group quotation</span></div></div><p class="group-discount-foot">The booking form estimates the discount on the experience price only. Transport is not included and is quoted separately based on pickup point, date and group size. Separately agreed extras are not discounted. These direct discounts do not apply to separately negotiated tour-operator rates.</p><a class="button" href="/booking">Check your group price</a></aside><p class="notice" style="margin-top:18px" data-i18n="exp_notice">All published experience prices are per person in USD; TZS equivalents are shown where published. The Materuni & Rau Forest package includes the Rau Forest entrance fee. Transport is not included and requires a separate quote based on pickup point, date and group size. Group discounts apply only to experience prices: 1–3 standard; 4–5 guests 5% off; 6–9 guests 8% off; 10–14 guests 10% off; 15+ guests custom quotation. A request is not a confirmed booking until the host confirms availability and final arrangements in writing.</p></section>

<!-- From the Journal (J5) -->
<section class="section" style="background:#E6DFD3;padding-top:48px;padding-bottom:56px">
  <div class="section-head">
    <span class="eyebrow">LOCAL PRACTICAL GUIDES</span>
    <h2>From the Journal</h2>
    <p>Helpful route guidance, arrival advice and cultural notes from our Materuni hosting team.</p>
  </div>
  <div class="cards" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));max-width:1100px;margin:0 auto">
    <article class="experience-card" style="border-radius:4px;overflow:hidden">
      <Image src={base+"hero_image/1791995544192-materuni-waterfall.jpg"} alt="Materuni waterfall trail in northern Tanzania" width={600} height={340} loading="lazy" decoding="async" format="webp" quality={76} style="height:200px;object-fit:cover" />
      <div class="card-body">
        <span class="pill" style="align-self:flex-start">GETTING HERE · 5 MIN READ</span>
        <h3 style="margin:10px 0 6px"><a href="/journal/how-to-get-to-materuni">How to Get to Materuni Village from Moshi, Arusha and KIA</a></h3>
        <p>Routes, road conditions and practical arrival advice for reaching Materuni Village from Moshi, Arusha and KIA.</p>
        <a class="button secondary" href="/journal/how-to-get-to-materuni" style="color:#1A3322!important;border:1px solid #1A3322">Read guide ↗</a>
      </div>
    </article>
    <article class="experience-card" style="border-radius:4px;overflow:hidden">
      <Image src={base+"coffee_image/1792472054273-optimized.webp"} alt="Traditional Chagga coffee preparation in Materuni Village" width={600} height={340} loading="lazy" decoding="async" format="webp" quality={76} style="height:200px;object-fit:cover" />
      <div class="card-body">
        <span class="pill" style="align-self:flex-start">CULTURE & FOOD · 4 MIN READ</span>
        <h3 style="margin:10px 0 6px"><a href="/journal/how-traditional-chagga-coffee-is-made">How Traditional Chagga Coffee is Made</a></h3>
        <p>Discover how traditional Chagga coffee is roasted, ground, brewed and tasted with local hosts in Materuni.</p>
        <a class="button secondary" href="/journal/how-traditional-chagga-coffee-is-made" style="color:#1A3322!important;border:1px solid #1A3322">Explore stories ↗</a>
      </div>
    </article>
  </div>
</section>

<!-- Sticky Mobile Booking Bar (T6) -->
<div class="sticky-mobile-booking-bar" role="region" aria-label="Quick booking request bar">
  <div class="sticky-price">
    <strong data-sticky-from-price>From $36</strong>
    <small>Per person</small>
  </div>
  <div class="sticky-actions">
    <a class="sticky-book-btn" href="/booking">Send request</a>
    <a class="sticky-wa-btn" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%20have%20a%20question%20about%20your%20experiences." target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 11.6a8.45 8.45 0 0 1-12.4 7.45L3.5 20.5l1.5-4.45a8.45 8.45 0 1 1 15.5-4.45Z"/><path d="M8.8 8.2c.25 2.9 2.1 5.2 5.15 6.15l1.2-1.3 2.05 1.05c-.15 1.5-1.2 2.35-2.65 2.35-3.95-.45-7.05-3.65-7.45-7.5 0-1.35.85-2.35 2.2-2.55l1.05 2.15-.95 1.05"/></svg>
    </a>
  </div>
</div>

<style>
.group-discount-panel{max-width:1180px;margin:32px auto 0;padding:28px;background:#E6DFD3;border:1px solid #C5A059;border-radius:4px}
.group-discount-heading{text-align:center;max-width:680px;margin:0 auto 22px}
.group-discount-heading .eyebrow{color:#1A3322;font:800 10px/1.5 Manrope,sans-serif;letter-spacing:.16em}
.group-discount-heading h3{margin:8px 0;color:#1A3322;font:600 clamp(27px,3vw,36px) "Cormorant Garamond",serif}
.group-discount-heading p,.group-discount-foot{color:#242421;font-size:13px;line-height:1.75}
.group-discount-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
.group-discount-grid>div{display:flex;flex-direction:column;justify-content:center;gap:7px;min-height:92px;padding:14px 10px;text-align:center;background:#FAF7F2;border:1px solid #E6DFD3;border-radius:4px}
.group-discount-grid strong{color:#1A3322;font-size:14px}
.group-discount-grid span{color:#242421;font-size:12px;line-height:1.45}
.group-discount-grid .group-custom{background:#1A3322;border-color:#1A3322}
.group-discount-grid .group-custom strong,.group-discount-grid .group-custom span{color:#FAF7F2}
.group-discount-foot{margin:18px 0 12px;text-align:center}
.group-discount-panel>.button{display:flex;width:max-content;max-width:100%;min-height:46px;align-items:center;justify-content:center;margin:0 auto;padding:0 22px}
.experience-photo{display:block;width:100%;height:clamp(220px,23vw,310px);aspect-ratio:8/5;object-fit:cover;object-position:center}
.catalog-product-tagline{display:block;margin:.35rem 0 .15rem;color:#1A3322;font-size:.75rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}
.catalog-best-for{font-size:.72rem!important;font-weight:700;color:#242421!important;letter-spacing:.03em}
.catalog-detail-heading{display:block;margin:.85rem 0 .2rem;color:#1A3322;font-size:.68rem;letter-spacing:.12em}
.shared-standard{margin:32px 0 0;padding:24px 28px;background:#E6DFD3;border:1px solid #C5A059;border-radius:4px}
.shared-standard h2{margin:0 0 14px;color:#1A3322;font:600 clamp(22px,3vw,30px) "Cormorant Garamond",serif}
.shared-standard ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 24px;margin:0;padding-left:18px;color:#242421;font-size:13px;line-height:1.7}
@media(max-width:760px){.group-discount-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.group-discount-grid .group-custom{grid-column:1/-1}.group-discount-panel{padding:20px;margin:24px 0}}
@media(max-width:620px){.shared-standard{padding:20px}.shared-standard ul{grid-template-columns:1fr}}

</style>

</SiteLayout>