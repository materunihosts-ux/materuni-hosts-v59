---
import SiteLayout from "../layouts/SiteLayout.astro";
type Experience = [string, number, string, string, string, string[], string[]];
const items: Experience[]=[
["Waterfalls & Coffee Tour",65,"Best for first-time visitors","waterfall_image/1791601414950-ew7ak42gjka.jpg","A balanced day combining the rainforest, the 95m waterfall and an interactive Chagga coffee experience.",["Guided rainforest hike with time at the waterfall","Bean-to-cup coffee with local hosts","Traditional songs and dancing, banana brew tasting","Home-cooked local lunch"],["Professional local guide","Village/entrance fees","Local lunch","1 bottle of drinking water per guest"]],
["Coffee & Chagga Culture Tour",50,"Best value","coffee_image/1791601540965-5mt58f2ipoe.jpg","A culture-first experience for travellers who want to slow down, meet local hosts and discover Chagga coffee.",["Roast, grind and brew organic Arabica coffee","Guided village nature walk","Live traditional Chagga dancing","Home-cooked local lunch and banana brew tasting"],["Professional local guide","Village/entrance fees","Local lunch","1 bottle of drinking water per guest"]],
["Cooking & Culture",70,"For food lovers","cooking_image/1791601646297-7th6jahyw0w.jpg","Go beyond sightseeing with a practical introduction to traditional Chagga food, cooking methods and village culture.",["Hands-on local cooking using traditional firewood methods","Prepare local dishes with Materuni hosts","Organic coffee-making experience","Village walk, traditional dancing and banana brew"],["Professional local guide","Village/entrance fees","Cooking experience","1 bottle of drinking water per guest"]],
["Waterfall Hike & Cultural Day Trip",75,"Signature day trip","culturalday_image/1791604657693-kcwbk80tcfs.jpg","A premium one-day combination for guests who want waterfall adventure plus a fuller taste of Materuni and Chagga culture.",["Rainforest hike to Materuni Waterfall","Time at the waterfall; swim where conditions permit","Chagga village experience with coffee brewing","Local lunch and traditional dance"],["Professional local guide","Village/entrance fees","Local lunch","1 bottle of drinking water per guest"]],
["Overnight Camping",110,"Overnight experience","camping_image/1791601872981-zmji0mykwhd.jpg","Trade a quick visit for a slower night in Materuni, combining nature, local food, storytelling and village life.",["Waterfall hike and village experience","Traditional firewood cooking class","Overnight camping with camping gear setup","Campfire storytelling, local dinner, breakfast and banana brew"],["Professional local guide","Village/entrance fees","Camping gear setup","Dinner, breakfast & drinking water"]],
["Ultimate",135,"Ultimate experience","ultimate_image/1791604660208-7c4yvzvsaf9.jpg","The most complete Materuni experience, bringing together waterfall, coffee, cooking, camping and Chagga culture.",["Scenic waterfall hike","Hands-on Chagga cooking class","Organic coffee tour and preparation","Overnight camping, storytelling, dance, lunch, dinner & breakfast"],["Professional local guide","Village/entrance fees","Full camping gear setup","Lunch, dinner, breakfast & drinking water"]]
];
const experienceKeys: Record<string,string> = {"Waterfalls & Coffee Tour":"Waterfall & Chagga Culture","Coffee & Chagga Culture Tour":"Traditional Coffee Experience","Cooking & Culture":"Traditional Chagga Cooking Class","Waterfall Hike & Cultural Day Trip":"Waterfall Hike & Cultural Day Trip","Overnight Camping":"Camping & Village Life","Ultimate":"Ultimate"};
const base="https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/";
---
<SiteLayout title="Materuni Experiences & Prices | Materuni Hosts">
<section class="page-hero"><span class="eyebrow">SIX THOUGHTFUL WAYS TO DISCOVER MATERUNI</span><h1>Choose your own Materuni experience.</h1><p>Transparent per-person prices, clear inclusions and authentic experiences hosted in Materuni Village.</p></section>
<section class="section"><div class="cards">{items.map((e)=><article class="experience-card"><img src={base+e[3]} alt={e[0]} loading="lazy"><div class="card-body"><div class="card-top"><span class="pill">{e[2]}</span><span class="price">${e[1]}<small>PER PERSON</small></span></div><h3>{e[0]}</h3><p>{e[4]}</p><strong style="font-size:12px;color:#173b2d">THE EXPERIENCE</strong><ul>{e[5].map(x=><li>{x}</li>)}</ul><strong style="font-size:12px;color:#173b2d">WHAT'S INCLUDED</strong><ul>{e[6].map(x=><li>{x}</li>)}</ul><a class="button" href={"/booking?experience="+encodeURIComponent(experienceKeys[e[0]])}>Check availability</a></div></article>)}</div><p class="notice" style="margin-top:28px">All prices are per person. Every package includes a professional local guide, relevant village/entrance fees and one bottle of drinking water per guest. Transport from Moshi, pickup point, group size and special dietary or accessibility needs should be confirmed when booking.</p></section>
</SiteLayout>