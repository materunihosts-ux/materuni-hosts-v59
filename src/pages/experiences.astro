---
import SiteLayout from "../layouts/SiteLayout.astro";
type Experience = [string, number, string, string, string, string[], string[]];
const items: Experience[]=[
["Waterfalls & Coffee Tour",65,"Best for first-time visitors","waterfall_image/1791601414950-ew7ak42gjka.jpg","A well-rounded introduction to Materuni, combining a guided forest walk to the 95-metre waterfall with hands-on coffee-making and time with local hosts.",["Guided rainforest hike with time at the waterfall","Bean-to-cup coffee with local hosts","Traditional songs and dancing, banana brew tasting","Home-cooked local lunch"],["Professional local guide","Village/entrance fees","Local lunch","1 bottle of drinking water per guest"]],
["Coffee & Chagga Culture Tour",50,"Best value","coffee_image/1791601540965-5mt58f2ipoe.jpg","A culture-led visit for travellers who want to understand the journey from coffee bean to cup and spend time learning about village life.",["Roast, grind and brew organic Arabica coffee","Guided village nature walk","Live traditional Chagga dancing","Home-cooked local lunch and banana brew tasting"],["Professional local guide","Village/entrance fees","Local lunch","1 bottle of drinking water per guest"]],
["Cooking & Culture",70,"For food lovers","cooking_image/1791601646297-7th6jahyw0w.jpg","Take part in preparing traditional Chagga food with local hosts and learn about the ingredients, methods and customs behind the meal.",["Hands-on local cooking using traditional firewood methods","Prepare local dishes with Materuni hosts","Organic coffee-making experience","Village walk, traditional dancing and banana brew"],["Professional local guide","Village/entrance fees","Cooking experience","1 bottle of drinking water per guest"]],
["Waterfall Hike & Cultural Day Trip",75,"Signature day trip","culturalday_image/1791604657693-kcwbk80tcfs.jpg","A fuller day for guests who want to combine the waterfall with coffee and cultural activities, allowing more room to enjoy the village experience.",["Rainforest hike to Materuni Waterfall","Time at the waterfall; swim where conditions permit","Chagga village experience with coffee brewing","Local lunch and traditional dance"],["Professional local guide","Village/entrance fees","Local lunch","1 bottle of drinking water per guest"]],
["Overnight Camping",110,"Overnight experience","camping_image/1791601872981-zmji0mykwhd.jpg","Stay beyond the day-trip pace. This overnight experience combines time outdoors with camping, local food and an evening of storytelling.",["Waterfall hike and village experience","Traditional firewood cooking class","Overnight camping with camping gear setup","Campfire storytelling, local dinner, breakfast and banana brew"],["Professional local guide","Village/entrance fees","Camping gear setup","Dinner, breakfast & drinking water"]],
["Ultimate",135,"Ultimate experience","ultimate_image/1791604660208-7c4yvzvsaf9.jpg","Our broadest combination for guests who want several sides of Materuni in one visit: waterfall, coffee-making, Chagga cooking and overnight camping.",["Scenic waterfall hike","Hands-on Chagga cooking class","Organic coffee tour and preparation","Overnight camping, storytelling, dance, lunch, dinner & breakfast"],["Professional local guide","Village/entrance fees","Full camping gear setup","Lunch, dinner, breakfast & drinking water"]]
];
const experienceKeys: Record<string,string> = {"Waterfalls & Coffee Tour":"Waterfall & Chagga Culture","Coffee & Chagga Culture Tour":"Traditional Coffee Experience","Cooking & Culture":"Traditional Chagga Cooking Class","Waterfall Hike & Cultural Day Trip":"Materuni Waterfall Hike & Cultural Day Trip","Overnight Camping":"Camping & Village Life","Ultimate":"The Ultimate Kilimanjaro Foothills & Materuni Experience"};
const base="https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/";
---
<SiteLayout title="Materuni Experiences & Prices | Materuni Hosts" description="Explore Materuni waterfall hikes, Chagga coffee experiences, cooking classes and village stays. Compare experiences and prices, then check availability with local hosts.">
<section class="page-hero"><span class="eyebrow" data-i18n="exp_eyebrow">SIX THOUGHTFUL WAYS TO DISCOVER MATERUNI</span><h1 data-i18n="experiences_page_title">Choose your own Materuni experience.</h1><p data-i18n="experiences_page_intro">Transparent per-person prices, clear inclusions and authentic experiences hosted in Materuni Village.</p></section>
<section class="section"><div class="cards">{items.map((e)=><article class="experience-card" data-experience-key={experienceKeys[e[0]]}><img data-gallery src={base+e[3]} alt={e[0]} loading="lazy" decoding="async" width="640" height="420"><div class="card-body"><div class="card-top"><span class="pill">{e[2]}</span><span class="price" data-catalog-price data-price-usd={e[1]}>${e[1]}<small>PER PERSON</small></span></div><h3 data-catalog-name>{e[0]}</h3><p data-catalog-description>{e[4]}</p><strong style="font-size:12px;color:#173b2d" data-i18n="exp_experience_label">THE EXPERIENCE</strong><ul>{e[5].map(x=><li>{x}</li>)}</ul><strong style="font-size:12px;color:#173b2d" data-i18n="exp_included_label">WHAT YOUR EXPERIENCE INCLUDES</strong><ul>{e[6].map(x=><li>{x}</li>)}</ul><a class="button" href={"/booking?experience="+encodeURIComponent(experienceKeys[e[0]])} data-i18n="exp_check_availability">Check availability</a></div></article>)}</div><p class="notice" style="margin-top:28px" data-i18n="exp_notice">All prices are per person. The inclusions listed under each experience describe what is covered in that package. Transport from Moshi is not included in the displayed prices unless agreed separately. Please share your pickup point, group size, dietary requirements or accessibility needs with us before your visit so we can discuss the arrangements. A booking request is not a confirmed reservation; your host will confirm the details with you.</p></section>
<script>
// @ts-nocheck
const catalogApi = "https://sskmzswoeljxwojcszta.supabase.co";
const catalogKey = "sb_publishable_G9ru4P_yKzievqiXjXEEbQ_p28cB_NZ";
const catalogHeaders = { apikey: catalogKey, Authorization: "Bearer " + catalogKey };
const cardsRoot = document.querySelector(".cards");
const safeText = (node, value) => { if (node && typeof value === "string") node.textContent = value; };
function makeCatalogCard(tour) {
  const card = document.createElement("article");
  card.className = "experience-card";
  card.dataset.experienceKey = tour.experience_key;
  if (tour.image_url && /^https:\/\//i.test(tour.image_url)) {
    const image = document.createElement("img");
    image.src = tour.image_url; image.alt = tour.display_name || "Materuni experience";
    image.loading = "lazy"; image.decoding = "async"; image.width = 640; image.height = 420;
    card.append(image);
  }
  const body = document.createElement("div"); body.className = "card-body";
  const top = document.createElement("div"); top.className = "card-top";
  const duration = document.createElement("span"); duration.className = "pill";
  duration.textContent = tour.duration_label || "Local experience";
  const price = document.createElement("span"); price.className = "price";
  price.textContent = "$" + Number(tour.price_usd).toFixed(0) + " ";
  const per = document.createElement("small"); per.textContent = "PER PERSON"; price.append(per);
  top.append(duration, price);
  const heading = document.createElement("h3"); heading.textContent = tour.display_name || "Materuni experience";
  const description = document.createElement("p"); description.textContent = tour.full_description || tour.short_description || "Ask our local hosts for details about this experience.";
  body.append(top, heading, description);
  if (Array.isArray(tour.inclusions) && tour.inclusions.length) {
    const label = document.createElement("strong"); label.style.cssText = "font-size:12px;color:#173b2d"; label.textContent = "WHAT YOUR EXPERIENCE INCLUDES"; label.dataset.i18n = "exp_included_label";
    const list = document.createElement("ul"); tour.inclusions.forEach(value => { const li = document.createElement("li"); li.textContent = value; list.append(li); }); body.append(label, list);
  }
  if (Array.isArray(tour.exclusions) && tour.exclusions.length) {
    const label = document.createElement("strong"); label.style.cssText = "display:block;margin-top:1rem;font-size:12px;color:#173b2d"; label.textContent = "NOT INCLUDED"; label.dataset.i18n = "exp_excluded_label";
    const list = document.createElement("ul"); tour.exclusions.forEach(value => { const li = document.createElement("li"); li.textContent = value; list.append(li); }); body.append(label, list);
  }
  const link = document.createElement("a"); link.className = "button"; link.textContent = "Check availability"; link.dataset.i18n = "exp_check_availability";
  link.href = "/booking?experience=" + encodeURIComponent(tour.experience_key);
  body.append(link); card.append(body); return card;
}
async function syncPublicCatalogue() {
  try {
    const query = new URLSearchParams({
      select: "experience_key,display_name,price_usd,is_active,short_description,full_description,image_url,duration_label,inclusions,exclusions,sort_order",
      order: "sort_order.asc"
    });
    const response = await fetch(catalogApi + "/rest/v1/experience_catalog?" + query, {
      headers: catalogHeaders, cache: "no-store"
    });
    if (!response.ok) throw new Error("Catalogue unavailable");
    const catalogue = await response.json();
    const active = catalogue.filter(item => item.is_active);
    const byKey = new Map(active.map(item => [item.experience_key, item]));
    cardsRoot.querySelectorAll("[data-experience-key]").forEach(card => {
      const item = byKey.get(card.dataset.experienceKey);
      if (!item) { card.remove(); return; }
      const price = card.querySelector("[data-catalog-price]");
      if (price) {
        price.textContent = "$" + Number(item.price_usd).toFixed(0);
        const suffix = document.createElement("small"); suffix.textContent = "PER PERSON"; price.append(suffix);
      }
      safeText(card.querySelector("[data-catalog-name]"), item.display_name);
      safeText(card.querySelector("[data-catalog-description]"), item.full_description || item.short_description);
      const image = card.querySelector("img");
      if (image && item.image_url && /^https:\/\//i.test(item.image_url)) image.src = item.image_url;
      const pill = card.querySelector(".pill");
      if (pill && item.duration_label) pill.textContent = item.duration_label;
      const inclusionList = card.querySelectorAll(".card-body ul");
      if (inclusionList[1] && Array.isArray(item.inclusions) && item.inclusions.length) {
        inclusionList[1].replaceChildren(...item.inclusions.map(value => {
          const li = document.createElement("li"); li.textContent = value; return li;
        }));
      }
      let exTitle = card.querySelector("[data-exclusions-title]");
      let exList = card.querySelector("[data-exclusions-list]");
      if (!exTitle) { exTitle = document.createElement("strong"); exTitle.dataset.exclusionsTitle = "true"; exTitle.style.cssText = "display:block;margin-top:1rem;font-size:12px;color:#173b2d"; exTitle.textContent = "NOT INCLUDED"; }
      if (!exList) { exList = document.createElement("ul"); exList.dataset.exclusionsList = "true"; }
      if (Array.isArray(item.exclusions) && item.exclusions.length) {
        exList.replaceChildren(...item.exclusions.map(value => { const li = document.createElement("li"); li.textContent = value; return li; }));
        const bookingLink = card.querySelector('a[href^="/booking"]');
        if (bookingLink) { const body = card.querySelector(".card-body"); body.insertBefore(exTitle, bookingLink); body.insertBefore(exList, bookingLink); }
      } else { exTitle.remove(); exList.remove(); }
      const bookingLink = card.querySelector('a[href^="/booking"]');
      if (bookingLink) bookingLink.href = "/booking?experience=" + encodeURIComponent(item.experience_key);
    });
    active.filter(item => !cardsRoot.querySelector('[data-experience-key="' + CSS.escape(item.experience_key) + '"]'))
      .forEach(item => cardsRoot.append(makeCatalogCard(item)));
  } catch (error) {
    console.warn("Using the built-in experience catalogue because the live catalogue could not be loaded.", error);
  } finally {
    if (window.MateruniApplyPageTranslations) window.MateruniApplyPageTranslations(localStorage.getItem("materuni-language") || "en");
  }
}
syncPublicCatalogue();
</script>
</SiteLayout>