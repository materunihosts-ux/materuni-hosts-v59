---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import { supabaseUrl } from "../lib/supabase-public";
type Experience = [string, number, string, string, string, string[], string[]];
const items: Experience[]=[
["Materuni Waterfall & Chagga Village Experience",40,"Waterfall & Chagga heritage","waterfall_image/1791998303073-materuni-waterfall-hike.jpg","Join a local host for a guided walk to Materuni Waterfall, then discover Chagga village life and traditional coffee making. Your host confirms the route and experience details before booking.",["Guided walk to Materuni Waterfall","Discover Materuni village life and Chagga heritage","Traditional coffee making and tasting"],["Local guide","Materuni village and waterfall entrance fees","Traditional Chagga coffee experience and tasting","Local lunch","Drinking water"]],
["Traditional Chagga Coffee Experience",36,"From coffee growing to a fresh cup","coffee_image/1791998412318-materuni-tour.jpg","Discover the Chagga coffee journey with local hosts in Materuni, from local growing traditions and hands-on roasting, grinding and brewing to a freshly prepared tasting.",["Discover local Chagga coffee-growing traditions","Take part in roasting, grinding and brewing","Taste freshly prepared coffee with your hosts"],["Professional local guide","Materuni village and waterfall entrance fees","Traditional Chagga coffee experience and tasting","Authentic local lunch","One bottle of drinking water"]],
["Traditional Chagga Cooking Class",49,"Cook, taste & share local food","", "Join a hands-on Chagga cooking class with local hosts, learn about ingredients and traditional preparation methods, and enjoy the food you help prepare.",["Hands-on traditional Chagga cooking class","Local cooking ingredients","Guided cooking session with a local host"],["Professional local guide","Materuni village and waterfall entrance fees","Traditional Chagga coffee experience","Authentic local lunch","One bottle of drinking water","Hands-on Chagga cooking session"]],
["Materuni & Moshi Town Cultural Experience",52,"Materuni village & Moshi town","story_image/1791995912146-materuni-community.jpg", "Pair the shared Materuni day experience with a guided Moshi town visit. Explore the town with a local guide, learn about its history and everyday life, and discover its streets and market area.",["Guided Moshi town walk with a local town guide","Local history and everyday-life interpretation","Local market walk and cultural orientation"],["Professional local Materuni guide","Materuni village and waterfall entrance fees","Traditional Chagga coffee experience","Authentic local lunch","One bottle of drinking water","Guided Moshi town walk with local guide"]],
["Materuni & Rau Forest Nature Experience",58,"Waterfall, culture & forest nature","story_image/1791601761441-q3iog8mni3r.jpg", "Combine the shared Materuni day experience with a guided nature walk in Rau Forest near Moshi. Discover forest ecology, birdlife, the ancient Mvule tree and nearby rice fields. The published package price includes the Rau Forest entrance fee.",["Guided Rau Forest nature walk","Forest interpretation and birdwatching","Ancient Mvule tree and nearby rice-field discovery"],["Professional local Materuni guide","Materuni village and waterfall entrance fees","Rau Forest entrance fee included","Traditional Chagga coffee experience","Authentic local lunch","One bottle of drinking water","Guided Rau Forest nature walk"]],
["Materuni Overnight Village Experience",90,"A slower Materuni village stay","story_image/1791994219885-materuni-coffe-plantatio-tour.jpg","Enjoy an overnight village experience in Materuni with local hosting and time to discover village life. Accommodation arrangements, meals and activities are confirmed by your host before booking.",["Overnight village experience with local hosting","Accommodation type and arrangements confirmed by host","Meals and next-day activities confirmed by host"],["Local guide","Materuni village and waterfall entrance fees","Traditional Chagga coffee experience","Local lunch","Drinking water","Overnight village experience with local hosting","Accommodation type, meals and activities confirmed by host"]]
];
const defaultExclusions = ["Transport to and from Materuni unless arranged separately","Personal purchases and expenses","Tips and gratuities"];
const experienceKeys: Record<string,string> = {"Materuni Waterfall & Chagga Village Experience":"waterfall","Traditional Chagga Coffee Experience":"coffee","Traditional Chagga Cooking Class":"cooking","Materuni & Moshi Town Cultural Experience":"moshi","Materuni & Rau Forest Nature Experience":"rau","Materuni Overnight Village Experience":"camping"};
const base=`${supabaseUrl}/storage/v1/object/public/materuni-images/`;
---
<SiteLayout title="Materuni Tours & Experiences | Waterfall & Chagga Culture" description="Explore Materuni tours near Moshi with local Chagga hosts: waterfall hikes, coffee and cooking experiences, village culture, Moshi day trips and nature walks." preloadImage={`${base}waterfall_image/1791998303073-materuni-waterfall-hike.jpg`}>
<section class="page-hero"><span class="eyebrow" data-i18n="home_section_eyebrow">LOCAL CHAGGA EXPERIENCES</span><h1 data-i18n="experiences_hero_title">Discover Materuni with local Chagga hosts.</h1><p data-i18n="experiences_hero_intro">Choose a guided waterfall and village experience, Chagga coffee traditions, hands-on cooking, a Moshi town visit, Rau Forest nature or an overnight village stay. Compare the highlights, inclusions and local arrangements for each experience.</p></section>
<section class="section"><div class="cards">{items.map((e)=><article class="experience-card" id={e[0] === "Materuni Overnight Village Experience" ? "camping" : undefined} data-experience-key={experienceKeys[e[0]]}>{e[0] === "Traditional Chagga Cooking Class" ? <div class="experience-placeholder" role="img" aria-label="Authentic Chagga cooking class photography will be added when a verified local image is available">CHAGGA COOKING EXPERIENCE</div> : <Image src={base+e[3]} alt={e[0]} loading="lazy" decoding="async" width={640} height={420} format="webp" quality={76} class="experience-photo" />}<div class="card-body"><div class="card-top"><span class="pill">{e[2]}</span><span class="price" data-catalog-price>${e[1]}<small data-i18n="exp_per_person">PER PERSON</small></span></div><h3 data-catalog-name>{e[0]}</h3><p data-catalog-description>{e[4]}</p><details class="experience-details"><summary>Experience details &amp; inclusions</summary><div class="experience-details-content"><strong style="font-size:12px;color:#173b2d" data-i18n="exp_experience_label">THE EXPERIENCE</strong><ul>{[...new Set(e[5])].map(x=><li>{x}</li>)}</ul><strong style="font-size:12px;color:#173b2d" data-i18n="exp_included_label">WHAT YOUR EXPERIENCE INCLUDES</strong><ul>{[...new Set(e[6])].map(x=><li>{x}</li>)}</ul><strong data-exclusions-title="true" style="display:block;margin-top:1rem;font-size:12px;color:#173b2d" data-i18n="exp_excluded_label">NOT INCLUDED</strong><ul data-exclusions-list="true">{defaultExclusions.map(x=><li>{x}</li>)}</ul></div></details><a class="button" href={"/booking?experience="+encodeURIComponent(experienceKeys[e[0]])} data-i18n="exp_check_availability">Check availability</a></div></article>)}</div><aside class="group-discount-panel" aria-labelledby="group-discount-title"><div class="group-discount-heading"><span class="eyebrow">TRAVELLING TOGETHER?</span><h3 id="group-discount-title">Ask about group arrangements</h3><p>For groups of four or more, contact your local host for a tailored quote. Any group pricing is confirmed before booking.</p></div><a class="button" href="/booking">Ask about your group</a></aside><p class="notice" style="margin-top:18px" data-i18n="exp_notice">All prices are per person in USD. The published Rau Forest package price includes the Rau Forest entrance fee. Transport to Materuni and between locations is arranged separately and quoted on request. A booking request is not confirmed until your host replies with availability and final arrangements.</p></section>

<!-- From the Journal (J5) -->
<section class="section" style="background:#f7f4ed;padding-top:48px;padding-bottom:56px">
  <div class="section-head">
    <span class="eyebrow">LOCAL PRACTICAL GUIDES</span>
    <h2>From the Journal</h2>
    <p>Helpful advice, transport timings, and cultural notes from our Materuni hosting team.</p>
  </div>
  <div class="cards" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr));max-width:1100px;margin:0 auto">
    <article class="experience-card" style="border-radius:12px;overflow:hidden">
      <Image src={base+"hero_image/1791995544192-materuni-waterfall.jpg"} alt="Materuni waterfall trail in northern Tanzania" width={600} height={340} loading="lazy" decoding="async" format="webp" quality={76} style="height:200px;object-fit:cover" />
      <div class="card-body">
        <span class="pill" style="align-self:flex-start">GETTING HERE · 5 MIN READ</span>
        <h3 style="margin:10px 0 6px"><a href="/journal/how-to-get-to-materuni">How to Get to Materuni Village from Moshi, Arusha and KIA</a></h3>
        <p>Routes, realistic travel times, road conditions, and confirmed vehicle prices from our local Chagga hosts.</p>
        <a class="button secondary" href="/journal/how-to-get-to-materuni" style="color:#1a3322!important;border:1px solid #1a3322">Read guide ↗</a>
      </div>
    </article>
    <article class="experience-card" style="border-radius:12px;overflow:hidden">
      <Image src={base+"coffee_image/1791998412318-materuni-tour.jpg"} alt="Chagga coffee harvesting and roasting" width={600} height={340} loading="lazy" decoding="async" format="webp" quality={76} style="height:200px;object-fit:cover" />
      <div class="card-body">
        <span class="pill" style="align-self:flex-start">CULTURE & FOOD · 4 MIN READ</span>
        <h3 style="margin:10px 0 6px"><a href="/journal">How Traditional Chagga Coffee is Made</a></h3>
        <p>From volcanic soil and hand-picked cherries to woodfire roasting, pestle rhythm, and songs.</p>
        <a class="button secondary" href="/journal" style="color:#1a3322!important;border:1px solid #1a3322">Explore stories ↗</a>
      </div>
    </article>
  </div>
</section>

<!-- Sticky Mobile Booking Bar (T6) -->
<div class="sticky-mobile-booking-bar" role="region" aria-label="Quick booking bar">
  <div class="sticky-price">
    <strong>From $36</strong>
    <small>Per person</small>
  </div>
  <div class="sticky-actions">
    <a class="sticky-book-btn" href="/booking">Check availability</a>
    <a class="sticky-wa-btn" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%20have%20a%20question%20about%20your%20experiences." target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 11.6a8.45 8.45 0 0 1-12.4 7.45L3.5 20.5l1.5-4.45a8.45 8.45 0 1 1 15.5-4.45Z"/><path d="M8.8 8.2c.25 2.9 2.1 5.2 5.15 6.15l1.2-1.3 2.05 1.05c-.15 1.5-1.2 2.35-2.65 2.35-3.95-.45-7.05-3.65-7.45-7.5 0-1.35.85-2.35 2.2-2.55l1.05 2.15-.95 1.05"/></svg>
    </a>
  </div>
</div>

<style>
.group-discount-panel{max-width:1180px;margin:30px auto;padding:28px;background:#f4efe6;border:1px solid #e3dacb;border-radius:16px}.group-discount-heading{text-align:center;max-width:680px;margin:0 auto 22px}.group-discount-heading .eyebrow{color:#755523;font:800 10px/1.5 Manrope,sans-serif;letter-spacing:.16em}.group-discount-heading h3{margin:8px 0;color:#1a3322;font:600 clamp(27px,3vw,36px) "Cormorant Garamond",serif}.group-discount-heading p,.group-discount-foot{color:#657066;font-size:13px;line-height:1.75}.group-discount-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.group-discount-grid>div{display:flex;flex-direction:column;justify-content:center;gap:7px;min-height:92px;padding:14px 10px;text-align:center;background:#fff;border:1px solid #e5ded2;border-radius:12px}.group-discount-grid strong{color:#1a3322;font-size:14px}.group-discount-grid span{color:#657066;font-size:12px;line-height:1.45}.group-discount-grid .group-custom{background:#1a3322;border-color:#1a3322}.group-discount-grid .group-custom strong,.group-discount-grid .group-custom span{color:#fff}.group-discount-foot{margin:18px 0 12px;text-align:center}.group-discount-panel>.button{display:flex;width:max-content;max-width:100%;min-height:46px;align-items:center;justify-content:center;margin:0 auto;padding:0 22px}@media(max-width:760px){.group-discount-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.group-discount-grid .group-custom{grid-column:1/-1}.group-discount-panel{padding:20px;margin:24px 0}}
.product-image-wrap{display:block}
.experience-photo{display:block;width:100%;height:clamp(220px,23vw,310px);aspect-ratio:8/5;object-fit:cover;object-position:center}
.experience-placeholder{display:grid;place-items:center;min-height:220px;aspect-ratio:8/5;background:linear-gradient(135deg,#1a3322,#566b53);color:#f4efe6;font:800 11px Manrope,sans-serif;letter-spacing:.16em;text-align:center;padding:20px}
.catalog-product-tagline{display:block;margin:.35rem 0 .15rem;color:#a27b3e;font-size:.75rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}
.catalog-best-for{font-size:.72rem!important;font-weight:700;color:#1a3322!important;letter-spacing:.03em}
.catalog-detail-heading{display:block;margin:.85rem 0 .2rem;color:#1a3322;font-size:.68rem;letter-spacing:.12em}
.group-discount-panel{margin-top:32px}.shared-standard{margin:32px 0 0;padding:24px 28px;background:#f4efe6;border:1px solid #e6dfd3;border-radius:16px}
.shared-standard h2{margin:0 0 14px;color:#1a3322;font:600 clamp(22px,3vw,30px) "Cormorant Garamond",serif}
.shared-standard ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 24px;margin:0;padding-left:18px;color:#425347;font-size:13px;line-height:1.7}
@media(max-width:620px){.shared-standard{padding:20px}.shared-standard ul{grid-template-columns:1fr}}

/* Experiences catalogue: compact editorial cards with optional detail disclosure */
.public-shell .section:has(>.cards) {
  max-width: 1400px;
  margin-inline: auto;
  padding: clamp(48px, 6vw, 82px) clamp(18px, 4vw, 60px);
}
.public-shell .section > .cards:not([style]) {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(18px, 2vw, 28px);
  align-items: stretch;
}
.public-shell .experience-card {
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid rgba(26,51,34,.12);
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 8px 28px rgba(26,51,34,.055);
  transition: transform .24s ease, box-shadow .24s ease, border-color .24s ease;
}
.public-shell .experience-card:hover {
  transform: translateY(-4px);
  border-color: rgba(197,160,89,.65);
  box-shadow: 0 18px 42px rgba(26,51,34,.11);
}
.public-shell .experience-photo,
.public-shell .experience-placeholder {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 10;
  min-height: 0;
  flex: 0 0 auto;
}
.public-shell .card-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 0;
  padding: clamp(19px, 2vw, 26px);
}
.public-shell .card-top {
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}
.public-shell .card-top .pill {
  max-width: 65%;
  font-size: 10px;
  line-height: 1.45;
}
.public-shell .experience-card h3 {
  margin: 0 0 10px;
  color: #1a3322;
  font: 600 clamp(22px, 1.8vw, 27px)/1.2 "Cormorant Garamond", Georgia, serif;
}
.public-shell .experience-card .card-body > p {
  margin: 0 0 18px;
  color: #59645b;
  font-size: 13px;
  line-height: 1.72;
}
.public-shell .experience-details {
  margin: 0 0 18px;
  border-top: 1px solid #eee8de;
  border-bottom: 1px solid #eee8de;
}
.public-shell .experience-details summary {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 10px 26px 10px 0;
  color: #294431;
  cursor: pointer;
  list-style: none;
  font: 700 11px/1.4 Manrope, sans-serif;
}
.public-shell .experience-details summary::-webkit-details-marker { display: none; }
.public-shell .experience-details summary::after {
  content: "+";
  position: absolute;
  right: 2px;
  top: 50%;
  transform: translateY(-50%);
  color: #9a7842;
  font: 500 20px/1 Manrope, sans-serif;
}
.public-shell .experience-details[open] summary::after { content: "−"; }
.public-shell .experience-details-content {
  padding: 0 0 12px;
  color: #566258;
  font-size: 12px;
  line-height: 1.65;
}
.public-shell .experience-details-content ul {
  margin: 5px 0 12px;
  padding-left: 18px;
  font-size: 12px;
  line-height: 1.65;
}
.public-shell .experience-details-content li { margin: 3px 0; }
.public-shell .catalog-product-tagline {
  color: #8b6b35;
  font-size: 10px;
  line-height: 1.5;
  letter-spacing: .09em;
}
.public-shell .catalog-best-for {
  margin: 6px 0 10px;
  color: #526055;
  font-size: 12px !important;
  line-height: 1.6;
}
.public-shell .catalog-detail-heading {
  margin: 10px 0 3px;
  color: #294431;
  font-size: 10px;
  line-height: 1.5;
  letter-spacing: .07em;
}
.public-shell .experience-card .button {
  width: 100%;
  min-height: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: auto;
  border-radius: 3px;
  font-size: 11px;
}
.public-shell .group-discount-panel {
  margin-top: 36px;
  border-radius: 16px;
}
.public-shell .section > .notice {
  max-width: 920px;
  margin: 20px auto 0;
  font-size: 13px;
  line-height: 1.75;
}
@media (max-width: 1040px) {
  .public-shell .section > .cards:not([style]) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 640px) {
  .public-shell .section:has(>.cards) { padding: 48px 16px; }
  .public-shell .section > .cards:not([style]) { grid-template-columns: 1fr; gap: 18px; }
  .public-shell .experience-photo,
  .public-shell .experience-placeholder { aspect-ratio: 16 / 9; }
  .public-shell .card-body { padding: 19px; }
  .public-shell .experience-card h3 { font-size: 24px; }
}
@media (prefers-reduced-motion: reduce) {
  .public-shell .experience-card { transition: none; }
  .public-shell .experience-card:hover { transform: none; }
}

</style>
<script>
// @ts-nocheck
import { supabaseUrl as catalogApi, publishableKey as catalogKey } from "../lib/supabase-public";
const catalogHeaders = { apikey: catalogKey, Authorization: "Bearer " + catalogKey };
const publicMediaBase = catalogApi + "/storage/v1/object/public/materuni-images/";
const photoAltByKey: Record<string,string> = {
  "Waterfall & Chagga Culture": "Materuni Waterfall and surrounding green forest in Tanzania",
  "Traditional Coffee Experience": "Traditional coffee experience with local Materuni hosts",
  "Traditional Chagga Cooking Class": "Guests preparing traditional Chagga food during a Materuni cooking class",
  "Materuni & Moshi Town Tour": "Local market scene in Moshi, Tanzania",
  "Materuni & Rau Forest Experience": "Rau Forest in Miembeni Ward, Moshi, Tanzania",
  "Camping & Village Life": "Village camping experience in Materuni beneath Mount Kilimanjaro"
};
function experiencePhoto(key: string, imageUrl?: string | null) {
  if (imageUrl && /^https:\/\//i.test(imageUrl)) return imageUrl;
  const fallback: Record<string,string> = {
    "Waterfall & Chagga Culture": publicMediaBase + "waterfall_image/1791998303073-materuni-waterfall-hike.jpg",
    "Traditional Coffee Experience": publicMediaBase + "coffee_image/1791998412318-materuni-tour.jpg",
    "Traditional Chagga Cooking Class": publicMediaBase + "coffee_image/1791994933291-materuni-coffe-picking-lesson.jpg",
    "Materuni & Moshi Town Tour": publicMediaBase + "story_image/1791995912146-materuni-community.jpg",
    "Materuni & Rau Forest Experience": publicMediaBase + "story_image/1791601761441-q3iog8mni3r.jpg",
    "Camping & Village Life": publicMediaBase + "story_image/1791994219885-materuni-coffe-plantatio-tour.jpg"
  };
  return fallback[key] || "";
}
const cardsRoot = document.querySelector(".cards");
const safeText = (node, value) => { if (node && typeof value === "string") node.textContent = value; };
function appendProductMeta(body, tour) {
  const meta = document.createElement("div"); meta.dataset.productMeta = "true";
  if (tour.product_tagline) { const tagline = document.createElement("span"); tagline.className = "catalog-product-tagline"; tagline.textContent = tour.product_tagline; meta.append(tagline); }
  if (tour.best_for) { const best = document.createElement("p"); best.className = "catalog-best-for"; const label = document.createElement("span"); label.dataset.i18n = "exp_best_for"; label.textContent = "BEST FOR"; best.append(label, document.createTextNode(" · " + tour.best_for)); meta.append(best); }
  const addList = (labelText, values) => {
    if (!Array.isArray(values) || !values.length) return;
    const label = document.createElement("strong"); label.className = "catalog-detail-heading"; label.textContent = labelText; meta.append(label);
    const list = document.createElement("ul");
    const uniqueValues = [...new Set(values)];
    uniqueValues.forEach(value => { if (typeof value !== "string" || !value.trim()) return; const li = document.createElement("li"); li.textContent = value; list.append(li); });
    meta.append(list);
  };
  addList("SIGNATURE MOMENTS", Array.isArray(tour.signature_moments) ? tour.signature_moments.slice(0,3) : []); meta.querySelectorAll(".catalog-detail-heading").forEach(label => { if (label.textContent === "SIGNATURE MOMENTS") label.dataset.i18n = "exp_signature_moments"; if (label.textContent === "YOUR UNIQUE EXPERIENCE") label.dataset.i18n = "exp_unique_experience"; });
  addList("WHAT YOUR EXPERIENCE INCLUDES", tour.inclusions);
  addList("YOUR UNIQUE EXPERIENCE", tour.unique_amenities);
  if (meta.childNodes.length) body.append(meta);
}
function makeCatalogCard(tour) {
  const card = document.createElement("article");
  card.className = "experience-card";
  if (tour.experience_key === "Camping & Village Life") card.id = "camping";
  card.dataset.experienceKey = tour.experience_key;
  const selectedImage = tour.experience_key === "Traditional Chagga Cooking Class" ? (tour.image_url || "") : experiencePhoto(tour.experience_key, tour.image_url);
  if (selectedImage && /^https:\/\//i.test(selectedImage)) {
    const image = document.createElement("img");
    image.src = selectedImage; image.alt = photoAltByKey[tour.experience_key] || (tour.experience_key === "Traditional Coffee Experience" ? "Materuni coffee experience with local hosts" : tour.display_name || "Materuni experience");
    image.className = "experience-photo"; image.loading = "lazy"; image.decoding = "async"; image.width = 640; image.height = 420;
    card.append(image);
  }
  const body = document.createElement("div"); body.className = "card-body";
  const top = document.createElement("div"); top.className = "card-top";
  const duration = document.createElement("span"); duration.className = "pill";
  duration.textContent = tour.duration_label || "Local experience";
  const price = document.createElement("span"); price.className = "price";
  price.textContent = "$" + Number(tour.price_usd).toFixed(0) + " ";
  const per = document.createElement("small"); per.dataset.i18n = "exp_per_person"; per.textContent = "PER PERSON"; price.append(per);
  top.append(duration, price);
  const heading = document.createElement("h3"); heading.textContent = tour.display_name || "Materuni experience";
  const description = document.createElement("p"); description.textContent = tour.full_description || tour.short_description || "Ask our local hosts for details about this experience.";
  const details = document.createElement("details"); details.className = "experience-details";
  const summary = document.createElement("summary"); summary.textContent = "Experience details & inclusions";
  const detailsContent = document.createElement("div"); detailsContent.className = "experience-details-content";
  appendProductMeta(detailsContent, tour);
  if (Array.isArray(tour.exclusions) && tour.exclusions.length) {
    const label = document.createElement("strong"); label.style.cssText = "display:block;margin-top:1rem;font-size:12px;color:#173b2d"; label.textContent = "NOT INCLUDED"; label.dataset.i18n = "exp_excluded_label";
    const list = document.createElement("ul"); list.dataset.exclusionsList = "true"; tour.exclusions.forEach(value => { const li = document.createElement("li"); li.textContent = value; list.append(li); }); label.dataset.exclusionsTitle = "true"; detailsContent.append(label, list);
  }
  details.append(summary, detailsContent);
