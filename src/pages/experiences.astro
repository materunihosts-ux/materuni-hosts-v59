---
import SiteLayout from "../layouts/SiteLayout.astro";
import { supabaseUrl } from "../lib/supabase-public";
type Experience = [string, number, string, string, string, string[], string[]];
const items: Experience[]=[
["Materuni Camping",110,"Flagship overnight stay","camping_image/1791601872981-zmji0mykwhd.jpg","Make Materuni your home for a night. This signature stay combines an overnight camp with the waterfall, Chagga coffee and cooking traditions, local food and evening storytelling.",["Overnight camping with camping gear setup","Waterfall and village experience","Chagga cooking, local dinner and breakfast","Campfire stories and time with local hosts"],["Professional local guide","Village/entrance fees","Camping gear setup","Dinner, breakfast & drinking water"]],
["Materuni Waterfall & Chagga Culture",75,"Best for first-time visitors","waterfall_image/1791601414950-ew7ak42gjka.jpg","A well-rounded introduction to Materuni, combining a guided forest walk to the 95-metre waterfall with hands-on coffee-making and time with local hosts.",["Guided rainforest hike with time at the waterfall","Bean-to-cup coffee with local hosts","Traditional songs and dancing, banana brew tasting","Home-cooked local lunch"],["Professional local guide","Village/entrance fees","Local lunch","1 bottle of drinking water per guest"]],
["Traditional Coffee Experience",65,"Best value","coffee_image/1791601540965-5mt58f2ipoe.jpg","A culture-led visit for travellers who want to understand the journey from coffee bean to cup and spend time learning about village life.",["Roast, grind and brew organic Arabica coffee","Guided village nature walk","Live traditional Chagga dancing","Home-cooked local lunch and banana brew tasting"],["Professional local guide","Village/entrance fees","Local lunch","1 bottle of drinking water per guest"]],
["Traditional Chagga Cooking Class",85,"For food lovers","cooking_image/1791601646297-7th6jahyw0w.jpg","Take part in preparing traditional Chagga food with local hosts and learn about the ingredients, methods and customs behind the meal.",["Hands-on local cooking using traditional firewood methods","Prepare local dishes with Materuni hosts","Organic coffee-making experience","Village walk, traditional dancing and banana brew"],["Professional local guide","Village/entrance fees","Cooking experience","1 bottle of drinking water per guest"]],
["Waterfall Hike & Cultural Day Trip",75,"Signature day trip","culturalday_image/1791604657693-kcwbk80tcfs.jpg","A fuller day for guests who want to combine the waterfall with coffee and cultural activities, allowing more room to enjoy the village experience.",["Rainforest hike to Materuni Waterfall","Time at the waterfall; swim where conditions permit","Chagga village experience with coffee brewing","Local lunch and traditional dance"],["Professional local guide","Village/entrance fees","Local lunch","1 bottle of drinking water per guest"]],
["Ultimate",135,"Ultimate experience","ultimate_image/1791604660208-7c4yvzvsaf9.jpg","Our broadest combination for guests who want several sides of Materuni in one visit: waterfall, coffee-making, Chagga cooking and overnight camping.",["Scenic waterfall hike","Hands-on Chagga cooking class","Organic coffee tour and preparation","Overnight camping, storytelling, dance, lunch, dinner & breakfast"],["Professional local guide","Village/entrance fees","Full camping gear setup","Lunch, dinner, breakfast & drinking water"]]
];
const defaultExclusions = ["Transport to and from Materuni unless arranged separately","Personal purchases and expenses","Tips and gratuities"];
const experienceKeys: Record<string,string> = {"Materuni Camping":"Camping & Village Life","Materuni Waterfall & Chagga Culture":"Waterfall & Chagga Culture","Traditional Coffee Experience":"Traditional Coffee Experience","Traditional Chagga Cooking Class":"Traditional Chagga Cooking Class","Waterfall Hike & Cultural Day Trip":"Materuni Waterfall Hike & Cultural Day Trip","Overnight Camping":"Camping & Village Life","Ultimate":"The Ultimate Kilimanjaro Foothills & Materuni Experience"};
const base=`${supabaseUrl}/storage/v1/object/public/materuni-images/`;
---
<SiteLayout title="Materuni Experiences & Prices | Materuni Hosts" description="Explore Materuni waterfall hikes, Chagga coffee experiences, cooking classes and village stays. Compare experiences and prices, then check availability with local hosts.">
<section class="page-hero"><span class="eyebrow" data-i18n="home_section_eyebrow">THE SIGNATURE MATERUNI STAY</span><h1 data-i18n="experiences_hero_title">Start with Materuni Camping. Make the village part of your story.</h1><p data-i18n="experiences_hero_intro">Our main experience is a community-based overnight stay in Materuni Village. Waterfall walks, Chagga coffee, cooking and cultural activities bring depth to the stay; shorter experiences can also be arranged.</p></section>
<section class="section"><div class="cards">{items.map((e)=><article class="experience-card" id={e[0] === "Materuni Camping" ? "camping" : undefined} data-experience-key={experienceKeys[e[0]]}><img src={base+e[3]} alt={e[0]} loading="lazy" decoding="async" width="640" height="420"><div class="card-body"><div class="card-top"><span class="pill">{e[2]}</span><span class="price" data-catalog-price>${e[1]}<small data-i18n="exp_per_person">PER PERSON</small></span></div><h3 data-catalog-name>{e[0]}</h3><p data-catalog-description>{e[4]}</p><strong style="font-size:12px;color:#173b2d" data-i18n="exp_experience_label">THE EXPERIENCE</strong><ul>{e[5].map(x=><li>{x}</li>)}</ul><strong style="font-size:12px;color:#173b2d" data-i18n="exp_included_label">WHAT YOUR EXPERIENCE INCLUDES</strong><ul>{e[6].map(x=><li>{x}</li>)}</ul><strong data-exclusions-title="true" style="display:block;margin-top:1rem;font-size:12px;color:#173b2d" data-i18n="exp_excluded_label">NOT INCLUDED</strong><ul data-exclusions-list="true">{defaultExclusions.map(x=><li>{x}</li>)}</ul><a class="button" href={"/booking?experience="+encodeURIComponent(experienceKeys[e[0]])} data-i18n="exp_check_availability">Check availability</a></div></article>)}</div><p class="notice" style="margin-top:28px" data-i18n="exp_notice">All prices are per person. The inclusions listed under each experience describe what is covered in that package. Transport from Moshi is not included in the displayed prices unless agreed separately. Please share your pickup point, group size, dietary requirements or accessibility needs with us before your visit so we can discuss the arrangements. A booking request is not a confirmed reservation; your host will confirm the details with you.</p></section>
<style>
.catalog-product-tagline{display:block;margin:.35rem 0 .15rem;color:#a27b3e;font-size:.75rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}
.catalog-best-for{font-size:.72rem!important;font-weight:700;color:#1a3322!important;letter-spacing:.03em}
.catalog-detail-heading{display:block;margin:.85rem 0 .2rem;color:#1a3322;font-size:.68rem;letter-spacing:.12em}
.shared-standard{margin:32px 0 0;padding:24px 28px;background:#f4efe6;border:1px solid #e6dfd3;border-radius:16px}
.shared-standard h2{margin:0 0 14px;color:#1a3322;font:600 clamp(22px,3vw,30px) "Cormorant Garamond",serif}
.shared-standard ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 24px;margin:0;padding-left:18px;color:#425347;font-size:13px;line-height:1.7}
@media(max-width:620px){.shared-standard{padding:20px}.shared-standard ul{grid-template-columns:1fr}}
</style>
<script>
// @ts-nocheck
import { supabaseUrl as catalogApi, publishableKey as catalogKey } from "../lib/supabase-public";
const catalogHeaders = { apikey: catalogKey, Authorization: "Bearer " + catalogKey };
const cardsRoot = document.querySelector(".cards");
const safeText = (node, value) => { if (node && typeof value === "string") node.textContent = value; };
function appendProductMeta(body, tour) {
  const meta = document.createElement("div"); meta.dataset.productMeta = "true";
  if (tour.product_tagline) { const tagline = document.createElement("span"); tagline.className = "catalog-product-tagline"; tagline.textContent = tour.product_tagline; meta.append(tagline); }
  if (tour.best_for) { const best = document.createElement("p"); best.className = "catalog-best-for"; const label = document.createElement("span"); label.dataset.i18n = "exp_best_for"; label.textContent = "BEST FOR"; best.append(label, document.createTextNode(" · " + tour.best_for)); meta.append(best); }
  const addList = (labelText, values) => {
    if (!Array.isArray(values) || !values.length) return;
    const label = document.createElement("strong"); label.className = "catalog-detail-heading"; label.textContent = labelText; meta.append(label);
    const list = document.createElement("ul");
    values.forEach(value => { if (typeof value !== "string" || !value.trim()) return; const li = document.createElement("li"); li.textContent = value; list.append(li); });
    meta.append(list);
  };
  addList("SIGNATURE MOMENTS", Array.isArray(tour.signature_moments) ? tour.signature_moments.slice(0,3) : []); meta.querySelectorAll(".catalog-detail-heading").forEach(label => { if (label.textContent === "SIGNATURE MOMENTS") label.dataset.i18n = "exp_signature_moments"; if (label.textContent === "YOUR UNIQUE EXPERIENCE") label.dataset.i18n = "exp_unique_experience"; });
  addList("WHAT YOUR EXPERIENCE INCLUDES", tour.inclusions);
  addList("YOUR UNIQUE EXPERIENCE", tour.unique_amenities);
  if (meta.childNodes.length) body.append(meta);
}
function makeCatalogCard(tour) {
  const card = document.createElement("article");
  card.className = "experience-card";
  if (tour.experience_key === "Camping & Village Life") card.id = "camping";
  card.dataset.experienceKey = tour.experience_key;
  if (tour.image_url && /^https:\/\//i.test(tour.image_url)) {
    const image = document.createElement("img");
    image.src = tour.image_url; image.alt = tour.display_name || "Materuni experience";
    image.loading = "lazy"; image.decoding = "async"; image.width = 640; image.height = 420;
    card.append(image);
  }
  const body = document.createElement("div"); body.className = "card-body";
  const top = document.createElement("div"); top.className = "card-top";
  const duration = document.createElement("span"); duration.className = "pill";
  duration.textContent = tour.duration_label || "Local experience";
  const price = document.createElement("span"); price.className = "price";
  price.textContent = "$" + Number(tour.price_usd).toFixed(0) + " ";
  const per = document.createElement("small"); per.dataset.i18n = "exp_per_person"; per.textContent = "PER PERSON"; price.append(per);
  top.append(duration, price);
  const heading = document.createElement("h3"); heading.textContent = tour.display_name || "Materuni experience";
  const description = document.createElement("p"); description.textContent = tour.full_description || tour.short_description || "Ask our local hosts for details about this experience.";
  body.append(top, heading, description);
  appendProductMeta(body, tour);
  if (Array.isArray(tour.exclusions) && tour.exclusions.length) {
    const label = document.createElement("strong"); label.style.cssText = "display:block;margin-top:1rem;font-size:12px;color:#173b2d"; label.textContent = "NOT INCLUDED"; label.dataset.i18n = "exp_excluded_label";
    const list = document.createElement("ul"); tour.exclusions.forEach(value => { const li = document.createElement("li"); li.textContent = value; list.append(li); }); body.append(label, list);
  }
  const link = document.createElement("a"); link.className = "button"; link.textContent = "Check availability"; link.dataset.i18n = "exp_check_availability";
  link.href = "/booking?experience=" + encodeURIComponent(tour.experience_key);
  body.append(link); card.append(body); return card;
}
async function syncPublicCatalogue() {
  try {
    const query = new URLSearchParams({
      select: "experience_key,display_name,price_usd,is_active,short_description,full_description,image_url,duration_label,inclusions,exclusions,product_tagline,best_for,signature_moments,unique_amenities,sort_order",
      order: "sort_order.asc"
    });
    const response = await fetch(catalogApi + "/rest/v1/experience_catalog?" + query, {
      headers: catalogHeaders, cache: "no-store"
    });
    if (!response.ok) throw new Error("Catalogue unavailable");
    const catalogue = await response.json();
    const active = catalogue.filter(item => item.is_active).sort((a,b) => Number(b.experience_key === "Camping & Village Life") - Number(a.experience_key === "Camping & Village Life") || Number(a.sort_order || 0) - Number(b.sort_order || 0));
    const byKey = new Map(active.map(item => [item.experience_key, item]));
    cardsRoot.querySelectorAll("[data-experience-key]").forEach(card => {
      const item = byKey.get(card.dataset.experienceKey);
      if (!item) { card.remove(); return; }
      const price = card.querySelector("[data-catalog-price]");
      if (price) {
        price.textContent = "$" + Number(item.price_usd).toFixed(0);
        const suffix = document.createElement("small"); suffix.textContent = "PER PERSON"; price.append(suffix);
      }
      safeText(card.querySelector("[data-catalog-name]"), item.display_name);
      safeText(card.querySelector("[data-catalog-description]"), item.full_description || item.short_description);
      const image = card.querySelector("img");
      if (image && item.image_url && /^https:\/\//i.test(item.image_url)) image.src = item.image_url;
      const pill = card.querySelector(".pill");
      if (pill && item.duration_label) pill.textContent = item.duration_label;
      const body = card.querySelector(".card-body");
      if (body) {
        body.querySelectorAll("[data-product-meta]").forEach(node => node.remove());
        const lists = body.querySelectorAll(":scope > ul");
        if (lists[0]) lists[0].remove();
        if (lists[1]) lists[1].remove();
        appendProductMeta(body, item);
      }
      let exTitle = card.querySelector("[data-exclusions-title]");
      let exList = card.querySelector("[data-exclusions-list]");
      if (!exTitle) { exTitle = document.createElement("strong"); exTitle.dataset.exclusionsTitle = "true"; exTitle.style.cssText = "display:block;margin-top:1rem;font-size:12px;color:#173b2d"; exTitle.textContent = "NOT INCLUDED"; }
      if (!exList) { exList = document.createElement("ul"); exList.dataset.exclusionsList = "true"; }
      if (Array.isArray(item.exclusions) && item.exclusions.length) {
        exList.replaceChildren(...item.exclusions.map(value => { const li = document.createElement("li"); li.textContent = value; return li; }));
        const bookingLink = card.querySelector('a[href^="/booking"]');
        if (bookingLink) { const body = card.querySelector(".card-body"); body.insertBefore(exTitle, bookingLink); body.insertBefore(exList, bookingLink); }
      } else { exTitle.remove(); exList.remove(); }
      const bookingLink = card.querySelector('a[href^="/booking"]');
      if (bookingLink) bookingLink.href = "/booking?experience=" + encodeURIComponent(item.experience_key);
    });
    active.filter(item => !cardsRoot.querySelector('[data-experience-key="' + CSS.escape(item.experience_key) + '"]'))
      .forEach(item => cardsRoot.append(makeCatalogCard(item)));
    try {
      const sharedResponse = await fetch(catalogApi + "/rest/v1/site_settings?select=setting_value&setting_key=eq.experience_shared_inclusions", { headers: catalogHeaders, cache: "no-store" });
      if (sharedResponse.ok) {
        const sharedRows = await sharedResponse.json();
        const raw = sharedRows?.[0]?.setting_value;
        const shared = typeof raw === "string" ? JSON.parse(raw) : raw;
        const old = document.querySelector("[data-shared-inclusions]");
        if (old) old.remove();
        if (Array.isArray(shared) && shared.length) {
          const panel = document.createElement("section"); panel.dataset.sharedInclusions = "true"; panel.className = "shared-standard";
          const heading = document.createElement("h2"); heading.dataset.i18n = "exp_shared_inclusions"; heading.textContent = "Included in every Materuni Hosts experience";
          const list = document.createElement("ul");
          shared.forEach(value => { if (typeof value !== "string" || !value.trim()) return; const li = document.createElement("li"); li.textContent = value; list.append(li); });
          panel.append(heading, list); cardsRoot.insertAdjacentElement("afterend", panel);
        }
      }
    } catch (sharedError) { console.warn("Shared inclusions unavailable.", sharedError); }
  } catch (error) {
    console.warn("Using the built-in experience catalogue because the live catalogue could not be loaded.", error);
  } finally {
    if (window.MateruniApplyPageTranslations) window.MateruniApplyPageTranslations(localStorage.getItem("materuni-language") || "en");
  }
}
syncPublicCatalogue();
</script>
</SiteLayout>