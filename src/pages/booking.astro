---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Check Availability & Book | Materuni Hosts">
<section class="page-hero"><span class="eyebrow">PLAN YOUR VISIT</span><h1>Check availability before you book.</h1><p>Choose your experience and preferred date. Available times are retrieved from our live Materuni Hosts calendar.</p></section>
<section class="booking-wrap"><div class="booking-panel"><form id="booking-form" class="form-grid">
<div class="field full"><label for="experience">Choose your experience *</label><select id="experience" required><option value="">Loading experiences…</option></select></div>
<div class="field"><label for="date">Preferred date *</label><input id="date" type="date" required></div><div class="field"><label for="slot">Available time *</label><select id="slot" required disabled><option value="">Choose a date first</option></select></div>
<div class="field"><label for="count">Number of guests *</label><input id="count" type="number" min="1" max="30" value="2" required></div><div class="field"><label for="name">Full name *</label><input id="name" autocomplete="name" required></div>
<div class="field"><label for="email">Email address *</label><input id="email" type="email" autocomplete="email" required></div><div class="field"><label for="phone">WhatsApp / phone *</label><input id="phone" type="tel" autocomplete="tel" required></div><div class="field"><label for="nationality">Nationality</label><input id="nationality"></div>
<div class="field"><label for="country">Country of residence</label><input id="country"></div><div class="field"><label for="language">Preferred language</label><select id="language"><option value="English">English</option><option value="Spanish">Español</option><option value="French">Français</option><option value="German">Deutsch</option></select></div>
<div class="field"><label for="contact">Preferred contact</label><select id="contact"><option value="WhatsApp">WhatsApp</option><option value="Email">Email</option></select></div><div class="field"><label for="pickup">Pickup point / transport</label><input id="pickup" placeholder="Moshi hotel, meeting point…"></div>
<div class="field full"><label for="notes">Special requests, dietary needs or accessibility notes</label><textarea id="notes"></textarea></div>
<div class="field full"><p class="notice">Submitting this form sends a booking request, not an online payment. Our team will contact you to confirm arrangements and provide payment instructions. Your booking is not confirmed until you receive confirmation from Materuni Hosts.</p><button class="button" id="submit" type="submit">Send booking request</button><p id="feedback" aria-live="polite" class="muted"></p></div>
</form></div></section>
<script>
// @ts-nocheck

const url="https://sskmzswoeljxwojcszta.supabase.co";
const key="sb_publishable_G9ru4P_yKzievqiXjXEEbQ_p28cB_NZ";
const headers={"apikey":key,"Authorization":"Bearer "+key,"Content-Type":"application/json"};
const $=id=>document.getElementById(id);
const today=new Date(); $("date").min=new Date(today.getTime()-today.getTimezoneOffset()*60000).toISOString().slice(0,10);\n$("date").max=new Date(today.getTime()+365*86400000-today.getTimezoneOffset()*60000).toISOString().slice(0,10);
const params=new URLSearchParams(location.search);
async function loadExperienceCatalog(){
 const select=$("experience");
 try {
  const q=new URLSearchParams({select:"experience_key,display_name,price_usd",is_active:"eq.true",order:"sort_order.asc"});
  const response=await fetch(url+"/rest/v1/experience_catalog?"+q,{headers});
  if(!response.ok) throw new Error("Could not load experiences");
  const catalog=await response.json();
  select.innerHTML='<option value="">Select an experience</option>';
  catalog.forEach(item=>{
   const option=document.createElement("option");
   option.value=item.experience_key;
   option.textContent=item.display_name+" · $"+Number(item.price_usd).toFixed(0)+" per person";
   select.append(option);
  });
  const wanted=(params.get("experience")||"").trim().toLowerCase();
  const match=[...select.options].find(o=>o.text.split(" · $")[0].trim().toLowerCase()===wanted||o.value.trim().toLowerCase()===wanted);
  if(match) select.value=match.value;
 } catch(error) {
  select.innerHTML='<option value="">Experiences temporarily unavailable</option>';
  $("feedback").textContent=error.message;
 }
}
loadExperienceCatalog();
$("date").addEventListener("change",async()=>{
 const exp=$("experience").value, date=$("date").value, sel=$("slot");sel.innerHTML='<option value="">Loading availability…</option>';sel.disabled=true;
 if(!exp||!date){sel.innerHTML='<option value="">Choose experience and date</option>';return}
 try{const q=new URLSearchParams({select:"id,experience,slot_date,start_time,end_time,capacity,booked_count",experience:"eq."+exp,slot_date:"eq."+date,is_active:"eq.true",order:"start_time.asc"});const r=await fetch(url+"/rest/v1/availability_slots?"+q,{headers});if(!r.ok)throw new Error("Availability could not be loaded");const rows=await r.json();const open=rows.filter(s=>Number(s.capacity)>Number(s.booked_count));sel.innerHTML=open.length?'<option value="">Select available time</option>':'<option value="">No available slots on this date</option>';open.forEach(s=>{const o=document.createElement("option");o.value=s.id;o.textContent=s.start_time.slice(0,5)+" – "+s.end_time.slice(0,5)+" · "+(s.capacity-s.booked_count)+" places";sel.append(o)});sel.disabled=!open.length}catch(e){sel.innerHTML='<option value="">Please contact us to check availability</option>';sel.disabled=true;$("feedback").textContent=e.message}
});
$("experience").addEventListener("change",()=>{if($("date").value)$("date").dispatchEvent(new Event("change"))});
$("booking-form").addEventListener("submit",async e=>{
 e.preventDefault();const btn=$("submit"),fb=$("feedback");btn.disabled=true;btn.textContent="Sending request…";fb.textContent="";
 const body={p_experience:$("experience").value,p_slot_id:$("slot").value,p_guest_count:Number($("count").value),p_guest:$("name").value.trim(),p_email:$("email").value.trim(),p_phone:$("phone").value.trim(),p_nationality:$("nationality").value,p_country_of_residence:$("country").value,p_preferred_contact:$("contact").value,p_pickup:$("pickup").value,p_language:$("language").value,p_notes:$("notes").value,p_booking_type:"tour"};
 try{if(!body.p_slot_id)throw new Error("Please select an available time slot.");const r=await fetch(url+"/rest/v1/rpc/submit_booking",{method:"POST",headers,body:JSON.stringify(body)});const data=await r.json();if(!r.ok)throw new Error(data.message||data.details||"Booking request could not be sent. Please contact us on WhatsApp.");fb.textContent="Your request has been received. We will contact you to confirm the details. Thank you!";$("booking-form").reset();$("slot").disabled=true;$("slot").innerHTML='<option value="">Choose a date first</option>'}catch(err){fb.textContent=err.message}finally{btn.disabled=false;btn.textContent="Send booking request"}
});
</script>
</SiteLayout>