---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Check Availability & Book | Materuni Hosts" description="Check live availability for Materuni waterfall, Chagga coffee, cooking and village experiences. Send a booking request directly to your local hosts.">
<section class="page-hero"><span class="eyebrow">PLAN YOUR VISIT</span><h1 data-i18n="booking_page_title">Check availability before you book.</h1><p data-i18n="booking_page_intro">Choose your experience and preferred date. Available times are retrieved from our live Materuni Hosts calendar.</p></section>
<section class="booking-wrap"><div class="booking-panel"><form id="booking-form" class="form-grid">
<div class="field full"><label for="experience" data-i18n="booking_experience_label">Choose your experience *</label><select id="experience" required><option value="">Loading experiences…</option></select></div>
<div class="field"><label for="date" data-i18n="booking_date_label">Preferred date *</label><input id="date" type="date" required></div><div class="field"><label for="slot" data-i18n="booking_slot_label">Available time *</label><select id="slot" required disabled><option value="">Choose an experience and date first</option></select><small id="availability-status" class="availability-status" role="status" aria-live="polite">Choose an experience and date to see live spaces.</small><button class="availability-refresh" id="refresh-availability" type="button" disabled data-i18n="booking_refresh">Refresh available times</button></div>
<div class="field"><label for="count" data-i18n="booking_guests_label">Number of guests *</label><input id="count" type="number" min="1" max="30" value="2" required></div><div class="field"><label for="name" data-i18n="booking_name_label">Full name *</label><input id="name" autocomplete="name" required></div>
<div class="field"><label for="email" data-i18n="booking_email_label">Email address</label><input id="email" type="email" autocomplete="email"></div><div class="field"><label for="phone" data-i18n="booking_phone_label">WhatsApp / phone</label><input id="phone" type="tel" autocomplete="tel"><small class="muted" data-i18n="booking_contact_hint">Provide at least one contact method: email or phone.</small></div><div class="field"><label for="nationality" data-i18n="booking_nationality_label">Nationality</label><input id="nationality"></div>
<div class="field"><label for="country" data-i18n="booking_country_label">Country of residence</label><input id="country"></div><div class="field"><label for="language" data-i18n="booking_language_label">Preferred language</label><select id="language"><option value="English">English</option><option value="Spanish">Español</option><option value="French">Français</option><option value="German">Deutsch</option></select></div>
<div class="field"><label for="contact" data-i18n="booking_contact_label">Preferred contact</label><select id="contact"><option value="WhatsApp">WhatsApp</option><option value="Email">Email</option></select></div><div class="field"><label for="pickup" data-i18n="booking_pickup_label">Pickup point / transport</label><input id="pickup" placeholder="Moshi hotel, meeting point…" data-i18n-placeholder="booking_pickup_placeholder"></div>
<div class="field full"><label for="notes" data-i18n="booking_notes_label">Special requests, dietary needs or accessibility notes</label><textarea id="notes" data-i18n-placeholder="booking_notes_placeholder"></textarea></div>
<div class="field full"><p class="notice" data-i18n="booking_notice">Submitting this form sends a booking request, not an online payment. Our team will contact you to confirm arrangements and provide payment instructions. Your booking is not confirmed until you receive confirmation from Materuni Hosts.</p><button class="button" id="submit" type="submit" data-i18n="booking_submit_label">Send booking request</button><p id="feedback" aria-live="polite" class="muted"></p></div>
</form></div></section>
<script>
// @ts-nocheck

const url="https://sskmzswoeljxwojcszta.supabase.co";
const key="sb_publishable_G9ru4P_yKzievqiXjXEEbQ_p28cB_NZ";
const headers={"apikey":key,"Authorization":"Bearer "+key,"Content-Type":"application/json"};
const $=id=>document.getElementById(id);
const tanzaniaToday=()=>new Intl.DateTimeFormat("en-CA",{timeZone:"Africa/Dar_es_Salaam",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date());
const addDays=(dateString,days)=>{const d=new Date(dateString+"T12:00:00+03:00");d.setDate(d.getDate()+days);return new Intl.DateTimeFormat("en-CA",{timeZone:"Africa/Dar_es_Salaam",year:"numeric",month:"2-digit",day:"2-digit"}).format(d)};
$("date").min=tanzaniaToday();
$("date").max=addDays(tanzaniaToday(),365);
// Start on the next local day so guests do not land on today's already-passed slots.
$("date").value=addDays(tanzaniaToday(),1);
const params=new URLSearchParams(location.search);
let availabilityRequest=0;
function setAvailabilityStatus(message,state="info"){
 const status=$("availability-status");
 status.textContent=message;
 status.dataset.state=state;
}
async function loadExperienceCatalog(){
 const select=$("experience");
 try {
  const q=new URLSearchParams({select:"experience_key,display_name,price_usd",is_active:"eq.true",order:"sort_order.asc"});
  const response=await fetch(url+"/rest/v1/experience_catalog?"+q,{headers,cache:"no-store"});
  if(!response.ok) throw new Error("Experiences could not be loaded. Please refresh the page.");
  const catalog=await response.json();
  select.innerHTML='<option value="">Select an experience</option>';
  catalog.forEach(item=>{
   const option=document.createElement("option");
   option.value=item.experience_key;
   option.textContent=item.display_name+" · $"+Number(item.price_usd).toFixed(0)+" per person";
   select.append(option);
  });
  const wanted=(params.get("experience")||"").trim().toLowerCase();
  const match=[...select.options].find(o=>o.text.split(" · $")[0].trim().toLowerCase()===wanted||o.value.trim().toLowerCase()===wanted);
  if(match) select.value=match.value;
  if(select.value && $("date").value) await refreshAvailability();
 } catch(error) {
  select.innerHTML='<option value="">Experiences temporarily unavailable</option>';
  $("feedback").textContent=error.message;
 }
}
loadExperienceCatalog();

function clearSelectedSlot(message="Choose an experience and date to see live spaces.") {
  $("slot").value="";
  $("slot").innerHTML='<option value="">Choose an available time</option>';
  $("slot").disabled=true;
  setAvailabilityStatus(message);
}
function showFeedback(message,state="error") {
  const fb=$("feedback");
  fb.textContent=message;
  fb.dataset.state=state;
  fb.className="booking-alert booking-alert-"+state;
  fb.setAttribute("role",state==="error"?"alert":"status");
  fb.setAttribute("aria-live",state==="error"?"assertive":"polite");
}
function safeError(payload,status) {
  return payload?.message || payload?.details || payload?.hint ||
    payload?.error_description || payload?.error ||
    (status===429 ? "Too many requests. Please wait a moment and try again." :
    status>=500 ? "Our booking service is temporarily unavailable. Please contact us on WhatsApp." :
    "We could not complete your request. Please check your details and try again.");
}

async function refreshAvailability(){
 const requestId=++availabilityRequest;
 const exp=$("experience").value;
 const date=$("date").value;
 const guests=Number($("count").value);
 const sel=$("slot");
 const refresh=$("refresh-availability");
 sel.innerHTML='<option value="">Checking live availability…</option>';
 sel.disabled=true;
 refresh.disabled=true;
 if(!exp||!date){
  clearSelectedSlot();
  return;
 }
 if(!Number.isInteger(guests)||guests<1||guests>30){
  clearSelectedSlot("Enter a whole number between 1 and 30 guests.");
  setAvailabilityStatus("Please enter a whole number between 1 and 30 guests.","error");
  return;
 }
 const localToday=tanzaniaToday();
 if(date<localToday){
  clearSelectedSlot("Choose a future date.");
  setAvailabilityStatus("That date has passed in Tanzania. Please choose today or a future date.","error");
  return;
 }
 setAvailabilityStatus("Checking available times for "+guests+" guest"+(guests===1?"":"s")+"…");
 refresh.disabled=false;
 try{
  const q=new URLSearchParams({
   select:"id,experience,slot_date,start_time,end_time,capacity,booked_count",
   experience:"eq."+exp,slot_date:"eq."+date,is_active:"eq.true",order:"start_time.asc"
  });
  const response=await fetch(url+"/rest/v1/availability_slots?"+q,{headers,cache:"no-store"});
  const rows=await response.json().catch(()=>null);
  if(!response.ok)throw new Error(safeError(rows,response.status));
  if(!Array.isArray(rows))throw new Error("The availability calendar returned an unexpected response.");
  if(requestId!==availabilityRequest)return;
  const localTime=new Intl.DateTimeFormat("en-GB",{timeZone:"Africa/Dar_es_Salaam",hour:"2-digit",minute:"2-digit",hourCycle:"h23"}).format(new Date());
  const open=rows.filter(slot=>{
   const remaining=Number(slot.capacity)-Number(slot.booked_count);
   const start=String(slot.start_time||"").slice(0,5);
   return Number.isFinite(remaining)&&remaining>=guests&&(date!==localToday||start>localTime);
  });
  sel.innerHTML='<option value="">'+(open.length?"Select an available time":"No suitable times available")+'</option>';
  open.forEach(slot=>{
   const option=document.createElement("option");
   option.value=slot.id;
   option.textContent=String(slot.start_time).slice(0,5)+" – "+String(slot.end_time).slice(0,5)+" · "+(Number(slot.capacity)-Number(slot.booked_count))+" spaces left";
   sel.append(option);
  });
  sel.disabled=!open.length;
  setAvailabilityStatus(open.length
   ? open.length+" available time"+(open.length===1?"":"s")+" found."
   : rows.length
    ? "No remaining slots fit your group, or today's times have passed. Try another date or a smaller group."
    : "No times have been added for this date yet. Choose another date or contact our local host.",
   open.length?"success":"warning");
 }catch(error){
  if(requestId!==availabilityRequest)return;
  sel.innerHTML='<option value="">Availability temporarily unavailable</option>';
  sel.disabled=true;
  setAvailabilityStatus(error.message||"Availability could not be checked. Please try again.","error");
 }
}
$("date").addEventListener("change",()=>{clearSelectedSlot("Date changed. Checking the new date…");refreshAvailability();});
$("experience").addEventListener("change",()=>{clearSelectedSlot("Experience changed. Checking available times…");refreshAvailability();});
$("count").addEventListener("change",()=>{clearSelectedSlot("Group size changed. Checking available spaces…");refreshAvailability();});
$("refresh-availability").addEventListener("click",refreshAvailability);

$("booking-form").addEventListener("submit",async e=>{
 e.preventDefault();
 const btn=$("submit");
 const fb=$("feedback");
 const guestEmail=$("email").value.trim();
 const guestPhone=$("phone").value.trim();
 const guestName=$("name").value.trim();
 const guestCount=Number($("count").value);
 const experience=$("experience").value;
 const date=$("date").value;
 const slotId=$("slot").value;

 if(!experience){showFeedback("Please choose an experience.");return;}
 if(!date||date<tanzaniaToday()){showFeedback("Please choose a valid future date.");return;}
 if(!slotId){showFeedback("Please select an available time slot.");return;}
 if(!Number.isInteger(guestCount)||guestCount<1||guestCount>30){showFeedback("Guest count must be a whole number between 1 and 30.");return;}
 if(guestName.length<2){showFeedback("Please enter your full name.");return;}
 if(!guestEmail&&!guestPhone){showFeedback("Please provide an email address or WhatsApp / phone number.");return;}
 if(guestEmail&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(guestEmail)){showFeedback("Please enter a valid email address.");return;}
 if(guestPhone&&!/^\+?[0-9\s()-]{7,20}$/.test(guestPhone)){showFeedback("Please enter a valid phone number.");return;}

 btn.disabled=true;
 btn.textContent="Sending request…";
 fb.textContent="";
 const body={
  p_experience:experience,p_slot_id:slotId,p_guest_count:guestCount,p_guest:guestName,
  p_email:guestEmail||null,p_phone:guestPhone||null,
  p_nationality:$("nationality").value.trim()||null,
  p_country_of_residence:$("country").value.trim()||null,
  p_preferred_contact:guestEmail&&!guestPhone?"Email":(!guestEmail&&guestPhone?"WhatsApp":$("contact").value),
  p_pickup:$("pickup").value.trim()||null,p_language:$("language").value,
  p_notes:$("notes").value.trim()||null,p_booking_type:"tour"
 };
 try{
  const response=await fetch(url+"/rest/v1/rpc/submit_booking",{
   method:"POST",headers,body:JSON.stringify(body),cache:"no-store"
  });
  const payload=await response.json().catch(()=>null);
  if(!response.ok)throw new Error(safeError(payload,response.status));
  const created=Array.isArray(payload)?payload[0]:payload;
  if(!created?.booking_id)throw new Error("The booking response could not be verified. Please contact our host before submitting again.");
  const reference=created.booking_reference||created.booking_id;
  let notice="";
  try{
   const notificationResponse=await fetch(url+"/functions/v1/booking-notifications",{
    method:"POST",headers,body:JSON.stringify({booking_id:created.booking_id})
   });
   const notificationPayload=await notificationResponse.json().catch(()=>null);
   const deliveryStates=Object.values(notificationPayload?.notifications||{});
   const hasDeliveryFailure=deliveryStates.some(state=>["failed","not_configured","no_guest_email"].includes(state));
   const hasDeliverySuccess=deliveryStates.some(state=>["sent","already_processed"].includes(state));
   if(!notificationResponse.ok||!notificationPayload?.success||(!hasDeliverySuccess&&hasDeliveryFailure)||hasDeliveryFailure){
    notice=" Automatic email/WhatsApp delivery is not fully confirmed, but your booking request is safely saved. Our host can verify it using your reference.";
   }
  }catch(notificationError){
   console.warn("Booking saved; notification delivery could not be confirmed.",notificationError);
   notice=" Your request is saved, but automatic notifications could not be confirmed. Our host can verify it using your reference.";
  }
  showFeedback("Booking request received — reference: "+reference+". Your request is awaiting host confirmation; it is not yet a confirmed reservation and no payment has been taken."+notice,notice?"warning":"success");
  $("booking-form").reset();
  $("date").min=tanzaniaToday();
  $("date").value=addDays(tanzaniaToday(),1);
  $("count").value="2";
  clearSelectedSlot("Your request was received. Choose another experience or date to make a new request.");
  await refreshAvailability();
 }catch(error){
  const message=error.message||"We could not send your booking. Please try again or contact us on WhatsApp.";
  const isCapacityConflict=/not enough spaces|no longer available|slot.*not found|already passed|inactive/i.test(message);
  showFeedback(isCapacityConflict?message+" Please refresh availability and choose another time.":message,"error");
  // Refresh in case another guest took the selected spaces while this form was open.
  refreshAvailability();
 }finally{
  btn.disabled=false;
  btn.textContent="Send booking request";
 }
});
</script>
</SiteLayout>