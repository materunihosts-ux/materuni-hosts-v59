---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Check Availability & Book | Materuni Hosts" description="Check live availability for Materuni waterfall, Chagga coffee, cooking and village experiences. Send a booking request directly to your local hosts.">
<section class="page-hero"><span class="eyebrow">PLAN YOUR VISIT</span><h1>Check availability before you book.</h1><p>Choose your experience and preferred date. Available times are retrieved from our live Materuni Hosts calendar.</p></section>
<section class="booking-wrap"><div class="booking-panel"><form id="booking-form" class="form-grid">
<div class="field full"><label for="experience">Choose your experience *</label><select id="experience" required><option value="">Loading experiences…</option></select></div>
<div class="field"><label for="date">Preferred date *</label><input id="date" type="date" required></div><div class="field"><label for="slot">Available time *</label><select id="slot" required disabled><option value="">Choose an experience and date first</option></select><small id="availability-status" class="availability-status" role="status" aria-live="polite">Choose an experience and date to see live spaces.</small><button class="availability-refresh" id="refresh-availability" type="button" disabled>Refresh available times</button></div>
<div class="field"><label for="count">Number of guests *</label><input id="count" type="number" min="1" max="30" value="2" required></div><div class="field"><label for="name">Full name *</label><input id="name" autocomplete="name" required></div>
<div class="field"><label for="email">Email address</label><input id="email" type="email" autocomplete="email"></div><div class="field"><label for="phone">WhatsApp / phone</label><input id="phone" type="tel" autocomplete="tel"><small class="muted">Provide at least one contact method: email or phone.</small></div><div class="field"><label for="nationality">Nationality</label><input id="nationality"></div>
<div class="field"><label for="country">Country of residence</label><input id="country"></div><div class="field"><label for="language">Preferred language</label><select id="language"><option value="English">English</option><option value="Spanish">Español</option><option value="French">Français</option><option value="German">Deutsch</option></select></div>
<div class="field"><label for="contact">Preferred contact</label><select id="contact"><option value="WhatsApp">WhatsApp</option><option value="Email">Email</option></select></div><div class="field"><label for="pickup">Pickup point / transport</label><input id="pickup" placeholder="Moshi hotel, meeting point…"></div>
<div class="field full"><label for="notes">Special requests, dietary needs or accessibility notes</label><textarea id="notes"></textarea></div>
<div class="field full"><p class="notice">Submitting this form sends a booking request, not an online payment. Our team will contact you to confirm arrangements and provide payment instructions. Your booking is not confirmed until you receive confirmation from Materuni Hosts.</p><button class="button" id="submit" type="submit">Send booking request</button><p id="feedback" aria-live="polite" class="muted"></p></div>
</form></div></section>
<script>
// @ts-nocheck

const url="https://sskmzswoeljxwojcszta.supabase.co";
const key="sb_publishable_G9ru4P_yKzievqiXjXEEbQ_p28cB_NZ";
const headers={"apikey":key,"Authorization":"Bearer "+key,"Content-Type":"application/json"};
const $=id=>document.getElementById(id);
const tanzaniaToday=()=>new Intl.DateTimeFormat("en-CA",{timeZone:"Africa/Dar_es_Salaam",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date());
const addDays=(dateString,days)=>{const d=new Date(dateString+"T12:00:00+03:00");d.setDate(d.getDate()+days);return new Intl.DateTimeFormat("en-CA",{timeZone:"Africa/Dar_es_Salaam",year:"numeric",month:"2-digit",day:"2-digit"}).format(d)};
$("date").min=tanzaniaToday();
$("date").max=addDays(tanzaniaToday(),365);
const params=new URLSearchParams(location.search);
let availabilityRequest=0;
function setAvailabilityStatus(message,state="info"){
 const status=$("availability-status");
 status.textContent=message;
 status.dataset.state=state;
}
async function loadExperienceCatalog(){
 const select=$("experience");
 try {
  const q=new URLSearchParams({select:"experience_key,display_name,price_usd",is_active:"eq.true",order:"sort_order.asc"});
  const response=await fetch(url+"/rest/v1/experience_catalog?"+q,{headers,cache:"no-store"});
  if(!response.ok) throw new Error("Experiences could not be loaded. Please refresh the page.");
  const catalog=await response.json();
  select.innerHTML='<option value="">Select an experience</option>';
  catalog.forEach(item=>{
   const option=document.createElement("option");
   option.value=item.experience_key;
   option.textContent=item.display_name+" · $"+Number(item.price_usd).toFixed(0)+" per person";
   select.append(option);
  });
  const wanted=(params.get("experience")||"").trim().toLowerCase();
  const match=[...select.options].find(o=>o.text.split(" · $")[0].trim().toLowerCase()===wanted||o.value.trim().toLowerCase()===wanted);
  if(match) select.value=match.value;
 } catch(error) {
  select.innerHTML='<option value="">Experiences temporarily unavailable</option>';
  $("feedback").textContent=error.message;
 }
}
async function refreshAvailability(){
 const requestId=++availabilityRequest;
 const exp=$("experience").value;
 const date=$("date").value;
 const countInput=$("count");
 const sel=$("slot");
 const refresh=$("refresh-availability");
 sel.innerHTML='<option value="">Checking live availability…</option>';
 sel.disabled=true;
 refresh.disabled=true;
 if(!exp||!date){
  sel.innerHTML='<option value="">Choose an experience and date first</option>';
  setAvailabilityStatus("Choose an experience and date to see live spaces.");
  return;
 }
 const guests=Number(countInput.value);
 if(!Number.isInteger(guests)||guests<1||guests>30){
  sel.innerHTML='<option value="">Enter 1–30 guests</option>';
  setAvailabilityStatus("Please enter a whole number between 1 and 30 guests.","error");
  return;
 }
 const localToday=tanzaniaToday();
 if(date<localToday){
  sel.innerHTML='<option value="">Choose a future date</option>';
  setAvailabilityStatus("That date has passed in Tanzania. Please choose today or a future date.","error");
  return;
 }
 setAvailabilityStatus("Checking available times for "+guests+" guest"+(guests===1?"":"s")+"…");
 refresh.disabled=false;
 try{
  const q=new URLSearchParams({select:"id,experience,slot_date,start_time,end_time,capacity,booked_count",experience:"eq."+exp,slot_date:"eq."+date,is_active:"eq.true",order:"start_time.asc"});
  const response=await fetch(url+"/rest/v1/availability_slots?"+q,{headers,cache:"no-store"});
  if(!response.ok)throw new Error("The calendar could not be reached. Please try again or contact us on WhatsApp.");
  const rows=await response.json();
  if(requestId!==availabilityRequest)return;
  const localTime=new Intl.DateTimeFormat("en-GB",{timeZone:"Africa/Dar_es_Salaam",hour:"2-digit",minute:"2-digit",hourCycle:"h23"}).format(new Date());
  const open=rows.filter(slot=>{
   const remaining=Number(slot.capacity)-Number(slot.booked_count);
   const start=String(slot.start_time||"").slice(0,5);
   const notPassed=date!==localToday||start>localTime;
   return Number.isFinite(remaining)&&remaining>=guests&&notPassed;
  });
  sel.innerHTML='<option value="">'+(open.length?"Select an available time":"No suitable times available")+'</option>';
  open.forEach(slot=>{
   const option=document.createElement("option");
   option.value=slot.id;
   option.textContent=String(slot.start_time).slice(0,5)+" – "+String(slot.end_time).slice(0,5)+" · "+(Number(slot.capacity)-Number(slot.booked_count))+" spaces left";
   sel.append(option);
  });
  sel.disabled=!open.length;
  if(open.length){
   setAvailabilityStatus(open.length+" available time"+(open.length===1?"":"s")+" found. Times update when your group size changes.","success");
  }else if(rows.length){
   setAvailabilityStatus("No remaining slots fit your group at this date, or today's times have passed. Try another date or a smaller group.","warning");
  }else{
   setAvailabilityStatus("No times have been added for this date yet. Choose another date or contact our local host.","warning");
  }
 }catch(error){
  if(requestId!==availabilityRequest)return;
  sel.innerHTML='<option value="">Availability temporarily unavailable</option>';
  sel.disabled=true;
  setAvailabilityStatus(error.message,"error");
 }
}
loadExperienceCatalog();
$("date").addEventListener("change",refreshAvailability);
$("experience").addEventListener("change",refreshAvailability);
$("count").addEventListener("change",refreshAvailability);
$("refresh-availability").addEventListener("click",refreshAvailability);
$("booking-form").addEventListener("submit",async e=>{
 e.preventDefault();const btn=$("submit"),fb=$("feedback");if(! $("email").value.trim() && ! $("phone").value.trim()){fb.textContent="Please provide an email address or WhatsApp / phone number so our host can contact you.";return;}btn.disabled=true;btn.textContent="Sending request…";fb.textContent="";
 const guestEmail=$("email").value.trim(),guestPhone=$("phone").value.trim();if(!guestEmail&&guestPhone)$("contact").value="WhatsApp";if(guestEmail&&!guestPhone)$("contact").value="Email";const body={p_experience:$("experience").value,p_slot_id:$("slot").value,p_guest_count:Number($("count").value),p_guest:$("name").value.trim(),p_email:guestEmail,p_phone:guestPhone,p_nationality:$("nationality").value,p_country_of_residence:$("country").value,p_preferred_contact:$("contact").value,p_pickup:$("pickup").value,p_language:$("language").value,p_notes:$("notes").value,p_booking_type:"tour"};
 try{if(!body.p_slot_id)throw new Error("Please select an available time slot.");const r=await fetch(url+"/rest/v1/rpc/submit_booking",{method:"POST",headers,body:JSON.stringify(body)});const data=await r.json();if(!r.ok)throw new Error(data.message||data.details||"Booking request could not be sent. Please contact us on WhatsApp.");const created=Array.isArray(data)?data[0]:data;const bookingReference=created?.booking_reference||"received";let notificationNotice="";try{const notificationResponse=await fetch(url+"/functions/v1/booking-notifications",{method:"POST",headers,body:JSON.stringify({booking_id:created?.booking_id})});const notificationData=await notificationResponse.json().catch(()=>({}));const outcomes=Object.values(notificationData.notifications||{});if(!notificationResponse.ok||!notificationData.success||outcomes.some(status=>status==="failed"||status==="not_configured")){notificationNotice=" Automatic email/WhatsApp delivery could not be fully confirmed, so please also contact our local host directly if you do not hear from us."}}catch(notificationError){console.warn("Booking saved; notification delivery could not be confirmed.",notificationError);notificationNotice=" Automatic email/WhatsApp delivery could not be confirmed, so please also contact our local host directly if you do not hear from us."}fb.textContent="Your request has been received. Reference: "+bookingReference+". A local host will contact you to confirm availability and arrangements. No payment has been taken."+notificationNotice; $("booking-form").reset();$("slot").disabled=true;$("slot").innerHTML='<option value="">Choose a date first</option>'}catch(err){fb.textContent=err.message}finally{btn.disabled=false;btn.textContent="Send booking request"}
});
</script>
</SiteLayout>