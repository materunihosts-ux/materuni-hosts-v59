---
import SiteLayout from "../layouts/SiteLayout.astro";
import { supabaseUrl } from "../lib/supabase-public";
const bookingPreview = `${supabaseUrl}/storage/v1/object/public/materuni-images/camping_image/1791601872981-zmji0mykwhd.jpg`;
---
<SiteLayout title="Materuni Tour Booking & Availability | Materuni Hosts" description="Check dates for Materuni Waterfall tours, Chagga coffee, cooking classes and camping near Moshi, Tanzania. Send a booking request to local hosts." preloadImage={bookingPreview}>
<section class="page-hero"><span class="eyebrow">PLAN YOUR VISIT</span><h1 data-i18n="booking_page_title">Check availability before you book.</h1><p data-i18n="booking_page_intro">Choose your experience and preferred date. Available times are retrieved from our live Materuni Hosts calendar.</p></section>
<style>.booking-terms-note{padding:18px 20px;border:1px solid #e6dfd3;border-radius:14px;background:#faf7f2;color:#242421;line-height:1.7}.booking-terms-note strong{display:block;color:#1a3322;margin-bottom:6px}.booking-terms-note p{margin:6px 0 0}.booking-terms-note p+p{font-size:.92em;color:#55564f}</style>
<section class="booking-wrap"><div class="booking-panel"><p class="muted" style="margin:0 0 16px"><span data-i18n="booking_reviews_intro">Independent guest feedback:</span> <a href="/reviews" data-i18n="booking_reviews_link">Read reviews</a> · <a href="https://g.page/r/CXy6M_Suiip9EBM/review" target="_blank" rel="noopener noreferrer" data-i18n="booking_leave_review">Leave a Google review</a></p>
<div class="booking-estimate" id="booking-estimate" hidden aria-live="polite" aria-atomic="true">
 <div class="booking-estimate-heading"><span class="eyebrow" data-i18n="estimate_heading">YOUR EXPERIENCE SUMMARY</span><span class="booking-estimate-note" data-i18n="estimate_note">Indicative estimate</span></div>
 <div class="booking-estimate-grid">
  <div><span data-i18n="estimate_experience">Selected experience</span><strong id="estimate-experience">Choose an experience</strong></div>
  <div><span data-i18n="estimate_unit">Price per guest</span><strong id="estimate-unit">—</strong></div>
  <div class="booking-estimate-total"><span data-i18n="estimate_total">Estimated group total</span><strong id="estimate-total">—</strong></div>
 </div>
 <p data-i18n="estimate_disclaimer">Estimate based on the current published experience price and guest count. Transport and separately agreed extras are not included. Indicative TZS guide (15 Oct 2026; 1 USD ≈ TZS 2,640): $65 ≈ TZS 172,000 · $75 ≈ TZS 198,000 · $85 ≈ TZS 224,000 · $110 ≈ TZS 290,000 · $135 ≈ TZS 356,000. TZS amounts are rounded estimates; your host confirms the final amount before payment. Your host will confirm the final arrangements and amount before payment.</p>
</div>
<form id="booking-form" class="form-grid">
<div class="field full"><label for="experience" data-i18n="booking_experience_label">Choose your experience *</label><select id="experience" required><option value="">Loading experiences…</option></select></div>
<div class="field"><label for="date" data-i18n="booking_date_label">Preferred date *</label><input id="date" type="date" required><small class="muted" id="date-availability-hint">Online times are shown only for dates with published availability. If your preferred date has no times, contact us and a local host can check the options.</small></div><div class="field"><label for="slot" data-i18n="booking_slot_label">Available time *</label><select id="slot" required disabled><option value="">Choose an experience and date first</option></select><small id="availability-status" class="availability-status" role="status" aria-live="polite">Choose an experience and date to see live spaces.</small><button class="availability-refresh" id="refresh-availability" type="button" disabled data-i18n="booking_refresh">Refresh available times</button></div>
<div class="field"><label for="count" data-i18n="booking_guests_label">Number of guests *</label><input id="count" type="number" min="1" max="30" value="2" required></div><div class="field"><label for="name" data-i18n="booking_name_label">Full name *</label><input id="name" autocomplete="name" required></div>
<div class="field"><label for="email" data-i18n="booking_email_label">Email address</label><input id="email" type="email" autocomplete="email"></div><div class="field"><label for="phone" data-i18n="booking_phone_label">WhatsApp / phone</label><input id="phone" type="tel" autocomplete="tel"><small class="muted" data-i18n="booking_contact_hint">Provide at least one contact method: email or phone.</small></div><div class="field"><label for="language" data-i18n="booking_language_label">Preferred language</label><select id="language"><option value="English">English</option><option value="Spanish">Español</option><option value="French">Français</option><option value="German">Deutsch</option></select></div>
<div class="field"><label for="pickup-origin" data-i18n="booking_transfer_label">Transfer request (optional)</label><select id="pickup-origin"><option value="" data-i18n="booking_transfer_none">No transfer / self-arranged</option><option value="Moshi" data-i18n="booking_transfer_moshi">Request pickup from Moshi</option><option value="Arusha" data-i18n="booking_transfer_arusha">Request pickup from Arusha</option><option value="Kilimanjaro International Airport (KIA)" data-i18n="booking_transfer_kia">Request pickup from KIA</option></select><small class="muted" data-i18n="booking_transfer_note">Pickup from Moshi, Arusha or KIA can be requested when you book. Your host will confirm a separate vehicle quote before you agree. Transfer is not included in the experience price. Typical road times are approximately 45–60 minutes from Moshi, 2.5–3 hours from Arusha and 1.5–2 hours from Kilimanjaro International Airport (KIA). Actual time depends on your exact pickup point, route, road and traffic conditions.</small></div><div class="field"><label for="pickup" data-i18n="booking_pickup_label">Hotel, address or flight details</label><input id="pickup" placeholder="Hotel name, flight number or meeting point…" data-i18n-placeholder="booking_pickup_placeholder"></div>
<div class="field full"><label for="notes" data-i18n="booking_notes_label">Special requests, dietary needs or accessibility notes</label><textarea id="notes" data-i18n-placeholder="booking_notes_placeholder"></textarea></div>
<div class="field full"><div class="notice booking-terms-note" role="note"><strong data-i18n="booking_notice_title">A request is not a payment or confirmed booking.</strong><p data-i18n="booking_notice">Sending this form is free and does not charge you or commit you to a booking. A Materuni Hosts host will check availability and share the proposed itinerary, final price, transport quote if requested, and applicable payment, cancellation and weather arrangements. You pay nothing until you review and confirm those details. Your booking is confirmed only when Materuni Hosts sends written confirmation.</p><p data-i18n="booking_notice_contact">Please provide at least one working email address or WhatsApp number so we can respond to your request. Your host will confirm availability and send payment details after you have reviewed the final arrangements. For time-sensitive plans, contact us directly on WhatsApp.</p></div><button class="button" id="submit" type="submit" data-i18n="booking_submit_label">Request your night in Materuni</button><p id="feedback" aria-live="polite" class="muted"></p></div>
</form></div></section>
<script>
// @ts-nocheck

import { supabaseUrl as url, publishableKey as key } from "../lib/supabase-public";
const headers={"apikey":key,"Authorization":"Bearer "+key,"Content-Type":"application/json"};
const $=id=>document.getElementById(id);
function updateBookingEstimate(){
 const select=$("experience"),count=Number($("count").value),option=select.selectedOptions[0];
 const panel=$("booking-estimate");
 if(!option||!option.value||!Number.isFinite(Number(option.dataset.price))||Number(option.dataset.price)<=0||!Number.isInteger(count)||count<1||count>30){panel.hidden=true;return}
 const unit=Number(option.dataset.price);
 const guests=count;
 const money=value=>new Intl.NumberFormat("en-US",{style:"currency",currency:"USD",maximumFractionDigits:0}).format(value);
 $("estimate-experience").textContent=option.textContent.split(" · $")[0];
 $("estimate-unit").textContent=money(unit);
 $("estimate-total").textContent=money(unit*guests);
 panel.hidden=false;
}
const tanzaniaToday=()=>new Intl.DateTimeFormat("en-CA",{timeZone:"Africa/Dar_es_Salaam",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date());
const addDays=(dateString,days)=>{const d=new Date(dateString+"T12:00:00+03:00");d.setDate(d.getDate()+days);return new Intl.DateTimeFormat("en-CA",{timeZone:"Africa/Dar_es_Salaam",year:"numeric",month:"2-digit",day:"2-digit"}).format(d)};
$("date").min=tanzaniaToday();
$("date").max=addDays(tanzaniaToday(),365);
// Start on the next local day so guests do not land on today's already-passed slots.
$("date").value=addDays(tanzaniaToday(),1);
const params=new URLSearchParams(location.search);
let availabilityRequest=0;
function setAvailabilityStatus(message,state="info"){
 const status=$("availability-status");
 status.textContent=message;
 status.dataset.state=state;
}
async function loadExperienceCatalog(){
 const select=$("experience");
 try {
  const q=new URLSearchParams({select:"experience_key,display_name,price_usd,duration_label",is_active:"eq.true",order:"sort_order.asc"});
  const response=await fetch(url+"/rest/v1/experience_catalog?"+q,{headers,cache:"no-store"});
  if(!response.ok) throw new Error("Experiences could not be loaded. Please refresh the page.");
  const catalog=await response.json();
  select.innerHTML='<option value="">Select an experience</option>';
  catalog.forEach(item=>{
   const option=document.createElement("option");
   option.value=item.experience_key;
   option.dataset.price=String(Number(item.price_usd)||0);
   option.textContent=item.display_name+" · $"+Number(item.price_usd).toFixed(0)+" per person"+(item.duration_label?" · "+item.duration_label:"");
   select.append(option);
  });
  const wanted=(params.get("experience")||"").trim().toLowerCase();
  const match=[...select.options].find(o=>o.text.split(" · $")[0].trim().toLowerCase()===wanted||o.value.trim().toLowerCase()===wanted);
  if(match) select.value=match.value;
  updateBookingEstimate();
 } catch(error) {
  console.error("Experience catalogue request failed:",error);
  select.innerHTML='<option value="">Experiences could not be loaded — refresh the page</option>';
  showFeedback("We could not load the experience list. Please refresh the page or contact us on WhatsApp. "+(error.message||""),"error");
  return;
 }
 // Availability is a separate service. A calendar error must never erase a catalogue that loaded successfully.
 if(select.value && $("date").value) await refreshAvailability();
}
loadExperienceCatalog();

function clearSelectedSlot(message="Choose an experience and date to see live spaces.") {
  $("slot").value="";
  $("slot").innerHTML='<option value="">Choose an available time</option>';
  $("slot").disabled=true;
  setAvailabilityStatus(message);
}
function showFeedback(message,state="error") {
  const fb=$("feedback");
  fb.textContent=message;
  fb.dataset.state=state;
  fb.className="booking-alert booking-alert-"+state;
  fb.setAttribute("role",state==="error"?"alert":"status");
  fb.setAttribute("aria-live",state==="error"?"assertive":"polite");
}
function safeError(payload,status) {
  const serverMessage = String(payload?.message || payload?.details || payload?.hint || payload?.error_description || payload?.error || "").trim();
  const message = serverMessage.toLowerCase();
  if (status === 429 || message.includes("too many booking requests") || message.includes("too many requests")) {
    return "We have received several requests from this contact in a short time. Please wait a little, or speak with our local host on WhatsApp.";
  }
  if (message.includes("not enough spaces") || message.includes("no longer available") || message.includes("slot was not found")) {
    return "Those spaces may have just been taken. Please refresh the available times and choose another slot.";
  }
  if (message.includes("already passed") || message.includes("valid future date")) {
    return "That time is no longer available. Please choose a later date or time.";
  }
  if (message.includes("experience") && message.includes("match")) {
    return "Please choose a time listed for your selected experience, then try again.";
  }
  if (status >= 500) {
    return "Our booking service is having a moment. Your details have not been confirmed; please try again shortly or contact our local host on WhatsApp.";
  }
  return "We could not complete your request. Please check your details and selected time, then try again.";
}

async function refreshAvailability(){
 const requestId=++availabilityRequest;
 const exp=$("experience").value;
 const date=$("date").value;
 const guests=Number($("count").value);
 const sel=$("slot");
 const refresh=$("refresh-availability");
 sel.innerHTML='<option value="">Checking live availability…</option>';
 sel.disabled=true;
 refresh.disabled=true;
 if(!exp||!date){
  clearSelectedSlot();
  return;
 }
 if(!Number.isInteger(guests)||guests<1||guests>30){
  clearSelectedSlot("Enter a whole number between 1 and 30 guests.");
  setAvailabilityStatus("Please enter a whole number between 1 and 30 guests.","error");
  return;
 }
 const localToday=tanzaniaToday();
 if(date<localToday){
  clearSelectedSlot("Choose a future date.");
  setAvailabilityStatus("That date has passed in Tanzania. Please choose today or a future date.","error");
  return;
 }
 setAvailabilityStatus("Checking available times for "+guests+" guest"+(guests===1?"":"s")+"…");
 refresh.disabled=false;
 try{
  const q=new URLSearchParams({
   select:"id,experience,slot_date,start_time,end_time,capacity,booked_count",
   experience:"eq."+exp,slot_date:"eq."+date,is_active:"eq.true",order:"start_time.asc"
  });
  const response=await fetch(url+"/rest/v1/availability_slots?"+q,{headers,cache:"no-store"});
  const rows=await response.json().catch(()=>null);
  if(!response.ok)throw new Error(safeError(rows,response.status));
  if(!Array.isArray(rows))throw new Error("The availability calendar returned an unexpected response.");
  if(requestId!==availabilityRequest)return;
  const localTime=new Intl.DateTimeFormat("en-GB",{timeZone:"Africa/Dar_es_Salaam",hour:"2-digit",minute:"2-digit",hourCycle:"h23"}).format(new Date());
  const open=rows.filter(slot=>{
   const remaining=Number(slot.capacity)-Number(slot.booked_count);
   const start=String(slot.start_time||"").slice(0,5);
   return Number.isFinite(remaining)&&remaining>=guests&&(date!==localToday||start>localTime);
  });
  sel.innerHTML='<option value="">'+(open.length?"Select an available time":"No suitable times available")+'</option>';
  open.forEach(slot=>{
   const option=document.createElement("option");
   option.value=slot.id;
   option.textContent=String(slot.start_time).slice(0,5)+" – "+String(slot.end_time).slice(0,5)+" · "+(Number(slot.capacity)-Number(slot.booked_count))+" spaces left";
   sel.append(option);
  });
  sel.disabled=!open.length;
  setAvailabilityStatus(open.length
   ? open.length+" available time"+(open.length===1?"":"s")+" found."
   : rows.length
    ? "No remaining slots fit your group, or today's times have passed. Try another date or a smaller group."
    : "No times have been added for this date yet. Choose another date or contact our local host.",
   open.length?"success":"warning");
 }catch(error){
  if(requestId!==availabilityRequest)return;
  sel.innerHTML='<option value="">Availability temporarily unavailable</option>';
  sel.disabled=true;
  setAvailabilityStatus(error.message||"Availability could not be checked. Please try again.","error");
 }
}
$("date").addEventListener("change",()=>{clearSelectedSlot("Date changed. Checking the new date…");refreshAvailability();});
$("experience").addEventListener("change",()=>{updateBookingEstimate();clearSelectedSlot("Experience changed. Checking available times…");refreshAvailability();});
$("count").addEventListener("input",updateBookingEstimate);
$("count").addEventListener("change",()=>{updateBookingEstimate();clearSelectedSlot("Group size changed. Checking available spaces…");refreshAvailability();});
$("refresh-availability").addEventListener("click",refreshAvailability);

$("booking-form").addEventListener("submit",async e=>{
 e.preventDefault();
 const btn=$("submit");
 const fb=$("feedback");
 const guestEmail=$("email").value.trim();
 const guestPhone=$("phone").value.trim();
 const guestName=$("name").value.trim();
 const guestCount=Number($("count").value);
 const experience=$("experience").value;
 const date=$("date").value;
 const slotId=$("slot").value;

 if(!experience){showFeedback("Please choose an experience.");return;}
 if(!date||date<tanzaniaToday()){showFeedback("Please choose a valid future date.");return;}
 if(!slotId){showFeedback("Please select an available time slot.");return;}
 if(!Number.isInteger(guestCount)||guestCount<1||guestCount>30){showFeedback("Guest count must be a whole number between 1 and 30.");return;}
 if(guestName.length<2){showFeedback("Please enter your full name.");return;}
 if(!guestEmail&&!guestPhone){showFeedback("Please provide an email address or WhatsApp / phone number.");return;}
 if(guestEmail&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(guestEmail)){showFeedback("Please enter a valid email address.");return;}
 if(guestPhone&&!/^\+?[0-9\s()-]{7,20}$/.test(guestPhone)){showFeedback("Please enter a valid phone number.");return;}

 btn.disabled=true;
 btn.textContent="Sending request…";
 fb.textContent="";
 const body={
  p_experience:experience,p_slot_id:slotId,p_guest_count:guestCount,p_guest:guestName,
  p_email:guestEmail||null,p_phone:guestPhone||null,
  p_nationality:null,p_country_of_residence:null,
  p_preferred_contact:guestEmail&&!guestPhone?"Email":"WhatsApp",
  p_pickup:[$("pickup-origin").value,$("pickup").value.trim()].filter(Boolean).join(" — ")||null,p_language:$("language").value,
  p_notes:(()=>{const notes=$("notes").value.trim();const source=params.get("source");const sourceLabel=source==="camping"?"Camping landing page":source==="day-trips"?"Day Trips landing page":source==="homepage"?"Homepage leading package":"";const campaign=(params.get("utm_campaign")||"").replace(/[\u0000-\u001f]/g,"").slice(0,100);const attribution=[sourceLabel,campaign?"Campaign: "+campaign:""].filter(Boolean).join(" | ");return [notes,attribution?"[Enquiry source: "+attribution+"]":""].filter(Boolean).join("\n")||null;})(),p_booking_type:"tour"
 };
 // Keep the same key when an identical request is retried after a timeout/reload.
 const attemptFingerprint=JSON.stringify(body);
 const attemptStorageKey="materuni-hosts-booking-attempt";
 let idempotencyKey="";
 try{
  const saved=JSON.parse(sessionStorage.getItem(attemptStorageKey)||"null");
  if(saved?.fingerprint===attemptFingerprint && /^[0-9a-f-]{36}$/i.test(saved.key)){
   idempotencyKey=saved.key;
  }
 }catch(storageError){ console.warn("Booking retry storage unavailable.",storageError); }
 if(!idempotencyKey){
  idempotencyKey=crypto.randomUUID();
  try{sessionStorage.setItem(attemptStorageKey,JSON.stringify({fingerprint:attemptFingerprint,key:idempotencyKey}));}catch(storageError){}
 }
 const requestBody={...body,p_idempotency_key:idempotencyKey};
 try{
  const response=await fetch(url+"/rest/v1/rpc/submit_booking_idempotent",{
   method:"POST",headers,body:JSON.stringify(requestBody),cache:"no-store"
  });
  const payload=await response.json().catch(()=>null);
  if(!response.ok)throw new Error(safeError(payload,response.status));
  const created=Array.isArray(payload)?payload[0]:payload;
  if(!created?.booking_id)throw new Error("The booking response could not be verified. Please contact our host before submitting again.");
  try{const saved=JSON.parse(sessionStorage.getItem(attemptStorageKey)||"null");if(saved?.key===idempotencyKey)sessionStorage.removeItem(attemptStorageKey);}catch(storageError){}
  const reference=created.booking_reference||created.booking_id;
  let notice="";
  try{
   const notificationResponse=await fetch(url+"/functions/v1/booking-notifications",{
    method:"POST",headers,body:JSON.stringify({booking_id:created.booking_id,idempotency_key:idempotencyKey})
   });
   const notificationPayload=await notificationResponse.json().catch(()=>null);
   const delivery=notificationPayload?.notifications||{};
   const delivered=state=>["sent","already_processed"].includes(state);
   const adminDelivered=[delivery.admin_new_booking_alert,delivery.admin_whatsapp_alert].some(delivered);
   const guestDelivered=[delivery.guest_booking_acknowledgement,delivery.guest_whatsapp_acknowledgement].some(delivered);
   if(!notificationResponse.ok||!notificationPayload?.success||!adminDelivered||!guestDelivered){
    notice=" Your booking request is safely saved, but we could not confirm every expected email or WhatsApp notification. Our local host will check your request using the reference above.";
   }
  }catch(notificationError){
   console.warn("Booking saved; notification delivery could not be confirmed.",notificationError);
   notice=" Your request is saved, but automatic notifications could not be confirmed. Our host can verify it using your reference.";
  }
  showFeedback("Booking request received — reference: "+reference+". Your request is awaiting host confirmation; it is not yet a confirmed reservation and no payment has been taken."+notice,notice?"warning":"success");
  $("booking-form").reset();
  updateBookingEstimate();
  $("date").min=tanzaniaToday();
  $("date").value=addDays(tanzaniaToday(),1);
  $("count").value="2";
  clearSelectedSlot("Your request was received. Choose another experience or date to make a new request.");
  await refreshAvailability();
 }catch(error){
  const message=error.message||"We could not send your booking. Please try again or contact us on WhatsApp.";
  const isCapacityConflict=/not enough spaces|no longer available|slot.*not found|already passed|inactive/i.test(message);
  const isNetworkFailure=error instanceof TypeError || /network|fetch failed|connection|timeout/i.test(message);
  if(isNetworkFailure){
   showFeedback("We could not confirm the server response. Your request may already be saved. Please retry without changing the booking details; we will use the same secure request key to avoid creating a duplicate. If the issue continues, contact our host on WhatsApp.","warning");
  }else{
   showFeedback(isCapacityConflict?message+" Please refresh availability and choose another time.":message,"error");
  }
  // Refresh in case another guest took the selected spaces while this form was open.
  refreshAvailability();
 }finally{
  btn.disabled=false;
  btn.textContent="Send booking request";
 }
});
</script>
</SiteLayout>