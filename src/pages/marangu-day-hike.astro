---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import { supabaseUrl } from "../lib/supabase-public";

const base = `${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const heroImg = `${base}story_image/1791994219885-materuni-coffe-plantatio-tour.jpg`;
const photo1 = `${base}story_image/1791601761441-q3iog8mni3r.jpg`;
const photo2 = `${base}waterfall_image/1791998303073-materuni-waterfall-hike.jpg`;
const photo3 = `${base}story_image/1791995912146-materuni-community.jpg`;

const serviceData = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Marangu Day Hike to Kilimanjaro National Park from Moshi",
  "touristType": ["Hikers", "Nature lovers", "Kilimanjaro day trekkers"],
  "description": "Guided day trek through the lower montane rainforest of Mount Kilimanjaro from Marangu Gate to Mandara Hut (2,720 m) or Ndoro Waterfalls with local Chagga mountain guides.",
  "provider": { "@type": "TourOperator", "name": "Materuni Hosts", "url": "https://materunihosts.com/" },
  "offers": {
    "@type": "Offer",
    "price": "85.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://materunihosts.com/booking?experience=marangu"
  },
  "url": "https://materunihosts.com/marangu-day-hike"
};

const faqs = [
  {
    q: "How difficult is the Marangu Day Hike?",
    a: "The hike is moderate. The trail climbs from Marangu Gate (1,870 m) through dense temperate rainforest to Mandara Hut (2,720 m), covering roughly 8 km (5 miles) each way with an 850m elevation gain. Anyone with reasonable walking fitness can enjoy this trek comfortably."
  },
  {
    q: "Do I need Kilimanjaro National Park permits for a day hike?",
    a: "Yes, official TANAPA (Tanzania National Parks) conservation entry permits and certified mountain guide registrations are required. All park entrance fees, rescue fees, and certified guides are fully included and pre-arranged in our tour package."
  },
  {
    q: "What wildlife can I expect to see along the Marangu trail?",
    a: "The montane rainforest is home to vibrant troops of black-and-white colobus monkeys and blue monkeys leaping through the canopy. You will also spot exotic birds such as the Hartlaub's turaco, giant tree ferns, wild impatiens kilimanjari flowers, and towering moss-draped camphor trees."
  },
  {
    q: "What should I pack and wear for a Marangu day hike?",
    a: "Wear supportive hiking boots or trail shoes with good traction, long moisture-wicking trousers, and warm layers (a fleece or softshell). Mountain rain showers are common in the afternoon, so pack a waterproof rain jacket. Bring a small daypack, 2 litres of drinking water, and sun protection."
  },
  {
    q: "How does Marangu compare to a Materuni Waterfall tour?",
    a: "Materuni is a village-based cultural and waterfall experience (about 40 minutes walking each way plus coffee roasting and local cuisine). Marangu is a longer wilderness trek that enters Mount Kilimanjaro National Park itself, reaching sub-alpine rainforest elevations."
  }
];
---

<SiteLayout
  title="Marangu Day Hike from Moshi | Kilimanjaro Rainforest Trek"
  description="Experience a guided Kilimanjaro day hike from Moshi to Marangu Gate and Mandara Hut. Ancient rainforest, colobus monkeys, and waterfalls with local Chagga hosts from $85."
  preloadImage={heroImg}
>
  <LocalBusinessSchema />
  <script type="application/ld+json" set:html={JSON.stringify(serviceData)} />
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))})} />

  <main class="marangu-page">
    <section class="hero-split">
      <div class="hero-text">
        <span class="eyebrow">KILIMANJARO NATIONAL PARK · DAY HIKES FROM MOSHI</span>
        <h1>Marangu Day Hike from Moshi</h1>
        <p>Trek the legendary lower slopes of Africa's highest mountain without embarking on a week-long summit expedition. Walk through ancient moss-draped montane cloud forest, spot black-and-white colobus monkeys, and explore the historic Chagga heartland of Marangu with experienced local mountain hosts.</p>
        <div class="price-callout">
          <span class="price-from">From <strong>$85 USD</strong> per person</span>
          <span class="price-sub">Includes private transfers from Moshi, certified mountain guide, park permits & lunch pack</span>
        </div>
        <div class="actions">
          <a class="button gold" href="/booking?experience=marangu">Check availability & book</a>
          <a class="button outline" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%20would%20like%20details%20for%20the%20Marangu%20Day%20Hike." target="_blank" rel="noopener noreferrer">Ask a host on WhatsApp</a>
        </div>
      </div>
      <div class="hero-media">
        <Image src={heroImg} alt="Scenic foothills of Mount Kilimanjaro near Marangu with lush greenery" width={800} height={600} loading="eager" fetchpriority="high" decoding="async" class="hero-img" format="webp" quality={76} />
      </div>
    </section>

    <!-- Photo Gallery: 3 photos (S9 requirement) -->
    <section class="gallery-section">
      <div class="gallery-header">
        <span class="eyebrow">RAINFOREST & HERITAGE</span>
        <h2>Explore the green gateway to Mount Kilimanjaro</h2>
        <p>A pristine montane habitat rich in ancient trees, endemic birds, wildlife, and Chagga tribal history.</p>
      </div>
      <div class="gallery-grid">
        <figure class="gallery-item">
          <Image src={photo1} alt="Dense green rainforest trail in Kilimanjaro National Park near Marangu Gate" width={600} height={420} loading="lazy" decoding="async" format="webp" quality={76} />
          <figcaption>Winding rainforest paths lined with giant ferns, ancient moss, and wild orchids.</figcaption>
        </figure>
        <figure class="gallery-item">
          <Image src={photo2} alt="Gushing waterfalls nestled in the forested valleys around Marangu" width={600} height={420} loading="lazy" decoding="async" format="webp" quality={76} />
          <figcaption>Spectacular mountain waterfalls cascading through volcanic basalt gorges.</figcaption>
        </figure>
        <figure class="gallery-item">
          <Image src={photo3} alt="Local Chagga mountain guides and village hospitality in Kilimanjaro Region" width={600} height={420} loading="lazy" decoding="async" format="webp" quality={76} />
          <figcaption>Certified local guides sharing historical tales, botany, and mountaineering lore.</figcaption>
        </figure>
      </div>
    </section>

    <section class="content-section">
      <div class="article-body">
        <h2>The perfect Kilimanjaro day adventure</h2>
        <p>For travelers who want to feel the immense presence of Mount Kilimanjaro beneath their feet but have limited time, our Marangu Day Hike offers an unforgettable glimpse of the mountain’s wild majesty. Situated approximately 45 km east of Moshi town, Marangu is known as the traditional historic route of early explorers and mountaineers.</p>
        <p>Leaving the cultivated banana groves behind, you enter Kilimanjaro National Park at Marangu Gate (1,870 metres). Within minutes of stepping onto the trail, the canopy closes overhead in a thick, magical shroud of rainforest. Giant eucalyptus, African mahogany, and ancient camphor trees draped in Spanish moss tower above the path. The air is remarkably crisp and fresh, scented with damp volcanic earth and eucalyptus leaves.</p>

        <h2>What your Marangu day hike includes</h2>
        <p>Our comprehensive day package covers all arrangements so you can focus entirely on enjoying the mountain trail:</p>
        <ul>
          <li><strong>Private door-to-door vehicle transfer:</strong> Morning pickup at 08:00 AM from your Moshi or Arusha hotel in a comfortable private vehicle, with safe drop-off in the late afternoon.</li>
          <li><strong>Licensed Kilimanjaro mountain guides:</strong> Experienced local guides certified by TANAPA who ensure your safety, set an enjoyable pace, and identify rare flora and fauna.</li>
          <li><strong>National park entrance permits:</strong> All official TANAPA conservation, rescue, and guide permits are handled and included.</li>
          <li><strong>Packed trail lunch & drinking water:</strong> Wholesome mountain picnic lunch box featuring sandwiches, roasted chicken or vegetarian bites, boiled eggs, fresh tropical fruit, and mineral water.</li>
          <li><strong>Optional Maundi Crater extension:</strong> For energetic hikers who reach Mandara Hut with time to spare, an extra 15-minute walk to Maundi Crater reveals panoramic views across Kenya and northern Tanzania.</li>
        </ul>

        <h2>Pricing and booking details</h2>
        <p>Our Marangu Day Hike is priced from <strong>$85 USD per person</strong> based on a group of 4 guests. For smaller groups or private solo departures, please contact us for custom rates that include your dedicated transport and guide. No deposit is required to submit a booking enquiry; your local host will review your dates, confirm vehicle arrangements, and answer any questions before you confirm.</p>
      </div>
    </section>

    <!-- FAQ Block (S9 requirement) -->
    <section class="faq-section">
      <div class="section-header">
        <span class="eyebrow">ESSENTIAL HIKING INFORMATION</span>
        <h2>Frequently asked questions about the Marangu hike</h2>
        <p>Clear facts to help you prepare for a day on Mount Kilimanjaro.</p>
      </div>
      <div class="faq-list">
        {faqs.map(faq => (
          <details class="faq-card">
            <summary><span>{faq.q}</span></summary>
            <div class="faq-content"><p>{faq.a}</p></div>
          </details>
        ))}
      </div>
    </section>

    <section class="booking-cta">
      <h2>Explore more Kilimanjaro day trips</h2>
      <p>Combine your trek with a cultural visit to <a href="/materuni-waterfall-tour">Materuni Waterfall</a>, our <a href="/materuni-coffee-tour">Chagga Coffee Tour</a>, or a refreshing swim at <a href="/chemka-hot-springs">Chemka Hot Springs</a>.</p>
      <div class="actions">
        <a class="button gold" href="/booking?experience=marangu">Book Marangu day hike</a>
        <a class="button outline" href="/itinerary">Customise an itinerary</a>
      </div>
    </section>
  </main>

  <!-- Sticky Mobile Booking Bar (T6) -->
  <div class="sticky-mobile-booking-bar" role="region" aria-label="Quick booking bar">
    <div class="sticky-price">
      <strong>From $85 USD</strong>
      <small>Per person · Full day</small>
    </div>
    <div class="sticky-actions">
      <a class="sticky-book-btn" href="/booking?experience=marangu">Book Marangu</a>
      <a class="sticky-wa-btn" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%20am%20interested%20in%20the%20Marangu%20hike." target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 11.6a8.45 8.45 0 0 1-12.4 7.45L3.5 20.5l1.5-4.45a8.45 8.45 0 1 1 15.5-4.45Z"/><path d="M8.8 8.2c.25 2.9 2.1 5.2 5.15 6.15l1.2-1.3 2.05 1.05c-.15 1.5-1.2 2.35-2.65 2.35-3.95-.45-7.05-3.65-7.45-7.5 0-1.35.85-2.35 2.2-2.55l1.05 2.15-.95 1.05"/></svg>
      </a>
    </div>
  </div>
</SiteLayout>

<style>
.marangu-page {
  color: #242421;
}
.hero-split {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
  gap: clamp(28px, 5vw, 64px);
  align-items: center;
  padding: clamp(54px, 8vw, 96px) clamp(20px, 6vw, 96px);
  background: #1A3322;
  color: #FAF7F2;
}
.hero-text h1 {
  font: 600 clamp(36px, 5vw, 60px)/1.08 "Cormorant Garamond", Georgia, serif;
  color: #FAF7F2;
  margin: 12px 0 18px;
}
.hero-text p {
  color: #E6DFD3;
  font-size: 16px;
  line-height: 1.75;
  max-width: 620px;
}
.price-callout {
  background: rgba(255, 255, 255, 0.08);
  border-left: 3px solid #C5A059;
  padding: 12px 18px;
  border-radius: 6px;
  margin: 22px 0 26px;
}
.price-from {
  display: block;
  font-size: 15px;
  color: #FAF7F2;
}
.price-from strong {
  color: #C5A059;
  font-size: 20px;
}
.price-sub {
  display: block;
  font-size: 12px;
  color: #C6D0C8;
  margin-top: 4px;
}
.hero-img {
  width: 100%;
  height: clamp(260px, 34vw, 440px);
  object-fit: cover;
  border-radius: 16px;
  box-shadow: 0 16px 40px rgba(0,0,0,0.3);
}
.actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  align-items: center;
}
.button {
  padding: 14px 26px;
  border-radius: 999px;
  font: 800 13px "Manrope", sans-serif;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
}
.button.gold {
  background: #C5A059;
  color: #1A3322 !important;
}
.button.outline {
  background: transparent;
  color: #FAF7F2 !important;
  border: 1px solid rgba(255,255,255,0.4);
}

.gallery-section {
  padding: 72px clamp(20px, 6vw, 96px);
  background: #F4EFE6;
  border-bottom: 1px solid #E6DFD3;
}
.gallery-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 36px;
}
.gallery-header h2 {
  font: 600 clamp(30px, 4vw, 44px) "Cormorant Garamond", Georgia, serif;
  color: #1A3322;
  margin: 8px 0;
}
.gallery-header p {
  color: #556056;
  font-size: 15px;
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  max-width: 1200px;
  margin: 0 auto;
}
.gallery-item {
  margin: 0;
  background: #FAF7F2;
  border: 1px solid #E6DFD3;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 6px 20px rgba(26,51,34,0.05);
}
.gallery-item img {
  width: 100%;
  height: 240px;
  object-fit: cover;
  display: block;
}
.gallery-item figcaption {
  padding: 14px 18px;
  font-size: 12px;
  line-height: 1.5;
  color: #556056;
}

.content-section {
  padding: 72px clamp(20px, 6vw, 96px);
  max-width: 900px;
  margin: 0 auto;
}
.article-body h2 {
  font: 600 clamp(28px, 3.8vw, 38px) "Cormorant Garamond", Georgia, serif;
  color: #1A3322;
  margin: 36px 0 14px;
}
.article-body p, .article-body li {
  font-size: 15px;
  line-height: 1.8;
  color: #425347;
}
.article-body ul {
  padding-left: 20px;
  margin: 16px 0 24px;
}
.article-body li {
  margin-bottom: 10px;
}

.faq-section {
  padding: 64px clamp(20px, 6vw, 96px);
  background: #FAF7F2;
  border-top: 1px solid #E6DFD3;
}
.faq-section .section-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 36px;
}
.faq-section .section-header h2 {
  font: 600 clamp(30px, 4vw, 42px) "Cormorant Garamond", Georgia, serif;
  color: #1A3322;
  margin: 8px 0;
}
.faq-list {
  max-width: 820px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.faq-card {
  background: #fff;
  border: 1px solid #E6DFD3;
  border-radius: 12px;
  padding: 16px 20px;
}
.faq-card summary {
  font: 600 17px/1.3 "Cormorant Garamond", Georgia, serif;
  color: #1A3322;
  cursor: pointer;
  list-style: none;
}
.faq-card summary::-webkit-details-marker {
  display: none;
}
.faq-content {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #E6DFD3;
  color: #556056;
  font-size: 14px;
  line-height: 1.65;
}

.booking-cta {
  padding: 64px 24px;
  text-align: center;
  background: #1A3322;
  color: #FAF7F2;
  margin: 48px clamp(20px, 6vw, 96px);
  border-radius: 18px;
}
.booking-cta h2 {
  font: 600 clamp(28px, 4vw, 42px) "Cormorant Garamond", Georgia, serif;
  color: #FAF7F2;
  margin: 0 0 10px;
}
.booking-cta p {
  color: #E6DFD3;
  font-size: 15px;
  margin: 0 0 24px;
}
.booking-cta a {
  color: #C5A059;
  text-decoration: underline;
}
.booking-cta .actions {
  justify-content: center;
}

@media(max-width: 760px) {
  .hero-split {
    grid-template-columns: 1fr;
  }
  .gallery-grid {
    grid-template-columns: 1fr;
  }
}
</style>
