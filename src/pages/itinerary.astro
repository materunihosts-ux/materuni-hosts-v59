---
// @ts-nocheck
import SiteLayout from "../layouts/SiteLayout.astro";
import { supabaseUrl } from "../lib/supabase-public";
const itineraryPreview = "https://commons.wikimedia.org/wiki/Special:FilePath/Rau_forest_in_Miembeni_Ward,_Moshi.jpg?width=1600";
const tours=[{"key":"Waterfall & Chagga Culture","name":"Materuni Waterfall & Chagga Culture","price":75,"duration":"7–8 hours","detail":"Waterfall trail, Chagga coffee traditions, village culture and local lunch."},{"key":"Traditional Coffee Experience","name":"Traditional Coffee Experience","price":65,"duration":"4–5 hours","detail":"Village walk, bean-to-cup coffee, Chagga culture and local lunch."},{"key":"Traditional Chagga Cooking Class","name":"Traditional Chagga Cooking Class","price":85,"duration":"5–6 hours","detail":"Hands-on traditional cooking, village life and cultural discovery."},{"key":"Camping & Village Life","name":"Materuni Camping","price":110,"duration":"1 night","detail":"Village experiences, camping, dinner, storytelling and breakfast."},{"key":"The Ultimate Kilimanjaro Foothills & Materuni Experience","name":"Ultimate","price":135,"duration":"1 night","detail":"A complete overnight combination of waterfall, coffee, cooking and village life."}];
---
<SiteLayout title="Build a Materuni Itinerary | Local Tours & Camping" description="Build a Materuni itinerary with waterfall hikes, Chagga coffee, cooking and overnight camping. Plan your visit with local hosts near Moshi, Tanzania." preloadImage={itineraryPreview}>
<section class="media-hero" aria-labelledby="itinerary-title"><div><span class="eyebrow">YOUR TRIP, THOUGHTFULLY PLANNED</span><h1 id="itinerary-title" data-i18n="itinerary_page_title">Build a Materuni itinerary that feels like yours.</h1><p data-i18n="itinerary_page_intro">Choose the experiences you are interested in. We will arrange them into a practical suggested plan for your visit.</p></div><img src={itineraryPreview} alt="Rau Forest in Miembeni Ward near Moshi, part of the Kilimanjaro foothills" width="1200" height="900" loading="eager" fetchpriority="high" decoding="async" /></section>
<section class="section"><div class="split" style="align-items:start"><div class="booking-panel"><form id="planner" class="form-grid">
<div class="field full"><label for="guest" data-i18n="itinerary_name_label">Your name</label><input id="guest" required maxlength="100" placeholder="Full name" data-i18n-placeholder="itinerary_name_placeholder"></div>
<div class="field"><label for="date" data-i18n="itinerary_date_label">Preferred start date</label><input id="date" type="date" required></div>
<div class="field"><label for="guests" data-i18n="itinerary_guests_label">Number of guests</label><input id="guests" type="number" min="1" max="30" value="2" required></div>
<div class="field"><label for="pace" data-i18n="itinerary_pace_label">Travel pace</label><select id="pace"><option value="relaxed">Relaxed – take your time</option><option value="balanced" selected>Balanced – a little of everything</option><option value="active">Active – fit more in</option></select></div>
<div class="field"><label for="interests" data-i18n="itinerary_interest_label">Main interest</label><select id="interests"><option>Culture and local life</option><option>Nature and waterfall</option><option>Coffee and food</option><option>A mix of everything</option></select></div>
<div class="field full"><span class="label" data-i18n="itinerary_select_experiences">Select experiences (choose more than one)</span><div class="form-grid choices">{tours.map((t,i)=><label class="choice"><input type="checkbox" name="tour" value={i} /> <span><strong>{t.name}</strong><small>${t.price} per person · {t.duration}</small></span></label>)}</div></div>
<div class="field full"><label for="notes" data-i18n="itinerary_notes_label">Anything we should consider?</label><textarea id="notes" rows="3" placeholder="Children, dietary needs, mobility, pickup point or special interests…" data-i18n-placeholder="itinerary_notes_placeholder"></textarea></div>
<div class="field full"><button class="button" type="submit" data-i18n="itinerary_submit_label">Create my suggested itinerary</button><p class="muted" id="planner-feedback" aria-live="polite"></p></div>
<p class="muted" data-i18n="itinerary_currency_note">Indicative TZS guide (15 Oct 2026; 1 USD ≈ TZS 2,640): $65 ≈ TZS 172,000 · $75 ≈ TZS 198,000 · $85 ≈ TZS 224,000 · $110 ≈ TZS 290,000 · $135 ≈ TZS 356,000. Some activities may overlap, so your host will confirm the final combination and price before payment.</p>
</form></div>
<div class="booking-panel itinerary-output" id="output"><span class="eyebrow">YOUR PERSONAL PLAN</span><h2>Your itinerary will appear here.</h2><p>Select one or more experiences and create your suggested plan. A local host can then confirm timing, availability and transport.</p></div></div></section>
<script>
// @ts-nocheck

let tourData=[{"key":"Waterfall & Chagga Culture","name":"Materuni Waterfall & Chagga Culture","price":75,"duration":"7–8 hours","detail":"Waterfall trail, Chagga coffee traditions, village culture and local lunch."},{"key":"Traditional Coffee Experience","name":"Traditional Coffee Experience","price":65,"duration":"4–5 hours","detail":"Village walk, bean-to-cup coffee, Chagga culture and local lunch."},{"key":"Traditional Chagga Cooking Class","name":"Traditional Chagga Cooking Class","price":85,"duration":"5–6 hours","detail":"Hands-on traditional cooking, village life and cultural discovery."},{"key":"Camping & Village Life","name":"Materuni Camping","price":110,"duration":"1 night","detail":"Village experiences, camping, dinner, storytelling and breakfast."},{"key":"The Ultimate Kilimanjaro Foothills & Materuni Experience","name":"Ultimate","price":135,"duration":"1 night","detail":"A complete overnight combination of waterfall, coffee, cooking and village life."}];
const form=document.getElementById("planner"), output=document.getElementById("output");
import { supabaseUrl, publishableKey } from "../lib/supabase-public";
  const catalogueEndpoint=`${supabaseUrl}/rest/v1/experience_catalog?select=experience_key,display_name,price_usd,short_description,full_description,duration_label,is_active,sort_order&is_active=eq.true&order=sort_order.asc`;
async function syncItineraryTours(){
 try{
  const response=await fetch(catalogueEndpoint,{headers:{apikey:publishableKey,Authorization:"Bearer "+publishableKey},cache:"no-store"});
  if(!response.ok)throw new Error("Catalogue unavailable");
  const rows=await response.json();
  if(!Array.isArray(rows)||!rows.length)return;
  tourData=rows.map(row=>({key:row.experience_key,name:row.display_name,price:Number(row.price_usd),duration:row.duration_label||"Duration confirmed by host",detail:row.full_description||row.short_description||"A locally hosted Materuni experience."}));
  const root=form.querySelector(".choices");root.replaceChildren();
  tourData.forEach((tour,index)=>{
   const label=document.createElement("label");label.className="choice";
   const input=document.createElement("input");input.type="checkbox";input.name="tour";input.value=String(index);
   const span=document.createElement("span");const strong=document.createElement("strong");strong.textContent=tour.name;
   const small=document.createElement("small");small.textContent="$"+tour.price.toFixed(0)+" per person · "+tour.duration;
   span.append(strong,small);label.append(input,span);root.append(label);
  });
 }catch(error){console.warn("Using the built-in itinerary catalogue.",error)}
}
syncItineraryTours();
const dateInput=document.getElementById("date");
dateInput.min=new Intl.DateTimeFormat("en-CA",{timeZone:"Africa/Dar_es_Salaam",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date());
form.addEventListener("submit",event=>{
 event.preventDefault();
 const selected=[...form.querySelectorAll('input[name="tour"]:checked')].map(input=>tourData[Number(input.value)]);
 const feedback=document.getElementById("planner-feedback");
 if(!selected.length){feedback.textContent="Please choose at least one experience.";return;}
 const guests=Number(document.getElementById("guests").value), date=dateInput.value;
 const pace=document.getElementById("pace").value, name=document.getElementById("guest").value.trim();
 const notes=document.getElementById("notes").value.trim(), interest=document.getElementById("interests").value;
 const total=selected.reduce((sum,t)=>sum+t.price,0)*guests;
 const durationSummary=selected.map(t=>t.duration).join(" + ");
 const dateLabel=new Date(date+"T12:00:00").toLocaleDateString(undefined,{day:"numeric",month:"long",year:"numeric"});
 const escapeHtml=value=>String(value).replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll(String.fromCharCode(34),"&quot;").replaceAll(String.fromCharCode(39),"&#39;");
 const cards=selected.map((t,i)=>'<li class="itinerary-stop"><span class="stop-number">'+(i+1)+'</span><div><strong>'+t.name+'</strong><p>'+t.detail+'</p><small>'+t.duration+' · $'+t.price+' per person</small></div></li>').join("");
 output.innerHTML='<span class="eyebrow">YOUR PERSONAL PLAN</span><h2>Suggested Materuni itinerary</h2><p><strong>'+escapeHtml(name)+'</strong> · '+escapeHtml(dateLabel)+' · '+guests+' guest(s)</p><p>'+escapeHtml(interest)+' · '+escapeHtml(pace)+' pace</p><ol class="itinerary-list">'+cards+'</ol><div class="notice"><strong>Published package subtotal: $'+total.toFixed(2)+'</strong><p>This adds the published prices of the selected packages for '+guests+' guest(s). Some activities may overlap; your host will confirm any combined-plan adjustment, sequence and final price. Transport and extras are not included unless confirmed.</p><p>Published durations: '+escapeHtml(durationSummary)+'. These are package durations, not a promise that every selected activity can be completed consecutively in one visit.</p></div><div class="itinerary-actions"><button class="button" type="button" id="send-plan">Send this plan to a local host on WhatsApp</button><button class="button secondary" type="button" id="share-pdf">Print / Save PDF</button><button class="button secondary" type="button" id="download-pdf">Download PDF</button></div><p class="muted">This is a suggested plan, not a confirmed reservation. Availability will be checked by your host.</p>';
 const message=['Hello Materuni Hosts, please help me refine this itinerary.','Name: '+name,'Start date: '+date,'Guests: '+guests,'Pace: '+pace,'Interest: '+interest,'Selected experiences: '+selected.map(t=>t.name).join(', '),'Published package subtotal: $'+total.toFixed(2),'Some activities may overlap; please confirm any combined-plan adjustment and final price.','Notes: '+(notes||'None')].join('\\n');
 document.getElementById("send-plan").addEventListener("click",()=>window.open('https://wa.me/255612068540?text='+encodeURIComponent(message),'_blank','noopener'));
 const pdfName='materuni-itinerary-'+date+'.pdf';
 const printPdf=()=>{
  const win=window.open("","_blank");
  if(!win){feedback.textContent="Allow pop-ups for this site, then choose Print / Save PDF again.";return;}
  const money=new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(total);
  const rows=selected.map((t,i)=>'<article class="stop"><div class="number">'+(i+1)+'</div><div class="stop-copy"><h2>'+escapeHtml(t.name)+'</h2><p>'+escapeHtml(t.detail)+'</p><div class="meta">'+escapeHtml(t.duration)+' · '+new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(t.price)+' per person</div></div></article>').join("");
  const safeNotes=escapeHtml(notes||"No additional requirements supplied.");
  const html='<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>'+escapeHtml(pdfName)+'</title><style> @page{size:A4;margin:16mm 15mm 18mm}*{box-sizing:border-box}body{margin:0;color:#242421;background:#fff;font:11pt/1.65 Arial,sans-serif}.sheet{max-width:780px;margin:0 auto}.masthead{background:#1A3322;color:#FAF7F2;padding:28px 32px;border-bottom:5px solid #C5A059}.brand{display:flex;align-items:center;gap:14px}.brand img{width:54px;height:54px;object-fit:contain;background:#fff;border-radius:50%;padding:4px}.brand-name{font:700 17px Arial,sans-serif;letter-spacing:2px}.brand-sub{font-size:8px;letter-spacing:2px;color:#E6DFD3;margin-top:5px}.kicker{color:#C5A059;font-size:9px;font-weight:700;letter-spacing:2px;margin:28px 0 8px}.masthead h1{font:500 30pt/1.08 Georgia,serif;margin:0;max-width:600px}.masthead .place{font-size:9pt;color:#E6DFD3;margin:10px 0 0}.content{padding:26px 30px}.intro{font:12pt/1.6 Georgia,serif;color:#1A3322;margin:0 0 20px}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:18px 0 26px}.fact{background:#FAF7F2;border:1px solid #E6DFD3;padding:12px;border-radius:8px}.fact small{display:block;color:#7A756B;font-size:8px;font-weight:700;letter-spacing:1px;text-transform:uppercase}.fact strong{display:block;color:#1A3322;font-size:11px;margin-top:4px}.section-label{font-size:9px;letter-spacing:2px;color:#92743B;font-weight:700;margin:25px 0 12px}.stop{display:flex;gap:14px;padding:15px 0;border-top:1px solid #E6DFD3;break-inside:avoid}.number{width:30px;height:30px;flex:0 0 30px;border-radius:50%;background:#1A3322;color:#fff;text-align:center;line-height:30px;font-weight:700}.stop h2{font:600 17pt/1.15 Georgia,serif;color:#1A3322;margin:0 0 6px}.stop p{margin:0 0 6px;color:#4F504B}.meta{font-size:9pt;color:#80652F;font-weight:700}.total{margin:24px 0;background:#F5F0E6;border-left:4px solid #C5A059;padding:16px 18px;break-inside:avoid}.total strong{display:block;color:#1A3322;font:600 20pt Georgia,serif}.total p{margin:6px 0 0;font-size:9pt;color:#555}.notes{padding:14px 16px;border:1px solid #E6DFD3;border-radius:8px;break-inside:avoid}.notes strong{color:#1A3322}.disclaimer{margin:22px 0;padding:13px 15px;background:#F8F3E9;border-radius:7px;font-size:9pt}.footer{border-top:1px solid #C5A059;padding:18px 30px;color:#62635C;font-size:9pt}.footer strong{display:block;color:#1A3322;letter-spacing:1.5px;margin-bottom:4px}.tagline{font:italic 12pt Georgia,serif;color:#80652F;margin-top:8px}@media print{body{print-color-adjust:exact;-webkit-print-color-adjust:exact}.sheet{max-width:none}.masthead,.total,.fact,.number{-webkit-print-color-adjust:exact;print-color-adjust:exact}}@media(max-width:560px){.facts{grid-template-columns:1fr 1fr}.masthead{padding:22px}.content{padding:20px}}</style></head><body><main class="sheet"><header class="masthead"><div class="brand"><img src="https://materunihosts.com/materuni-hosts-logo-round.svg" alt="Materuni Hosts"><div><div class="brand-name">MATERUNI HOSTS</div><div class="brand-sub">LOCAL EXPERIENCES · KILIMANJARO</div></div></div><div class="kicker">YOUR PERSONAL JOURNEY</div><h1>Suggested Materuni itinerary</h1><p class="place">Materuni Village · Moshi · Kilimanjaro, Tanzania</p></header><section class="content"><p class="intro">A thoughtful plan shaped around local experiences, culture and the natural beauty of Materuni.</p><div class="facts"><div class="fact"><small>Prepared for</small><strong>'+escapeHtml(name)+'</strong></div><div class="fact"><small>Preferred date</small><strong>'+escapeHtml(dateLabel)+'</strong></div><div class="fact"><small>Guests</small><strong>'+guests+'</strong></div><div class="fact"><small>Travel pace</small><strong>'+escapeHtml(pace)+'</strong></div><div class="fact"><small>Main interest</small><strong>'+escapeHtml(interest)+'</strong></div></div><div class="section-label">SELECTED EXPERIENCES</div>'+rows+'<div class="total"><small>PUBLISHED PACKAGE SUBTOTAL · '+guests+' GUEST(S)</small><strong>'+money+'</strong><p>Based on published per-person package prices multiplied by the group size. Some activities may overlap; the host will confirm any combined-plan adjustment and final amount. Transport and extras are excluded unless confirmed.</p></div><div class="notes"><strong>Guest notes & special requirements</strong><p>'+safeNotes+'</p></div><div class="disclaimer"><strong>Planning document — not a confirmed booking.</strong> Availability, activity sequence, timings, transport and final pricing must be confirmed by Materuni Hosts before payment.</div></section><footer class="footer"><strong>MATERUNI HOSTS</strong>Materuni Village · Moshi · Tanzania<br>WhatsApp: +255 612 068 540 · hello@materunihosts.com<div class="tagline">Come as a guest. Leave as a friend.</div></footer></main><script>window.addEventListener("load",()=>setTimeout(()=>window.print(),450));<\/script></body></html>';
  win.document.open();win.document.write(html);win.document.close();setTimeout(()=>win.print(),650);
 };
 document.getElementById("download-pdf").addEventListener("click",()=>{printPdf();feedback.textContent="Print preview opened. Choose Save as PDF in your browser's print options.";});
 document.getElementById("share-pdf").addEventListener("click",()=>{printPdf();feedback.textContent="Save the PDF from the print window, then share it from your device.";});
 feedback.textContent="Your suggested itinerary is ready below.";
});
</script>
<style>.media-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.9fr);gap:clamp(24px,5vw,64px);align-items:center;padding:clamp(42px,7vw,88px) clamp(22px,7vw,100px);background:#1a3322;color:#faf7f2}.media-hero h1{color:#faf7f2;max-width:13ch;font:600 clamp(38px,5vw,64px)/1.04 "Cormorant Garamond",serif}.media-hero p{color:#e6dfd3;line-height:1.85;max-width:58ch}.media-hero img{display:block;width:100%;height:clamp(240px,34vw,430px);object-fit:cover;object-position:center 45%;border-radius:12px;box-shadow:0 18px 42px #0003}@media(max-width:720px){.media-hero{grid-template-columns:1fr;padding:42px 22px}.media-hero img{height:260px}}</style>
</SiteLayout>