---
// @ts-nocheck
import SiteLayout from "../layouts/SiteLayout.astro";
import { supabaseUrl } from "../lib/supabase-public";
const itineraryPreview = `${supabaseUrl}/storage/v1/object/public/materuni-images/waterfall_image/1791601414950-ew7ak42gjka.jpg`;
const tours=[{"key":"Waterfall & Chagga Culture","name":"Materuni Waterfall & Chagga Culture","price":75,"duration":"7–8 hours","detail":"Waterfall trail, Chagga coffee traditions, village culture and local lunch."},{"key":"Traditional Coffee Experience","name":"Traditional Coffee Experience","price":65,"duration":"4–5 hours","detail":"Village walk, bean-to-cup coffee, Chagga culture and local lunch."},{"key":"Traditional Chagga Cooking Class","name":"Traditional Chagga Cooking Class","price":85,"duration":"5–6 hours","detail":"Hands-on traditional cooking, village life and cultural discovery."},{"key":"Camping & Village Life","name":"Materuni Camping","price":110,"duration":"1 night","detail":"Village experiences, camping, dinner, storytelling and breakfast."},{"key":"The Ultimate Kilimanjaro Foothills & Materuni Experience","name":"Ultimate","price":135,"duration":"1 night","detail":"A complete overnight combination of waterfall, coffee, cooking and village life."}];
---
<SiteLayout title="Build Your Materuni Itinerary | Materuni Hosts" description="Choose Materuni experiences and create a tailored itinerary with local hosts." preloadImage={itineraryPreview}>
<section class="page-hero"><span class="eyebrow">YOUR TRIP, THOUGHTFULLY PLANNED</span><h1 data-i18n="itinerary_page_title">Build a Materuni itinerary that feels like yours.</h1><p data-i18n="itinerary_page_intro">Choose the experiences you are interested in. We will arrange them into a practical suggested plan for your visit.</p></section>
<section class="section"><div class="split" style="align-items:start"><div class="booking-panel"><form id="planner" class="form-grid">
<div class="field full"><label for="guest" data-i18n="itinerary_name_label">Your name</label><input id="guest" required maxlength="100" placeholder="Full name" data-i18n-placeholder="itinerary_name_placeholder"></div>
<div class="field"><label for="date" data-i18n="itinerary_date_label">Preferred start date</label><input id="date" type="date" required></div>
<div class="field"><label for="guests" data-i18n="itinerary_guests_label">Number of guests</label><input id="guests" type="number" min="1" max="30" value="2" required></div>
<div class="field"><label for="pace" data-i18n="itinerary_pace_label">Travel pace</label><select id="pace"><option value="relaxed">Relaxed – take your time</option><option value="balanced" selected>Balanced – a little of everything</option><option value="active">Active – fit more in</option></select></div>
<div class="field"><label for="interests" data-i18n="itinerary_interest_label">Main interest</label><select id="interests"><option>Culture and local life</option><option>Nature and waterfall</option><option>Coffee and food</option><option>A mix of everything</option></select></div>
<div class="field full"><span class="label" data-i18n="itinerary_select_experiences">Select experiences (choose more than one)</span><div class="form-grid choices">{tours.map((t,i)=><label class="choice"><input type="checkbox" name="tour" value={i} /> <span><strong>{t.name}</strong><small>${t.price} per person · {t.duration}</small></span></label>)}</div></div>
<div class="field full"><label for="notes" data-i18n="itinerary_notes_label">Anything we should consider?</label><textarea id="notes" rows="3" placeholder="Children, dietary needs, mobility, pickup point or special interests…" data-i18n-placeholder="itinerary_notes_placeholder"></textarea></div>
<div class="field full"><button class="button" type="submit" data-i18n="itinerary_submit_label">Create my suggested itinerary</button><p class="muted" id="planner-feedback" aria-live="polite"></p></div>
<p class="muted" data-i18n="itinerary_currency_note">Indicative TZS guide (15 Oct 2026; 1 USD ≈ TZS 2,640): $65 ≈ TZS 172,000 · $75 ≈ TZS 198,000 · $85 ≈ TZS 224,000 · $110 ≈ TZS 290,000 · $135 ≈ TZS 356,000. Some activities may overlap, so your host will confirm the final combination and price before payment.</p>
</form></div>
<div class="booking-panel itinerary-output" id="output"><span class="eyebrow">YOUR PERSONAL PLAN</span><h2>Your itinerary will appear here.</h2><p>Select one or more experiences and create your suggested plan. A local host can then confirm timing, availability and transport.</p></div></div></section>
<script>
// @ts-nocheck

let tourData=[{"key":"Waterfall & Chagga Culture","name":"Materuni Waterfall & Chagga Culture","price":75,"duration":"7–8 hours","detail":"Waterfall trail, Chagga coffee traditions, village culture and local lunch."},{"key":"Traditional Coffee Experience","name":"Traditional Coffee Experience","price":65,"duration":"4–5 hours","detail":"Village walk, bean-to-cup coffee, Chagga culture and local lunch."},{"key":"Traditional Chagga Cooking Class","name":"Traditional Chagga Cooking Class","price":85,"duration":"5–6 hours","detail":"Hands-on traditional cooking, village life and cultural discovery."},{"key":"Camping & Village Life","name":"Materuni Camping","price":110,"duration":"1 night","detail":"Village experiences, camping, dinner, storytelling and breakfast."},{"key":"The Ultimate Kilimanjaro Foothills & Materuni Experience","name":"Ultimate","price":135,"duration":"1 night","detail":"A complete overnight combination of waterfall, coffee, cooking and village life."}];
const form=document.getElementById("planner"), output=document.getElementById("output");
import { supabaseUrl, publishableKey } from "../lib/supabase-public";
  const catalogueEndpoint=`${supabaseUrl}/rest/v1/experience_catalog?select=experience_key,display_name,price_usd,short_description,full_description,duration_label,is_active,sort_order&is_active=eq.true&order=sort_order.asc`;
async function syncItineraryTours(){
 try{
  const response=await fetch(catalogueEndpoint,{headers:{apikey:publishableKey,Authorization:"Bearer "+publishableKey},cache:"no-store"});
  if(!response.ok)throw new Error("Catalogue unavailable");
  const rows=await response.json();
  if(!Array.isArray(rows)||!rows.length)return;
  tourData=rows.map(row=>({key:row.experience_key,name:row.display_name,price:Number(row.price_usd),duration:row.duration_label||"Duration confirmed by host",detail:row.full_description||row.short_description||"A locally hosted Materuni experience."}));
  const root=form.querySelector(".choices");root.replaceChildren();
  tourData.forEach((tour,index)=>{
   const label=document.createElement("label");label.className="choice";
   const input=document.createElement("input");input.type="checkbox";input.name="tour";input.value=String(index);
   const span=document.createElement("span");const strong=document.createElement("strong");strong.textContent=tour.name;
   const small=document.createElement("small");small.textContent="$"+tour.price.toFixed(0)+" per person · "+tour.duration;
   span.append(strong,small);label.append(input,span);root.append(label);
  });
 }catch(error){console.warn("Using the built-in itinerary catalogue.",error)}
}
syncItineraryTours();
const dateInput=document.getElementById("date");
dateInput.min=new Intl.DateTimeFormat("en-CA",{timeZone:"Africa/Dar_es_Salaam",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date());
form.addEventListener("submit",event=>{
 event.preventDefault();
 const selected=[...form.querySelectorAll('input[name="tour"]:checked')].map(input=>tourData[Number(input.value)]);
 const feedback=document.getElementById("planner-feedback");
 if(!selected.length){feedback.textContent="Please choose at least one experience.";return;}
 const guests=Number(document.getElementById("guests").value), date=dateInput.value;
 const pace=document.getElementById("pace").value, name=document.getElementById("guest").value.trim();
 const notes=document.getElementById("notes").value.trim(), interest=document.getElementById("interests").value;
 const total=selected.reduce((sum,t)=>sum+t.price,0)*guests;
 const durationSummary=selected.map(t=>t.duration).join(" + ");
 const dateLabel=new Date(date+"T12:00:00").toLocaleDateString(undefined,{day:"numeric",month:"long",year:"numeric"});
 const escapeHtml=value=>String(value).replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll(String.fromCharCode(34),"&quot;").replaceAll(String.fromCharCode(39),"&#39;");
 const cards=selected.map((t,i)=>'<li class="itinerary-stop"><span class="stop-number">'+(i+1)+'</span><div><strong>'+t.name+'</strong><p>'+t.detail+'</p><small>'+t.duration+' · $'+t.price+' per person</small></div></li>').join("");
 output.innerHTML='<span class="eyebrow">YOUR PERSONAL PLAN</span><h2>Suggested Materuni itinerary</h2><p><strong>'+escapeHtml(name)+'</strong> · '+escapeHtml(dateLabel)+' · '+guests+' guest(s)</p><p>'+escapeHtml(interest)+' · '+escapeHtml(pace)+' pace</p><ol class="itinerary-list">'+cards+'</ol><div class="notice"><strong>Estimated experience total: $'+total.toFixed(2)+'</strong><p>Subtotal adds the published prices of the selected packages for '+guests+' guest(s). Some activities may overlap; your host will confirm any combined-plan adjustment, sequence and final price. Transport and extras are not included unless confirmed.</p><p>Published durations: '+escapeHtml(durationSummary)+'. These are package durations, not a promise that every selected activity can be completed consecutively in one visit.</p></div><div class="itinerary-actions"><button class="button" type="button" id="send-plan">Send this plan to a local host on WhatsApp</button><button class="button secondary" type="button" id="share-pdf">Share itinerary PDF</button><button class="button secondary" type="button" id="download-pdf">Download PDF</button></div><p class="muted">This is a suggested plan, not a confirmed reservation. Availability will be checked by your host.</p>';
 const message=['Hello Materuni Hosts, please help me refine this itinerary.','Name: '+name,'Start date: '+date,'Guests: '+guests,'Pace: '+pace,'Interest: '+interest,'Selected experiences: '+selected.map(t=>t.name).join(', '),'Published package subtotal: ,'Notes: '+(notes||'None')].join('\\n');
 document.getElementById("send-plan").addEventListener("click",()=>window.open('https://wa.me/255612068540?text='+encodeURIComponent(message),'_blank','noopener'));
 const makePdf=()=>{
  const raw=['MATERUNI HOSTS','MATERUNI VILLAGE · MOSHI · TANZANIA','','SUGGESTED MATERUNI ITINERARY','Guest: '+name,'Preferred start date: '+date,'Guests: '+guests,'Travel pace: '+pace,'Main interest: '+interest,'','SELECTED EXPERIENCES',...selected.flatMap((t,i)=>[(i+1)+'. '+t.name,t.duration+' | $'+t.price+' per person',t.detail,'']),'PUBLISHED PACKAGE SUBTOTAL: ,'Your local host must confirm availability, timings, transport and final price before payment.','', 'hello@materunihosts.com | WhatsApp +255 612 068 540'];
  const clean=s=>String(s).normalize("NFKD").replace(/[\\u0300-\\u036f]/g,"").replace(/[^\\x20-\\x7E]/g,"-");
  const wrap=(s,max=88)=>{const words=clean(s).split(/\\s+/);const out=[];let line="";for(const word of words){if((line+" "+word).trim().length>max){out.push(line);line=word;}else line=(line+" "+word).trim();}if(line)out.push(line);return out;};
  const lines=raw.flatMap(line=>wrap(line));const pages=[];for(let i=0;i<lines.length;i+=48)pages.push(lines.slice(i,i+48));
  const objects=[];const add=s=>{objects.push(s);return objects.length;};
  const catalogId=add("<< /Type /Catalog /Pages 2 0 R >>");
  const pagesId=add("");
  const fontId=add("<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>");
  const pageIds=[];
  for(const pageLines of pages){let stream="BT\n/F1 10 Tf\n50 790 Td\n14 TL\n";for(const line of pageLines){stream+="("+line.replace(/\\\\/g,"\\\\\\\\").replace(/\\(/g,"\\\\(").replace(/\\)/g,"\\\\)")+") Tj\nT*\n";}stream+="ET";
   const contentId=add("<< /Length "+stream.length+" >>\nstream\n"+stream+"\nendstream");
   const pageId=add("<< /Type /Page /Parent "+pagesId+" 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 "+fontId+" 0 R >> >> /Contents "+contentId+" 0 R >>");pageIds.push(pageId);}
  objects[pagesId-1]="<< /Type /Pages /Kids ["+pageIds.map(id=>id+" 0 R").join(" ")+"] /Count "+pageIds.length+" >>";
  let pdf="%PDF-1.4\n";const offsets=[0];objects.forEach((obj,i)=>{offsets.push(pdf.length);pdf+=(i+1)+" 0 obj\n"+obj+"\nendobj\n";});
  const xref=pdf.length;pdf+="xref\n0 "+(objects.length+1)+"\n0000000000 65535 f \n";for(let i=1;i<offsets.length;i++)pdf+=String(offsets[i]).padStart(10,"0")+" 00000 n \n";pdf+="trailer\n<< /Size "+(objects.length+1)+" /Root "+catalogId+" 0 R >>\nstartxref\n"+xref+"\n%%EOF";
  return new Blob([pdf],{type:"application/pdf"});
 };
 const pdfName='materuni-itinerary-'+date+'.pdf';
 const downloadPdf=()=>{const url=URL.createObjectURL(makePdf());const a=document.createElement("a");a.href=url;a.download=pdfName;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1500);};
 document.getElementById("download-pdf").addEventListener("click",()=>{downloadPdf();feedback.textContent="PDF is being downloaded. You can share it from your phone's Downloads folder.";});
 document.getElementById("share-pdf").addEventListener("click",async()=>{const file=new File([makePdf()],pdfName,{type:"application/pdf"});if(navigator.share&&navigator.canShare&&navigator.canShare({files:[file]})){try{await navigator.share({files:[file],title:"My Materuni itinerary",text:"Suggested itinerary from Materuni Hosts"});feedback.textContent="PDF share menu opened.";}catch(error){if(error.name!=="AbortError")feedback.textContent="Sharing was unavailable. Use Download PDF instead.";}}else{downloadPdf();feedback.textContent="Direct PDF sharing is not supported in this browser. The PDF has been downloaded so you can share it from Downloads.";}}); feedback.textContent="Your suggested itinerary is ready below.";
});
</script>
