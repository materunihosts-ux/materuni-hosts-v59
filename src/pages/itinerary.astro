---
// @ts-nocheck
import SiteLayout from "../layouts/SiteLayout.astro";

const itineraryPreview = "https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/story_image/1791601761441-q3iog8mni3r.jpg";
const tours=[
  {"key":"Waterfall & Chagga Culture","name":"Materuni Waterfall & Chagga Village Experience","price":40,"duration":"7–8 hours","detail":"Guided hike to the 95m waterfall, coffee roasting, Chagga dance, local lunch and complimentary Mbege tasting."},
  {"key":"Traditional Coffee Experience","name":"Materuni Coffee & Chagga Culture Experience","price":36,"duration":"4–5 hours","detail":"From bean to cup: Chagga coffee traditions, roasting, grinding, brewing and fresh tasting."},
  {"key":"Traditional Chagga Cooking Class","name":"Materuni Chagga Cooking & Village Experience","price":49,"duration":"5–6 hours","detail":"Hands-on traditional firewood cooking class, authentic local ingredients and shared village meal."},
  {"key":"Materuni & Moshi Town Tour","name":"Materuni & Moshi Town Cultural Tour","price":52,"duration":"7–8 hours","detail":"Pair Materuni waterfall and coffee with a guided Moshi town history walk, local market and culture."},
  {"key":"Materuni & Rau Forest Experience","name":"Materuni & Rau Forest Nature Experience","price":58,"duration":"7–8 hours","detail":"Combine Materuni waterfall with a guided nature walk in Rau Forest, ancient Mvule tree and birdlife."},
  {"key":"Camping & Village Life","name":"Materuni Overnight Village Experience","price":90,"duration":"2 days · 1 night","detail":"Stay overnight in Materuni: tent setup, dinner by the fire, storytelling, breakfast and next-day village tour."}
];
---
<SiteLayout title="Build a Materuni Itinerary | Local Tours" description="Build a Materuni itinerary with waterfall hikes, Chagga coffee, cooking and overnight camping. Plan your visit with local hosts near Moshi, Tanzania." preloadImage={itineraryPreview}>
<section class="media-hero" aria-labelledby="itinerary-title"><div><span class="eyebrow">YOUR TRIP, THOUGHTFULLY PLANNED</span><h1 id="itinerary-title" data-i18n="itinerary_page_title">Build a Materuni itinerary that feels like yours.</h1><p data-i18n="itinerary_page_intro">Choose the experiences you are interested in. We will arrange them into a practical suggested plan for your visit.</p></div><img src={itineraryPreview} alt="Lush nature and trail around Materuni in the Kilimanjaro foothills" width="1200" height="900" loading="eager" fetchpriority="high" decoding="async" /></section>
<section class="section"><div class="split" style="align-items:start"><div class="booking-panel"><form id="planner" class="form-grid">
<div class="field full"><label for="guest" data-i18n="itinerary_name_label">Your name</label><input id="guest" required maxlength="100" placeholder="Full name" data-i18n-placeholder="itinerary_name_placeholder"></div>
<div class="field"><label for="date" data-i18n="itinerary_date_label">Preferred start date</label><input id="date" type="date" required></div>
<div class="field"><label for="guests" data-i18n="itinerary_guests_label">Number of guests</label><input id="guests" type="number" min="1" max="30" value="2" required></div>
<div class="field"><label for="pace" data-i18n="itinerary_pace_label">Travel pace</label><select id="pace"><option value="relaxed">Relaxed – take your time</option><option value="balanced" selected>Balanced – a little of everything</option><option value="active">Active – fit more in</option></select></div>
<div class="field"><label for="interests" data-i18n="itinerary_interest_label">Main interest</label><select id="interests"><option>Culture and local life</option><option>Nature and waterfall</option><option>Coffee and food</option><option>A mix of everything</option></select></div>
<div class="field full"><span class="label" data-i18n="itinerary_select_experiences">Select experiences (choose more than one)</span><div class="form-grid choices">{tours.map((t,i)=><label class="choice"><input type="checkbox" name="tour" value={i} /> <span><strong>{t.name}</strong><small>${t.price} per person · {t.duration}</small></span></label>)}</div></div>
<div class="field full"><label for="notes" data-i18n="itinerary_notes_label">Anything we should consider?</label><textarea id="notes" rows="3" placeholder="Children, dietary needs, mobility, pickup point or special interests…" data-i18n-placeholder="itinerary_notes_placeholder"></textarea></div>
<div class="field full"><button class="button" type="submit" data-i18n="itinerary_submit_label">Create my suggested itinerary</button><p class="muted" id="planner-feedback" aria-live="polite"></p></div>
<p class="muted" data-i18n="itinerary_currency_note">Indicative TZS guide: $40 ≈ TZS 106,000 · $36 ≈ TZS 95,000 · $49 ≈ TZS 130,000 · $52 ≈ TZS 138,000 · $58 ≈ TZS 153,000. The overnight experience is published in USD only; ask your host to confirm the local-currency amount. Some activities may overlap, so your host will confirm any combined-plan adjustment and final price before payment.</p>
</form></div>
<div class="booking-panel itinerary-output" id="output"><span class="eyebrow">YOUR PERSONAL PLAN</span><h2>Your itinerary will appear here.</h2><p>Select one or more experiences and create your suggested plan. A local host can then confirm timing, availability and transport.</p></div></div></section>

<style>.media-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.9fr);gap:clamp(24px,5vw,64px);align-items:center;padding:clamp(42px,7vw,88px) clamp(22px,7vw,100px);background:#1a3322;color:#faf7f2}.media-hero h1{color:#faf7f2;max-width:13ch;font:600 clamp(38px,5vw,64px)/1.04 "Cormorant Garamond",serif}.media-hero p{color:#e6dfd3;line-height:1.85;max-width:58ch}.media-hero img{display:block;width:100%;height:clamp(240px,34vw,430px);object-fit:cover;object-position:center 45%;border-radius:12px;box-shadow:0 18px 42px #0003}@media(max-width:720px){.media-hero{grid-template-columns:1fr;padding:42px 22px}.media-hero img{height:260px}}</style>
</SiteLayout>