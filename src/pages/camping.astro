    <a class="sticky-wa-btn" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%20want%20to%20book%20the%20Camping%20stay." target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 11.6a8.45 8.45 0 0 1-12.4 7.45L3.5 20.5l1.5-4.45a8.45 8.45 0 1 1 15.5-4.45Z"/><path d="M8.8 8.2c.25 2.9 2.1 5.2 5.15 6.15l1.2-1.3 2.05 1.05c-.15 1.5-1.2 2.35-2.65 2.35-3.95-.45-7.05-3.65-7.45-7.5 0-1.35.85-2.35 2.2-2.55l1.05 2.15-.95 1.05"/></svg>
    </a>
  </div>
</div>
<style>
.group-discount-panel{margin-top:30px}.product-best-for{margin:.35rem 0 .8rem;color:#1a3322;font-size:12px;font-weight:700;line-height:1.6}
.shared-standard{margin:28px 0 0;padding:24px 28px;background:#f4efe6;border:1px solid #e6dfd3;border-radius:16px}
.shared-standard h3{margin:0 0 14px;color:#1a3322;font:600 clamp(22px,3vw,30px) "Cormorant Garamond",serif}
.shared-standard ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 24px;margin:0;padding-left:18px;color:#425347;font-size:13px;line-height:1.7}
@media(max-width:620px){.shared-standard{padding:20px}.shared-standard ul{grid-template-columns:1fr}}
</style>
<script>
 // @ts-nocheck
 import { supabaseUrl, publishableKey } from "../lib/supabase-public";
 const catalogueHeaders={apikey:publishableKey,Authorization:"Bearer "+publishableKey};
 const escapeText=(node,value)=>{if(node&&typeof value==="string")node.textContent=value};
 async function syncCampingProducts(){
  try{
   const response=await fetch(`${supabaseUrl}/rest/v1/experience_catalog?select=experience_key,display_name,price_usd,duration_label,short_description,full_description,image_url,product_tagline,best_for,signature_moments,unique_amenities,is_active&experience_key=in.(Camping%20%26%20Village%20Life,The%20Ultimate%20Kilimanjaro%20Foothills%20%26%20Materuni%20Experience)`,{headers:catalogueHeaders,cache:"no-store"});
   if(!response.ok)throw new Error("Camping catalogue unavailable");
   const items=await response.json();
   items.filter(item=>item.is_active).forEach(item=>{
    const card=document.querySelector('[data-experience-key="'+CSS.escape(item.experience_key)+'"]');if(!card)return;
    escapeText(card.querySelector("h3"),item.display_name);
    const price=card.querySelector(".price");if(price){price.textContent="$"+Number(item.price_usd).toFixed(0)+" ";const small=document.createElement("small");small.textContent="PER PERSON"+(item.duration_label?" · "+item.duration_label.toUpperCase():"");price.append(small);}
    if(item.experience_key==="Camping & Village Life"){const proofPrice=document.querySelector(".proof div:nth-child(2) strong");if(proofPrice)proofPrice.textContent="$"+Number(item.price_usd).toFixed(0);}
    escapeText(card.querySelector(".offer-body>p"),item.full_description||item.short_description);
    const kicker=card.querySelector(".offer-body>.kicker");if(kicker&&item.product_tagline)kicker.textContent=item.product_tagline.toUpperCase();
    const list=card.querySelector(".offer-body>ul");if(list){list.replaceChildren(...(Array.isArray(item.unique_amenities)?item.unique_amenities:[]).map(value=>{const li=document.createElement("li");li.textContent=value;return li;}));}
    const old=card.querySelector("[data-best-for]");if(old)old.remove();
    if(item.best_for){const best=document.createElement("p");best.dataset.bestFor="true";best.className="product-best-for";best.textContent="BEST FOR · "+item.best_for;card.querySelector(".offer-body")?.insertBefore(best,list);}
   });
   const sharedResponse=await fetch(`${supabaseUrl}/rest/v1/site_settings?select=setting_value&setting_key=eq.experience_shared_inclusions`,{headers:catalogueHeaders,cache:"no-store"});
   if(sharedResponse.ok){const rows=await sharedResponse.json(),raw=rows?.[0]?.setting_value,shared=typeof raw==="string"?JSON.parse(raw):raw;const offers=document.querySelector(".offers");if(Array.isArray(shared)&&shared.length&&offers&&!document.querySelector("[data-shared-inclusions]")){const panel=document.createElement("aside");panel.className="shared-standard";panel.dataset.sharedInclusions="true";const h=document.createElement("h3");h.textContent="Included in every Materuni Hosts experience";const ul=document.createElement("ul");shared.forEach(value=>{const li=document.createElement("li");li.textContent=value;ul.append(li)});panel.append(h,ul);offers.insertAdjacentElement("afterend",panel);}}
  }catch(error){console.warn("Using built-in camping content.",error)}
 }
 syncCampingProducts();
 const pageFields={"hero_title":".camp-hero h1","hero_intro":".camp-hero .camp-copy>p","story_title":".story h2","story_intro":".story>div>p","offers_title":".section>.heading h2","offers_intro":".section>.heading p","final_title":".camp .final h2","final_intro":".camp .final>p","final_cta":".camp .final a.button.light"};
 let landingContent=null;
 function applyLandingCopy(){
  const locale=(localStorage.getItem("materuni-language")||"en").toLowerCase();
  if(locale!=="en"||!landingContent)return;
  Object.entries(pageFields).forEach(([key,selector])=>{const value=landingContent[key];const node=document.querySelector(selector);if(node&&typeof value==="string"&&value.trim())node.textContent=value});
 }
 fetch(`${supabaseUrl}/rest/v1/site_settings?select=setting_value&setting_key=eq.landing_pages_content`,{headers:{apikey:publishableKey,Authorization:"Bearer "+publishableKey},cache:"no-store"})
  .then(response=>response.ok?response.json():[])
  .then(rows=>{
   const raw=rows?.[0]?.setting_value;if(!raw)return;
   const saved=typeof raw==="string"?JSON.parse(raw):raw;const content=saved?.camping;if(!content||typeof content!=="object")return;
   landingContent=content;applyLandingCopy();
  }).catch(error=>console.warn("Optional landing-page content unavailable; showing built-in copy.",error));
 document.getElementById("site-language")?.addEventListener("change",applyLandingCopy);
</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"Materuni Overnight Village Experience","description":"A one-night village camping experience in Materuni with local Chagga hosting, tent accommodation, dinner, breakfast and a next-day guided village experience. Transport is arranged separately.","provider":{"@type":"Organization","name":"Materuni Hosts","url":"https://materunihosts.com"},"areaServed":{"@type":"Place","name":"Materuni Village, Kilimanjaro Region, Tanzania"}}</script>
</SiteLayout>