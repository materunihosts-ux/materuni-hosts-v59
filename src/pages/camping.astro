---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image, getImage } from "astro:assets";
import { supabaseUrl } from "../lib/supabase-public";
const base = `${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const heroSource = base + "story_image/1791994219885-materuni-coffe-plantatio-tour.jpg";
const galleryCampSource = base + "story_image/1791995912146-materuni-community.jpg";
const offerSource = base + "culturalday_image/1791994608797-materuni-waterfall-hike-trail.jpg";
const heroOptimized = await getImage({src:heroSource,width:1200,height:800,format:"webp",quality:76});
const hero = heroOptimized.src;
---
<SiteLayout title="Materuni Overnight Village Experience | Camping Near Moshi" description="Stay overnight in Materuni Village with local Chagga hosts. Includes camping, dinner, breakfast, a guided waterfall walk and traditional coffee near Moshi." preloadImage={hero}>
<style>.group-discount-panel{max-width:1180px;margin:30px auto;padding:28px;background:#f4efe6;border:1px solid #e3dacb;border-radius:16px}.group-discount-heading{text-align:center;max-width:680px;margin:0 auto 22px}.group-discount-heading .eyebrow{color:#755523;font:800 10px/1.5 Manrope,sans-serif;letter-spacing:.16em}.group-discount-heading h3{margin:8px 0;color:#1a3322;font:600 clamp(27px,3vw,36px) "Cormorant Garamond",serif}.group-discount-heading p,.group-discount-foot{color:#657066;font-size:13px;line-height:1.75}.group-discount-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.group-discount-grid>div{display:flex;flex-direction:column;justify-content:center;gap:7px;min-height:92px;padding:14px 10px;text-align:center;background:#fff;border:1px solid #e5ded2;border-radius:12px}.group-discount-grid strong{color:#1a3322;font-size:14px}.group-discount-grid span{color:#657066;font-size:12px;line-height:1.45}.group-discount-grid .group-custom{background:#1a3322;border-color:#1a3322}.group-discount-grid .group-custom strong,.group-discount-grid .group-custom span{color:#fff}.group-discount-foot{margin:18px 0 12px;text-align:center}.group-discount-panel>.button{display:flex;width:max-content;max-width:100%;min-height:46px;align-items:center;justify-content:center;margin:0 auto;padding:0 22px}@media(max-width:760px){.group-discount-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.group-discount-grid .group-custom{grid-column:1/-1}.group-discount-panel{padding:20px;margin:24px 0}}
.camp{color:#30372f}.camp-hero{display:grid;grid-template-columns:1fr 1fr;min-height:570px;background:#1a3322}.camp-copy{padding:clamp(38px,7vw,96px);display:flex;flex-direction:column;justify-content:center;color:#fff}.camp-copy h1{color:#fff;font-size:clamp(46px,6vw,76px);line-height:.98;max-width:10ch;margin:18px 0}.camp-copy p{color:#e5e9e3;max-width:56ch;line-height:1.85}.camp-media{min-height:420px;overflow:hidden;background:#263e2d}.camp-media img{display:block;width:100%;height:100%;min-height:420px;object-fit:cover;object-position:center 48%}.kicker{font:800 10px/1.5 Manrope,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#d9bd83}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}.actions .button{min-height:52px}.proof{display:grid;grid-template-columns:repeat(3,1fr);background:#f5f0e7}.proof div{text-align:center;padding:20px;border-right:1px solid #e1d9cb}.proof strong{display:block;font:600 25px Cormorant Garamond,serif;color:#1a3322}.proof span{font:800 10px Manrope,sans-serif;letter-spacing:.08em;color:#687168;text-transform:uppercase}.section{padding:clamp(52px,7vw,90px) clamp(22px,7vw,100px)}.story{display:grid;grid-template-columns:1fr 1fr;gap:clamp(25px,5vw,68px);align-items:center;max-width:1180px;margin:auto}.story img{width:100%;height:100%;max-height:520px;aspect-ratio:4/5;object-fit:cover;border-radius:16px}.story h2,.heading h2{font-size:clamp(34px,4.5vw,54px)}.story p,.heading p{color:#657066;line-height:1.85}.list{list-style:none;padding:0;margin:22px 0}.list li{padding:11px 0 11px 28px;position:relative;border-bottom:1px solid #e9e3d9;line-height:1.6}.list li:before{content:"✓";position:absolute;left:0;color:#8a6a34;font-weight:900}.heading{text-align:center;max-width:760px;margin:0 auto 36px}.heading p{margin:0 auto}.offers{display:grid;grid-template-columns:1fr 1fr;gap:22px;max-width:1180px;margin:auto}.offer{background:white;border:1px solid #e7dfd2;border-radius:17px;overflow:hidden;box-shadow:0 12px 30px #1a33220d}.offer img{width:100%;height:250px;object-fit:cover}.offer-body{padding:25px}.offer h3{font-size:29px;margin:10px 0}.price{font:600 34px Cormorant Garamond,serif;color:#1a3322}.price small{font:800 10px Manrope,sans-serif;letter-spacing:.1em;color:#687168}.offer p,.note{color:#657066;line-height:1.8}.cross-sell{max-width:1180px;margin:34px auto 0;padding:26px 30px;display:flex;align-items:center;justify-content:space-between;gap:20px;background:#fff;border:1px solid #e2d9ca;border-left:4px solid #c5a059;border-radius:12px}.cross-sell h3{font:600 26px Cormorant Garamond,serif;color:#1a3322;margin:0 0 5px}.cross-sell p{font-size:13px;color:#657066;line-height:1.7;margin:0}.faq{max-width:850px;margin:auto}.faq details{padding:18px 0;border-bottom:1px solid #e4ddd1}.faq summary{font-weight:800;color:#1a3322;cursor:pointer}.faq details p{color:#687168;line-height:1.8}.final{background:#1a3322;color:#fff;text-align:center;padding:70px 22px}.final h2{color:#fff;font-size:clamp(36px,5vw,56px);max-width:17ch;margin:0 auto 14px}.final p{color:#e1e7e0;margin:0 auto;line-height:1.8}@media(max-width:800px){.camp-gallery{grid-template-columns:1fr!important}.camp-gallery img{height:230px!important}.camp-hero,.story{grid-template-columns:1fr}.camp-media{min-height:330px;grid-row:1}.camp-media img{min-height:330px}.camp-copy{padding:52px 23px}.proof{grid-template-columns:1fr}.proof div{border-bottom:1px solid #e1d9cb}.offers{grid-template-columns:1fr}}@media(max-width:560px){.cross-sell{display:block;padding:22px}.cross-sell .button{display:flex;margin-top:15px;justify-content:center}.camp-copy h1{font-size:clamp(44px,12vw,58px)}.actions{display:grid}.actions .button{width:100%}.story img{aspect-ratio:4/3}.section{padding-inline:20px}}
</style>
<div class="camp">
<section class="camp-hero" aria-labelledby="camping-title"><div class="camp-copy"><span class="kicker" data-i18n="camping_eyebrow">SLEEP IN THE FOOTHILLS · MATERUNI VILLAGE</span><h1 id="camping-title" data-i18n="camping_title">Waterfall at noon, a firewood supper, stories by the fire. One night in Materuni.</h1><p data-i18n="camping_intro">Trade a rushed stop for a night in Materuni. Wake beneath the green slopes of Kilimanjaro, share Chagga food and coffee traditions, follow forest paths and spend the evening around camp with your local hosts.</p><div class="actions"><a class="button light" href="/booking?source=camping&experience=camping" data-i18n="camping_check_dates">Check camping dates</a><a class="button secondary" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%27m%20interested%20in%20overnight%20camping.%20Please%20share%20dates%20and%20details." target="_blank" rel="noopener noreferrer" data-i18n="camping_whatsapp">Plan with a local host</a></div></div><div class="camp-media"><Image src={heroSource} alt="Green coffee-growing landscape in Materuni Village" width={1200} height={800} loading="eager" fetchpriority="high" format="webp" quality={76} /></div></section>
<div class="proof"><div><strong>1 night</strong><span data-i18n="camping_proof_night">A slower Materuni stay</span></div><div><strong>$101</strong><span data-i18n="camping_proof_rate">Per person · published rate</span></div><div><strong data-i18n="camping_proof_hosts">Local hosts</strong><span data-i18n="camping_proof_connection">Chagga village connection</span></div></div>
<section class="section"><div class="story"><Image src={base+"story_image/1791994219885-materuni-coffe-plantatio-tour.jpg"} alt="Coffee traditions shared with local Materuni hosts" loading="lazy" decoding="async" width={700} height={850} format="webp" quality={76} /><div><span class="kicker" data-i18n="camping_story_kicker">MORE THAN A PLACE TO SLEEP</span><h2 data-i18n="camping_story_title">A village evening, not just an overnight stop.</h2><p data-i18n="camping_story_intro">Camping is the centre of this experience. The day gives you time to discover the waterfall and village; the evening creates space for food, conversation and the rhythms of local life. It is an invitation to slow down and experience Materuni with care.</p><ul class="list"><li data-i18n="camping_story_feature_1">Overnight camping with gear setup</li><li data-i18n="camping_story_feature_2">Guided waterfall and village experience</li><li data-i18n="camping_story_feature_3">Chagga cooking, local dinner and breakfast</li><li data-i18n="camping_story_feature_4">Campfire stories and time with local hosts</li></ul><a class="button" href="/booking?source=camping&experience=camping" data-i18n="camping_story_cta">Request your camping stay</a></div></div></section>
<section class="section" aria-labelledby="camp-comfort-title"><div class="heading"><span class="kicker" data-i18n="camping_details_eyebrow">THE OVERNIGHT DETAILS</span><h2 id="camp-comfort-title" data-i18n="camping_details_title">A simple night, thoughtfully hosted.</h2><p data-i18n="camping_details_intro">One night in Materuni with camping gear setup, dinner, breakfast and time around the campfire. Your host confirms the exact accommodation setup and practical facilities with you before payment.</p></div><div class="camp-gallery" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;max-width:1180px;margin:0 auto"><Image src={galleryCampSource} alt="Local community life in Materuni Village" loading="lazy" decoding="async" width={700} height={480} format="webp" quality={76} style="width:100%;height:260px;object-fit:cover;border-radius:14px" /><Image src={base+"coffee_image/1791998412318-materuni-tour.jpg"} alt="Traditional coffee preparation in Materuni" loading="lazy" decoding="async" width={700} height={480} format="webp" quality={76} style="width:100%;height:260px;object-fit:cover;border-radius:14px" /><Image src={base+"waterfall_image/1791998303073-materuni-waterfall-hike.jpg"} alt="Forest trail and Materuni waterfall" loading="lazy" decoding="async" width={700} height={480} format="webp" quality={76} style="width:100%;height:260px;object-fit:cover;border-radius:14px" /></div><div class="camp-facts" style="max-width:1180px;margin:24px auto 0;padding:24px;background:#f4efe6;border-radius:14px"><h3 data-i18n="camping_details_facts_title" style="font:600 27px Cormorant Garamond,serif;color:#1a3322;margin:0 0 12px">Camp comfort & concrete setup</h3><ul class="list"><li><strong>Sleeping setup:</strong> Weatherproof dome tents fully pitched on arrival with thick high-density foam mattresses, clean linens, warm sleeping bags and pillows.</li><li><strong>Meals & campfire:</strong> Home-cooked evening meal around the campfire prepared with fresh village vegetables, rice or ugali, and local chicken or vegetarian options, followed by breakfast and morning Chagga coffee.</li><li><strong>Washroom & hygiene:</strong> Clean dedicated village washroom with running water and private mountain-water bucket shower facilities.</li><li><strong>Night climate:</strong> Temperatures hover between 14°C and 17°C at night. We recommend bringing a warm fleece or jumper, sturdy footwear and your personal toiletries.</li></ul></div></section>
<section class="section" style="background:#f1ece3"><div class="heading"><span class="kicker" data-i18n="camping_offers_kicker">CHOOSE YOUR WAY TO STAY</span><h2 data-i18n="camping_offers_title">Make one night the heart of your Materuni visit.</h2><p data-i18n="camping_offers_intro">Choose the overnight camping stay or combine it with more foothills and village experiences. Your host can help shape the details around your dates and group.</p></div><div class="offers">
<article class="offer" data-experience-key="Camping & Village Life"><Image src={offerSource} alt="A green village trail in Materuni" loading="lazy" decoding="async" width={700} height={430} format="webp" quality={76} /><div class="offer-body"><span class="kicker" data-i18n="camping_offer_one_kicker">OVERNIGHT VILLAGE EXPERIENCE</span><h3 data-i18n="camping_package_title">Materuni Village Overnight Camping</h3><div class="price">$101 <small>PER PERSON · 1 NIGHT</small></div><p data-i18n="camping_offer_one_intro">A night in the village with camping, waterfall and cultural experiences, local food and time with your hosts.</p><ul class="list"><li>Camping gear setup</li><li>Waterfall and village experience</li><li>Local dinner and breakfast</li><li>Campfire stories and hosting</li></ul><a class="button" href="/booking?source=camping&experience=camping">Check dates</a></div></article>
</div><aside class="group-discount-panel" aria-labelledby="group-discount-title"><div class="group-discount-heading"><span class="eyebrow">SAVE MORE AS A GROUP</span><h3 id="group-discount-title">Direct group discounts</h3><p>Your discount is applied automatically to the per-person package price when you book.</p></div><div class="group-discount-grid"><div><strong>1–3 guests</strong><span>Standard rate</span></div><div><strong>4–5 guests</strong><span>5% off per person</span></div><div><strong>6–9 guests</strong><span>8% off per person</span></div><div><strong>10–14 guests</strong><span>10% off per person</span></div><div class="group-custom"><strong>15+ guests</strong><span>Custom group quotation</span></div></div><p class="group-discount-foot">See your discounted price per guest, total group savings and estimated group total in the booking form. These direct discounts do not apply to STO rates. Transport and separately agreed extras are excluded.</p><a class="button" href="/booking">Check your group price</a></aside><aside class="cross-sell"><div><h3 data-i18n="camping_cross_title">Only have one day in Materuni?</h3><p data-i18n="camping_cross_intro">Explore the waterfall, coffee and Chagga culture with one of our guided day trips.</p></div><a class="button" href="/day-trips" data-i18n="camping_cross_cta">Explore day trips</a></aside><p class="note">Door-to-door private transfers available: Moshi ($25/vehicle), Kilimanjaro Airport KIA ($50/vehicle) or Arusha ($80/vehicle) can be selected directly when you book. A booking request is not confirmed until your host replies with availability and final arrangements.</p></section>
<section class="section" style="background:#FAF7F2;padding:40px 20px"><div class="heading"><span class="kicker">FROM THE JOURNAL</span><h2>Stories & tips from the camp</h2><p>Read what to expect during an authentic night in Materuni Village: <a href="/journal/staying-overnight-in-materuni" style="color:#1a3322;font-weight:700;text-decoration:underline">Staying Overnight in Materuni: What to Expect</a> and plan your journey with <a href="/journal/how-to-get-to-materuni" style="color:#1a3322;font-weight:700;text-decoration:underline">How to Get to Materuni Village from Moshi, Arusha and KIA</a>.</p></div></section>
<section class="final"><span class="kicker" data-i18n="camping_final_kicker">COME AS A GUEST. LEAVE AS A FRIEND.</span><h2 data-i18n="camping_final_title">Let Materuni be more than a day on your itinerary.</h2><p data-i18n="camping_final_intro">Tell us when you would like to stay and we will help you plan the next step.</p><div class="actions" style="justify-content:center"><a class="button light" href="/booking?source=camping&experience=camping" data-i18n="camping_final_cta">Check camping availability</a><a class="button secondary" href="https://wa.me/255612068540" target="_blank" rel="noopener noreferrer" data-i18n="camping_final_whatsapp">WhatsApp your host</a></div></section>
</div>

<!-- Sticky Mobile Booking Bar (T6) -->
