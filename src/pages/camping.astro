---
import SiteLayout from "../layouts/SiteLayout.astro";
import { supabaseUrl } from "../lib/supabase-public";
const base = `${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const hero = base + "camping_image/1791601872981-zmji0mykwhd.jpg";
---
<SiteLayout title="Materuni Camping | Overnight Village Stay near Kilimanjaro" description="Stay overnight in Materuni Village with local Chagga hosts. Discover waterfall trails, coffee traditions, village food and a relaxed evening around camp in the Kilimanjaro foothills." preloadImage={hero}>
<style>
.camp{color:#30372f}.camp-hero{display:grid;grid-template-columns:1fr 1fr;min-height:570px;background:#1a3322}.camp-copy{padding:clamp(38px,7vw,96px);display:flex;flex-direction:column;justify-content:center;color:#fff}.camp-copy h1{color:#fff;font-size:clamp(46px,6vw,76px);line-height:.98;max-width:10ch;margin:18px 0}.camp-copy p{color:#e5e9e3;max-width:56ch;line-height:1.85}.camp-media{min-height:420px;background:#263e2d center/cover}.kicker{font:800 10px/1.5 Manrope,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#d9bd83}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}.actions .button{min-height:52px}.proof{display:grid;grid-template-columns:repeat(3,1fr);background:#f5f0e7}.proof div{text-align:center;padding:20px;border-right:1px solid #e1d9cb}.proof strong{display:block;font:600 25px Cormorant Garamond,serif;color:#1a3322}.proof span{font:800 10px Manrope,sans-serif;letter-spacing:.08em;color:#687168;text-transform:uppercase}.section{padding:clamp(52px,7vw,90px) clamp(22px,7vw,100px)}.story{display:grid;grid-template-columns:1fr 1fr;gap:clamp(25px,5vw,68px);align-items:center;max-width:1180px;margin:auto}.story img{width:100%;height:100%;max-height:520px;aspect-ratio:4/5;object-fit:cover;border-radius:16px}.story h2,.heading h2{font-size:clamp(34px,4.5vw,54px)}.story p,.heading p{color:#657066;line-height:1.85}.list{list-style:none;padding:0;margin:22px 0}.list li{padding:11px 0 11px 28px;position:relative;border-bottom:1px solid #e9e3d9;line-height:1.6}.list li:before{content:"✓";position:absolute;left:0;color:#8a6a34;font-weight:900}.heading{text-align:center;max-width:760px;margin:0 auto 36px}.heading p{margin:0 auto}.offers{display:grid;grid-template-columns:1fr 1fr;gap:22px;max-width:1180px;margin:auto}.offer{background:white;border:1px solid #e7dfd2;border-radius:17px;overflow:hidden;box-shadow:0 12px 30px #1a33220d}.offer img{width:100%;height:250px;object-fit:cover}.offer-body{padding:25px}.offer h3{font-size:29px;margin:10px 0}.price{font:600 34px Cormorant Garamond,serif;color:#1a3322}.price small{font:800 10px Manrope,sans-serif;letter-spacing:.1em;color:#687168}.offer p,.note{color:#657066;line-height:1.8}.cross-sell{max-width:1180px;margin:34px auto 0;padding:26px 30px;display:flex;align-items:center;justify-content:space-between;gap:20px;background:#fff;border:1px solid #e2d9ca;border-left:4px solid #c5a059;border-radius:12px}.cross-sell h3{font:600 26px Cormorant Garamond,serif;color:#1a3322;margin:0 0 5px}.cross-sell p{font-size:13px;color:#657066;line-height:1.7;margin:0}.faq{max-width:850px;margin:auto}.faq details{padding:18px 0;border-bottom:1px solid #e4ddd1}.faq summary{font-weight:800;color:#1a3322;cursor:pointer}.faq details p{color:#687168;line-height:1.8}.final{background:#1a3322;color:#fff;text-align:center;padding:70px 22px}.final h2{color:#fff;font-size:clamp(36px,5vw,56px);max-width:17ch;margin:0 auto 14px}.final p{color:#e1e7e0;margin:0 auto;line-height:1.8}@media(max-width:800px){.camp-hero,.story{grid-template-columns:1fr}.camp-media{min-height:330px;grid-row:1}.camp-copy{padding:52px 23px}.proof{grid-template-columns:1fr}.proof div{border-bottom:1px solid #e1d9cb}.offers{grid-template-columns:1fr}}@media(max-width:560px){.cross-sell{display:block;padding:22px}.cross-sell .button{display:flex;margin-top:15px;justify-content:center}.camp-copy h1{font-size:clamp(44px,12vw,58px)}.actions{display:grid}.actions .button{width:100%}.story img{aspect-ratio:4/3}.section{padding-inline:20px}}
</style>
<div class="camp">
<section class="camp-hero" aria-labelledby="camping-title"><div class="camp-copy"><span class="kicker">SLEEP IN THE FOOTHILLS · MATERUNI VILLAGE</span><h1 id="camping-title">Stay a little longer. Feel a little closer.</h1><p>Trade a rushed stop for a night in Materuni. Wake beneath the green slopes of Kilimanjaro, share Chagga food and coffee traditions, follow forest paths and spend the evening around camp with your local hosts.</p><div class="actions"><a class="button light" href="/booking?source=camping&experience=Camping%20%26%20Village%20Life">Check camping dates</a><a class="button secondary" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%27m%20interested%20in%20overnight%20camping.%20Please%20share%20dates%20and%20details." target="_blank" rel="noopener noreferrer">Plan with a local host</a></div></div><div class="camp-media" role="img" aria-label="Materuni village overnight camping experience" style={`background-image:url("${hero}")`}></div></section>
<div class="proof"><div><strong>1 night</strong><span>A slower Materuni stay</span></div><div><strong>$110</strong><span>Per person · published rate</span></div><div><strong>Local hosts</strong><span>Chagga village connection</span></div></div>
<section class="section"><div class="story"><img src={base+"story_image/1791601761441-q3iog8mni3r.jpg"} alt="Coffee traditions shared with local Materuni hosts" loading="lazy" width="700" height="850"><div><span class="kicker">MORE THAN A PLACE TO SLEEP</span><h2>A village evening, not just an overnight stop.</h2><p>Camping is the centre of this experience. The day gives you time to discover the waterfall and village; the evening creates space for food, conversation and the rhythms of local life. It is an invitation to slow down and experience Materuni with care.</p><ul class="list"><li>Overnight camping with gear setup</li><li>Guided waterfall and village experience</li><li>Chagga cooking, local dinner and breakfast</li><li>Campfire stories and time with local hosts</li></ul><a class="button" href="/booking?source=camping&experience=Camping%20%26%20Village%20Life">Request your camping stay</a></div></div></section>
<section class="section" style="background:#f1ece3"><div class="heading"><span class="kicker">CHOOSE YOUR WAY TO STAY</span><h2>Make one night the heart of your Materuni visit.</h2><p>Choose the overnight camping stay or combine it with more foothills and village experiences. Your host can help shape the details around your dates and group.</p></div><div class="offers">
<article class="offer"><img src={hero} alt="Materuni village camping stay" loading="lazy" width="700" height="430"><div class="offer-body"><span class="kicker">FLAGSHIP OVERNIGHT STAY</span><h3>Materuni Village Overnight Camping</h3><div class="price">$110 <small>PER PERSON</small></div><p>A night in the village with camping, waterfall and cultural experiences, local food and time with your hosts.</p><ul class="list"><li>Camping gear setup</li><li>Waterfall and village experience</li><li>Local dinner and breakfast</li><li>Campfire stories and hosting</li></ul><a class="button" href="/booking?source=camping&experience=Camping%20%26%20Village%20Life">Check dates</a></div></article>
<article class="offer"><img src={base+"ultimate_image/1791604660208-7c4yvzvsaf9.jpg"} alt="Materuni waterfall and cultural experiences" loading="lazy" width="700" height="430"><div class="offer-body"><span class="kicker">A FULLER MATERUNI JOURNEY</span><h3>Ultimate Foothills Experience</h3><div class="price">$135 <small>PER PERSON</small></div><p>Bring together the waterfall, Chagga cooking, coffee traditions and an overnight camp in one fuller visit.</p><ul class="list"><li>Scenic waterfall hike</li><li>Hands-on Chagga cooking</li><li>Organic coffee experience</li><li>Overnight camping and meals</li></ul><a class="button" href="/booking?source=camping&experience=The%20Ultimate%20Kilimanjaro%20Foothills%20%26%20Materuni%20Experience">Explore this stay</a></div></article>
</div><aside class="cross-sell"><div><h3>Only have one day in Materuni?</h3><p>Explore the waterfall, coffee and Chagga culture with one of our guided day trips.</p></div><a class="button" href="/day-trips">Explore day trips</a></aside><p class="note">Prices are per person and reflect currently published package rates. Transport to and from Materuni, personal purchases and tips are not included unless agreed separately. A booking request is not confirmed until your host replies with availability and final arrangements.</p></section>
<section class="section"><div class="heading"><span class="kicker">GOOD TO KNOW</span><h2>Before you arrive</h2><p>We want you to know what to expect, so you can arrive relaxed and ready to enjoy the village.</p></div><div class="faq"><details><summary>Is camping suitable for first-time visitors?</summary><p>Yes. Share your travel dates, group size and questions with your host. We will explain the arrangements and what to bring before confirming.</p></details><details><summary>Is transport included?</summary><p>Transport is not included in the displayed rate unless arranged separately. Tell us your pickup point when you enquire.</p></details><details><summary>What should I bring?</summary><p>Bring comfortable walking shoes, a light rain layer and personal toiletries. Your host can clarify the camping setup for your selected date.</p></details><details><summary>How do I secure a date?</summary><p>Send a booking request with your preferred date and group size. A local host will check availability and confirm the details with you.</p></details></div></section>
<section class="final"><span class="kicker">COME AS A GUEST. LEAVE AS A FRIEND.</span><h2>Let Materuni be more than a day on your itinerary.</h2><p>Tell us when you would like to stay and we will help you plan the next step.</p><div class="actions" style="justify-content:center"><a class="button light" href="/booking?source=camping&experience=Camping%20%26%20Village%20Life">Check camping availability</a><a class="button secondary" href="https://wa.me/255612068540" target="_blank" rel="noopener noreferrer">WhatsApp your host</a></div></section>
</div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"Materuni Village Overnight Camping","description":"An overnight village camping stay with local Chagga hosts in Materuni, including a guided waterfall and cultural experience.","provider":{"@type":"Organization","name":"Materuni Hosts","url":"https://materunihosts.com"},"areaServed":{"@type":"Place","name":"Materuni Village, Kilimanjaro Region, Tanzania"},"offers":[{"@type":"Offer","price":"110","priceCurrency":"USD","description":"Per person"},{"@type":"Offer","price":"135","priceCurrency":"USD","description":"Ultimate Foothills Experience, per person"}]}</script>
</SiteLayout>