---
import SiteLayout from "../layouts/SiteLayout.astro";
import { supabaseUrl } from "../lib/supabase-public";
const community = `${supabaseUrl}/storage/v1/object/public/materuni-images/story_image/1791995912146-materuni-community.jpg`;
---
<SiteLayout title="About Us | Materuni Hosts – Founded by Saidi Materu" description="Meet Materuni Hosts, founded by Saidi Materu. Discover our local approach to Materuni waterfall tours, Chagga coffee, cooking, village culture and day trips around Kilimanjaro, Tanzania." canonicalOverride="/about-us">
<main class="about-page">
<section class="about-hero">
  <div class="about-hero-copy">
    <p class="eyebrow">ABOUT MATERUNI HOSTS · MATERUNI VILLAGE</p>
    <h1>Experience Materuni through the people who call it home.</h1>
    <p>Materuni Hosts was founded by <strong>Saidi Materu</strong> with a simple purpose: to welcome visitors to discover the natural beauty, culture and everyday life of Materuni Village in a thoughtful and personal way.</p>
    <p>Based in the foothills of Mount Kilimanjaro, near Moshi, we bring guests closer to the place through local experiences, genuine hospitality and time spent exploring with people who know the area.</p>
    <div class="actions"><a class="button" href="/experiences">Explore our experiences</a><a class="text-link" href="/booking">Plan your visit</a></div>
  </div>
  <img src={community} alt="Local community life in Materuni Village, Tanzania" width="900" height="760" loading="eager" fetchpriority="high" decoding="async" />
</section>

<section class="founder-section">
  <div class="founder-copy">
    <p class="eyebrow">A NOTE ABOUT OUR FOUNDER</p>
    <h2>Founded by Saidi Materu.</h2>
    <p>Materuni Hosts was established by Saidi Materu to help visitors experience more than a destination. The idea is to create opportunities for guests to connect with Materuni: its landscapes, its people, its food and the traditions that shape local life.</p>
    <p>That local perspective guides how we welcome guests and shape our experiences. We want visitors to feel comfortable asking questions, learning at their own pace and understanding the place with respect. Every visit should feel personal, well explained and thoughtfully arranged.</p>
    <p>Our story is closely connected to Materuni itself. Rather than offering only one kind of tour, we invite guests to choose from a range of experiences that reveal different sides of the village and the wider Kilimanjaro area.</p>
  </div>
  <aside class="founder-note"><span>OUR PURPOSE</span><p>To share the beauty and culture of Materuni through welcoming, meaningful experiences led with local knowledge and respect.</p></aside>
</section>

<section class="about-intro">
  <p class="eyebrow">WHO WE ARE</p>
  <h2>A local team, a personal welcome.</h2>
  <p>Materuni Hosts is a locally hosted tourism business based in Materuni Village, in Tanzania’s Kilimanjaro Region. We help travellers discover the area through a balanced range of nature, cultural and day-trip experiences.</p>
  <p>We believe a good visit begins with clear information and a warm welcome. Before choosing an experience, guests should be able to understand what it involves, how much time to allow and what is included. We aim to make planning straightforward and the experience itself relaxed, informative and enjoyable.</p>
  <p>Whether you are visiting for a few hours or spending more time in the area, we want you to leave with a deeper appreciation of Materuni and the people and traditions that make it special.</p>
</section>

<section class="values-section">
  <div class="section-heading"><p class="eyebrow">WHAT MATTERS TO US</p><h2>The principles behind every visit.</h2></div>
  <div class="values-grid">
    <article><span>01</span><h3>Local connection</h3><p>We place local hosts, knowledge and perspectives at the heart of the guest experience.</p></article>
    <article><span>02</span><h3>Respect for culture</h3><p>We share Chagga traditions and everyday village life with care, openness and respect.</p></article>
    <article><span>03</span><h3>Care for nature</h3><p>We encourage visitors to appreciate the landscapes and natural environment of Materuni responsibly.</p></article>
    <article><span>04</span><h3>Clear communication</h3><p>We aim to explain each experience, its inclusions and arrangements clearly before guests book.</p></article>
  </div>
</section>

<section class="experience-section">
  <div class="section-heading"><p class="eyebrow">EXPLORE WITH MATERUNI HOSTS</p><h2>Many ways to discover the area.</h2><p>Every traveller is different. Choose the experience that matches your interests, schedule and sense of adventure.</p></div>
  <div class="experience-grid">
    <article><h3>Materuni Waterfall and nature walks</h3><p>Walk through the green highland landscape and discover the impressive Materuni Waterfall with a local guide.</p><a href="/materuni-waterfall-tour">Explore waterfall tours</a></article>
    <article><h3>Chagga coffee experience</h3><p>Discover local coffee traditions and take part in the process of preparing coffee, from the beans to your cup.</p><a href="/materuni-coffee-tour">Explore coffee experiences</a></article>
    <article><h3>Cooking and local food</h3><p>Get closer to local food culture through a hands-on cooking experience and the flavours of the area.</p><a href="/experiences">Explore food experiences</a></article>
    <article><h3>Village and cultural experiences</h3><p>Spend time learning about village life, local stories and the cultural traditions of the Chagga community.</p><a href="/experiences">Discover cultural experiences</a></article>
    <article><h3>Day trips around Kilimanjaro</h3><p>Explore selected places around the region, including nature, water and cultural destinations near Moshi.</p><a href="/day-trips">View day trips</a></article>
    <article><h3>Overnight and outdoor experiences</h3><p>Make more time for the landscape with an outdoor stay and an opportunity to enjoy the quieter side of the area.</p><a href="/experiences">See all experiences</a></article>
  </div>
</section>

<section class="about-next">
  <p class="eyebrow">YOUR VISIT STARTS HERE</p>
  <h2>We would be glad to welcome you to Materuni.</h2>
  <p>Browse the experiences, compare the details and send us a booking request. We will follow up to confirm availability and discuss the arrangements before your booking is final.</p>
  <div class="actions"><a class="button" href="/experiences">View all experiences</a><a class="text-link" href="/booking">Make a booking request</a></div>
</section>
</main>
</SiteLayout>
<style>
.about-page{color:#242421}.about-page .about-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(280px,.95fr);gap:clamp(28px,5vw,68px);align-items:center;padding:clamp(48px,7vw,88px) clamp(22px,7vw,100px);background:#1a3322;color:#faf7f2}.about-page .about-hero img{width:100%;height:clamp(280px,38vw,470px);object-fit:cover;border-radius:16px}.about-page .eyebrow{color:#b38a43;font:800 11px Manrope,sans-serif;letter-spacing:.16em;text-transform:uppercase}.about-page h1,.about-page h2{font-family:"Cormorant Garamond",serif;font-weight:600;line-height:1.05}.about-page h1{font-size:clamp(44px,6vw,72px);margin:14px 0}.about-page .about-hero h1{color:#faf7f2!important;text-shadow:0 1px 1px #00000020}.about-page h2{font-size:clamp(34px,4.5vw,52px);color:#1a3322;margin:10px 0 18px}.about-page h3{color:#1a3322;font:700 17px Manrope,sans-serif}.about-page p{color:#586258;line-height:1.85}.about-page .about-hero p:not(.eyebrow){max-width:680px;color:#e6dfd3}.about-page .about-hero strong{color:#fff}.about-page .actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:24px}.about-page .button{display:inline-block;padding:13px 21px;border-radius:999px;background:#c5a059;color:#1a3322;text-decoration:none;font:800 13px Manrope,sans-serif}.about-page .text-link{color:inherit;font-weight:800;text-underline-offset:4px}.about-page .founder-section{max-width:1160px;margin:auto;padding:clamp(48px,7vw,82px) 24px;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,.7fr);gap:clamp(28px,6vw,76px);align-items:center}.about-page .founder-note{padding:30px;background:#f3eee5;border-radius:16px;border-left:3px solid #c5a059}.about-page .founder-note span,.about-page .values-grid article span{font:800 11px Manrope,sans-serif;letter-spacing:.15em;color:#9a7538}.about-page .founder-note p{font:600 22px "Cormorant Garamond",serif;color:#1a3322;line-height:1.4}.about-page .about-intro,.about-page .values-section,.about-page .experience-section,.about-page .about-next{max-width:1160px;margin:auto;padding:clamp(44px,6vw,76px) 24px}.about-page .about-intro{max-width:900px}.about-page .section-heading{max-width:760px;margin-bottom:26px}.about-page .values-grid,.about-page .experience-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.about-page .values-grid article,.about-page .experience-grid article{padding:24px;border:1px solid #e6dfd3;border-radius:16px;background:#fff}.about-page .values-grid article h3,.about-page .experience-grid article h3{margin:12px 0}.about-page .experience-grid article a{color:#1a3322;font-weight:800;text-underline-offset:4px}.about-page .about-next{text-align:center;max-width:820px}.about-page .about-next .actions{justify-content:center}@media(max-width:760px){.about-page .about-hero{grid-template-columns:1fr;padding:48px 22px}.about-page .about-hero img{height:260px}.about-page .founder-section{grid-template-columns:1fr}.about-page .values-grid,.about-page .experience-grid{grid-template-columns:1fr}}
</style>
