---
import SiteLayout from "../layouts/SiteLayout.astro";
import { supabaseUrl, publishableKey } from "../lib/supabase-public";

const defaultCommunity = `${supabaseUrl}/storage/v1/object/public/materuni-images/story_image/1791995912146-materuni-community.jpg`;

const defaultTeam = [
  {
    name: "Saidi Materu",
    role: "Founder & Lead Mountain Host",
    bio: "Lifelong Materuni resident with 12+ years sharing Chagga history, waterfall trekking, and coffee culture.",
    image: defaultCommunity
  },
  {
    name: "Elia",
    role: "Chagga Coffee Specialist",
    bio: "Guiding the artisanal roasting ceremony over woodfire with ancestral songs and pestle grinding.",
    image: `${supabaseUrl}/storage/v1/object/public/materuni-images/coffee_image/1791998412318-materuni-tour.jpg`
  },
  {
    name: "Amani",
    role: "Forest & Trail Guide",
    bio: "Expert on native Kilimanjaro plants, birdlife, waterfall safety, and the scenic foothills paths.",
    image: `${supabaseUrl}/storage/v1/object/public/materuni-images/story_image/1791601761441-q3iog8mni3r.jpg`
  }
];

let dynamic: any = null;
try {
  const res = await fetch(`${supabaseUrl}/rest/v1/site_settings?select=setting_value&setting_key=eq.about_us_content`, {
    headers: { apikey: publishableKey, Authorization: `Bearer ${publishableKey}` }
  });
  if (res.ok) {
    const rows = await res.json();
    if (rows?.[0]?.setting_value) {
      dynamic = typeof rows[0].setting_value === "string" ? JSON.parse(rows[0].setting_value) : rows[0].setting_value;
    }
  }
} catch (e) {
  // Use rich static defaults
}

const heroEyebrow = dynamic?.heroEyebrow || "ABOUT MATERUNI HOSTS · MATERUNI VILLAGE";
const heroTitle = dynamic?.heroTitle || "Experience Materuni through the people who call it home.";
const heroP1 = dynamic?.heroP1 || "Materuni Hosts was founded by Saidi Materu with a simple purpose: to welcome visitors to discover the natural beauty, culture and everyday life of Materuni Village in a thoughtful and personal way.";
const heroP2 = dynamic?.heroP2 || "Based in the foothills of Mount Kilimanjaro, near Moshi, we bring guests closer to the place through local experiences, genuine hospitality and time spent exploring with people who know the area.";
const heroImage = dynamic?.heroImage || defaultCommunity;

const founderEyebrow = dynamic?.founderEyebrow || "A NOTE ABOUT OUR FOUNDER";
const founderTitle = dynamic?.founderTitle || "Founded by Saidi Materu.";
const founderP1 = dynamic?.founderP1 || "Materuni Hosts was established by Saidi Materu to help visitors experience more than a destination. The idea is to create opportunities for guests to connect with Materuni: its landscapes, its people, its food and the traditions that shape local life.";
const founderP2 = dynamic?.founderP2 || "That local perspective guides how we welcome guests and shape our experiences. We want visitors to feel comfortable asking questions, learning at their own pace and understanding the place with respect. Every visit should feel personal, well explained and thoughtfully arranged.";
const founderP3 = dynamic?.founderP3 || "Our story is closely connected to Materuni itself. Rather than offering only one kind of tour, we invite guests to choose from a range of experiences that reveal different sides of the village and the wider Kilimanjaro area.";
const founderPurpose = dynamic?.founderPurpose || "To share the beauty and culture of Materuni through welcoming, meaningful experiences led with local knowledge and respect.";

const team = Array.isArray(dynamic?.team) && dynamic.team.length ? dynamic.team : defaultTeam;

const val1Title = dynamic?.val1Title || "Local connection";
const val1Desc = dynamic?.val1Desc || "We place local hosts, knowledge and perspectives at the heart of the guest experience.";
const val2Title = dynamic?.val2Title || "Respect for culture";
const val2Desc = dynamic?.val2Desc || "We share Chagga traditions and everyday village life with care, openness and respect.";
const val3Title = dynamic?.val3Title || "Care for nature";
const val3Desc = dynamic?.val3Desc || "We encourage visitors to appreciate the landscapes and natural environment of Materuni responsibly.";
const val4Title = dynamic?.val4Title || "Clear communication";
const val4Desc = dynamic?.val4Desc || "We aim to explain each experience, its inclusions and arrangements clearly before guests book.";

const communityNote = dynamic?.communityNote || "Authentic local Chagga hosts born and raised in Materuni Village · Moshi, Kilimanjaro, Tanzania";
---
<SiteLayout title="About Us | Materuni Hosts – Founded by Saidi Materu" description="Meet Materuni Hosts, founded by Saidi Materu. Discover local waterfall tours, Chagga coffee and cooking, village culture and day trips near Kilimanjaro." canonicalOverride="/about-us" preloadImage={community}>
<main class="about-page">
<!-- Hero Section -->
<section class="about-hero">
  <div class="about-hero-copy">
    <p class="eyebrow" id="about-hero-eyebrow-el">{heroEyebrow}</p>
    <h1 id="about-hero-title-el">{heroTitle}</h1>
    <p id="about-hero-p1-el" set:html={heroP1.replace("Saidi Materu", "<strong>Saidi Materu</strong>")}></p>
    <p id="about-hero-p2-el">{heroP2}</p>
    <div class="actions">
      <a class="button" href="/experiences">Explore our experiences</a>
      <a class="text-link" href="/booking">Plan your visit</a>
    </div>
  </div>
  <div class="about-hero-image-wrap">
    <img id="about-hero-img-el" src={heroImage} alt="Local community life in Materuni Village, Tanzania" width="900" height="760" loading="eager" fetchpriority="high" decoding="async" />
  </div>
</section>

<!-- Impact Metrics Strip -->
<section class="village-metrics-strip" aria-label="Village commitments and hosting metrics">
  <div class="metrics-grid">
    <div class="metric-item">
      <strong>100%</strong>
      <span>Chagga Hosted & Operated</span>
    </div>
    <div class="metric-item">
      <strong>12+ Yrs</strong>
      <span>Guiding Mount Kilimanjaro Slopes</span>
    </div>
    <div class="metric-item">
      <strong>95 Metres</strong>
      <span>Pristine Materuni Waterfall</span>
    </div>
    <div class="metric-item">
      <strong>Direct</strong>
      <span>Village Community Benefit</span>
    </div>
  </div>
</section>

<!-- Founder Section -->
<section class="founder-section">
  <div class="founder-copy">
    <p class="eyebrow" id="about-founder-eyebrow-el">{founderEyebrow}</p>
    <h2 id="about-founder-title-el">{founderTitle}</h2>
    <p id="about-founder-p1-el">{founderP1}</p>
    <p id="about-founder-p2-el">{founderP2}</p>
    <p id="about-founder-p3-el">{founderP3}</p>
  </div>
  <aside class="founder-note">
    <span>OUR PURPOSE</span>
    <p id="about-founder-purpose-el">{founderPurpose}</p>
  </aside>
</section>

<!-- Team & Local Guides Section -->
<section class="about-intro">
  <div class="section-heading" style="text-align:center;margin:0 auto 32px">
    <p class="eyebrow">WHO WE ARE</p>
    <h2>A local team, a personal welcome.</h2>
    <p style="max-width:720px;margin:0 auto">Materuni Hosts is a locally hosted tourism business based in Materuni Village, in Tanzania’s Kilimanjaro Region. We believe a good visit begins with clear information, genuine warmth, and knowledgeable local guidance.</p>
  </div>
  
  <div class="team-grid" id="about-team-grid">
    {team.map((host: any) => (
      <div class="team-card">
        <img src={host.image || defaultCommunity} alt={`${host.name} local host in Materuni`} width="130" height="130" loading="lazy" decoding="async" class="host-avatar" />
        <h3>{host.name}</h3>
        <span class="host-role">{host.role}</span>
        <p class="host-bio">{host.bio}</p>
      </div>
    ))}
  </div>

  <div class="community-callout">
    <p id="about-community-note-el">{communityNote}</p>
  </div>
</section>

<!-- Values Section -->
<section class="values-section">
  <div class="section-heading">
    <p class="eyebrow">WHAT MATTERS TO US</p>
    <h2>The principles behind every visit.</h2>
  </div>
  <div class="values-grid">
    <article>
      <span>01</span>
      <h3>{val1Title}</h3>
      <p>{val1Desc}</p>
    </article>
    <article>
      <span>02</span>
      <h3>{val2Title}</h3>
      <p>{val2Desc}</p>
    </article>
    <article>
      <span>03</span>
      <h3>{val3Title}</h3>
      <p>{val3Desc}</p>
    </article>
    <article>
      <span>04</span>
      <h3>{val4Title}</h3>
      <p>{val4Desc}</p>
    </article>
  </div>
</section>

<!-- Experience Collection Section -->
<section class="experience-section">
  <div class="section-heading">
    <p class="eyebrow">EXPLORE WITH MATERUNI HOSTS</p>
    <h2>Many ways to discover the area.</h2>
    <p>Every traveller is different. Choose the experience that matches your interests, schedule and sense of adventure.</p>
  </div>
  <div class="experience-grid">
    <article>
      <h3>Materuni Waterfall and nature walks</h3>
      <p>Walk through the green highland landscape and discover the impressive Materuni Waterfall with a local guide.</p>
      <a href="/materuni-waterfall-tour">Explore waterfall tours</a>
    </article>
    <article>
      <h3>Chagga coffee experience</h3>
      <p>Discover local coffee traditions and take part in the process of preparing coffee, from the beans to your cup.</p>
      <a href="/materuni-coffee-tour">Explore coffee experiences</a>
    </article>
    <article>
      <h3>Cooking and local food</h3>
      <p>Get closer to local food culture through a hands-on cooking experience and the flavours of the area.</p>
      <a href="/experiences">Explore food experiences</a>
    </article>
    <article>
      <h3>Village and cultural experiences</h3>
      <p>Spend time learning about village life, local stories and the cultural traditions of the Chagga community.</p>
      <a href="/chagga-cultural-tour">Discover cultural experiences</a>
    </article>
    <article>
      <h3>Day trips around Kilimanjaro</h3>
      <p>Explore selected places around the region, including nature, water and cultural destinations near Moshi.</p>
      <a href="/day-trips">View day trips</a>
    </article>
    <article>
      <h3>Overnight and outdoor experiences</h3>
      <p>Make more time for the landscape with an outdoor stay and an opportunity to enjoy the quieter side of the area.</p>
      <a href="/camping">See camping experiences</a>
    </article>
  </div>
</section>

<!-- Call to Action -->
<section class="about-next">
  <p class="eyebrow">YOUR VISIT STARTS HERE</p>
  <h2>We would be glad to welcome you to Materuni.</h2>
  <p>Browse the experiences, compare the details and send us a booking request. We will follow up to confirm availability and discuss the arrangements before your booking is final.</p>
  <div class="actions">
    <a class="button" href="/experiences">View all experiences</a>
    <a class="text-link" href="/booking">Make a booking request</a>
  </div>
</section>
</main>
</SiteLayout>

<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../lib/supabase-public";

// Client-side hydration for real-time updates from admin
try {
  fetch(`${supabaseUrl}/rest/v1/site_settings?select=setting_value&setting_key=eq.about_us_content`, {
    headers: { apikey: publishableKey, Authorization: "Bearer " + publishableKey }
  }).then(r => r.json()).then(rows => {
    const val = rows?.[0]?.setting_value;
    if (!val) return;
    const data = typeof val === "string" ? JSON.parse(val) : val;
    if (!data) return;

    const setTxt = (id, str) => {
      const el = document.getElementById(id);
      if (el && typeof str === "string" && str.trim()) el.textContent = str;
    };

    setTxt("about-hero-eyebrow-el", data.heroEyebrow);
    setTxt("about-hero-title-el", data.heroTitle);
    if (data.heroP1 && document.getElementById("about-hero-p1-el")) {
      document.getElementById("about-hero-p1-el").innerHTML = data.heroP1.replace("Saidi Materu", "<strong>Saidi Materu</strong>");
    }
    setTxt("about-hero-p2-el", data.heroP2);
    if (data.heroImage && document.getElementById("about-hero-img-el")) {
      document.getElementById("about-hero-img-el").src = data.heroImage;
    }

    setTxt("about-founder-eyebrow-el", data.founderEyebrow);
    setTxt("about-founder-title-el", data.founderTitle);
    setTxt("about-founder-p1-el", data.founderP1);
    setTxt("about-founder-p2-el", data.founderP2);
    setTxt("about-founder-p3-el", data.founderP3);
    setTxt("about-founder-purpose-el", data.founderPurpose);
    setTxt("about-community-note-el", data.communityNote);

    // If dynamic team members are present
    if (Array.isArray(data.team) && data.team.length && document.getElementById("about-team-grid")) {
      const grid = document.getElementById("about-team-grid");
      grid.replaceChildren();
      data.team.forEach(host => {
        const card = document.createElement("div");
        card.className = "team-card";
        
        const img = document.createElement("img");
        img.src = host.image || data.heroImage || "";
        img.alt = `${host.name} local host in Materuni`;
        img.width = 130;
        img.height = 130;
        img.loading = "lazy";
        img.decoding = "async";
        img.className = "host-avatar";

        const h3 = document.createElement("h3");
        h3.textContent = host.name;

        const role = document.createElement("span");
        role.className = "host-role";
        role.textContent = host.role;

        const bio = document.createElement("p");
        bio.className = "host-bio";
        bio.textContent = host.bio;

        card.append(img, h3, role, bio);
        grid.append(card);
      });
    }
  }).catch(() => {});
} catch {}
</script>

<style>
.about-page {
  color: #242421;
}
.about-page .about-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(280px, .95fr);
  gap: clamp(28px, 5vw, 68px);
  align-items: center;
  padding: clamp(48px, 7vw, 88px) clamp(22px, 7vw, 100px);
  background: #1A3322;
  color: #FAF7F2;
}
.about-page .about-hero-image-wrap img {
  width: 100%;
  height: clamp(280px, 38vw, 470px);
  object-fit: cover;
  border-radius: 16px;
  box-shadow: 0 16px 36px rgba(0,0,0,0.25);
}
.about-page .eyebrow {
  color: #755523;
  font: 800 11px Manrope, sans-serif;
  letter-spacing: .16em;
  text-transform: uppercase;
}
.about-page .about-hero .eyebrow {
  color: #E0C17C;
}
.about-page h1, .about-page h2 {
  font-family: "Cormorant Garamond", serif;
  font-weight: 600;
  line-height: 1.05;
}
.about-page h1 {
  font-size: clamp(44px, 6vw, 72px);
  margin: 14px 0;
}
.about-page .about-hero h1 {
  color: #FAF7F2 !important;
  text-shadow: 0 1px 1px #00000020;
}
.about-page h2 {
  font-size: clamp(34px, 4.5vw, 52px);
  color: #1A3322;
  margin: 10px 0 18px;
}
.about-page h3 {
  color: #1A3322;
  font: 700 17px Manrope, sans-serif;
}
.about-page p {
  color: #586258;
  line-height: 1.85;
}
.about-page .about-hero p:not(.eyebrow) {
  max-width: 680px;
  color: #E6DFD3;
}
.about-page .about-hero strong {
  color: #fff;
}
.about-page .actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
  margin-top: 24px;
}
.about-page .button {
  display: inline-block;
  padding: 13px 24px;
  border-radius: 999px;
  background: #C5A059;
  color: #1A3322;
  text-decoration: none;
  font: 800 13px Manrope, sans-serif;
  transition: transform 0.15s ease, background-color 0.15s ease;
}
.about-page .button:hover {
  background: #D4B26F;
  transform: translateY(-1px);
}
.about-page .text-link {
  color: inherit;
  font-weight: 800;
  text-underline-offset: 4px;
}

/* Village Metrics Strip */
.village-metrics-strip {
  background: #FAF7F2;
  border-bottom: 1px solid #E6DFD3;
  padding: 32px 24px;
}
.metrics-grid {
  max-width: 1160px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}
.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 4px;
}
.metric-item strong {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(28px, 3.5vw, 40px);
  color: #1A3322;
  line-height: 1.1;
}
.metric-item span {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #755523;
}
@media (max-width: 760px) {
  .metrics-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
  }
}

.about-page .founder-section {
  max-width: 1160px;
  margin: auto;
  padding: clamp(48px, 7vw, 82px) 24px;
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(240px, .7fr);
  gap: clamp(28px, 6vw, 76px);
  align-items: center;
}
.about-page .founder-note {
  padding: 32px;
  background: #F3EEE5;
  border-radius: 16px;
  border-left: 3px solid #C5A059;
}
.about-page .founder-note span, .about-page .values-grid article span {
  font: 800 11px Manrope, sans-serif;
  letter-spacing: .15em;
  color: #755523;
}
.about-page .founder-note p {
  font: 600 22px "Cormorant Garamond", serif;
  color: #1A3322;
  line-height: 1.4;
  margin: 10px 0 0;
}

.about-page .about-intro, .about-page .values-section, .about-page .experience-section, .about-page .about-next {
  max-width: 1160px;
  margin: auto;
  padding: clamp(44px, 6vw, 76px) 24px;
}
.about-page .section-heading {
  max-width: 760px;
  margin-bottom: 26px;
}

/* Team Grid */
.team-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
  margin: 36px 0;
}
.team-card {
  background: #fff;
  border: 1px solid #E6DFD3;
  border-radius: 16px;
  padding: 28px 24px;
  text-align: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.team-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 28px rgba(0,0,0,0.06);
}
.host-avatar {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  object-fit: cover;
  margin: 0 auto 16px;
  border: 3px solid #C5A059;
  box-shadow: 0 4px 14px rgba(0,0,0,0.08);
}
.team-card h3 {
  margin: 0 0 4px;
  font-size: 20px;
  color: #1A3322;
}
.host-role {
  display: block;
  color: #755523;
  font: 800 11px Manrope, sans-serif;
  letter-spacing: .1em;
  text-transform: uppercase;
  margin-bottom: 12px;
}
.host-bio {
  font-size: 13px;
  line-height: 1.65;
  color: #586258;
  margin: 0;
}

.community-callout {
  background: #F4EFE6;
  border: 1px solid #E6DFD3;
  border-radius: 12px;
  padding: 18px 24px;
  margin-top: 24px;
  text-align: center;
}
.community-callout p {
  margin: 0;
  font-size: 13px;
  color: #1A3322;
  font-weight: 600;
}

/* Values Grid */
.about-page .values-grid, .about-page .experience-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}
.about-page .values-grid article, .about-page .experience-grid article {
  padding: 26px 24px;
  border: 1px solid #E6DFD3;
  border-radius: 16px;
  background: #fff;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.about-page .values-grid article:hover, .about-page .experience-grid article:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.04);
}
.about-page .values-grid article h3, .about-page .experience-grid article h3 {
  margin: 12px 0 8px;
}
.about-page .experience-grid article a {
  color: #1A3322;
  font-weight: 800;
  text-underline-offset: 4px;
  display: inline-block;
  margin-top: 10px;
}
.about-page .about-next {
  text-align: center;
  max-width: 820px;
}
.about-page .about-next .actions {
  justify-content: center;
}

@media (max-width: 760px) {
  .about-page .about-hero {
    grid-template-columns: 1fr;
    padding: 48px 22px;
  }
  .about-page .founder-section {
    grid-template-columns: 1fr;
  }
  .about-page .values-grid, .about-page .experience-grid {
    grid-template-columns: 1fr;
  }
}
</style>
