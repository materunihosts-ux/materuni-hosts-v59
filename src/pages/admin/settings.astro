---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Website Settings | Materuni Hosts Admin" description="Manage public links, partner invitation emails and WhatsApp templates." noindex={true}>
<section class="page-hero"><span class="eyebrow">PRIVATE ADMIN</span><h1>Website & communication settings</h1><p>Manage public profiles and the messages used for partner invitations.</p></section>
<section class="booking-wrap"><div class="booking-panel" id="login-panel"><h2>Administrator sign in</h2><form id="login-form" class="form-grid"><div class="field full"><label for="email">Admin email</label><input id="email" type="email" autocomplete="username" required></div><div class="field full"><label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required></div><div class="field full"><button class="button" id="login-button" type="submit">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div></form></div>
<div id="manager" hidden>
 <div class="booking-panel">
  <div class="section-heading"><div><span class="eyebrow">PUBLIC PROFILES</span><h2>Social media & review links</h2><p><a href="/admin/bookings">Bookings</a> · <a href="/admin/analytics">Analytics</a> · <a href="/admin/conversations">Guest conversations</a> · <a href="/admin/tours">Tours & availability</a> · <a href="/admin/partners">Partners</a></p></div><button class="button button-secondary" id="logout" type="button">Sign out</button></div>
  <form id="settings-form" class="form-grid">
   <div class="field full"><label for="instagram">Instagram URL</label><input id="instagram" type="url" placeholder="https://www.instagram.com/..."></div>
   <div class="field full"><label for="facebook">Facebook URL</label><input id="facebook" type="url" placeholder="https://www.facebook.com/..."></div>
   <div class="field full"><label for="tripadvisor">Tripadvisor URL</label><input id="tripadvisor" type="url" placeholder="https://www.tripadvisor.com/..."></div>
   <div class="field full"><label for="google">Google review URL</label><input id="google" type="url" placeholder="https://g.page/r/..."></div>
   <div class="field full"><hr><span class="eyebrow">PARTNER INVITATION · EMAIL</span><h2>Invitation email template</h2><p class="muted">This template is used when an administrator selects “Send invitation” on a partner record.</p></div>
   <div class="field full"><label for="partner-email-subject">Email subject</label><input id="partner-email-subject" maxlength="180" required value="An invitation to collaborate with Materuni Hosts"></div>
   <div class="field full"><label for="partner-email-body">Email message</label><textarea id="partner-email-body" rows="12" maxlength="8000" required>Hello &#123;&#123;partner_name&#125;&#125;,

Warm greetings from Materuni Hosts.

We would love to explore a thoughtful local partnership with &#123;&#123;partner_name&#125;&#125;. We host authentic Chagga coffee, waterfall, food and village experiences in Materuni Village, and value clear communication and guest care.

If you are open to a conversation, simply reply to this email or reach us on WhatsApp at &#123;&#123;whatsapp&#125;&#125;. We would be pleased to share our experiences and discuss how we can work together.

Warm regards,
&#123;&#123;host_name&#125;&#125;
Materuni Hosts
&#123;&#123;reply_email&#125;&#125;
Come as a guest. Leave as a friend.</textarea><small class="muted">Available placeholders: &#123;&#123;partner_name&#125;&#125;, &#123;&#123;host_name&#125;&#125;, &#123;&#123;reply_email&#125;&#125;, &#123;&#123;whatsapp&#125;&#125;. They are automatically filled when an invitation is sent.</small></div>
   <div class="field full"><hr><span class="eyebrow">PARTNER INVITATION · WHATSAPP</span><h2>WhatsApp template settings</h2><p class="muted">Enter the exact approved Meta WhatsApp Business template name and language. Leave the name empty to keep automatic WhatsApp invitations disabled.</p></div>
   <div class="field"><label for="whatsapp-template-name">Approved Meta template name</label><input id="whatsapp-template-name" maxlength="100" placeholder="e.g. partner_invitation"></div>
   <div class="field"><label for="whatsapp-template-language">Template language code</label><input id="whatsapp-template-language" maxlength="12" value="en" placeholder="en"></div>
   <div class="field full"><p class="notice">WhatsApp delivery also requires the Meta Cloud API access token, phone number ID and an approved template with three body variables in this order: business name, contact name, Materuni Hosts WhatsApp number. Saving these settings does not submit a template to Meta or activate missing API credentials.</p></div>
   <div class="field full"><button class="button" id="save" type="submit">Save all settings</button><p id="feedback" class="muted" aria-live="polite"></p></div>
  </form>
 </div>
</div></section>
<style>
#settings-form hr{width:100%;border:0;border-top:1px solid var(--line,#ded8cd);margin:.35rem 0 1rem}
#settings-form h2{margin:.3rem 0;font-size:1.35rem}
#settings-form textarea{min-height:260px;line-height:1.65;white-space:pre-wrap}
#settings-form .notice{max-width:100%}
@media(max-width:620px){#settings-form textarea{min-height:300px}#settings-form .field{min-width:0}}
</style>
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
let token="",emailTemplatesState={};
const el=id=>document.getElementById(id);
const headers=()=>({"apikey":publishableKey,"Authorization":"Bearer "+token,"Content-Type":"application/json"});
async function request(path,options={}){const r=await fetch(supabaseUrl+path,{...options,headers:{...headers(),...(options.headers||{})}});const body=await r.json().catch(()=>null);if(!r.ok)throw new Error(body?.message||body?.details||body?.hint||"Request failed");return body}
const parseSetting=value=>{if(typeof value!=="string")return value||{};try{return JSON.parse(value)}catch{return {}}};
const fields={instagram:"instagram_url",facebook:"facebook_url",tripadvisor:"tripadvisor_url",google:"google_review_url"};
el("login-form").addEventListener("submit",async e=>{
 e.preventDefault();const b=el("login-button");b.disabled=true;el("login-feedback").textContent="Checking account…";
 try{
  const r=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:{"apikey":publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email:el("email").value.trim(),password:el("password").value})});
  const session=await r.json();if(!r.ok||!session?.access_token||!session?.user?.id)throw new Error(session.msg||session.message||"Sign in failed");
  token=session.access_token;
  const admins=await request("/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(session.user.id));
  if(!admins.length)throw new Error("This account is not authorised as an administrator");
  const rows=await request("/rest/v1/site_settings?select=setting_key,setting_value");
  for(const [id,key] of Object.entries(fields)){const row=rows.find(x=>x.setting_key===key);el(id).value=row?.setting_value||""}
  emailTemplatesState=parseSetting(rows.find(x=>x.setting_key==="email_templates")?.setting_value);
  const partnerEmail=emailTemplatesState.partner||{};
  if(partnerEmail.subject)el("partner-email-subject").value=partnerEmail.subject;
  if(partnerEmail.body)el("partner-email-body").value=partnerEmail.body;
  const whatsapp=parseSetting(rows.find(x=>x.setting_key==="whatsapp_partner_template")?.setting_value);
  el("whatsapp-template-name").value=whatsapp.name||"";
  el("whatsapp-template-language").value=whatsapp.language||"en";
  el("login-panel").hidden=true;el("manager").hidden=false;
 }catch(err){token="";el("login-feedback").textContent=err.message}
 finally{b.disabled=false}
});
el("settings-form").addEventListener("submit",async e=>{
 e.preventDefault();const b=el("save");b.disabled=true;el("feedback").textContent="Saving settings…";
 try{
  const rows=Object.entries(fields).map(([id,key])=>({setting_key:key,setting_value:el(id).value.trim(),updated_at:new Date().toISOString()}));
  const emailTemplates={...emailTemplatesState,partner:{subject:el("partner-email-subject").value.trim(),body:el("partner-email-body").value.trim()}};
  emailTemplatesState=emailTemplates;
  const whatsappTemplate={name:el("whatsapp-template-name").value.trim(),language:el("whatsapp-template-language").value.trim()||"en"};
  rows.push({setting_key:"email_templates",setting_value:JSON.stringify(emailTemplates),updated_at:new Date().toISOString()});
  rows.push({setting_key:"whatsapp_partner_template",setting_value:JSON.stringify(whatsappTemplate),updated_at:new Date().toISOString()});
  await request("/rest/v1/site_settings?on_conflict=setting_key",{method:"POST",headers:{"Prefer":"resolution=merge-duplicates,return=minimal"},body:JSON.stringify(rows)});
  el("feedback").textContent="All settings saved. Partner invitations will use the updated email template and WhatsApp configuration.";
 }catch(err){el("feedback").textContent=err.message}
 finally{b.disabled=false}
});
el("logout").addEventListener("click",async()=>{try{await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:headers()})}catch{}token="";el("manager").hidden=true;el("login-panel").hidden=false;el("login-form").reset();el("settings-form").reset()});
</script>
</SiteLayout>
