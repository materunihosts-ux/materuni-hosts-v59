---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Website Settings | Materuni Hosts Admin" description="Manage public social media and review links." noindex={true}>
<section class="page-hero"><span class="eyebrow">PRIVATE ADMIN</span><h1>Website & social settings</h1><p>Update the public links shown on your Materuni Hosts website.</p></section>
<section class="booking-wrap"><div class="booking-panel" id="login-panel"><h2>Administrator sign in</h2><form id="login-form" class="form-grid"><div class="field full"><label for="email">Admin email</label><input id="email" type="email" autocomplete="username" required></div><div class="field full"><label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required></div><div class="field full"><button class="button" id="login-button">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div></form></div>
<div id="manager" hidden><div class="booking-panel"><div class="section-heading"><div><span class="eyebrow">PUBLIC PROFILES</span><h2>Social media & review links</h2><p><a href="/admin/bookings">Bookings</a> · <a href="/admin/tours">Tours & availability</a></p></div><button class="button button-secondary" id="logout" type="button">Sign out</button></div>
<form id="settings-form" class="form-grid">
<div class="field full"><label for="instagram">Instagram URL</label><input id="instagram" type="url" placeholder="https://www.instagram.com/..." required></div>
<div class="field full"><label for="facebook">Facebook URL</label><input id="facebook" type="url" placeholder="https://www.facebook.com/..." required></div>
<div class="field full"><label for="tripadvisor">Tripadvisor URL</label><input id="tripadvisor" type="url" placeholder="https://www.tripadvisor.com/..." required></div>
<div class="field full"><label for="google">Google review URL</label><input id="google" type="url" placeholder="https://g.page/r/..." required></div>
<div class="field full"><button class="button" id="save" type="submit">Save website links</button><p id="feedback" class="muted" aria-live="polite"></p></div></form></div></div></section>
<script>
// @ts-nocheck

const supabaseUrl="https://sskmzswoeljxwojcszta.supabase.co", publishableKey="sb_publishable_G9ru4P_yKzievqiXjXEEbQ_p28cB_NZ";
let token="";
const el=id=>document.getElementById(id);
const headers=()=>({"apikey":publishableKey,"Authorization":"Bearer "+token,"Content-Type":"application/json"});
async function request(path,options={}){const r=await fetch(supabaseUrl+path,{...options,headers:{...headers(),...(options.headers||{})}});const body=await r.json().catch(()=>null);if(!r.ok)throw new Error(body?.message||body?.details||"Request failed");return body}
const fields={instagram:"instagram_url",facebook:"facebook_url",tripadvisor:"tripadvisor_url",google:"google_review_url"};
el("login-form").addEventListener("submit",async e=>{e.preventDefault();const b=el("login-button");b.disabled=true;el("login-feedback").textContent="Checking account…";try{const r=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:{"apikey":publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email:el("email").value.trim(),password:el("password").value})});const session=await r.json();if(!r.ok)throw new Error(session.msg||session.message||"Sign in failed");token=session.access_token;const admins=await request("/rest/v1/admin_users?select=user_id&user_id=eq."+session.user.id);if(!admins.length)throw new Error("This account is not authorised as an administrator");const rows=await request("/rest/v1/site_settings?select=setting_key,setting_value");for(const [id,key] of Object.entries(fields)){const row=rows.find(x=>x.setting_key===key);el(id).value=row?.setting_value||""}el("login-panel").hidden=true;el("manager").hidden=false}catch(err){token="";el("login-feedback").textContent=err.message}finally{b.disabled=false}});
el("settings-form").addEventListener("submit",async e=>{e.preventDefault();const b=el("save");b.disabled=true;el("feedback").textContent="Saving…";try{const rows=Object.entries(fields).map(([id,key])=>({setting_key:key,setting_value:el(id).value.trim(),updated_at:new Date().toISOString()}));await request("/rest/v1/site_settings?on_conflict=setting_key",{method:"POST",headers:{"Prefer":"resolution=merge-duplicates,return=minimal"},body:JSON.stringify(rows)});el("feedback").textContent="Links saved. They will appear on the public website."; }catch(err){el("feedback").textContent=err.message}finally{b.disabled=false}});
el("logout").addEventListener("click",async()=>{try{await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:headers()})}catch{}token="";el("manager").hidden=true;el("login-panel").hidden=false;el("login-form").reset()});
</script>
</SiteLayout>