---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Tour Operations & Documents | Materuni Hosts" description="Private rate management and branded tour document workspace." noindex={true}>
<section class="page-hero"><span class="eyebrow">MATERUNI HOSTS · PRIVATE OPERATIONS</span><h1>Tour Operations & Documents</h1><p>Manage commercial rates and prepare guest or agent documents from one protected workspace.</p></section>
<section class="booking-wrap">
 <div class="booking-panel" id="login-panel"><h2>Administrator sign in</h2><form id="login-form" class="form-grid"><div class="field full"><label for="admin-email">Admin email</label><input id="admin-email" type="email" autocomplete="username" required></div><div class="field full"><label for="admin-password">Password</label><input id="admin-password" type="password" autocomplete="current-password" required></div><div class="field full"><button class="button" id="login-button">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div></form></div>
 <div id="manager" hidden>
  <div class="booking-panel"><div class="section-heading"><div><span class="eyebrow">COMMERCIAL WORKSPACE</span><h2>Tour Operations</h2><p class="muted">Retail, STO, Net and partner contract rates are private and only available to authorised admins.</p></div><div class="admin-shortcuts"><a class="button button-secondary" href="/admin/">Dashboard</a><a class="button button-secondary" href="/admin/tours">Packages</a><button class="button button-secondary" id="logout" type="button">Sign out</button></div></div>
   <div class="admin-home-grid">
    <a class="admin-home-card admin-home-primary" href="#rates"><span class="admin-home-icon">01</span><span><strong>Rate management</strong><small>Retail, STO, Net, contract and seasonal rates</small></span><span class="admin-home-arrow">→</span></a>
    <a class="admin-home-card admin-home-primary" href="#documents"><span class="admin-home-icon">02</span><span><strong>Document studio</strong><small>Itinerary, quotation, invoice and price-list drafts</small></span><span class="admin-home-arrow">→</span></a>
    <a class="admin-home-card admin-home-primary" href="#records"><span class="admin-home-icon">03</span><span><strong>Saved commercial records</strong><small>Review current rate plans and package rates</small></span><span class="admin-home-arrow">→</span></a>
   </div>
  </div>
  <div class="booking-panel" id="rates" style="margin-top:1.2rem">
   <span class="eyebrow">01 · RATE PLAN SETUP</span><h2>Create a price list</h2><p class="muted">Create a separate rate plan for Retail, STO, Net or a named agent contract. No sample prices are preloaded.</p>
   <form id="plan-form" class="form-grid">
    <div class="field"><label for="plan-name">Price list name *</label><input id="plan-name" maxlength="120" placeholder="e.g. 2027 STO Rates" required></div>
    <div class="field"><label for="plan-type">Rate category *</label><select id="plan-type"><option value="retail">Retail / Public</option><option value="sto">STO</option><option value="net">Net</option><option value="contract">Agent / Contract</option><option value="seasonal">Seasonal</option><option value="group">Group</option></select></div>
    <div class="field"><label for="plan-currency">Currency</label><select id="plan-currency"><option>USD</option><option>TZS</option><option>EUR</option><option>GBP</option></select></div>
    <div class="field"><label for="plan-partner">Partner (optional)</label><select id="plan-partner"><option value="">No specific partner</option></select></div>
    <div class="field"><label for="plan-from">Valid from</label><input id="plan-from" type="date"></div>
    <div class="field"><label for="plan-until">Valid until</label><input id="plan-until" type="date"></div>
    <div class="field full"><label for="plan-notes">Internal notes</label><textarea id="plan-notes" rows="2" maxlength="1500"></textarea></div>
    <div class="field full"><button class="button" id="save-plan" type="submit">Save price list</button><p id="plan-feedback" class="muted" aria-live="polite"></p></div>
   </form>
   <div class="divider"></div>
   <span class="eyebrow">02 · PACKAGE RATES</span><h2>Add a rate to a price list</h2>
   <form id="rate-form" class="form-grid">
    <div class="field full"><label for="rate-experience">Package *</label><select id="rate-experience" required><option value="">Select package</option></select></div>
    <div class="field full"><label for="rate-plan">Price list *</label><select id="rate-plan" required><option value="">Select price list</option></select></div>
    <div class="field"><label for="rate-min">Minimum guests</label><input id="rate-min" type="number" min="1" value="1" required></div>
    <div class="field"><label for="rate-max">Maximum guests (optional)</label><input id="rate-max" type="number" min="1" placeholder="No maximum"></div>
    <div class="field"><label for="rate-amount">Price *</label><input id="rate-amount" type="number" min="0" step="0.01" required></div>
    <div class="field"><label for="rate-unit">Pricing unit</label><select id="rate-unit"><option value="per_person">Per person</option><option value="per_group">Per group</option><option value="per_night">Per night</option><option value="per_vehicle">Per vehicle</option></select></div>
    <div class="field full"><button class="button" id="save-rate" type="submit">Save package rate</button><p id="rate-feedback" class="muted" aria-live="polite"></p></div>
   </form>
  </div>
  <div class="booking-panel" id="records" style="margin-top:1.2rem"><div class="section-heading"><div><span class="eyebrow">03 · RATE REGISTER</span><h2>Saved rates</h2><p class="muted">Internal register; never displayed on public pages.</p></div><button class="button button-secondary" id="refresh-rates" type="button">Refresh</button></div><div id="rate-list" class="admin-booking-list">Loading rates…</div><p id="rate-list-feedback" class="muted" aria-live="polite"></p></div>
  <div class="booking-panel" id="saved-documents" style="margin-top:1.2rem"><div class="section-heading"><div><span class="eyebrow">04 · DOCUMENT REGISTER</span><h2>Saved quotations & invoices</h2><p class="muted">Private financial records, references and payment status.</p></div><button class="button button-secondary" id="refresh-documents" type="button">Refresh records</button></div><div id="saved-document-list" class="admin-booking-list">Sign in to load records.</div><p id="saved-document-feedback" class="muted" aria-live="polite"></p></div>
  <div class="booking-panel" id="documents" style="margin-top:1.2rem">
   <span class="eyebrow">05 · DOCUMENT STUDIO</span><h2>Prepare a branded document</h2><p class="muted">Create a branded document, preview it, then download a high-resolution A4 PDF directly. For best results, complete the recipient, dates, services and payment details before generating.</p>
   <form id="document-form" class="form-grid">
    <div class="field"><label for="doc-type">Document type</label><select id="doc-type"><option value="itinerary">Tour itinerary</option><option value="quotation">Quotation / proposal</option><option value="invoice">Invoice</option><option value="price_list">Price list</option><option value="receipt">Payment receipt</option></select></div>
    <div class="field"><label for="doc-audience">Prepared for</label><select id="doc-audience"><option value="guest">Direct guest</option><option value="agent">Travel agent</option><option value="internal">Internal use</option></select></div>
    <div class="field"><label for="doc-language">Language</label><select id="doc-language"><option value="en">English</option><option value="es">Español</option><option value="fr">Français</option><option value="de">Deutsch</option></select></div>
    <div class="field"><label for="doc-currency">Currency</label><select id="doc-currency"><option>USD</option><option>TZS</option><option>EUR</option><option>GBP</option></select></div>
    <div class="field"><label for="doc-recipient">Guest / agency name</label><input id="doc-recipient" maxlength="160" placeholder="Recipient name"></div>
    <div class="field"><label for="doc-email">Email</label><input id="doc-email" type="email" maxlength="254" placeholder="recipient@example.com"></div>
    <div class="field"><label for="doc-title">Document title *</label><input id="doc-title" maxlength="180" placeholder="e.g. Materuni Village & Waterfall Experience" required></div>
    <div class="field"><label for="doc-date">Travel / issue date</label><input id="doc-date" type="date"></div>
    <div class="field"><label for="doc-price-plan">Price list to use</label><select id="doc-price-plan"><option value="">Select saved price list</option></select></div>
    <div class="field"><label for="doc-price-scope">Price list contents</label><select id="doc-price-scope"><option value="all">All packages</option><option value="single">One package only</option></select></div>
    <div class="field full" id="doc-single-package-wrap" hidden><label for="doc-price-package">Choose one package</label><select id="doc-price-package"><option value="">Select package</option></select></div>
    <div class="field full"><label for="doc-body">Itinerary / description / services (one line per item)</label><textarea id="doc-body" rows="7" placeholder="Day 1 — Arrival in Materuni&#10;Guided village walk&#10;Chagga coffee experience"></textarea></div>
    <div class="field"><label for="doc-amount">Total amount</label><input id="doc-amount" type="number" min="0" step="0.01" value="0"></div>
    <div class="field"><label for="doc-deposit">Deposit / amount paid</label><input id="doc-deposit" type="number" min="0" step="0.01" value="0"></div>
    <div class="field full"><label for="doc-terms">Terms & conditions / notes</label><textarea id="doc-terms" rows="3"></textarea></div>
    <div class="field full"><div class="actions"><button class="button" type="submit">Generate branded preview</button><button class="button button-secondary" id="export-rates-csv" type="button">Export rate register CSV</button></div><p id="doc-feedback" class="muted" aria-live="polite"></p></div>
   </form>
   <div id="document-preview" class="document-preview" hidden></div>
  </div>
 </div>
</section>
<style>
.document-preview{margin-top:1.5rem;background:#fff;color:#242421;border:1px solid #d9d1c4;padding:clamp(18px,4vw,42px);border-radius:12px;max-width:850px}.document-preview .doc-brand{display:flex;align-items:center;gap:16px;border-bottom:3px solid #C5A059;padding-bottom:18px}.document-preview .doc-brand img{width:42px;height:42px;min-width:42px;object-fit:contain;border-radius:50%;border:1px solid #e6dfd3;padding:3px;background:#fff}.document-preview h2{font-family:'Cormorant Garamond',serif;color:#1A3322;font-size:2rem}.document-preview .doc-footer{border-top:1px solid #e6dfd3;margin-top:28px;padding-top:14px;color:#555;font-size:12px}.document-preview .doc-items{white-space:pre-wrap;line-height:1.8}.document-preview .doc-total{font-size:1.2rem;font-weight:800;color:#1A3322}.document-preview{font-family:Manrope,Arial,sans-serif;line-height:1.65;box-shadow:0 12px 38px rgba(26,51,34,.08)}.document-preview .doc-brand{min-height:88px}.document-preview .doc-items{margin:20px 0;overflow-wrap:anywhere}.doc-price-table{width:100%;border-collapse:collapse;margin:18px 0;font-size:13px}.doc-price-table th{background:#1A3322;color:#fff;text-align:left}.doc-price-table th,.doc-price-table td{padding:10px 9px;border:1px solid #e6dfd3}.doc-price-table tr:nth-child(even){background:#FAF7F2}.document-preview .doc-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;padding-top:18px;border-top:1px solid #e6dfd3}.document-preview .doc-note{background:#FAF7F2;border-left:3px solid #C5A059;padding:12px 15px;margin:18px 0;font-size:13px}.document-preview h2{font-size:clamp(28px,4vw,38px);line-height:1.15;margin:8px 0 18px}.document-preview .doc-footer{line-height:1.8}@page{size:A4;margin:14mm 13mm 16mm} @media print{html,body{background:#fff!important;margin:0!important;padding:0!important}body *{visibility:hidden!important}.document-preview,.document-preview *{visibility:visible!important}.document-preview{position:absolute!important;left:0!important;top:0!important;width:100%!important;max-width:none!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;font-size:10pt!important;color:#242421!important;-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}.document-preview .doc-actions{display:none!important}.document-preview .doc-brand,.document-preview h2,.document-preview .doc-total{break-inside:avoid;page-break-inside:avoid}.document-preview .doc-items,.document-preview .doc-footer{orphans:3;widows:3}.document-preview img{max-width:14mm!important;max-height:14mm!important}}
</style>
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
let token="",currentUserId="",plans=[],rates=[],experiences=[],partners=[],quotations=[],invoices=[];
const el=id=>document.getElementById(id),headers=()=>({apikey:publishableKey,Authorization:"Bearer "+token,"Content-Type":"application/json"});
async function api(path,options={}){const r=await fetch(supabaseUrl+path,{...options,headers:{...headers(),...(options.headers||{})}});const d=await r.json().catch(()=>null);if(!r.ok)throw new Error(d?.message||d?.details||d?.error_description||"Request failed");return d}
const escapeHtml=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function fillSelect(id,rows,label,value){const s=el(id);s.replaceChildren();const first=document.createElement("option");first.value="";first.textContent="Select";s.append(first);rows.forEach(r=>{const o=document.createElement("option");o.value=r[value];o.textContent=r[label];s.append(o)})}
async function loadAll(){const [p,r,e,a]=await Promise.all([api("/rest/v1/rate_plans?select=*&order=created_at.desc"),api("/rest/v1/package_rates?select=*&order=created_at.desc"),api("/rest/v1/experience_catalog?select=id,experience_key,display_name,is_active&order=sort_order.asc"),api("/rest/v1/partners?select=id,business_name&order=business_name.asc")]);plans=p;rates=r;experiences=e;partners=a;fillSelect("rate-plan",plans,"name","id");fillSelect("rate-experience",experiences,"display_name","id");fillSelect("doc-price-plan",plans,"name","id");fillSelect("doc-price-package",experiences,"display_name","id");const ps=el("plan-partner");ps.replaceChildren(new Option("No specific partner",""));partners.forEach(p=>ps.append(new Option(p.business_name,p.id)));renderRates();await loadDocuments()}
async function loadDocuments(){const [q,i]=await Promise.all([api("/rest/v1/quotations?select=id,quotation_number,guest_name,currency,total,status,created_at&order=created_at.desc&limit=30"),api("/rest/v1/invoices?select=id,invoice_number,guest_name,currency,total,amount_paid,balance,status,created_at&order=created_at.desc&limit=30")]);quotations=q;invoices=i;renderDocuments()}
function renderDocuments(){const root=el("saved-document-list");root.replaceChildren();const items=[...quotations.map(x=>({...x,kind:"Quotation",ref:x.quotation_number,paid:null})),...invoices.map(x=>({...x,kind:"Invoice",ref:x.invoice_number,paid:x.amount_paid}))].sort((a,b)=>new Date(b.created_at)-new Date(a.created_at));if(!items.length){root.textContent="No saved quotations or invoices yet.";return}items.forEach(x=>{const card=document.createElement("article");card.className="admin-booking-card";const title=document.createElement("strong");title.textContent=x.kind+" · "+x.ref;const detail=document.createElement("p");detail.className="muted";detail.textContent=(x.guest_name||"Guest")+" · "+x.currency+" "+Number(x.total||0).toFixed(2)+" · "+String(x.status||"draft").replaceAll("_"," ");if(x.kind==="Invoice")detail.textContent+=" · Paid "+x.currency+" "+Number(x.paid||0).toFixed(2)+" · Balance "+x.currency+" "+Number(x.balance||0).toFixed(2);card.append(title,detail);root.append(card)})}
function renderRates(){const root=el("rate-list");root.replaceChildren();if(!rates.length){root.textContent="No package rates yet. Create a rate plan, then add rates above.";return}rates.forEach(rate=>{const plan=plans.find(p=>p.id===rate.rate_plan_id),pkg=experiences.find(p=>p.id===rate.experience_id);const card=document.createElement("article");card.className="admin-booking-card";const title=document.createElement("strong");title.textContent=(pkg?.display_name||"Package") + " · " + (plan?.name||"Rate plan");const detail=document.createElement("p");detail.className="muted";detail.textContent=(plan?.rate_type||"").toUpperCase()+" · "+plan?.currency+" "+Number(rate.amount).toFixed(2)+" · "+rate.pricing_unit.replaceAll("_"," ")+" · "+rate.guest_min+"–"+(rate.guest_max||"∞")+" guests";card.append(title,detail);root.append(card)})}
el("login-form").addEventListener("submit",async ev=>{ev.preventDefault();const b=el("login-button");b.disabled=true;el("login-feedback").textContent="Verifying administrator…";try{const r=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:{apikey:publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email:el("admin-email").value.trim(),password:el("admin-password").value})});const s=await r.json();if(!r.ok)throw new Error(s.msg||s.message||"Sign in failed");token=s.access_token;currentUserId=s.user.id;const admins=await api("/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(s.user.id));if(!admins.length)throw new Error("This account is not authorised as an administrator");el("login-panel").hidden=true;el("manager").hidden=false;await loadAll()}catch(err){token="";el("login-feedback").textContent=err.message}finally{b.disabled=false}});
el("plan-form").addEventListener("submit",async ev=>{ev.preventDefault();const b=el("save-plan");b.disabled=true;try{await api("/rest/v1/rate_plans",{method:"POST",headers:{Prefer:"return=representation"},body:JSON.stringify({name:el("plan-name").value.trim(),rate_type:el("plan-type").value,currency:el("plan-currency").value,partner_id:el("plan-partner").value||null,valid_from:el("plan-from").value||null,valid_until:el("plan-until").value||null,notes:el("plan-notes").value.trim()||null})});el("plan-feedback").textContent="Price list saved.";el("plan-form").reset();await loadAll()}catch(err){el("plan-feedback").textContent=err.message}finally{b.disabled=false}});
el("rate-form").addEventListener("submit",async ev=>{ev.preventDefault();const b=el("save-rate");b.disabled=true;try{const min=Number(el("rate-min").value),max=el("rate-max").value?Number(el("rate-max").value):null;if(max!==null&&max<min)throw new Error("Maximum guests must be equal to or greater than minimum guests.");await api("/rest/v1/package_rates",{method:"POST",headers:{Prefer:"return=representation"},body:JSON.stringify({experience_id:el("rate-experience").value,rate_plan_id:el("rate-plan").value,guest_min:min,guest_max:max,amount:Number(el("rate-amount").value),pricing_unit:el("rate-unit").value})});el("rate-feedback").textContent="Package rate saved.";el("rate-form").reset();await loadAll()}catch(err){el("rate-feedback").textContent=err.message}finally{b.disabled=false}});
el("refresh-rates").addEventListener("click",()=>loadAll().catch(e=>el("rate-list-feedback").textContent=e.message));el("refresh-documents").addEventListener("click",()=>loadDocuments().catch(e=>el("saved-document-feedback").textContent=e.message));
function csv(){const rows=[["Package","Price list","Rate type","Currency","Amount","Pricing unit","Minimum guests","Maximum guests","Valid from","Valid until"]];rates.forEach(r=>{const p=plans.find(x=>x.id===r.rate_plan_id),e=experiences.find(x=>x.id===r.experience_id);rows.push([e?.display_name,p?.name,p?.rate_type,p?.currency,r.amount,r.pricing_unit,r.guest_min,r.guest_max||"",p?.valid_from||"",p?.valid_until||""])});return rows.map(row=>row.map(v=>'"'+String(v??"").replaceAll('"','""')+'"').join(",")).join("\r\n")}
function downloadCsv(){const blob=new Blob(["\uFEFF"+csv()],{type:"text/csv;charset=utf-8"}),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="materuni-hosts-rate-register.csv";a.click();URL.revokeObjectURL(url)}
el("doc-price-scope").addEventListener("change",()=>{el("doc-single-package-wrap").hidden=el("doc-price-scope").value!=="single"});el("export-rates-csv").addEventListener("click",downloadCsv);el("export-rates-csv").addEventListener("click",()=>{el("doc-feedback").textContent="Rate register CSV exported."});el("document-form").addEventListener("submit",ev=>{ev.preventDefault();const type=el("doc-type").value,lang=el("doc-language").value,recipient=el("doc-recipient").value.trim(),currency=el("doc-currency").value,total=Number(el("doc-amount").value||0),paid=Number(el("doc-deposit").value||0);if(paid>total&&total>0){el("doc-feedback").textContent="Amount paid cannot exceed the document total.";return}if(type==="price_list"&&(!el("doc-price-plan").value||(el("doc-price-scope").value==="single"&&!el("doc-price-package").value))){el("doc-feedback").textContent="Select a saved price list and, for a single-package list, choose the package.";return}const labels={en:{itinerary:"TOUR ITINERARY",quotation:"TOUR QUOTATION",invoice:"INVOICE",price_list:"PRICE LIST",receipt:"PAYMENT RECEIPT"},es:{itinerary:"ITINERARIO",quotation:"COTIZACIÓN",invoice:"FACTURA",price_list:"LISTA DE PRECIOS",receipt:"RECIBO"},fr:{itinerary:"ITINÉRAIRE",quotation:"DEVIS",invoice:"FACTURE",price_list:"TARIFS",receipt:"REÇU"},de:{itinerary:"REISEPLAN",quotation:"ANGEBOT",invoice:"RECHNUNG",price_list:"PREISLISTE",receipt:"QUITTUNG"}};const root=el("document-preview");root.hidden=false;root.innerHTML='<div class="doc-brand"><img src="/materuni-hosts-logo-round.svg" alt="Materuni Hosts logo"><div><strong style="color:#1A3322;font-size:20px">MATERUNI HOSTS</strong><div style="font-size:11px;letter-spacing:2px;color:#9b7a39">LOCAL HOSTS · MATERUNI, TANZANIA</div></div></div><p style="color:#9b7a39;letter-spacing:2px;font-size:12px;font-weight:800;margin-top:28px">'+labels[lang][type]+'</p><h2>'+escapeHtml(el("doc-title").value)+'</h2><p><strong>Prepared for:</strong> '+escapeHtml(recipient||"—")+' &nbsp; <strong>Date:</strong> '+escapeHtml(el("doc-date").value||new Date().toLocaleDateString())+'</p><p><strong>Contact:</strong> '+escapeHtml(el("doc-email").value||"—")+'</p><div class="doc-items">'+escapeHtml(el("doc-body").value)+'</div>'+(type==="itinerary"?"":'<p class="doc-total">Total: '+escapeHtml(currency)+" "+total.toFixed(2)+'</p><p>Amount paid / deposit: '+escapeHtml(currency)+" "+paid.toFixed(2)+'<br>Balance: '+escapeHtml(currency)+" "+Math.max(0,total-paid).toFixed(2)+'</p>')+'<h3 style="color:#1A3322">Terms & important information</h3><div class="doc-items">'+escapeHtml(el("doc-terms").value||"Please contact Materuni Hosts if you need any clarification about these arrangements.")+'</div><div class="doc-footer">Materuni Hosts · Materuni Village, Moshi, Kilimanjaro, Tanzania<br>hello@materunihosts.com · +255 612 068 540<br><em>Come as a guest. Leave as a friend.</em></div><div class="doc-actions"><button class="button" id="download-document-pdf" type="button">Download high-quality PDF</button><button class="button button-secondary" id="download-document-docx" type="button">Download DOCX</button><button class="button button-secondary" id="download-document-xlsx" type="button">Download XLSX</button><button class="button button-secondary" id="print-document" type="button">Print</button><button class="button button-secondary" id="share-document" type="button">Share document</button>'+(type==="quotation"||type==="invoice"?'<button class="button button-secondary" id="save-document-record" type="button">Save '+(type==="quotation"?"quotation":"invoice")+' to records</button>':"")+'</div>';if(type==="price_list"){const selectedPlan=plans.find(p=>p.id===el("doc-price-plan").value);const scope=el("doc-price-scope").value;const selectedPackage=el("doc-price-package").value;const filtered=rates.filter(r=>r.rate_plan_id===el("doc-price-plan").value&&(scope!=="single"||r.experience_id===selectedPackage));const rows=filtered.map(r=>{const pkg=experiences.find(x=>x.id===r.ex