---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Tour Operations & Documents | Materuni Hosts" description="Private rate management and branded tour document workspace." noindex={true}>
<section class="page-hero"><span class="eyebrow">MATERUNI HOSTS · PRIVATE OPERATIONS</span><h1>Tour Operations & Documents</h1><p>Manage commercial rates and prepare international-standard vouchers, invoices, itineraries and quotations from one protected workspace.</p></section>
<section class="booking-wrap">
 <div class="booking-panel" id="login-panel"><h2>Administrator sign in</h2><form id="login-form" class="form-grid"><div class="field full"><label for="admin-email">Admin email</label><input id="admin-email" type="email" autocomplete="username" required></div><div class="field full"><label for="admin-password">Password</label><input id="admin-password" type="password" autocomplete="current-password" required></div><div class="field full"><button class="button" id="login-button">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div></form></div>
 <div id="manager" hidden>
  <div class="booking-panel"><div class="section-heading"><div><span class="eyebrow">COMMERCIAL WORKSPACE</span><h2>Tour Operations</h2><p class="muted">Retail, STO, Net and partner contract rates are private and only available to authorised admins.</p></div><div class="admin-shortcuts"><a class="button button-secondary" href="/admin/">Dashboard</a><a class="button button-secondary" href="/admin/tours">Packages</a><button class="button button-secondary" id="logout" type="button">Sign out</button></div></div>
   <div class="admin-home-grid">
    <a class="admin-home-card admin-home-primary" href="#rates"><span class="admin-home-icon">01</span><span><strong>Rate management</strong><small>Retail, STO, Net, contract and seasonal rates</small></span><span class="admin-home-arrow">→</span></a>
    <a class="admin-home-card admin-home-primary" href="#documents"><span class="admin-home-icon">02</span><span><strong>Document studio</strong><small>Booking.com vouchers, Travelogic itineraries, tax invoices</small></span><span class="admin-home-arrow">→</span></a>
    <a class="admin-home-card admin-home-primary" href="#records"><span class="admin-home-icon">03</span><span><strong>Saved commercial records</strong><small>Review current rate plans and package rates</small></span><span class="admin-home-arrow">→</span></a>
   </div>
  </div>
  <div class="booking-panel" id="rates" style="margin-top:1.2rem">
   <span class="eyebrow">01 · RATE PLAN SETUP</span><h2>Create a price list</h2><p class="muted">Create a separate rate plan for Retail, STO, Net or a named agent contract. No sample prices are preloaded.</p>
   <form id="plan-form" class="form-grid">
    <div class="field"><label for="plan-name">Price list name *</label><input id="plan-name" maxlength="120" placeholder="e.g. 2027 STO Rates" required></div>
    <div class="field"><label for="plan-type">Rate category *</label><select id="plan-type"><option value="retail">Retail / Public</option><option value="sto">STO</option><option value="net">Net</option><option value="contract">Agent / Contract</option><option value="seasonal">Seasonal</option><option value="group">Group</option></select></div>
    <div class="field"><label for="plan-currency">Currency</label><select id="plan-currency"><option>USD</option><option>TZS</option><option>EUR</option><option>GBP</option></select></div>
    <div class="field"><label for="plan-partner">Partner (optional)</label><select id="plan-partner"><option value="">No specific partner</option></select></div>
    <div class="field"><label for="plan-from">Valid from</label><input id="plan-from" type="date"></div>
    <div class="field"><label for="plan-until">Valid until</label><input id="plan-until" type="date"></div>
    <div class="field full"><label for="plan-notes">Internal notes</label><textarea id="plan-notes" rows="2" maxlength="1500"></textarea></div>
    <div class="field full"><button class="button" id="save-plan" type="submit">Save price list</button><p id="plan-feedback" class="muted" aria-live="polite"></p></div>
   </form>
   <div class="divider"></div>
   <span class="eyebrow">02 · PACKAGE RATES</span><h2>Add a rate to a price list</h2>
   <form id="rate-form" class="form-grid">
    <div class="field full"><label for="rate-experience">Package *</label><select id="rate-experience" required><option value="">Select package</option></select></div>
    <div class="field full"><label for="rate-plan">Price list *</label><select id="rate-plan" required><option value="">Select price list</option></select></div>
    <div class="field"><label for="rate-min">Minimum guests</label><input id="rate-min" type="number" min="1" value="1" required></div>
    <div class="field"><label for="rate-max">Maximum guests (optional)</label><input id="rate-max" type="number" min="1" placeholder="No maximum"></div>
    <div class="field"><label for="rate-amount">Price *</label><input id="rate-amount" type="number" min="0" step="0.01" required></div>
    <div class="field"><label for="rate-unit">Pricing unit</label><select id="rate-unit"><option value="per_person">Per person</option><option value="per_group">Per group</option><option value="per_night">Per night</option><option value="per_vehicle">Per vehicle</option></select></div>
    <div class="field full"><button class="button" id="save-rate" type="submit">Save package rate</button><p id="rate-feedback" class="muted" aria-live="polite"></p></div>
   </form>
  </div>
  <div class="booking-panel" id="records" style="margin-top:1.2rem"><div class="section-heading"><div><span class="eyebrow">03 · RATE REGISTER</span><h2>Saved rates</h2><p class="muted">Internal register; never displayed on public pages.</p></div><button class="button button-secondary" id="refresh-rates" type="button">Refresh</button></div><div id="rate-list" class="admin-booking-list">Loading rates…</div><p id="rate-list-feedback" class="muted" aria-live="polite"></p></div>
  <div class="booking-panel" id="saved-documents" style="margin-top:1.2rem"><div class="section-heading"><div><span class="eyebrow">04 · DOCUMENT REGISTER</span><h2>Saved quotations & invoices</h2><p class="muted">Private financial records, references and payment status.</p></div><button class="button button-secondary" id="refresh-documents" type="button">Refresh records</button></div><div id="saved-document-list" class="admin-booking-list">Sign in to load records.</div><p id="saved-document-feedback" class="muted" aria-live="polite"></p></div>
  <div class="booking-panel" id="documents" style="margin-top:1.2rem">
   <div class="section-heading">
    <div>
     <span class="eyebrow">05 · INTERNATIONAL DOCUMENT STUDIO</span>
     <h2>Prepare professional travel documents</h2>
     <p class="muted">Produce Booking.com standard tour vouchers, Travelogic luxury itineraries, commercial tax invoices, and payment receipts with customizable issuer, banking, and signatory details.</p>
    </div>
   </div>

   <div class="preset-strip" role="region" aria-label="Professional document templates">
    <span class="preset-title">⚡ Instant Standards:</span>
    <button type="button" class="preset-btn" id="preset-voucher">Booking.com Tour Voucher</button>
    <button type="button" class="preset-btn" id="preset-invoice">Commercial Tax Invoice</button>
    <button type="button" class="preset-btn" id="preset-itinerary">Travelogic Itinerary Proposal</button>
    <button type="button" class="preset-btn" id="preset-receipt">Official Payment Receipt</button>
   </div>

   <form id="document-form" class="form-grid">
    <div class="field"><label for="doc-type">Document type *</label><select id="doc-type"><option value="voucher">Booking.com Standard Tour Voucher</option><option value="invoice">Commercial Tax Invoice</option><option value="quotation">Tour Quotation / Proposal (Travelogic)</option><option value="itinerary">Detailed Tour Itinerary (Travelogic)</option><option value="receipt">Official Payment Receipt</option><option value="price_list">Confidential Tariff & Price List</option></select></div>
    <div class="field"><label for="doc-audience">Prepared for</label><select id="doc-audience"><option value="guest">Direct Guest</option><option value="agent">Travel Agent / Partner (B2B)</option><option value="internal">Internal Operations</option></select></div>
    <div class="field"><label for="doc-language">Language</label><select id="doc-language"><option value="en">English</option><option value="sw">Kiswahili</option><option value="es">Español</option><option value="fr">Français</option><option value="de">Deutsch</option></select></div>
    <div class="field"><label for="doc-currency">Currency</label><select id="doc-currency"><option value="USD">USD ($)</option><option value="TZS">TZS (TSh)</option><option value="EUR">EUR (€)</option><option value="GBP">GBP (£)</option></select></div>

    <div class="field"><label for="doc-reference">Confirmation / Reference code *</label><input id="doc-reference" maxlength="60" placeholder="e.g. MH-CONF-2026-8492" required></div>
    <div class="field"><label for="doc-pin">Security PIN / Verification key</label><input id="doc-pin" maxlength="20" placeholder="e.g. 4189"></div>

    <div class="field"><label for="doc-recipient">Guest or agency name *</label><input id="doc-recipient" maxlength="160" placeholder="e.g. Sarah & David Jenkins" required></div>
    <div class="field"><label for="doc-email">Email</label><input id="doc-email" type="email" maxlength="254" placeholder="e.g. guest@example.com"></div>
    <div class="field"><label for="doc-phone">Guest WhatsApp / phone</label><input id="doc-phone" maxlength="50" placeholder="e.g. +44 7700 900123"></div>
    <div class="field"><label for="doc-country">Guest country / residence</label><input id="doc-country" maxlength="80" placeholder="e.g. United Kingdom"></div>

    <div class="field full"><label for="doc-title">Document title *</label><input id="doc-title" maxlength="180" placeholder="e.g. Materuni Waterfall Hike & Traditional Chagga Coffee Masterclass" required></div>

    <div class="field"><label for="doc-date">Travel / service date *</label><input id="doc-date" type="date" required></div>
    <div class="field"><label for="doc-timing">Service time & duration</label><input id="doc-timing" maxlength="100" placeholder="e.g. 09:00 AM – 03:30 PM (Approx. 6.5 hrs)"></div>
    <div class="field"><label for="doc-pax">Party size / guests</label><input id="doc-pax" maxlength="60" placeholder="e.g. 2 Adults"></div>
    <div class="field"><label for="doc-host">Lead host / guide</label><input id="doc-host" maxlength="100" placeholder="e.g. Saidi Materu (Lead Cultural Guide)"></div>

    <div class="field full"><label for="doc-meeting-point">Meeting point & GPS coordinates</label><input id="doc-meeting-point" maxlength="220" placeholder="e.g. Materuni Cultural Tourism Centre, Materuni Village (GPS: -3.2505° S, 37.3912° E)"></div>

    <div class="field"><label for="doc-payment-status">Payment status</label><select id="doc-payment-status"><option value="paid">Paid in Full (Guaranteed)</option><option value="partially_paid">Partially Paid (Balance on Arrival)</option><option value="unpaid">Unpaid / Pay on Arrival</option></select></div>
    <div class="field"><label for="doc-payment-method">Payment method</label><select id="doc-payment-method"><option value="credit_card">Online Credit / Debit Card</option><option value="mpesa">Vodacom M-Pesa Lipa Namba</option><option value="bank_wire">Bank Wire Transfer (CRDB / NMB)</option><option value="cash">Cash on Arrival (USD / TZS)</option></select></div>

    <div class="field"><label for="doc-price-plan">Price list to use (optional)</label><select id="doc-price-plan"><option value="">Select saved price list</option></select></div>
    <div class="field"><label for="doc-price-scope">Price list contents</label><select id="doc-price-scope"><option value="all">All packages</option><option value="single">One package only</option></select></div>
    <div class="field full" id="doc-single-package-wrap" hidden><label for="doc-price-package">Choose one package</label><select id="doc-price-package"><option value="">Select package</option></select></div>

    <div class="field full">
     <label for="doc-lines">
      <strong>Itemized line items & schedule</strong>
      <small style="display:block;color:#7A756B;margin-top:2px;font-weight:normal">Format: Description | Quantity | Unit Price (e.g. Materuni Waterfall & Chagga Culture Hike | 2 | 40.00)</small>
     </label>
     <textarea id="doc-lines" rows="6" placeholder="Materuni Waterfall & Chagga Village Hike | 2 | 40.00&#10;Traditional Coffee Roasting & Tasting Masterclass | 2 | 36.00&#10;Authentic Chagga Hot Lunch & Tropical Fruits | 2 | 0.00&#10;Roundtrip Moshi Town Private 4x4 Transfer | 1 | 35.00"></textarea>
    </div>

    <div class="field"><label for="doc-amount">Total amount</label><input id="doc-amount" type="number" min="0" step="0.01" value="0"></div>
    <div class="field"><label for="doc-deposit">Amount paid / deposit</label><input id="doc-deposit" type="number" min="0" step="0.01" value="0"></div>

    <div class="field full">
     <label for="doc-inclusions">What's included (one item per line)</label>
     <textarea id="doc-inclusions" rows="4" placeholder="Certified local Chagga guide (English & Swahili)&#10;All village cultural permits and conservation entrance fees&#10;Hands-on coffee roasting, grinding, singing & tasting&#10;Traditional Chagga hot lunch with fresh tropical fruits&#10;Mountain spring water refills and wooden walking stick"></textarea>
    </div>

    <div class="field full">
     <label for="doc-exclusions">What's not included / optional</label>
     <textarea id="doc-exclusions" rows="2" placeholder="Gratuities for guide and village cooks (discretionary)&#10;Personal travel and medical insurance"></textarea>
    </div>

    <div class="field full">
     <label for="doc-advice">Traveller advice & what to bring</label>
     <textarea id="doc-advice" rows="3" placeholder="Footwear: Sturdy walking shoes or hiking sneakers with good traction (trails may be moist or rocky)&#10;Attire: Comfortable lightweight clothing, light rain jacket, modest village attire&#10;Waterfall swim: Swimwear and towel if you wish to swim in the cool waterfall pool&#10;Cash: Small Tanzanian Shillings cash for handcrafted souvenirs or coffee beans"></textarea>
    </div>

    <div class="field full">
     <label for="doc-terms">Terms, cancellation policy & payment remittance</label>
     <textarea id="doc-terms" rows="4" placeholder="Free cancellation up to 48 hours prior to start time. Rescheduling is flexible.&#10;Remittance: Vodacom M-Pesa Lipa Namba (+255 612 068 540) or CRDB Bank Moshi Branch.&#10;Cash settlement accepted on arrival in clean USD banknotes (series 2013+) or TZS at current daily exchange rate."></textarea>
    </div>

    <!-- Collapsible Full Business, Remittance & Signatory Customizer (Makes every single part of invoice editable) -->
    <details class="field full" style="background:#FAF7F2;border:1px solid #E6DFD3;border-radius:10px;padding:14px 18px;margin:8px 0" id="customizer-details">
     <summary style="font-weight:700;color:#1A3322;cursor:pointer;font-size:14px">⚙️ Company, Banking & Signatory Customizer (Click to edit all invoice header, bank & seal details)</summary>
     <p class="muted" style="margin:8px 0 14px;font-size:12px">Every single part of the invoice and document header, address, tax registration, remittance banking, and signatory is editable below.</p>
     <div class="form-grid" style="margin-top:10px">
      <div class="field"><label for="doc-co-name">Business / Issuer Name</label><input id="doc-co-name" maxlength="120" value="MATERUNI HOSTS"></div>
      <div class="field"><label for="doc-co-subtitle">Category / Tagline</label><input id="doc-co-subtitle" maxlength="160" value="LOCAL CULTURAL EXPERIENCES · MATERUNI VILLAGE, MOSHI, TANZANIA"></div>
      <div class="field full"><label for="doc-co-address">Registered Physical Address</label><input id="doc-co-address" maxlength="220" value="Materuni Village, Uru Rural, P.O. Box 1888 Moshi, Kilimanjaro, Tanzania"></div>
      <div class="field"><label for="doc-co-tax-id">Official Tax / Registration No.</label><input id="doc-co-tax-id" maxlength="100" value="Registered Community Cultural Tourism Enterprise"></div>
      <div class="field"><label for="doc-co-email">Official Business Email</label><input id="doc-co-email" type="email" maxlength="254" value="materunihosts@gmail.com"></div>
      <div class="field"><label for="doc-co-phone">Official Phone / WhatsApp</label><input id="doc-co-phone" maxlength="50" value="+255 612 068 540"></div>
      <div class="field"><label for="doc-co-website">Official Website</label><input id="doc-co-website" maxlength="100" value="https://materunihosts.com"></div>

      <div class="field"><label for="doc-bank-name">Remittance Bank & Branch</label><input id="doc-bank-name" maxlength="120" value="CRDB Bank Plc, Moshi Main Branch"></div>
      <div class="field"><label for="doc-bank-account">Account Name & Number</label><input id="doc-bank-account" maxlength="120" value="Materuni Hosts · A/C: 0150... (USD / TZS)"></div>
      <div class="field"><label for="doc-bank-swift">SWIFT / BIC Code</label><input id="doc-bank-swift" maxlength="30" value="CORUTZTZ"></div>
      <div class="field"><label for="doc-bank-mpesa">Mobile Money Lipa Namba</label><input id="doc-bank-mpesa" maxlength="80" value="Vodacom M-Pesa Lipa Namba (+255 612 068 540)"></div>
      <div class="field full"><label for="doc-bank-cash">Cash Settlement Policy</label><input id="doc-bank-cash" maxlength="220" value="Accepted on arrival in clean USD banknotes (series 2013 or newer) or TZS at Bank of Tanzania daily rate"></div>

      <div class="field"><label for="doc-tax-label">Tax / Levy Line Label</label><input id="doc-tax-label" maxlength="100" value="Community Tourism Levy (0% Inclusive)"></div>
      <div class="field"><label for="doc-tax-amount">Tax / Levy Amount</label><input id="doc-tax-amount" type="number" min="0" step="0.01" value="0.00"></div>

      <div class="field"><label for="doc-signatory-name">Authorized Signatory Name</label><input id="doc-signatory-name" maxlength="100" value="Saidi Materu"></div>
      <div class="field"><label for="doc-signatory-title">Signatory Position / Title</label><input id="doc-signatory-title" maxlength="100" value="Founder & Lead Cultural Guide"></div>
      <div class="field full"><label for="doc-brand-tagline">Official Brand Slogan / Tagline</label><input id="doc-brand-tagline" maxlength="140" value="Come as a guest. Leave as a friend."></div>

      <div class="field full">
       <button type="button" class="button button-secondary" id="save-invoice-defaults">💾 Save Company & Bank Details as Defaults</button>
       <span id="save-defaults-feedback" class="muted" style="margin-left:10px" aria-live="polite"></span>
      </div>
     </div>
    </details>

    <div class="field full">
     <div class="actions">
      <button class="button" type="submit">Generate branded document</button>
      <button class="button button-secondary" id="export-rates-csv" type="button">Export rate register CSV</button>
     </div>
     <p id="doc-feedback" class="muted" aria-live="polite"></p>
    </div>
   </form>

   <div id="document-preview" class="document-preview" hidden></div>
  </div>
 </div>
</section>

<style>
.preset-strip{display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:#FAF7F2;border:1px solid #E6DFD3;border-radius:10px;padding:10px 14px;margin-bottom:18px}
.preset-title{font-size:12px;font-weight:700;color:#1A3322;text-transform:uppercase;letter-spacing:1px}
.preset-btn{background:#fff;border:1px solid #C5A059;color:#1A3322;padding:6px 12px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s ease}
.preset-btn:hover{background:#1A3322;color:#FAF7F2;border-color:#1A3322}

.document-preview{margin-top:2rem;background:#fff;color:#242421;border:1px solid #d9d1c4;padding:clamp(20px,4vw,44px);border-radius:12px;max-width:880px;font-family:Manrope,Arial,sans-serif;line-height:1.65;box-shadow:0 14px 44px rgba(26,51,34,.1)}
.document-preview .doc-masthead{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;border-bottom:3px solid #C5A059;padding-bottom:18px}
.document-preview .doc-brand-block{display:flex;align-items:center;gap:14px}
.document-preview .doc-brand-block img{width:56px;height:56px;min-width:56px;object-fit:contain;border-radius:50%;border:1px solid #e6dfd3;padding:3px;background:#fff}
.document-preview .doc-brand-text h1,.document-preview .doc-brand-text strong{font-family:'Cormorant Garamond',Georgia,serif;color:#1A3322;font-size:24px;letter-spacing:1px;margin:0;line-height:1.1;display:block}
.document-preview .doc-brand-sub{font-size:10px;letter-spacing:2px;color:#80652F;font-weight:700;margin-top:4px}
.document-preview .doc-pnr-box{background:#FAF7F2;border:1px solid #C5A059;border-radius:8px;padding:8px 14px;text-align:right}
.document-preview .doc-pnr-label{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#7A756B;font-weight:700}
.document-preview .doc-pnr-value{font-family:monospace;font-size:16px;font-weight:800;color:#1A3322;letter-spacing:1px}

.doc-status-banner{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#1A3322;color:#FAF7F2;padding:12px 18px;border-radius:8px;margin:18px 0}
.doc-status-badge{font-size:13px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;display:flex;align-items:center;gap:8px}
.doc-status-badge::before{content:"✓";background:#C5A059;color:#1A3322;width:20px;height:20px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:12px;font-weight:900}
.doc-status-note{font-size:12px;color:#E6DFD3}

.doc-cards-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin:18px 0}
.doc-card{background:#FAF7F2;border:1px solid #E6DFD3;border-radius:8px;padding:12px 14px}
.doc-card-kicker{font-size:9px;text-transform:uppercase;letter-spacing:1.5px;color:#80652F;font-weight:800;display:block;margin-bottom:4px}
.doc-card strong{font-size:13px;color:#1A3322;display:block;line-height:1.35}
.doc-card small{font-size:11px;color:#666;display:block;margin-top:3px;line-height:1.4}

.doc-title-block{margin:22px 0 16px}
.doc-title-block h2{font-family:'Cormorant Garamond',Georgia,serif;color:#1A3322;font-size:clamp(24px,3.5vw,34px);line-height:1.18;margin:4px 0}

.doc-parties-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:18px 0;background:#FAF7F2;border:1px solid #E6DFD3;border-radius:8px;padding:14px 18px;font-size:12px}
.doc-party-col h4{font-size:11px;text-transform:uppercase;letter-spacing:1.5px;color:#80652F;margin:0 0 6px}
.doc-party-col p{margin:2px 0;color:#4F504B;line-height:1.5}
.doc-party-col strong{color:#1A3322}

.doc-table{width:100%;border-collapse:collapse;margin:18px 0;font-size:12px}
.doc-table th{background:#1A3322;color:#FAF7F2;padding:10px 12px;text-align:left;font-weight:700;font-size:11px;letter-spacing:1px;text-transform:uppercase}
.doc-table th:last-child,.doc-table td:last-child{text-align:right}
.doc-table td{padding:10px 12px;border-bottom:1px solid #E6DFD3;color:#333}
.doc-table tr:nth-child(even){background:#FAF7F2}

.doc-financial-grid{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;margin:20px 0;flex-wrap:wrap}
.doc-stamp-box{flex:1;min-width:240px;display:flex;align-items:center}
.doc-stamp{display:inline-block;border:3px solid #1A3322;border-radius:10px;padding:10px 18px;text-align:center;color:#1A3322;font-weight:800;letter-spacing:2px;text-transform:uppercase;transform:rotate(-3deg);background:rgba(26,51,34,.03)}
.doc-stamp.paid{border-color:#1A3322;color:#1A3322}
.doc-stamp.due{border-color:#80652F;color:#80652F}
.doc-stamp-title{font-size:14px;font-weight:900}
.doc-stamp-sub{font-size:9px;letter-spacing:1.5px;margin-top:3px;color:#555}

.doc-totals-box{width:290px;background:#FAF7F2;border:1px solid #E6DFD3;border-radius:8px;padding:14px 16px;font-size:12px}
.doc-total-row{display:flex;justify-content:space-between;padding:4px 0;color:#555}
.doc-total-row.grand{border-top:2px solid #C5A059;margin-top:6px;padding-top:8px;font-size:15px;font-weight:800;color:#1A3322}
.doc-total-row.balance{border-top:1px dashed #C5A059;margin-top:4px;padding-top:6px;font-size:14px;font-weight:800;color:#80652F}

.doc-checklists{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:18px 0}
