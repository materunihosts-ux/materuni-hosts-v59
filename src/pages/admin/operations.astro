<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
let token="",currentUserId="",plans=[],rates=[],experiences=[],partners=[],quotations=[],invoices=[];
const el=id=>document.getElementById(id),headers=()=>({apikey:publishableKey,Authorization:"Bearer "+token,"Content-Type":"application/json"});
async function api(path,options={}){const r=await fetch(supabaseUrl+path,{...options,headers:{...headers(),...(options.headers||{})}});const d=await r.json().catch(()=>null);if(!r.ok)throw new Error(d?.message||d?.details||d?.error_description||"Request failed");return d}
const escapeHtml=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

function fillSelect(id,rows,label,value){
 const s=el(id);if(!s)return;s.replaceChildren();
 const first=document.createElement("option");first.value="";first.textContent="Select";s.append(first);
 rows.forEach(r=>{const o=document.createElement("option");o.value=r[value];o.textContent=r[label];s.append(o)});
}

function loadCompanyDefaults(){
 try{
  const saved=localStorage.getItem("materuni_invoice_company_defaults");
  if(!saved)return;
  const d=JSON.parse(saved);
  if(d.coName)el("doc-co-name").value=d.coName;
  if(d.coSubtitle)el("doc-co-subtitle").value=d.coSubtitle;
  if(d.coAddress)el("doc-co-address").value=d.coAddress;
  if(d.coTaxId)el("doc-co-tax-id").value=d.coTaxId;
  if(d.coEmail)el("doc-co-email").value=d.coEmail;
  if(d.coPhone)el("doc-co-phone").value=d.coPhone;
  if(d.coWebsite)el("doc-co-website").value=d.coWebsite;
  if(d.bankName)el("doc-bank-name").value=d.bankName;
  if(d.bankAccount)el("doc-bank-account").value=d.bankAccount;
  if(d.bankSwift)el("doc-bank-swift").value=d.bankSwift;
  if(d.bankMpesa)el("doc-bank-mpesa").value=d.bankMpesa;
  if(d.bankCash)el("doc-bank-cash").value=d.bankCash;
  if(d.taxLabel)el("doc-tax-label").value=d.taxLabel;
  if(d.signatoryName)el("doc-signatory-name").value=d.signatoryName;
  if(d.signatoryTitle)el("doc-signatory-title").value=d.signatoryTitle;
  if(d.brandTagline)el("doc-brand-tagline").value=d.brandTagline;
 }catch{}
}

async function loadAll(){
 const [p,r,e,a]=await Promise.all([
  api("/rest/v1/rate_plans?select=*&order=created_at.desc"),
  api("/rest/v1/package_rates?select=*&order=created_at.desc"),
  api("/rest/v1/experience_catalog?select=id,experience_key,display_name,is_active&order=sort_order.asc"),
  api("/rest/v1/partners?select=id,business_name&order=business_name.asc")
 ]);
 plans=p||[];rates=r||[];experiences=e||[];partners=a||[];
 fillSelect("rate-plan",plans,"name","id");
 fillSelect("rate-experience",experiences,"display_name","id");
 fillSelect("doc-price-plan",plans,"name","id");
 fillSelect("doc-price-package",experiences,"display_name","id");
 const ps=el("plan-partner");
 if(ps){
  ps.replaceChildren(new Option("No specific partner",""));
  partners.forEach(p=>ps.append(new Option(p.business_name,p.id)));
 }
 renderRates();
 await loadDocuments();
 loadCompanyDefaults();
 checkUrlPrefill();
}

async function loadDocuments(){
 const [q,i]=await Promise.all([
  api("/rest/v1/quotations?select=id,quotation_number,guest_name,currency,total,status,created_at&order=created_at.desc&limit=30"),
  api("/rest/v1/invoices?select=id,invoice_number,guest_name,currency,total,amount_paid,balance,status,created_at&order=created_at.desc&limit=30")
 ]);
 quotations=q||[];invoices=i||[];
 renderDocuments();
}

function renderDocuments(){
 const root=el("saved-document-list");if(!root)return;root.replaceChildren();
 const items=[
  ...quotations.map(x=>({...x,kind:"Quotation",ref:x.quotation_number,paid:null})),
  ...invoices.map(x=>({...x,kind:"Invoice",ref:x.invoice_number,paid:x.amount_paid}))
 ].sort((a,b)=>new Date(b.created_at)-new Date(a.created_at));
 if(!items.length){root.textContent="No saved quotations or invoices yet.";return}
 items.forEach(x=>{
  const card=document.createElement("article");card.className="admin-booking-card";
  const title=document.createElement("strong");title.textContent=x.kind+" · "+x.ref;
  const detail=document.createElement("p");detail.className="muted";
  detail.textContent=(x.guest_name||"Guest")+" · "+x.currency+" "+Number(x.total||0).toFixed(2)+" · "+String(x.status||"draft").replaceAll("_"," ");
  if(x.kind==="Invoice")detail.textContent+=" · Paid "+x.currency+" "+Number(x.paid||0).toFixed(2)+" · Balance "+x.currency+" "+Number(x.balance||0).toFixed(2);
  card.append(title,detail);root.append(card);
 });
}

function renderRates(){
 const root=el("rate-list");if(!root)return;root.replaceChildren();
 if(!rates.length){root.textContent="No package rates yet. Create a rate plan, then add rates above.";return}
 rates.forEach(rate=>{
  const plan=plans.find(p=>p.id===rate.rate_plan_id),pkg=experiences.find(p=>p.id===rate.experience_id);
  const card=document.createElement("article");card.className="admin-booking-card";
  const title=document.createElement("strong");title.textContent=(pkg?.display_name||"Package") + " · " + (plan?.name||"Rate plan");
  const detail=document.createElement("p");detail.className="muted";
  detail.textContent=(plan?.rate_type||"").toUpperCase()+" · "+plan?.currency+" "+Number(rate.amount).toFixed(2)+" · "+rate.pricing_unit.replaceAll("_"," ")+" · "+rate.guest_min+"–"+(rate.guest_max||"∞")+" guests";
  card.append(title,detail);root.append(card);
 });
}

el("login-form").addEventListener("submit",async ev=>{
 ev.preventDefault();
 const b=el("login-button");b.disabled=true;el("login-feedback").textContent="Verifying administrator…";
 try{
  const r=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:{apikey:publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email:el("admin-email").value.trim(),password:el("admin-password").value})});
  const s=await r.json();if(!r.ok)throw new Error(s.msg||s.message||"Sign in failed");
  token=s.access_token;currentUserId=s.user.id;
  const admins=await api("/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(s.user.id));
  if(!admins.length)throw new Error("This account is not authorised as an administrator");
  el("login-panel").hidden=true;el("manager").hidden=false;
  await loadAll();
 }catch(err){token="";el("login-feedback").textContent=err.message}
 finally{b.disabled=false}
});

el("plan-form").addEventListener("submit",async ev=>{
 ev.preventDefault();const b=el("save-plan");b.disabled=true;
 try{
  await api("/rest/v1/rate_plans",{method:"POST",headers:{Prefer:"return=representation"},body:JSON.stringify({name:el("plan-name").value.trim(),rate_type:el("plan-type").value,currency:el("plan-currency").value,partner_id:el("plan-partner").value||null,valid_from:el("plan-from").value||null,valid_until:el("plan-until").value||null,notes:el("plan-notes").value.trim()||null})});
  el("plan-feedback").textContent="Price list saved.";el("plan-form").reset();await loadAll();
 }catch(err){el("plan-feedback").textContent=err.message}finally{b.disabled=false}
});

el("rate-form").addEventListener("submit",async ev=>{
 ev.preventDefault();const b=el("save-rate");b.disabled=true;
 try{
  const min=Number(el("rate-min").value),max=el("rate-max").value?Number(el("rate-max").value):null;
  if(max!==null&&max<min)throw new Error("Maximum guests must be equal to or greater than minimum guests.");
  await api("/rest/v1/package_rates",{method:"POST",headers:{Prefer:"return=representation"},body:JSON.stringify({experience_id:el("rate-experience").value,rate_plan_id:el("rate-plan").value,guest_min:min,guest_max:max,amount:Number(el("rate-amount").value),pricing_unit:el("rate-unit").value})});
  el("rate-feedback").textContent="Package rate saved.";el("rate-form").reset();await loadAll();
 }catch(err){el("rate-feedback").textContent=err.message}finally{b.disabled=false}
});

el("refresh-rates").addEventListener("click",()=>loadAll().catch(e=>el("rate-list-feedback").textContent=e.message));
el("refresh-documents").addEventListener("click",()=>loadDocuments().catch(e=>el("saved-document-feedback").textContent=e.message));

function csv(){
 const rows=[["Package","Price list","Rate type","Currency","Amount","Pricing unit","Minimum guests","Maximum guests","Valid from","Valid until"]];
 rates.forEach(r=>{const p=plans.find(x=>x.id===r.rate_plan_id),e=experiences.find(x=>x.id===r.experience_id);rows.push([e?.display_name,p?.name,p?.rate_type,p?.currency,r.amount,r.pricing_unit,r.guest_min,r.guest_max||"",p?.valid_from||"",p?.valid_until||""])});
 return rows.map(row=>row.map(v=>'"'+String(v??"").replaceAll('"','""')+'"').join(",")).join("\r\n");
}
function downloadCsv(){
 const blob=new Blob(["\uFEFF"+csv()],{type:"text/csv;charset=utf-8"}),url=URL.createObjectURL(blob),a=document.createElement("a");
 a.href=url;a.download="materuni-hosts-rate-register.csv";a.click();URL.revokeObjectURL(url);
}
el("doc-price-scope").addEventListener("change",()=>{el("doc-single-package-wrap").hidden=el("doc-price-scope").value!=="single"});
el("export-rates-csv").addEventListener("click",downloadCsv);

function getTodayString(){return new Intl.DateTimeFormat("en-CA",{timeZone:"Africa/Dar_es_Salaam",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date())}

function checkUrlPrefill(){
 try{
  const params=new URLSearchParams(window.location.search);
  if(!params.get("ref")&&!params.get("name")&&!params.get("experience"))return;
  if(params.get("ref"))el("doc-reference").value=params.get("ref");
  if(params.get("pin"))el("doc-pin").value=params.get("pin");
  if(params.get("name"))el("doc-recipient").value=params.get("name");
  if(params.get("email"))el("doc-email").value=params.get("email");
  if(params.get("phone"))el("doc-phone").value=params.get("phone");
  if(params.get("date"))el("doc-date").value=params.get("date");
  if(params.get("time"))el("doc-timing").value=params.get("time");
  if(params.get("pax"))el("doc-pax").value=params.get("pax");
  if(params.get("experience"))el("doc-title").value=params.get("experience");
  if(params.get("type"))el("doc-type").value=params.get("type");
 }catch{}
}
checkUrlPrefill();
