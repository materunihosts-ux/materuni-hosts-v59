   rows.push([]);
   rows.push(["","","","Published Subtotal",total]);
   rows.push(["","","","Amount Paid",paid]);
   rows.push(["","","","Balance Due",balance]);
   rows.push([]);
   rows.push(["Bank Wire",bankName+" - "+bankAccount+" - SWIFT: "+bankSwift]);
   rows.push(["Mobile Money",bankMpesa]);
   rows.push(["Terms",terms]);

   const wb=XLSX.utils.book_new(),ws=XLSX.utils.aoa_to_sheet(rows);
   ws["!cols"]=[{wch:6},{wch:45},{wch:10},{wch:16},{wch:20}];
   XLSX.utils.book_append_sheet(wb,ws,"Tour Document");
   XLSX.writeFile(wb,"Materuni-Hosts-"+(ref||"document")+".xlsx");
   el("doc-feedback").textContent="Editable XLSX spreadsheet downloaded.";
  }catch(err){el("doc-feedback").textContent="XLSX export failed: "+err.message}
  finally{btn.disabled=false;btn.textContent=orig}
 });

 // Save to Database Records
 const saveBtn=el("save-document-record");
 if(saveBtn){
  saveBtn.addEventListener("click",async()=>{
   saveBtn.disabled=true;el("doc-feedback").textContent="Saving commercial record to database…";
   try{
    const isQuot=type==="quotation"||type==="itinerary";
    const common={
     recipient_type:audience==="agent"?"agent":"guest",
     partner_id:null,
     guest_name:recipient,
     guest_email:email||null,
     language_code:lang,
     currency,
     created_by:currentUserId,
     subtotal:total,
     discount:0,
     total,
     notes:advice||null,
     terms:terms||null,
     rate_snapshot:{
      reference:ref,
      document_title:title,
      meeting_point:meetingPoint,
      timing,
      pax,
      company_name:coName,
      created_at:new Date().toISOString()
     }
    };

    let record;
    if(isQuot){
     record=await api("/rest/v1/quotations",{
      method:"POST",
      headers:{Prefer:"return=representation"},
      body:JSON.stringify({
       ...common,
       quotation_number:ref,
       guest_count:1,
       travel_start:date||null,
       status:"draft"
      })
     });
     const id=record[0].id;
     for(const item of parsedItems){
      await api("/rest/v1/quotation_items",{
       method:"POST",
       body:JSON.stringify({
        quotation_id:id,
        description:item.desc,
        quantity:item.qty,
        unit_price:item.rate,
        line_total:item.total,
        sort_order:item.idx
       })
      });
     }
    }else{
     record=await api("/rest/v1/invoices",{
      method:"POST",
      headers:{Prefer:"return=representation"},
      body:JSON.stringify({
       ...common,
       invoice_number:ref,
       issue_date:date,
       status:paid>=total&&total>0?"paid":paid>0?"partially_paid":"unpaid",
       amount_paid:paid,
       balance
      })
     });
     const id=record[0].id;
     for(const item of parsedItems){
      await api("/rest/v1/invoice_items",{
       method:"POST",
       body:JSON.stringify({
        invoice_id:id,
        description:item.desc,
        quantity:item.qty,
        unit_price:item.rate,
        line_total:item.total,
        sort_order:item.idx
       })
      });
     }
     if(paid>0){
      await api("/rest/v1/payments",{
       method:"POST",
       body:JSON.stringify({
        invoice_id:id,
        amount:paid,
        currency,
        payment_method:paymentMethod,
        notes:"Recorded from international document studio ("+ref+")",
        recorded_by:currentUserId
       })
      });
     }
    }

    saveBtn.textContent="✓ Saved ("+ref+")";
    el("doc-feedback").textContent="Record "+ref+" has been saved to the private database register.";
    await loadDocuments();
   }catch(err){
    el("doc-feedback").textContent="Save failed: "+err.message;
    saveBtn.disabled=false;
   }
  });
 }

 el("doc-feedback").textContent="Branded document preview generated successfully.";
});

el("logout").addEventListener("click",async()=>{
 try{await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:headers()})}catch{}
 token="";currentUserId="";
 el("manager").hidden=true;el("login-panel").hidden=false;el("login-form").reset();
});
</script>
</SiteLayout>