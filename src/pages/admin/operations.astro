function parseLines(raw, defaultCurrency){
 const lines=raw.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
 return lines.map((l,idx)=>{
  const parts=l.split("|").map(p=>p.trim());
  if(parts.length>=3){
   const desc=parts[0];
   const qty=Number(parts[1])||1;
   const rateStr=parts[2].replace(/[^0-9.]/g,"");
   const rate=Number(rateStr)||0;
   const total=qty*rate;
   return {idx:idx+1,desc,qty,rate,total,raw:l,isStructured:true};
  }
  return {idx:idx+1,desc:l,qty:1,rate:0,total:0,raw:l,isStructured:false};
 });
}

