 // PDF Export via html2pdf.js
 el("print-document").addEventListener("click",()=>window.print());
 el("download-document-pdf").addEventListener("click",async()=>{
  const btn=el("download-document-pdf"),orig=btn.textContent;
  let actions=null;btn.disabled=true;btn.textContent="Generating PDF…";
  try{
   if(!window.html2pdf){
    await new Promise((resolve,reject)=>{
     const s=document.createElement("script");
     s.src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.3/html2pdf.bundle.min.js";
     s.onload=resolve;s.onerror=()=>reject(new Error("PDF library unavailable"));
     document.head.append(s);
    });
   }
   const safe=(ref+"-"+title).normalize("NFKD").replace(/[^a-zA-Z0-9]+/g,"-").replace(/^-|-$/g,"").toLowerCase();
   actions=root.querySelector(".doc-actions");if(actions)actions.style.display="none";
   await window.html2pdf().set({
    margin:[10,10,12,10],
    filename:"Materuni-Hosts-"+safe+".pdf",
    image:{type:"jpeg",quality:0.98},
    html2canvas:{scale:2,useCORS:true,allowTaint:false,backgroundColor:"#ffffff",scrollY:0},
    jsPDF:{unit:"mm",format:"a4",orientation:"portrait",compress:true},
    pagebreak:{mode:["css","legacy"],avoid:[".doc-masthead",".doc-status-banner",".doc-cards-grid",".doc-table",".doc-financial-grid",".doc-signatures",".doc-footer"]}
   }).from(root).save();
   el("doc-feedback").textContent="High-quality A4 PDF downloaded successfully.";
  }catch(err){
   el("doc-feedback").textContent="Direct PDF download failed, opening browser print dialog: "+err.message;
   window.print();
  }finally{
   if(actions)actions.style.display="flex";
   btn.disabled=false;btn.textContent=orig;
  }
 });

 // Share via Web Share API
 el("share-document").addEventListener("click",async()=>{
  const shareText=`${docTypeLabels[type]?.[lang]||"TOUR DOCUMENT"}\nRef: ${ref}\nTitle: ${title}\nGuest: ${recipient}\nDate: ${date}\nTotal: ${currency} ${total.toFixed(2)}\nStatus: ${statusLabels[paymentStatus]||paymentStatus}\n${coName} · ${coPhone}\n${coWebsite}`;
  try{
   if(navigator.share){
    await navigator.share({title:title+" · "+coName,text:shareText,url:coWebsite});
    el("doc-feedback").textContent="Document summary shared.";
   }else if(navigator.clipboard?.writeText){
    await navigator.clipboard.writeText(shareText);
    el("doc-feedback").textContent="Document details copied to clipboard. Paste into WhatsApp or email.";
   }else{
    el("doc-feedback").textContent="Sharing not supported in this browser.";
   }
  }catch(err){
   if(err.name!=="AbortError")el("doc-feedback").textContent="Share failed: "+err.message;
  }
 });

 // DOCX Export
 async function loadDocLib(src,globalName){
  if(window[globalName])return window[globalName];
  await new Promise((res,rej)=>{const s=document.createElement("script");s.src=src;s.onload=res;s.onerror=()=>rej(new Error("Failed to load "+globalName));document.head.append(s)});
  return window[globalName];
 }

 el("download-document-docx").addEventListener("click",async()=>{
  const btn=el("download-document-docx"),orig=btn.textContent;btn.disabled=true;btn.textContent="Building DOCX…";
  try{
   const docx=await loadDocLib("https://unpkg.com/docx@8.5.0/build/index.umd.js","docx");
   const {Document,Packer,Paragraph,TextRun,Header,Footer,AlignmentType,HeadingLevel}=docx;

   const children=[
    new Paragraph({text:coName,heading:HeadingLevel.HEADING_1,alignment:AlignmentType.CENTER}),
    new Paragraph({text:coSubtitle,alignment:AlignmentType.CENTER}),
    new Paragraph({text:(docTypeLabels[type]?.[lang]||"TOUR DOCUMENT")+" · REF: "+ref,heading:HeadingLevel.HEADING_2,alignment:AlignmentType.CENTER}),
    new Paragraph({text:title,heading:HeadingLevel.TITLE,alignment:AlignmentType.CENTER}),
    new Paragraph({children:[
     new TextRun({text:"Guest / Agency: ",bold:true}),new TextRun(recipient),
     new TextRun({text:"   |   Date: ",bold:true}),new TextRun(date),
     new TextRun({text:"   |   Pax: ",bold:true}),new TextRun(pax)
    ]}),
    new Paragraph({children:[
     new TextRun({text:"Meeting Point: ",bold:true}),new TextRun(meetingPoint),
     new TextRun({text:"   |   Host: ",bold:true}),new TextRun(host)
    ]}),
    new Paragraph({text:"ITEMIZED SERVICES & SCHEDULE",heading:HeadingLevel.HEADING_3})
   ];

   parsedItems.forEach(item=>{
    children.push(new Paragraph({
     children:[
      new TextRun({text:item.idx+". "+item.desc,bold:true}),
      new TextRun({text:"  (Qty: "+item.qty+", Rate: "+currency+" "+item.rate.toFixed(2)+", Total: "+currency+" "+item.total.toFixed(2)+")"})
     ]
    }));
   });

   children.push(new Paragraph({text:"FINANCIAL SUMMARY",heading:HeadingLevel.HEADING_3}));
   children.push(new Paragraph({children:[new TextRun({text:"Total: "+currency+" "+total.toFixed(2)+"  |  Paid: "+currency+" "+paid.toFixed(2)+"  |  Balance Due: "+currency+" "+balance.toFixed(2),bold:true})]}));
   children.push(new Paragraph({children:[new TextRun({text:"Status: "+(statusLabels[paymentStatus]||paymentStatus),bold:true})]}));

   if(isInvoice || isVoucher){
    children.push(new Paragraph({text:"REMITTANCE & BANKING DETAILS",heading:HeadingLevel.HEADING_3}));
    children.push(new Paragraph({text:"Bank: "+bankName+" | Account: "+bankAccount+" | SWIFT: "+bankSwift}));
    children.push(new Paragraph({text:"M-Pesa: "+bankMpesa}));
   }

   if(inclusions.length){
    children.push(new Paragraph({text:"WHAT IS INCLUDED",heading:HeadingLevel.HEADING_3}));
    inclusions.forEach(inc=>children.push(new Paragraph({text:"• "+inc})));
   }
   if(advice){
    children.push(new Paragraph({text:"TRAVELLER GUIDANCE & WHAT TO BRING",heading:HeadingLevel.HEADING_3}));
    advice.split(/\r?\n/).forEach(a=>children.push(new Paragraph({text:a})));
   }
   if(terms){
    children.push(new Paragraph({text:"TERMS & REMITTANCE",heading:HeadingLevel.HEADING_3}));
    terms.split(/\r?\n/).forEach(t=>children.push(new Paragraph({text:t})));
   }

   const doc=new Document({
    sections:[{
     properties:{page:{size:{width:11906,height:16838},margin:{top:850,right:850,bottom:850,left:850}}},
     headers:{default:new Header({children:[new Paragraph({text:coName+"  |  "+brandTagline,alignment:AlignmentType.CENTER})]})},
     footers:{default:new Footer({children:[new Paragraph({text:coAddress+"  |  "+coEmail+"  |  "+coPhone,alignment:AlignmentType.CENTER})]})},
     children
    }]
   });

   const blob=await Packer.toBlob(doc),url=URL.createObjectURL(blob),a=document.createElement("a");
   a.href=url;a.download="Materuni-Hosts-"+(ref||"document")+".docx";a.click();URL.revokeObjectURL(url);
   el("doc-feedback").textContent="Editable DOCX document downloaded.";
  }catch(err){el("doc-feedback").textContent="DOCX export failed: "+err.message}
  finally{btn.disabled=false;btn.textContent=orig}
 });

