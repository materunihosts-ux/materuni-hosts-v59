---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="AI Command Center | Materuni Hosts" description="Private AI workspace for Materuni Hosts." noindex={true}>
<main class="ai-shell">
  <header class="top"><a href="/admin/business-os">← Business OS</a><span class="eyebrow">PRIVATE WORKSPACE · PHASE 1</span></header>
  <section class="intro"><p class="eyebrow">MATERUNI HOSTS · AI COMMAND CENTER</p><h1>Think clearly. Act with approval.</h1><p>Use one workspace to plan SEO, guest experience, marketing and daily operations. AI outputs are drafts only; nothing is published, sent or changed automatically.</p></section>
  <section id="login-panel" class="panel login"><h2>Administrator sign in</h2><form id="login-form"><label for="email">Admin email</label><input id="email" type="email" autocomplete="username" required><label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required><button id="login-button">Sign in</button><p id="login-feedback" role="status"></p></form></section>
  <section id="workspace" hidden>
    <div class="grid">
      <section class="panel composer">
        <div class="panel-head"><div><p class="eyebrow">AI WORKBENCH</p><h2>Give your assistant a task</h2></div><span class="draft-badge">Draft mode</span></div>
        <label for="provider">AI provider</label><select id="provider"><option value="openai">OpenAI</option><option value="anthropic">Anthropic · Claude</option><option value="google">Google · Gemini</option></select>
        <label for="task">What should we work on?</label><textarea id="task" rows="8" maxlength="6000" placeholder="Example: Prepare a 7-day content plan to attract travellers interested in Chagga culture and Materuni waterfall. Use our authentic local voice and flag anything that needs verification."></textarea>
        <div class="examples"><button type="button" data-prompt="Create a practical SEO action plan for materunihosts.com. Prioritise technical issues, search intent and pages that can attract visitors to Materuni. Do not invent search volume or rankings.">SEO action plan</button><button type="button" data-prompt="Create a 7-day Instagram content calendar for Materuni Hosts focused on authentic Chagga culture, local hosts and real village experiences. Include caption concepts and photo requirements; do not invent images or events.">Social content plan</button><button type="button" data-prompt="Design a guest enquiry follow-up workflow for Materuni Hosts. Separate suggested message drafts from actions requiring human approval.">Guest follow-up workflow</button></div>
        <button id="run" class="primary">Generate draft <span>→</span></button><p id="run-status" role="status" class="status"></p>
      </section>
      <aside class="panel side"><p class="eyebrow">GOVERNANCE</p><h2>Human approval stays in control</h2><ul><li>AI can prepare drafts and recommendations.</li><li>No automatic publishing or guest messaging.</li><li>No booking, price or advertising budget changes.</li><li>Provider API keys stay on the server.</li></ul><div class="connection"><strong>Provider connection</strong><p id="provider-status">Checking server configuration when you generate your first task.</p></div><button id="logout" class="quiet">Sign out</button></aside>
    </div>
    <section id="result-panel" class="panel result" hidden><div class="panel-head"><div><p class="eyebrow">ASSISTANT OUTPUT</p><h2>Your working draft</h2></div><span id="model-label" class="draft-badge"></span></div><pre id="answer"></pre><div class="result-actions"><button id="copy" class="quiet">Copy draft</button><button id="download" class="quiet">Export .txt</button></div><p class="note">Review all facts before using this draft. This workspace has not executed an external action.</p></section>
  </section>
</main>
</SiteLayout>
<script>
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
const el=(id)=>document.getElementById(id);let token="";
const headers=()=>({apikey:publishableKey,"Content-Type":"application/json"});
el("login-form").addEventListener("submit",async e=>{e.preventDefault();const b=el("login-button");b.disabled=true;el("login-feedback").textContent="Checking administrator access…";try{const r=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:headers(),body:JSON.stringify({email:el("email").value.trim(),password:el("password").value})});const s=await r.json();if(!r.ok||!s.access_token)throw new Error(s.msg||s.message||"Sign in failed.");token=s.access_token;const a=await fetch(supabaseUrl+"/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(s.user.id),{headers:{apikey:publishableKey,Authorization:"Bearer "+token}});const admins=await a.json();if(!a.ok||!Array.isArray(admins)||!admins.length)throw new Error("This account is not on the administrator allowlist.");el("login-panel").hidden=true;el("workspace").hidden=false;}catch(err){token="";el("login-feedback").textContent=err.message;}finally{b.disabled=false;}});
document.querySelectorAll("[data-prompt]").forEach(b=>b.addEventListener("click",()=>{el("task").value=b.dataset.prompt;}));
let latest="";
el("run").addEventListener("click",async()=>{const prompt=el("task").value.trim();if(prompt.length<10){el("run-status").textContent="Write a little more detail before generating.";return;}const b=el("run");b.disabled=true;el("run-status").textContent="Preparing your draft securely…";el("provider-status").textContent="Checking provider connection…";el("result-panel").hidden=true;try{const r=await fetch("/api/business-os-ai",{method:"POST",headers:{...headers(),Authorization:"Bearer "+token},body:JSON.stringify({provider:el("provider").value,prompt})});const d=await r.json();if(!r.ok)throw new Error(d.error||"AI request failed.");latest=d.answer;el("answer").textContent=latest;el("model-label").textContent=d.provider+" · "+d.model;el("result-panel").hidden=false;el("provider-status").textContent=d.provider+" is connected and responded successfully.";el("run-status").textContent="Draft generated. No external action was performed.";}catch(err){el("run-status").textContent=err.message;if(/not connected|environment/i.test(err.message))el("provider-status").textContent=err.message;}finally{b.disabled=false;}});
el("copy").addEventListener("click",async()=>{try{await navigator.clipboard.writeText(latest);el("copy").textContent="Copied";}catch{el("copy").textContent="Clipboard unavailable";}});
el("download").addEventListener("click",()=>{const blob=new Blob([latest],{type:"text/plain;charset=utf-8"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="materuni-hosts-ai-draft.txt";a.click();URL.revokeObjectURL(url);});
el("logout").addEventListener("click",async()=>{try{await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:{apikey:publishableKey,Authorization:"Bearer "+token}});}catch{}token="";el("workspace").hidden=true;el("login-panel").hidden=false;el("login-form").reset();el("login-feedback").textContent="Signed out.";});
</script>
<style>
.ai-shell{max-width:1160px;margin:auto;padding:34px 20px 80px;color:#242421}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:32px}.top a{color:#1a3322;text-decoration:none;font-weight:700;font-size:14px}.eyebrow{font-size:11px;letter-spacing:.16em;font-weight:750;color:#a17d40;margin:0 0 10px}.intro{max-width:760px;margin:0 auto 32px;text-align:center}.intro h1{font:600 clamp(36px,5vw,58px)/1.08 Georgia,serif;color:#1a3322;margin:0 0 14px}.intro>p:last-child{font-size:16px;line-height:1.75;color:#68675f}.panel{background:#fff;border:1px solid #e6dfd3;border-radius:14px;padding:clamp(20px,3vw,30px)}.login{max-width:460px;margin:30px auto}.login form{display:grid;gap:10px}.ai-shell label{display:block;font-weight:650;font-size:13px;margin:14px 0 7px}.ai-shell input,.ai-shell select,.ai-shell textarea{width:100%;padding:13px 14px;border:1px solid #d8d1c5;border-radius:8px;background:#fff;color:#242421;font:inherit}.ai-shell textarea{resize:vertical;line-height:1.6}.ai-shell button{cursor:pointer;border:0;border-radius:8px;padding:12px 16px;font-weight:700}.ai-shell button:disabled{opacity:.55;cursor:wait}.login button,.primary{background:#1a3322;color:#faf7f2}.grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,.8fr);gap:18px;align-items:start}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.panel h2{font:600 25px Georgia,serif;color:#1a3322;margin:0 0 16px}.draft-badge{font-size:11px;letter-spacing:.08em;padding:7px 10px;border-radius:30px;background:#f2eee5;color:#665333;white-space:nowrap}.examples{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.examples button,.quiet{background:#f2eee5;color:#1a3322;font-size:12px}.primary{width:100%;display:flex;justify-content:space-between;align-items:center;margin-top:8px}.status{font-size:13px;line-height:1.5;color:#755d34;min-height:20px}.side ul{padding-left:19px;color:#5e5d56;font-size:14px;line-height:1.8}.connection{margin-top:22px;padding:15px;background:#faf7f2;border-radius:8px}.connection p{font-size:13px;line-height:1.55;color:#68675f}.result{margin-top:18px}.result pre{white-space:pre-wrap;overflow-wrap:anywhere;font:14px/1.75 system-ui,sans-serif;color:#363630;background:#faf7f2;padding:18px;border-radius:8px;max-height:650px;overflow:auto}.result-actions{display:flex;gap:9px}.note{font-size:12px;color:#777166;line-height:1.6}@media(max-width:760px){.ai-shell{padding:22px 14px 60px}.top{margin-bottom:22px}.grid{grid-template-columns:1fr}.intro{text-align:left}.intro h1{font-size:36px}.panel-head{align-items:flex-start}.examples button{flex:1 1 100%;text-align:left}}
</style>
