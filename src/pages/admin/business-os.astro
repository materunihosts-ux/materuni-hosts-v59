---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Business OS | Materuni Hosts" description="Private Materuni Hosts Business OS workspace." noindex={true}>
<main class="os-shell">
  <section class="os-login" id="login-panel">
    <p class="eyebrow">MATERUNI HOSTS · BUSINESS OS PREVIEW</p>
    <h1>One place to run your business.</h1>
    <p class="muted">Sign in with an approved administrator account to preview the unified workspace.</p>
    <form id="login-form">
      <label for="email">Administrator email</label>
      <input id="email" type="email" autocomplete="username" required />
      <label for="password">Password</label>
      <input id="password" type="password" autocomplete="current-password" required />
      <button id="login-button" type="submit">Sign in to Business OS</button>
      <p id="login-feedback" class="feedback" role="status" aria-live="polite"></p>
    </form>
  </section>

  <section id="workspace" hidden>
    <header class="os-header">
      <div><p class="eyebrow">MATERUNI HOSTS</p><h1>Business OS</h1><p class="muted">Your operations, guests and growth in one workspace.</p></div>
      <button class="secondary" id="logout" type="button">Sign out</button>
    </header>
    <section class="welcome">
      <div><p class="eyebrow">PRIVATE PILOT · PHASE 1</p><h2>Good to have you back.</h2><p>We are bringing the existing Materuni Hosts tools into one clear operating workspace. Existing booking and website modules remain available while new capabilities are introduced in stages.</p></div>
      <div class="pilot-mark"><span>MH</span><small>BUSINESS OS</small></div>
    </section>
    <div class="section-title"><div><p class="eyebrow">WORKSPACES</p><h2>Business modules</h2></div><span class="status">Pilot preview</span></div>
    <div class="module-grid">
      <a class="module featured" href="/admin/"><span class="module-icon">01</span><span class="module-tag">EXISTING</span><h3>Business overview</h3><p>Open your current admin dashboard and operational snapshot.</p><b>Open dashboard →</b></a>
      <a class="module" href="/admin/bookings"><span class="module-icon">02</span><span class="module-tag">EXISTING</span><h3>Bookings & availability</h3><p>Manage requests, confirmations, cancellations and tour capacity.</p><b>Manage bookings →</b></a>
      <a class="module" href="/admin/tours"><span class="module-icon">03</span><span class="module-tag">EXISTING</span><h3>Experiences & pricing</h3><p>Maintain the official experience catalogue and availability.</p><b>Manage experiences →</b></a>
      <a class="module" href="/admin/conversations"><span class="module-icon">04</span><span class="module-tag">EXISTING</span><h3>Guest conversations</h3><p>Review enquiries and guest concierge conversations.</p><b>Open inbox →</b></a>
      <a class="module" href="/admin/marketing"><span class="module-icon">05</span><span class="module-tag">EXISTING</span><h3>Marketing & SEO studio</h3><p>Audit pages, prepare research briefs and draft website content.</p><b>Open marketing →</b></a>
      <a class="module" href="/admin/analytics"><span class="module-icon">06</span><span class="module-tag">EXISTING</span><h3>Analytics & reporting</h3><p>Review booking and business performance indicators.</p><b>View analytics →</b></a>
      <article class="module planned"><span class="module-icon">07</span><span class="module-tag">PLANNED</span><h3>AI Command Center</h3><p>One AI Director coordinating specialist agents with approval controls.</p><small>Planned for a later pilot phase</small></article>
      <article class="module planned"><span class="module-icon">08</span><span class="module-tag">PLANNED</span><h3>Social & creative studio</h3><p>Content calendar, creative drafts and publishing approvals.</p><small>Planned for a later pilot phase</small></article>
      <article class="module planned"><span class="module-icon">09</span><span class="module-tag">PLANNED</span><h3>CRM & automation</h3><p>Lead pipeline, follow-ups, workflows and customer journeys.</p><small>Planned for a later pilot phase</small></article>
      <article class="module planned"><span class="module-icon">10</span><span class="module-tag">PLANNED</span><h3>Integrations</h3><p>Connect Google, Meta, WhatsApp and AI providers securely.</p><small>Planned for a later pilot phase</small></article>
    </div>
    <p class="footnote">This is a preview shell. Planned modules are not active integrations and do not perform automated actions yet.</p>
  </section>
</main>
</SiteLayout>
<script>
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
const byId = (id: string) => document.getElementById(id) as HTMLElement;
const login = byId("login-form") as HTMLFormElement;
const panel = byId("login-panel");
const workspace = byId("workspace");
const button = byId("login-button") as HTMLButtonElement;
let accessToken = "";
const feedback = byId("login-feedback");
const headers = () => ({ apikey: publishableKey, Authorization: "Bearer " + accessToken });
login.addEventListener("submit", async (event) => {
  event.preventDefault();
  button.disabled = true;
  feedback.textContent = "Verifying administrator access…";
  try {
    const response = await fetch(supabaseUrl + "/auth/v1/token?grant_type=password", {
      method: "POST",
      headers: { apikey: publishableKey, "Content-Type": "application/json" },
      body: JSON.stringify({
        email: (byId("email") as HTMLInputElement).value.trim(),
        password: (byId("password") as HTMLInputElement).value
      })
    });
    const session = await response.json();
    if (!response.ok || !session.access_token || !session.user?.id) {
      throw new Error(session.msg || session.message || "Sign in failed. Check your details.");
    }
    accessToken = session.access_token;
    const adminResponse = await fetch(
      supabaseUrl + "/rest/v1/admin_users?select=user_id&user_id=eq." + encodeURIComponent(session.user.id),
      { headers: { ...headers(), Accept: "application/json" } }
    );
    const admins = await adminResponse.json();
    if (!adminResponse.ok || !Array.isArray(admins) || admins.length === 0) {
      throw new Error("This account is not authorised as a Materuni Hosts administrator.");
    }
    panel.hidden = true;
    workspace.hidden = false;
  } catch (error) {
    accessToken = "";
    feedback.textContent = error instanceof Error ? error.message : "Unable to sign in.";
  } finally {
    button.disabled = false;
  }
});
byId("logout").addEventListener("click", async () => {
  try {
    if (accessToken) await fetch(supabaseUrl + "/auth/v1/logout", { method: "POST", headers: headers() });
  } catch { /* Local session is cleared even if the remote logout request fails. */ }
  accessToken = "";
  workspace.hidden = true;
  panel.hidden = false;
  login.reset();
  feedback.textContent = "You have signed out.";
});
</script>
<style>
.os-shell{max-width:1180px;margin:0 auto;padding:clamp(24px,5vw,64px) 20px 80px;color:#242421}
.os-login{max-width:480px;margin:5vh auto;padding:clamp(24px,5vw,42px);border:1px solid #e6dfd3;border-radius:18px;background:#fff}
.eyebrow{font-size:.7rem;letter-spacing:.16em;font-weight:700;color:#9b783e;margin:0 0 12px}
.os-login h1,.os-header h1{font:600 clamp(2rem,5vw,3.4rem)/1.08 Georgia,serif;color:#1a3322;margin:0 0 12px}
.muted{color:#716f68;line-height:1.65}
#login-form{display:grid;gap:10px;margin-top:24px}
#login-form label{font-size:.9rem;font-weight:650}
#login-form input{width:100%;padding:13px 14px;border:1px solid #d8d1c5;border-radius:9px;font:inherit;background:#fff}
#login-form button,.secondary{border:0;border-radius:9px;padding:13px 18px;background:#1a3322;color:#fff;font-weight:700;cursor:pointer}
#login-form button:disabled{opacity:.6;cursor:wait}
.feedback{min-height:1.4em;color:#8a4c27;font-size:.88rem}
.os-header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:28px}
.os-header h1{margin:0}
.os-header .muted{margin:8px 0 0}
.secondary{background:#f0ece4;color:#1a3322}
.welcome{display:flex;justify-content:space-between;align-items:center;gap:28px;padding:clamp(24px,5vw,46px);border-radius:18px;background:#1a3322;color:#faf7f2}
.welcome .eyebrow{color:#c5a059}.welcome h2{font:600 clamp(1.8rem,4vw,2.7rem)/1.1 Georgia,serif;margin:0 0 12px}.welcome p:last-child{max-width:650px;color:#e6dfd3;line-height:1.7;margin-bottom:0}
.pilot-mark{width:112px;height:112px;flex:0 0 112px;border:1px solid #c5a059;border-radius:50%;display:grid;place-content:center;text-align:center;color:#c5a059}.pilot-mark span{font:2.2rem Georgia,serif}.pilot-mark small{font-size:.55rem;letter-spacing:.15em}
.section-title{display:flex;align-items:end;justify-content:space-between;margin:38px 0 16px}.section-title h2{font:600 1.8rem Georgia,serif;color:#1a3322;margin:0}.section-title .eyebrow{margin-bottom:8px}
.status{font-size:.75rem;padding:7px 11px;border-radius:99px;background:#f0ece4;color:#675638}
.module-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.module{position:relative;display:block;min-height:210px;padding:22px;border:1px solid #e6dfd3;border-radius:14px;text-decoration:none;color:#242421;background:#fff;transition:border-color .2s,transform .2s}
.module[href]:hover{border-color:#c5a059;transform:translateY(-2px)}
.module-icon{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:9px;background:#f5f1e9;color:#1a3322;font-weight:750;font-size:.78rem}
.module-tag{float:right;font-size:.62rem;letter-spacing:.12em;font-weight:750;color:#8b7650}
.module h3{font:600 1.25rem Georgia,serif;color:#1a3322;margin:20px 0 8px}
.module p{font-size:.9rem;line-height:1.55;color:#716f68;margin:0 0 18px}
.module b{font-size:.82rem;color:#8a6b35}
.module.planned{background:#faf7f2;border-style:dashed}
.module.planned small{font-size:.78rem;color:#817b70}
.footnote{margin-top:20px;color:#777166;font-size:.8rem;line-height:1.6}
@media(max-width:800px){.module-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:540px){.os-shell{padding:24px 14px 56px}.os-header{align-items:flex-start}.welcome{align-items:flex-start}.pilot-mark{width:68px;height:68px;flex-basis:68px}.pilot-mark span{font-size:1.5rem}.pilot-mark small{font-size:.42rem}.module-grid{grid-template-columns:1fr}.module{min-height:0}.section-title{align-items:center}}
</style>
