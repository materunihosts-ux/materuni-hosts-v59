---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Business OS | Materuni Hosts" description="Private Materuni Hosts business workspace." noindex={true}>
<main class="app-shell">
  <section class="login-wrap" id="login-panel">
    <div class="login-brand"><span class="brand-mark">MH</span><div><b>Materuni Hosts</b><small>BUSINESS WORKSPACE</small></div></div>
    <p class="eyebrow">PRIVATE ADMIN ACCESS</p>
    <h1>Your business,<br/>in one place.</h1>
    <p class="muted">Sign in to manage daily operations and explore the unified workspace.</p>
    <form id="login-form" class="login-form">
      <label for="email">Administrator email</label><input id="email" type="email" autocomplete="username" required />
      <label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required />
      <button id="login-button" type="submit">Continue to workspace <span>→</span></button>
      <button id="forgot-password" class="link-button" type="button">Forgot your password?</button>
      <p id="login-feedback" class="feedback" role="status" aria-live="polite"></p>
    </form>
    <form id="recovery-form" class="login-form" hidden>
      <label for="recovery-email">Administrator email</label><input id="recovery-email" type="email" autocomplete="email" required />
      <button id="recovery-button" type="submit">Send password reset email</button>
      <button id="cancel-recovery" class="link-button" type="button">Back to sign in</button><p id="recovery-feedback" class="feedback" role="status"></p>
    </form>
    <form id="new-password-form" class="login-form" hidden>
      <label for="new-password">New password</label><input id="new-password" type="password" autocomplete="new-password" minlength="8" required />
      <label for="confirm-password">Confirm new password</label><input id="confirm-password" type="password" autocomplete="new-password" minlength="8" required />
      <button id="save-password" type="submit">Save new password</button><p id="password-feedback" class="feedback" role="status"></p>
    </form>
    <div class="login-foot">Secure workspace · Authorised administrators only</div>
  </section>

  <div id="workspace" class="workspace" hidden>
    <aside class="sidebar">
      <a class="brand" href="/admin/business-os"><span class="brand-mark">MH</span><span><b>Materuni Hosts</b><small>BUSINESS OS</small></span></a>
      <div class="nav-label">OPERATIONS</div>
      <a class="nav-item active" href="/admin/business-os"><span>⌂</span> Overview</a>
      <a class="nav-item" href="/admin/bookings"><span>▦</span> Bookings</a>
      <a class="nav-item" href="/admin/conversations"><span>◌</span> Guest CRM & inbox</a>
      <a class="nav-item" href="/admin/tours"><span>◇</span> Experiences & pricing</a>
      <div class="nav-label nav-label-spaced">GROWTH ENGINE</div>
      <a class="nav-item" href="/admin/marketing"><span>↗</span> Marketing & SEO studio</a>
      <a class="nav-item" href="/admin/seo"><span>⌕</span> SEO metadata</a>
      <div class="nav-label nav-label-spaced">AI & CONTROL</div>
      <a class="nav-item" href="/admin/ai"><span>✳</span> AI assistant</a>
      <a class="nav-item" href="/admin/analytics"><span>▤</span> Performance insights</a>
      <a class="nav-item" href="/admin/approvals"><span>✓</span> Approvals & safety</a>
      <div class="nav-label nav-label-spaced">WEBSITE</div>
      <a class="nav-item" href="/admin"><span>↗</span> Public website dashboard</a>
      <div class="sidebar-bottom"><div class="pilot-state"><i></i><span><b>Private pilot</b><small>Workspace preview</small></span></div><button id="logout" class="logout-button" type="button">Sign out ↗</button></div>
    </aside>

    <section class="main-area">
      <header class="topbar"><div class="mobile-brand"><span class="brand-mark">MH</span><b>Materuni Hosts</b></div><div class="breadcrumb">Business OS <span>/</span> Overview <span class="today-label" id="today-label"></span></div><div class="top-actions"><span class="secure-label">● Private workspace</span><button class="avatar" type="button" aria-label="Administrator account">MH</button></div></header>
      <main class="content">
        <div class="page-heading"><div><p class="eyebrow">BUSINESS COMMAND CENTER</p><h1>Good to have you back.</h1><p class="muted">Your daily operations, growth work and business intelligence in one calm workspace.</p></div><a class="outline-button" href="/admin">Manage public website ↗</a></div>

        <section class="hero-panel">
          <div class="hero-copy"><span class="hero-kicker">YOUR BUSINESS, CONNECTED</span><h2>More clarity.<br/><em>Less busywork.</em></h2><p>Manage guest operations and marketing issues here. The public website dashboard remains a separate space for editing pages, images and website settings.</p><a href="/admin/ai" class="hero-link">Talk to your AI assistant <span>→</span></a></div>
          <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="sun-disc"></div><div class="hill hill-back"></div><div class="hill hill-front"></div><div class="art-caption">MATERUNI<br/><small>AT THE FOOT OF KILIMANJARO</small></div></div>
        </section>

        <div class="section-heading"><div><p class="eyebrow">DAILY OPERATIONS</p><h2>What needs your attention?</h2></div><span class="section-note">Start with a task</span></div>
        <div class="quick-search"><span>⌕</span><input id="workspace-search" type="search" placeholder="Find a task: bookings, guest, SEO, campaign…" aria-label="Search Business OS tasks"><kbd>Search</kbd></div>
        <section class="task-grid searchable-workspace">
          <a class="task-card task-main" href="/admin/bookings"><span class="task-icon">▦</span><span class="task-arrow">↗</span><h3>Manage bookings</h3><p>Review guest requests, confirm dates and manage upcoming experiences.</p><b>Open bookings <span>→</span></b></a>
          <a class="task-card" href="/admin/conversations"><span class="task-icon">◌</span><span class="task-arrow">↗</span><h3>Guest conversations</h3><p>Keep enquiries and guest follow-ups moving.</p><b>Open inbox <span>→</span></b></a>
          <a class="task-card" href="/admin/tours"><span class="task-icon">◇</span><span class="task-arrow">↗</span><h3>Experiences & prices</h3><p>Update tour information, prices and inclusions.</p><b>Manage catalogue <span>→</span></b></a>
        </section>


        <section class="growth-section" aria-labelledby="growth-heading">
          <div class="section-heading"><div><p class="eyebrow">GROWTH & MARKETING COMMAND CENTER</p><h2 id="growth-heading">Find opportunities. Fix issues. Grow steadily.</h2></div><span class="section-note">Visibly-inspired SEO · HubSpot-inspired CRM</span></div>
          <div class="growth-grid searchable-workspace">
            <a class="growth-card growth-feature" href="/admin/marketing"><span class="growth-tag">SEO INTELLIGENCE</span><strong>Website visibility & SEO</strong><p>Run on-page audits, identify technical issues and prepare keyword-led content briefs.</p><span class="growth-action">Open SEO studio ↗</span></a>
            <a class="growth-card" href="/admin/conversations"><span class="growth-icon">◎</span><strong>CRM & lead pipeline</strong><p>Keep enquiries, guest conversations and follow-ups moving in one place.</p><span class="growth-action">Open guest CRM ↗</span></a>
            <a class="growth-card" href="/admin/marketing"><span class="growth-icon">✳</span><strong>Campaign & content studio</strong><p>Plan useful stories, social content and email campaign drafts for approval.</p><span class="growth-action">Open marketing ↗</span></a>
            <a class="growth-card" href="/admin/approvals"><span class="growth-icon">✓</span><strong>Workflow approvals</strong><p>Keep publishing, customer messages and sensitive business actions controlled.</p><span class="growth-action">Review approvals ↗</span></a>
            <a class="growth-card" href="/admin/analytics"><span class="growth-icon">⌁</span><strong>Growth performance</strong><p>Review available business and channel reporting without inventing missing metrics.</p><span class="growth-action">View insights ↗</span></a>
          </div>
          <p class="growth-disclaimer"><strong>Current connection status:</strong> the website crawler and admin tools are available. Search Console data sync, social publishing, automated CRM follow-ups and live AI providers still need connection and testing.</p>
        </section>
        <section class="lower-grid">
          <div class="panel assistant-panel"><div class="panel-top"><div><p class="eyebrow">AI BUSINESS ASSISTANT</p><h2>Your thinking partner</h2></div><span class="spark">✳</span></div><p>Analyse business performance, identify SEO and marketing issues, prepare campaigns and guest replies. Keep publishing and sensitive actions behind your approval.</p><a class="dark-button" href="/admin/ai">Open AI assistant <span>→</span></a><div class="provider-note"><i></i> AI setup required · live generation is not yet confirmed.</div></div>
          <div class="panel readiness-panel"><p class="eyebrow">AUTOMATION ROADMAP</p><h2>Building your connected business</h2><div class="roadmap-item"><span class="roadmap-dot done">✓</span><div><b>Core admin workspace</b><small>Dashboard, login and existing tools</small></div><span class="state-pill state-ready">Available</span></div><div class="roadmap-item"><span class="roadmap-dot progress">2</span><div><b>AI assistant</b><small>Interface prepared; provider setup pending</small></div><span class="state-pill state-progress">Setup</span></div><div class="roadmap-item"><span class="roadmap-dot">3</span><div><b>Marketing intelligence</b><small>SEO audits, content planning, campaign workflows and growth tasks</small></div><span class="state-pill">Planned</span></div><div class="roadmap-item"><span class="roadmap-dot">4</span><div><b>CRM & customer journeys</b><small>Lead pipeline, guest history, follow-ups and performance insights</small></div><span class="state-pill">Planned</span></div></div>
        </section>
        <footer class="app-footer"><span>Materuni Hosts · Business OS</span><span>Built around people, place and meaningful experiences.</span></footer>
      </main>
    </section>
  </div>
</main>
</SiteLayout>
<script>
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
const byId = (id: string) => document.getElementById(id) as HTMLElement;
const login = byId("login-form") as HTMLFormElement;
const recoveryForm = byId("recovery-form") as HTMLFormElement;
const newPasswordForm = byId("new-password-form") as HTMLFormElement;
const panel = byId("login-panel");
const workspace = byId("workspace");
const button = byId("login-button") as HTMLButtonElement;
let accessToken = "";
let recoveryToken = "";
const feedback = byId("login-feedback");
const headers = () => ({ apikey: publishableKey, Authorization: "Bearer " + accessToken });
const showLoginError = (message: string) => {
  if (/invalid login credentials/i.test(message)) feedback.textContent = "Email or password is incorrect. Check your details or reset the password.";
  else if (/email not confirmed/i.test(message)) feedback.textContent = "This administrator email has not been confirmed. Check your inbox.";
  else feedback.textContent = message;
};
login.addEventListener("submit", async (event) => {
  event.preventDefault(); button.disabled = true; feedback.textContent = "Verifying administrator access…";
  try {
    const response = await fetch(supabaseUrl + "/auth/v1/token?grant_type=password", { method:"POST", headers:{apikey:publishableKey,"Content-Type":"application/json"}, body:JSON.stringify({email:(byId("email") as HTMLInputElement).value.trim(),password:(byId("password") as HTMLInputElement).value}) });
    const session = await response.json();
    if (!response.ok || !session.access_token || !session.user?.id) throw new Error(session.msg || session.message || session.error_description || "Sign in failed.");
    accessToken = session.access_token;
    const adminResponse = await fetch(supabaseUrl + "/rest/v1/admin_users?select=user_id&user_id=eq." + encodeURIComponent(session.user.id), {headers:{...headers(),Accept:"application/json"}});
    const admins = await adminResponse.json();
    if (!adminResponse.ok || !Array.isArray(admins) || !admins.length) throw new Error("This account is not on the Materuni Hosts administrator allowlist.");
    panel.hidden = true; workspace.hidden = false;
  } catch (error) { accessToken = ""; showLoginError(error instanceof Error ? error.message : "Unable to sign in."); }
  finally { button.disabled = false; }
});
byId("forgot-password").addEventListener("click", () => { (byId("recovery-email") as HTMLInputElement).value=(byId("email") as HTMLInputElement).value.trim();login.hidden=true;recoveryForm.hidden=false;feedback.textContent=""; });
byId("cancel-recovery").addEventListener("click",()=>{recoveryForm.hidden=true;login.hidden=false;byId("recovery-feedback").textContent="";});
recoveryForm.addEventListener("submit",async(event)=>{event.preventDefault();const b=byId("recovery-button") as HTMLButtonElement;const f=byId("recovery-feedback");b.setAttribute("disabled","true");f.textContent="Requesting a secure reset email…";try{const email=(byId("recovery-email") as HTMLInputElement).value.trim();const redirectTo=window.location.origin+window.location.pathname;const response=await fetch(supabaseUrl+"/auth/v1/recover?redirect_to="+encodeURIComponent(redirectTo),{method:"POST",headers:{apikey:publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email})});const result=await response.json().catch(()=>({}));if(!response.ok)throw new Error(result.msg||result.message||"Could not request a reset email.");f.textContent="If this email belongs to an account, a reset link has been sent. Check your inbox and spam folder.";}catch(error){f.textContent=error instanceof Error?error.message:"Could not request a reset email.";}finally{b.removeAttribute("disabled");}});
const hashParams=new URLSearchParams(window.location.hash.replace(/^#/,""));
if(hashParams.get("type")==="recovery"&&hashParams.get("access_token")){recoveryToken=hashParams.get("access_token")||"";login.hidden=true;recoveryForm.hidden=true;newPasswordForm.hidden=false;window.history.replaceState(null,"",window.location.pathname+window.location.search);byId("password-feedback").textContent="Choose a new password for your administrator account.";}
newPasswordForm.addEventListener("submit",async(event)=>{event.preventDefault();const password=(byId("new-password") as HTMLInputElement).value;const confirmation=(byId("confirm-password") as HTMLInputElement).value;const f=byId("password-feedback");const b=byId("save-password") as HTMLButtonElement;if(password.length<8){f.textContent="Use at least 8 characters.";return;}if(password!==confirmation){f.textContent="The passwords do not match.";return;}b.disabled=true;f.textContent="Updating your password securely…";try{const response=await fetch(supabaseUrl+"/auth/v1/user",{method:"PUT",headers:{apikey:publishableKey,Authorization:"Bearer "+recoveryToken,"Content-Type":"application/json"},body:JSON.stringify({password})});const result=await response.json().catch(()=>({}));if(!response.ok)throw new Error(result.msg||result.message||"Password update failed. Request a fresh reset link.");recoveryToken="";newPasswordForm.hidden=true;login.hidden=false;panel.querySelector("h1")!.textContent="Password updated.";feedback.textContent="Your password has been changed. Sign in with your new password.";(byId("password")).focus();}catch(error){f.textContent=error instanceof Error?error.message:"Password update failed.";}finally{b.disabled=false;}});
const workspaceSearch=byId("workspace-search") as HTMLInputElement;
workspaceSearch.addEventListener("input",()=>{const query=workspaceSearch.value.trim().toLocaleLowerCase();document.querySelectorAll(".searchable-workspace > a").forEach(card=>{const item=card as HTMLElement;item.hidden=!!query&&!item.textContent!.toLocaleLowerCase().includes(query);});});
const todayLabel=byId("today-label");todayLabel.textContent=new Intl.DateTimeFormat(undefined,{weekday:"short",day:"numeric",month:"short"}).format(new Date());
byId("logout").addEventListener("click",async()=>{try{if(accessToken)await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:headers()});}catch{}accessToken="";workspace.hidden=true;panel.hidden=false;login.reset();feedback.textContent="You have signed out.";});
</script>
<style>
:root{--forest:#1a3322;--ivory:#faf7f2;--sand:#e6dfd3;--gold:#c5a059;--ink:#242421;--muted:#77766f;--line:#e9e4da}
[hidden]{display:none!important}.app-shell{min-height:100vh;background:#f7f6f2;color:var(--ink);font-family:Manrope,Arial,sans-serif}.eyebrow{font-size:10px;letter-spacing:.17em;font-weight:800;color:#98763d;margin:0 0 10px}.muted{color:var(--muted);line-height:1.65}
.login-wrap{width:min(460px,calc(100% - 32px));margin:6vh auto;padding:34px;background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:0 18px 60px #2927190d}.login-brand,.brand{display:flex;align-items:center;gap:12px;margin-bottom:44px;color:var(--forest);text-decoration:none}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border-radius:50%;border:1px solid var(--gold);font:20px Georgia,serif;color:var(--gold);flex:none}.login-brand b,.brand b{display:block;font:600 18px Georgia,serif}.login-brand small,.brand small{display:block;margin-top:4px;font-size:9px;letter-spacing:.18em;color:#8d8068}.login-wrap h1{font:500 clamp(36px,7vw,52px)/1.05 Georgia,serif;color:var(--forest);margin:0 0 14px}.login-wrap>.muted{font-size:14px}.login-form{display:grid;gap:10px;margin-top:26px}.login-form label{font-size:12px;font-weight:750;color:#45463f}.login-form input{height:48px;border:1px solid #ded9cf;border-radius:10px;padding:0 14px;font:inherit;outline:none}.login-form input:focus{border-color:var(--gold);box-shadow:0 0 0 3px #c5a05922}.login-form button:not(.link-button){height:49px;margin-top:8px;background:var(--forest);color:white;border:0;border-radius:10px;font-weight:750;cursor:pointer}.login-form button span{float:right}.link-button{background:none;border:0;text-align:left;color:#816633;text-decoration:underline;padding:8px 0;cursor:pointer}.feedback{font-size:12px;color:#a14d31;min-height:18px}.login-foot{border-top:1px solid var(--line);margin-top:24px;padding-top:17px;color:#999184;font-size:10px}
.workspace{min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:244px;background:#fff;border-right:1px solid var(--line);padding:25px 17px;display:flex;flex-direction:column;z-index:3}.brand{padding:0 9px 28px;margin:0 0 17px;border-bottom:1px solid var(--line)}.nav-label{padding:8px 12px;color:#aaa397;font-size:9px;font-weight:800;letter-spacing:.16em}.nav-label-spaced{margin-top:22px}.nav-item{display:flex;align-items:center;gap:13px;padding:11px 13px;margin:2px 0;border-radius:9px;color:#65665e;text-decoration:none;font-size:12px;font-weight:650;transition:.18s}.nav-item span{width:18px;text-align:center;font-size:17px;color:#8c866f}.nav-item:hover,.nav-item.active{background:#f1f2ed;color:var(--forest)}.nav-item.active{font-weight:800}.nav-item.active span{color:var(--gold)}.sidebar-bottom{margin-top:auto;border-top:1px solid var(--line);padding:17px 7px 0}.pilot-state{display:flex;gap:10px;align-items:center}.pilot-state i,.provider-note i{width:7px;height:7px;border-radius:50%;background:#c49b52;display:block;flex:none}.pilot-state b,.pilot-state small{display:block}.pilot-state b{font-size:11px;color:var(--forest)}.pilot-state small{font-size:10px;color:#999184;margin-top:3px}.logout-button{margin-top:18px;background:none;border:0;color:#77766f;font:inherit;font-size:11px;cursor:pointer;padding:7px 0}
.main-area{margin-left:244px;min-height:100vh}.topbar{height:68px;display:flex;align-items:center;justify-content:space-between;padding:0 42px;background:#fff;border-bottom:1px solid var(--line)}.breadcrumb{font-size:11px;color:#85847d}.breadcrumb span{padding:0 9px;color:#c5a059}.top-actions{display:flex;align-items:center;gap:17px}.secure-label{font-size:10px;color:#77766f}.secure-label:first-letter{color:#6e986d}.avatar{width:32px;height:32px;border-radius:50%;border:1px solid #e6d9bd;background:#f7f0e3;color:var(--forest);font:12px Georgia,serif}.mobile-brand{display:none}.content{max-width:1320px;margin:0 auto;padding:36px 42px 24px}.page-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px}.page-heading h1{font:500 clamp(30px,4vw,42px)/1.1 Georgia,serif;color:var(--forest);margin:0 0 8px}.page-heading .muted{font-size:12px;margin:0}.outline-button{padding:10px 14px;border:1px solid #d9d2c5;border-radius:9px;color:var(--forest);text-decoration:none;font-size:10px;font-weight:750;background:#fff}
