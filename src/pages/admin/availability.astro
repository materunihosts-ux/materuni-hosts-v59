---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Tour Availability | Materuni Hosts Business OS" description="Manage published guest booking dates and time slots." noindex={true}>
<section class="page-hero availability-hero">
  <span class="eyebrow">BUSINESS OS · OPERATIONS</span>
  <h1>Tour availability</h1>
  <p>Publish and manage the dates and time slots guests can request. Public experience descriptions, photos and displayed prices remain in the Public Website Dashboard.</p>
  <div class="workspace-links"><a class="button" href="/admin/business-os">← Business OS</a><a class="button button-secondary" href="/admin">Public Website Dashboard ↗</a></div>
</section>
<section class="booking-wrap">
  <div class="booking-panel" id="login-panel">
    <h2>Administrator sign in</h2>
    <p class="muted">Only authorised Materuni Hosts administrators can change booking availability.</p>
    <form id="login-form" class="form-grid">
      <div class="field full"><label for="admin-email">Admin email</label><input id="admin-email" type="email" autocomplete="username" required></div>
      <div class="field full"><label for="admin-password">Password</label><input id="admin-password" type="password" autocomplete="current-password" required></div>
      <div class="field full"><button class="button" id="login-button" type="submit">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div>
    </form>
  </div>
  <div id="manager" hidden>
    <div class="booking-panel availability-create">
      <span class="eyebrow">PUBLISH BOOKING SLOTS</span>
      <h2>Create available dates & times</h2>
      <p class="muted">Choose an active experience and publish one or more dates. Existing matching slots are skipped to avoid accidental duplicates.</p>
      <form id="slot-form" class="form-grid">
        <div class="field full"><label for="slot-experience">Experience *</label><select id="slot-experience" required><option value="">Loading experiences…</option></select></div>
        <div class="field"><label for="slot-date">Start date *</label><input id="slot-date" type="date" required></div>
        <div class="field"><label for="slot-end-date">End date (optional)</label><input id="slot-end-date" type="date"><small class="muted">Up to 90 calendar days, inclusive.</small></div>
        <div class="field"><label for="slot-capacity">Guest capacity per slot *</label><input id="slot-capacity" type="number" min="1" max="100" value="10" required></div>
        <div class="field"><label for="slot-start">Start time *</label><input id="slot-start" type="time" value="08:00" required></div>
        <div class="field"><label for="slot-end">End time *</label><input id="slot-end" type="time" value="14:00" required></div>
        <div class="field full"><button class="button" id="publish-slots" type="submit">Publish availability</button><p id="slot-feedback" class="muted" aria-live="polite"></p></div>
      </form>
    </div>
    <div class="booking-panel availability-calendar">
      <div class="section-heading"><div><span class="eyebrow">UPCOMING DEPARTURES</span><h2>Availability calendar</h2><p class="muted">Review remaining capacity and open or close guest booking slots.</p></div><button class="button button-secondary" id="refresh-slots" type="button">Refresh list</button></div>
      <div id="availability-list" class="admin-booking-list" aria-live="polite"><p class="muted">Loading availability…</p></div>
      <p class="muted availability-note">Closing a slot prevents new guest requests for that departure. It does not cancel existing bookings.</p>
    </div>
    <div class="workspace-footer"><a href="/admin/operations">Open commercial rates & documents ↗</a><button class="button button-secondary" id="logout" type="button">Sign out</button></div>
  </div>
</section>
<style>
.availability-hero{padding:clamp(26px,5vw,46px);border-radius:20px;background:linear-gradient(120deg,#1a3322,#314b36 72%,#52684b);color:#faf7f2}.availability-hero .eyebrow{color:#dfc17e}.availability-hero h1{font:500 clamp(34px,5vw,48px)/1.08 Georgia,serif;color:#faf7f2}.availability-hero p{max-width:760px;color:#e5e8df;line-height:1.7}.workspace-links{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}.availability-hero .button{background:#c5a059;color:#1a3322;border:1px solid #c5a059}.availability-hero .button-secondary{background:transparent;color:#faf7f2;border-color:#ffffff77}.availability-create,.availability-calendar{margin-top:18px}.availability-create h2,.availability-calendar h2{font:500 24px Georgia,serif;color:#1a3322}.availability-create .form-grid{gap:15px}.availability-create input,.availability-create select{min-height:44px;border-radius:9px}.availability-create button{min-height:44px}.availability-note{margin-top:14px;padding-top:12px;border-top:1px solid #eee9e0;font-size:12px}.workspace-footer{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:16px}.workspace-footer a{color:#1a3322;font-size:12px;font-weight:700;text-decoration:none}.availability-row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 0;border-bottom:1px solid #eee9e0}.availability-row:last-child{border-bottom:0}.availability-row strong{display:block;color:#1a3322}.availability-row small{display:block;margin-top:5px;color:#77766f;line-height:1.5}.availability-row button{white-space:nowrap}@media(max-width:650px){.availability-hero{padding:26px 20px}.workspace-footer{align-items:flex-start;flex-direction:column}.availability-calendar .section-heading{align-items:flex-start;gap:10px}.availability-row button{width:100%}}
</style>
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
let accessToken="";
const el=id=>document.getElementById(id);
const headers=()=>({apikey:publishableKey,Authorization:"Bearer "+accessToken,"Content-Type":"application/json"});
async function api(path,options={}){const response=await fetch(supabaseUrl+path,{...options,headers:{...headers(),...(options.headers||{})}});const data=await response.json().catch(()=>null);if(!response.ok)throw new Error(data?.message||data?.details||data?.error_description||"Request failed.");return data}
const localDate=()=>new Intl.DateTimeFormat("en-CA",{timeZone:"Africa/Dar_es_Salaam",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date());
const today=localDate();
el("slot-date").min=today;el("slot-end-date").min=today;
function node(tag,className,value){const n=document.createElement(tag);if(className)n.className=className;n.textContent=value==null?"":String(value);return n}
async function loadExperiences(){const rows=await api("/rest/v1/experience_catalog?select=experience_key,display_name,price_usd,is_active&is_active=eq.true&order=display_name.asc");const select=el("slot-experience");select.replaceChildren(node("option","","Select an experience"));select.options[0].value="";rows.forEach(item=>{const option=node("option","",item.display_name+" · $"+Number(item.price_usd).toFixed(0));option.value=item.experience_key;select.append(option)});if(!rows.length)throw new Error("No active experiences are available. Add or activate an experience in the Public Website Dashboard first.");}
async function refreshAvailability(){const list=el("availability-list");list.replaceChildren(node("p","muted","Loading availability…"));try{const query=new URLSearchParams({select:"id,experience,slot_date,start_time,end_time,capacity,booked_count,is_active",slot_date:"gte."+today,order:"slot_date.asc,start_time.asc",limit:"200"});const rows=await api("/rest/v1/availability_slots?"+query.toString());list.replaceChildren();if(!rows.length){list.append(node("p","muted","No upcoming availability has been published yet."));return}rows.forEach(slot=>{const row=document.createElement("div");row.className="availability-row";const info=document.createElement("div");info.append(node("strong","",slot.experience||"Experience"),node("small","",slot.slot_date+" · "+String(slot.start_time).slice(0,5)+"–"+String(slot.end_time).slice(0,5)+" · "+Math.max(0,Number(slot.capacity)-Number(slot.booked_count))+" spaces left of "+slot.capacity+" · "+(slot.is_active?"Open for requests":"Closed")));const action=document.createElement("button");action.type="button";action.className="button button-secondary";action.textContent=slot.is_active?"Close availability":"Reopen availability";action.addEventListener("click",async()=>{action.disabled=true;try{await api("/rest/v1/availability_slots?id=eq."+encodeURIComponent(slot.id),{method:"PATCH",body:JSON.stringify({is_active:!slot.is_active})});await refreshAvailability()}catch(error){el("slot-feedback").textContent=error.message;action.disabled=false}});row.append(info,action);list.append(row)})}catch(error){list.replaceChildren(node("p","muted","Availability could not be loaded: "+error.message))}}
el("login-form").addEventListener("submit",async event=>{event.preventDefault();const button=el("login-button");button.disabled=true;el("login-feedback").textContent="Verifying administrator access…";try{const response=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:{apikey:publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email:el("admin-email").value.trim(),password:el("admin-password").value})});const session=await response.json();if(!response.ok||!session.access_token||!session.user?.id)throw new Error(session.msg||session.message||"Sign in failed.");accessToken=session.access_token;const admins=await api("/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(session.user.id));if(!Array.isArray(admins)||!admins.length)throw new Error("This account is not authorised as an administrator.");el("login-panel").hidden=true;el("manager").hidden=false;await Promise.all([loadExperiences(),refreshAvailability()])}catch(error){accessToken="";el("login-feedback").textContent=error.message}finally{button.disabled=false}});
el("slot-form").addEventListener("submit",async event=>{event.preventDefault();const button=el("publish-slots");button.disabled=true;const feedback=el("slot-feedback");feedback.textContent="Checking dates and publishing…";try{const experience=el("slot-experience").value,startDate=el("slot-date").value,endDate=el("slot-end-date").value||startDate,start=el("slot-start").value,end=el("slot-end").value,capacity=Number(el("slot-capacity").value);if(!experience)throw new Error("Choose an active experience.");if(!startDate||startDate<today)throw new Error("Choose today or a future date.");if(endDate<startDate)throw new Error("End date cannot be earlier than start date.");if(end<=start)throw new Error("End time must be later than start time.");if(!Number.isInteger(capacity)||capacity<1||capacity>100)throw new Error("Capacity must be between 1 and 100 guests.");const dates=[];let current=new Date(startDate+"T12:00:00Z"),stop=new Date(endDate+"T12:00:00Z");while(current<=stop&&dates.length<91){dates.push(current.toISOString().slice(0,10));current.setUTCDate(current.getUTCDate()+1)}if(current<=stop)throw new Error("Choose a date range of no more than 90 days.");const query=new URLSearchParams({select:"slot_date",experience:"eq."+experience,start_time:"eq."+start,end_time:"eq."+end});query.append("slot_date","gte."+startDate);query.append("slot_date","lte."+endDate);const existing=await api("/rest/v1/availability_slots?"+query.toString());const already=new Set((Array.isArray(existing)?existing:[]).map(x=>x.slot_date));const fresh=dates.filter(date=>!already.has(date));if(!fresh.length){feedback.textContent="All matching dates already exist. No duplicate slots were created.";return}const payload=fresh.map(date=>({experience,slot_date:date,start_time:start,end_time:end,capacity,booked_count:0,is_active:true}));await api("/rest/v1/availability_slots",{method:"POST",headers:{"Prefer":"return=minimal"},body:JSON.stringify(payload)});feedback.textContent="Published "+fresh.length+" date(s). "+(dates.length-fresh.length)+" existing date(s) skipped.";el("slot-form").reset();el("slot-date").min=today;el("slot-end-date").min=today;el("slot-capacity").value="10";el("slot-start").value="08:00";el("slot-end").value="14:00";await refreshAvailability()}catch(error){feedback.textContent=error.message}finally{button.disabled=false}});
el("refresh-slots").addEventListener("click",refreshAvailability);
el("logout").addEventListener("click",async()=>{try{await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:headers()})}catch{}accessToken="";el("manager").hidden=true;el("login-panel").hidden=false;el("login-form").reset();el("login-feedback").textContent="You have signed out."});
</script>
</SiteLayout>