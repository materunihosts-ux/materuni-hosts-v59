---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Booking Management | Materuni Hosts" description="Private booking management for Materuni Hosts administrators." noindex={true}>
<section class="page-hero">
  <span class="eyebrow">PRIVATE ADMIN</span>
  <h1>Booking management</h1>
  <p>Review guest requests, confirm reservations, cancel bookings and keep availability accurate.</p>
</section>
<section class="booking-wrap">
  <div class="booking-panel" id="login-panel">
    <h2>Administrator sign in</h2>
    <p class="muted">Only authorised Materuni Hosts administrators can access guest information.</p>
    <form id="login-form" class="form-grid">
      <div class="field full"><label for="admin-email">Admin email</label><input id="admin-email" type="email" autocomplete="username" required></div>
      <div class="field full"><label for="admin-password">Password</label><input id="admin-password" type="password" autocomplete="current-password" required></div>
      <div class="field full"><button class="button" id="login-button" type="submit">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div>
    </form>
  </div>
  <div id="manager" hidden>
    <div class="booking-panel">
      <div class="section-heading"><div><span class="eyebrow">RESERVATIONS</span><h2>Guest bookings</h2><p class="muted">Private guest details — keep this page secure.</p></div><div class="admin-shortcuts"><a class="button button-secondary" href="/admin/analytics">Analytics</a><a class="button button-secondary" href="/admin/conversations">Guest conversations</a><a class="button button-secondary" href="/admin/tours">Tours & availability</a><a class="button button-secondary" href="/admin/settings">Website settings</a><button class="button button-secondary" id="logout" type="button">Sign out</button></div></div>
      <form id="filter-form" class="form-grid">
        <div class="field"><label for="from-date">From</label><input id="from-date" type="date" required></div>
        <div class="field"><label for="to-date">To</label><input id="to-date" type="date" required></div>
        <div class="field"><label for="status-filter">Status</label><select id="status-filter"><option value="all">All statuses</option><option>New</option><option>Contacted</option><option>Confirmed</option><option>Cancelled</option></select></div>
        <div class="field"><label for="search-filter">Search guest / reference</label><input id="search-filter" type="search" placeholder="Name, email, reference…"></div>
        <div class="field full"><button class="button" type="submit" id="refresh-button">Load bookings</button><p id="booking-feedback" class="muted" aria-live="polite"></p></div>
      </form>
    </div>
    <div class="booking-panel" style="margin-top:1.5rem">
      <div class="admin-stats" id="booking-stats">
        <div class="admin-stat"><span>Total in range</span><strong id="stat-total">—</strong></div>
        <div class="admin-stat"><span>New requests</span><strong id="stat-new">—</strong></div>
        <div class="admin-stat"><span>Contacted</span><strong id="stat-contacted">—</strong></div>
        <div class="admin-stat"><span>Confirmed</span><strong id="stat-confirmed">—</strong></div>
        <div class="admin-stat"><span>Cancelled</span><strong id="stat-cancelled">—</strong></div>
      </div>
      <div id="booking-list" class="admin-booking-list"><p class="muted">Choose a date range and load bookings.</p></div>
    </div>
    <div class="booking-panel" style="margin-top:1.5rem"><span class="eyebrow">AUTOMATION HEALTH</span><h2>Notification delivery log</h2><p class="muted">See whether booking acknowledgement emails and WhatsApp alerts were sent, skipped or failed.</p><div id="notification-list" class="admin-notification-list"><p class="muted">Sign in to load notification history.</p></div></div>
  </div>
</section>
<script>
// @ts-nocheck

const supabaseUrl = "https://sskmzswoeljxwojcszta.supabase.co";
const publishableKey = "sb_publishable_G9ru4P_yKzievqiXjXEEbQ_p28cB_NZ";
let accessToken = "";
const el = id => document.getElementById(id);
const headers = () => ({ apikey: publishableKey, Authorization: "Bearer " + accessToken, "Content-Type": "application/json" });
async function notifyBookingChange(bookingId, event) {
  try {
    const result = await api("/functions/v1/admin-booking-notification", {
      method: "POST",
      body: JSON.stringify({ booking_id: bookingId, event })
    });
    return result;
  } catch (error) {
    console.error("Booking changed, but guest notification did not complete:", error);
    return { success: false, error: error.message };
  }
}
const localDate = date => new Intl.DateTimeFormat("en-CA", {
  timeZone: "Africa/Dar_es_Salaam", year: "numeric", month: "2-digit", day: "2-digit"
}).format(date);
const today = new Date();
el("from-date").value = localDate(new Date(today.getTime() - 30 * 86400000));
el("to-date").value = localDate(new Date(today.getTime() + 90 * 86400000));
async function api(path, options = {}) {
  const response = await fetch(supabaseUrl + path, { ...options, headers: { ...headers(), ...(options.headers || {}) } });
  const data = await response.json().catch(() => null);
  if (!response.ok) throw new Error(data?.message || data?.details || data?.error_description || "Request failed.");
  return data;
}
function makeText(tag, className, value) {
  const node = document.createElement(tag);
  if (className) node.className = className;
  node.textContent = value == null ? "" : String(value);
  return node;
}
async function loadNotificationLogs() {
  const list = el("notification-list");
  try {
    const rows = await api("/rest/v1/rpc/admin_get_notification_logs",{method:"POST",body:"{}"});
    list.replaceChildren();
    if (!rows.length) { list.append(makeText("p","muted","No notification attempts have been recorded yet.")); return; }
    rows.slice(0,30).forEach(item => {
      const line = document.createElement("div"); line.className = "admin-notification-row";
      const main = document.createElement("div");
      main.append(makeText("strong","",String(item.notification_type || "Booking update").replaceAll("_"," ")),makeText("span","muted",String(item.recipient || "—")));
      const meta = document.createElement("div");
      meta.append(makeText("span","notification-channel",item.channel || "—"),makeText("span","status-pill status-" + String(item.delivery_status || "pending").toLowerCase(),item.delivery_status || "pending"));
      line.append(main,meta);
      if (item.error_message) line.append(makeText("p","notification-error",item.error_message));
      list.append(line);
    });
  } catch (error) { list.replaceChildren(makeText("p","muted","Notification history could not be loaded: " + error.message)); }
}
let bookingLoadRequest = 0;
async function loadBookings() {
  const requestId = ++bookingLoadRequest;
  const button = el("refresh-button");
  button.disabled = true;
  el("booking-feedback").textContent = "Loading bookings…";
  try {
    const from = el("from-date").value;
    const to = el("to-date").value;
    if (!from || !to || to < from) throw new Error("Please choose a valid date range.");
    const rows = await api("/rest/v1/rpc/admin_get_bookings", {
      method: "POST",
      body: JSON.stringify({ p_start_date: from, p_end_date: to })
    });
    if (requestId !== bookingLoadRequest) return;
    const bookings = Array.isArray(rows) ? rows : [];
    const status = el("status-filter").value;
    const term = el("search-filter").value.trim().toLowerCase();
    const filtered = bookings.filter(b => (status === "all" || b.booking_status === status) &&
      (!term || [b.guest_name,b.guest_email,b.guest_phone,b.booking_reference,b.experience].some(v => String(v || "").toLowerCase().includes(term))));
    el("stat-total").textContent = bookings.length;
    el("stat-new").textContent = bookings.filter(b => b.booking_status === "New").length;
    el("stat-contacted").textContent = bookings.filter(b => b.booking_status === "Contacted").length;
    el("stat-confirmed").textContent = bookings.filter(b => b.booking_status === "Confirmed").length;
    el("stat-cancelled").textContent = bookings.filter(b => b.booking_status === "Cancelled").length;
    const list = el("booking-list");
    list.replaceChildren();
    if (!filtered.length) list.append(makeText("p","muted","No bookings found for these filters."));
    filtered.forEach(booking => {
      const card = document.createElement("article");
      card.className = "admin-booking-card";
      const top = document.createElement("div"); top.className = "admin-booking-top";
      const identity = document.createElement("div");
      identity.append(makeText("h3","",booking.guest_name || "Guest"), makeText("p","muted",booking.booking_reference || "No reference"));
      const badge = makeText("span","status-pill status-" + String(booking.booking_status || "new").toLowerCase(),booking.booking_status || "Unknown");
      top.append(identity,badge);
      const details = document.createElement("div"); details.className = "admin-booking-details";
      [
        ["Experience",booking.experience],["Date",booking.booking_date],["Start time",booking.start_time || "To be arranged"],
        ["Guests",booking.guest_count],["Email",booking.guest_email],["Phone",booking.guest_phone],
        ["Booking type",booking.booking_type],["Pickup",booking.pickup],["Notes",booking.notes]
      ].forEach(([label,value]) => {
        const item = document.createElement("div");
        item.append(makeText("span","admin-detail-label",label),makeText("strong","",value || "—"));
        details.append(item);
      });
      const actions = document.createElement("div"); actions.className = "admin-booking-actions";
      if (booking.booking_status === "New" || booking.booking_status === "Contacted") {
        const confirm = makeText("button","button","Confirm booking"); confirm.type = "button";
        confirm.addEventListener("click", async () => {
          if (!window.confirm("Confirm this booking? The availability slot has already been reserved by the request.")) return;
          confirm.disabled = true;
          try { await api("/rest/v1/rpc/admin_confirm_booking",{method:"POST",body:JSON.stringify({p_booking_id:booking.booking_id})}); const notice = await notifyBookingChange(booking.booking_id,"confirmed"); el("booking-feedback").textContent = notice.success ? "Booking confirmed and guest notification processed." : "Booking confirmed. Guest notification needs attention: " + (notice.error || "not sent"); await Promise.all([loadBookings(),loadNotificationLogs()]); }
          catch (error) { el("booking-feedback").textContent = error.message; confirm.disabled = false; }
        });
        actions.append(confirm);
        const cancel = makeText("button","button button-secondary","Cancel"); cancel.type = "button";
        cancel.addEventListener("click", async () => {
          if (!window.confirm("Cancel this booking and restore its reserved spaces?")) return;
          cancel.disabled = true;
          try { await api("/rest/v1/rpc/admin_cancel_booking",{method:"POST",body:JSON.stringify({p_booking_id:booking.booking_id})}); const notice = await notifyBookingChange(booking.booking_id,"cancelled"); el("booking-feedback").textContent = notice.success ? "Booking cancelled and guest notification processed." : "Booking cancelled. Guest notification needs attention: " + (notice.error || "not sent"); await Promise.all([loadBookings(),loadNotificationLogs()]); }
          catch (error) { el("booking-feedback").textContent = error.message; cancel.disabled = false; }
        });
        actions.append(cancel);
      } else if (booking.booking_status === "Confirmed") {
        const cancel = makeText("button","button button-secondary","Cancel booking"); cancel.type = "button";
        cancel.addEventListener("click", async () => {
          if (!window.confirm("Cancel this confirmed booking and restore its spaces?")) return;
          cancel.disabled = true;
          try { await api("/rest/v1/rpc/admin_cancel_booking",{method:"POST",body:JSON.stringify({p_booking_id:booking.booking_id})}); const notice = await notifyBookingChange(booking.booking_id,"cancelled"); el("booking-feedback").textContent = notice.success ? "Booking cancelled and guest notification processed." : "Booking cancelled. Guest notification needs attention: " + (notice.error || "not sent"); await Promise.all([loadBookings(),loadNotificationLogs()]); }
          catch (error) { el("booking-feedback").textContent = error.message; cancel.disabled = false; }
        });
        actions.append(cancel);
        const reschedule = makeText("button","button button-secondary","Reschedule");
        reschedule.type = "button";
        reschedule.addEventListener("click", async () => {
          reschedule.disabled = true;
          try {
            const today = localDate(new Date());
            const params = new URLSearchParams({
              select:"id,slot_date,start_time,end_time,capacity,booked_count",
              experience:"eq."+booking.experience,
              slot_date:"gte."+today,
              is_active:"eq.true",
              order:"slot_date.asc,start_time.asc",
              limit:"100"
            });
            const slots = await api("/rest/v1/availability_slots?"+params.toString());
            const guestCount = Number(booking.guest_count || 1);
            const available = slots.filter(slot => (slot.slot_date !== booking.booking_date || String(slot.start_time).slice(0,5) !== String(booking.start_time || "").slice(0,5)) && Number(slot.capacity)-Number(slot.booked_count)>=guestCount);
            if (!available.length) throw new Error("No matching future time slots have enough spaces yet.");
            const picker = document.createElement("select");
            picker.setAttribute("aria-label","Choose a new date and time");
            available.forEach(slot => {
              const option = document.createElement("option");
              option.value = slot.id;
              option.textContent = slot.slot_date+" · "+String(slot.start_time).slice(0,5)+"–"+String(slot.end_time).slice(0,5)+" · "+(Number(slot.capacity)-Number(slot.booked_count))+" spaces left";
              picker.append(option);
            });
            const save = makeText("button","button","Save new time");
            save.type = "button";
            const cancelPicker = makeText("button","button button-secondary","Close");
            cancelPicker.type = "button";
            const editor = document.createElement("div");
            editor.className = "admin-booking-actions";
            editor.append(picker,save,cancelPicker);
            actions.append(editor);
            cancelPicker.addEventListener("click",()=>editor.remove());
            save.addEventListener("click",async()=>{
              save.disabled = true;
              try {
                await api("/rest/v1/rpc/admin_reschedule_booking",{method:"POST",body:JSON.stringify({p_booking_id:booking.booking_id,p_new_slot_id:picker.value})});
                const notice = await notifyBookingChange(booking.booking_id,"rescheduled");
                el("booking-feedback").textContent = notice.success ? "Booking rescheduled and guest notification processed." : "Booking rescheduled. Guest notification needs attention: " + (notice.error || "not sent");
                await Promise.all([loadBookings(),loadNotificationLogs()]);
              } catch(error) {
                el("booking-feedback").textContent = error.message;
                save.disabled = false;
              }
            });
          } catch(error) {
            el("booking-feedback").textContent = error.message;
          } finally {
            reschedule.disabled = false;
          }
        });
        actions.append(reschedule);
      }
      const bookingDate = String(booking.booking_date || "");
      const todayString = localDate(new Date());
      if (booking.booking_status === "Cancelled" || (bookingDate && bookingDate < todayString)) {
        const remove = makeText("button","button button-danger","Delete old booking"); remove.type = "button";
        remove.addEventListener("click", async () => {
          if (!window.confirm("Permanently delete this old booking record? This cannot be undone.")) return;
          remove.disabled = true;
          try { await api("/rest/v1/rpc/admin_delete_booking",{method:"POST",body:JSON.stringify({p_booking_id:booking.booking_id})}); await loadBookings(); }
          catch (error) { el("booking-feedback").textContent = error.message; remove.disabled = false; }
        });
        actions.append(remove);
      }
      card.append(top,details,actions);
      list.append(card);
    });
    el("booking-feedback").textContent = "Showing " + filtered.length + " of " + bookings.length + " bookings.";
  } catch (error) {
    el("booking-feedback").textContent = error.message;
  } finally {
    if (requestId === bookingLoadRequest) button.disabled = false;
  }
}
el("login-form").addEventListener("submit", async event => {
  event.preventDefault();
  const button = el("login-button"); button.disabled = true;
  el("login-feedback").textContent = "Verifying administrator…";
  try {
    const response = await fetch(supabaseUrl + "/auth/v1/token?grant_type=password", {
      method:"POST", headers:{apikey:publishableKey,"Content-Type":"application/json"},
      body:JSON.stringify({email:el("admin-email").value.trim(),password:el("admin-password").value})
    });
    const session = await response.json();
    if (!response.ok) throw new Error(session.msg || session.message || "Sign in failed.");
    accessToken = session.access_token;
    const admins = await api("/rest/v1/admin_users?select=user_id&user_id=eq." + encodeURIComponent(session.user.id));
    if (!admins.length) { accessToken = ""; throw new Error("This account is not authorised as an administrator."); }
    el("login-panel").hidden = true; el("manager").hidden = false;
    await Promise.all([loadBookings(),loadNotificationLogs()]);
  } catch (error) { el("login-feedback").textContent = error.message; }
  finally { button.disabled = false; }
});
el("filter-form").addEventListener("submit", event => { event.preventDefault(); loadBookings(); });
el("status-filter").addEventListener("change", loadBookings);
let bookingSearchTimer;
el("search-filter").addEventListener("input", () => {
  clearTimeout(bookingSearchTimer);
  bookingSearchTimer = setTimeout(loadBookings, 300);
});
el("logout").addEventListener("click", async () => {
  try { await fetch(supabaseUrl + "/auth/v1/logout",{method:"POST",headers:headers()}); } catch {}
  accessToken = ""; el("manager").hidden = true; el("login-panel").hidden = false; el("login-form").reset();
});
</script>
</SiteLayout>
