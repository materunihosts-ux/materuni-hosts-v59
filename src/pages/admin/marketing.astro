---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Marketing & SEO Studio | Materuni Hosts" description="Research-led SEO, content planning and blog drafting workspace." noindex={true}>
<section class="page-hero growth-hero"><span class="eyebrow">BUSINESS OS · GROWTH ENGINE</span><h1>Marketing & SEO Studio</h1><p>Find website issues, plan useful content and organise growth work from one workspace. Live data is clearly separated from research suggestions and local drafts.</p><div class="growth-hero-actions"><a class="button" href="/admin/business-os">← Business OS</a><a class="button button-secondary" href="/admin/seo">SEO metadata editor ↗</a></div></section>
<section class="booking-wrap">
 <div class="booking-panel" id="login-panel"><h2>Administrator sign in</h2><form id="login-form" class="form-grid"><div class="field full"><label for="admin-email">Admin email</label><input id="admin-email" type="email" autocomplete="username" required></div><div class="field full"><label for="admin-password">Password</label><input id="admin-password" type="password" autocomplete="current-password" required></div><div class="field full"><button class="button" id="login-button">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div></form></div>
 <div id="manager" hidden>
  <div class="admin-topbar"><div class="admin-topbar-links"><a class="button button-secondary" href="/admin/business-os">← Business OS</a><a class="button button-secondary" href="/admin">Website dashboard</a><a class="button button-secondary" href="/admin/seo">SEO metadata</a><a class="button button-secondary" href="/sitemap.xml" target="_blank" rel="noopener">Sitemap ↗</a></div><button class="button button-secondary" id="logout">Sign out</button></div>
  <nav class="growth-jump-nav" aria-label="Growth workspace sections"><a href="#seo-audit">SEO audit</a><a href="#research-workbench">Research brief</a><a href="#content-studio">Content studio</a><a href="#integrations">Connections</a></nav>
  <div class="booking-panel growth-work-panel" id="seo-audit" style="margin-top:1rem"><span class="eyebrow">AUTOMATED ON-PAGE CHECK</span><h2>Website SEO crawler</h2><p class="muted">Checks live public pages from the website itself. It does not pretend to have Google rankings or backlink data.</p><div class="form-grid"><div class="field"><label for="audit-scope">Pages to inspect</label><select id="audit-scope"><option value="sitemap">URLs from sitemap.xml</option><option value="core">Core pages only</option></select></div><div class="field" style="align-self:end"><button class="button" id="run-audit" type="button">Run live audit</button></div></div><div class="audit-toolbar"><p id="audit-status" class="muted" aria-live="polite">Not run yet.</p><button class="button button-secondary" id="export-audit" type="button" hidden>Export CSV</button><button class="button button-secondary" id="export-audit-json" type="button" hidden>Export JSON snapshot</button><label class="button button-secondary" for="previous-audit-file">Choose previous snapshot</label><input id="previous-audit-file" type="file" accept="application/json,.json" hidden><button class="button button-secondary" id="compare-audits" type="button" hidden>Compare snapshots</button></div><p id="compare-status" class="muted" aria-live="polite"></p><div id="compare-results" aria-live="polite"></div><div class="admin-stats"><div class="admin-stat"><span>Pages checked</span><strong id="audit-count">—</strong></div><div class="admin-stat"><span>Issues found</span><strong id="audit-issues">—</strong></div><div class="admin-stat"><span>Missing H1</span><strong id="audit-h1">—</strong></div><div class="admin-stat"><span>Missing descriptions</span><strong id="audit-meta">—</strong></div></div><div id="audit-results" style="overflow:auto;margin-top:1rem"></div></div>
  <div class="booking-panel growth-work-panel" id="research-workbench" style="margin-top:1rem"><span class="eyebrow">RESEARCH WORKBENCH</span><h2>SEO opportunity brief</h2><p class="muted">Create a structured research brief for a topic. Suggestions are research hypotheses, not live keyword data or measured search volume.</p><div class="form-grid"><div class="field full"><label for="topic">Topic or experience</label><input id="topic" placeholder="e.g. Chagga traditional coffee experience" /></div><div class="field"><label for="audience">Target visitor</label><select id="audience"><option>International travellers visiting Moshi</option><option>Culture and heritage travellers</option><option>Kilimanjaro visitors adding a day trip</option><option>Responsible tourism researchers</option></select></div><div class="field"><label for="intent">Search intent</label><select id="intent"><option>Informational</option><option>Commercial investigation</option><option>Transactional</option></select></div><div class="field full"><button class="button" id="make-brief" type="button">Build research brief</button></div></div><div id="research-output" class="booking-panel" hidden style="margin-top:1rem"></div></div>
  <div class="booking-panel growth-work-panel" id="content-studio" style="margin-top:1rem"><span class="eyebrow">CONTENT & CAMPAIGN STUDIO</span><h2>Blog editor & SEO checklist</h2><p class="muted">Prepare an article draft and optimise its search snippet. Working copies are stored only in this browser on this device; publishing is not connected.</p><div class="form-grid"><div class="field full"><label for="blog-title">Article title</label><input id="blog-title" maxlength="150" placeholder="Enter a useful, specific headline" /></div><div class="field"><label for="blog-keyword">Primary keyword</label><input id="blog-keyword" placeholder="Primary search phrase" /></div><div class="field"><label for="blog-slug">Suggested URL slug</label><input id="blog-slug" placeholder="article-url-slug" /></div><div class="field full"><label for="blog-description">Meta description</label><textarea id="blog-description" rows="2" maxlength="160" placeholder="Summarise the article in a clear search snippet"></textarea><small id="description-count" class="muted">0 / 160 characters</small></div><div class="field full"><label for="blog-body">Article draft (Markdown supported)</label><textarea id="blog-body" rows="16" placeholder="# Introduction&#10;&#10;Write an accurate, useful article grounded in local knowledge..."></textarea></div><div class="field full"><div class="actions"><button class="button button-secondary" id="save-draft" type="button">Save draft now</button><button class="button button-secondary" id="export-draft" type="button">Export Markdown</button><button class="button button-secondary" id="clear-draft" type="button">Clear draft</button></div><p id="blog-feedback" class="muted" aria-live="polite"></p></div></div><div id="blog-checks" class="muted"></div></div>
  <div class="booking-panel growth-work-panel" id="integrations" style="margin-top:1rem"><span class="eyebrow">CONNECTED DATA & AUTOMATION</span><h2>Connected data sources</h2><p class="muted">The live crawler above works without external credentials. Search Console performance, keyword volumes, competitor SERP research and AI-assisted writing require verified OAuth/API or AI-provider connections. No sample metrics are shown as real data.</p><ul><li>Website page audit: available</li><li>Google Search Console: connection required</li><li>Keyword/SERP research provider: connection required</li><li>AI research and writing provider: connection required</li><li>Direct blog publishing: CMS workflow required</li></ul></div>
 </div>
</section>

<style>
.growth-hero{padding:clamp(26px,5vw,48px);border-radius:20px;background:linear-gradient(120deg,#1a3322,#314b36 70%,#536449);color:#faf7f2}.growth-hero .eyebrow{color:#dfc17e}.growth-hero h1{font:500 clamp(32px,5vw,48px)/1.08 Georgia,serif;color:#faf7f2}.growth-hero p{max-width:720px;color:#e4e7dd;line-height:1.7}.growth-hero-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}.growth-hero-actions .button{background:#c5a059;color:#1a3322;border:1px solid #c5a059}.growth-hero-actions .button-secondary{background:transparent;color:#faf7f2;border-color:#ffffff66}.growth-jump-nav{position:sticky;top:0;z-index:5;display:flex;gap:8px;overflow-x:auto;padding:11px 0;background:#faf7f2;scrollbar-width:thin}.growth-jump-nav a{flex:none;padding:9px 13px;border:1px solid #e6dfd3;border-radius:22px;background:#fff;color:#1a3322;text-decoration:none;font-size:11px;font-weight:700}.growth-work-panel{scroll-margin-top:65px}.growth-work-panel h2{font-family:Georgia,serif;color:#1a3322}.growth-work-panel .form-grid{gap:15px}.growth-work-panel input,.growth-work-panel select,.growth-work-panel textarea{border-radius:9px}.growth-work-panel button{min-height:42px}.growth-work-panel table{font-size:12px}.growth-work-panel th{background:#f5f1e9}.growth-work-panel li{line-height:1.65}.growth-work-panel .admin-stats{gap:10px}.growth-work-panel .admin-stat{border-radius:11px}.audit-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.audit-toolbar p{margin:8px 0}.audit-toolbar button[hidden]{display:none}@media(max-width:650px){.growth-hero{padding:26px 20px}.growth-jump-nav{margin:0 -14px;padding:10px 14px}.admin-topbar{align-items:flex-start;gap:10px}.admin-topbar-links{flex-wrap:nowrap;overflow-x:auto;max-width:calc(100vw - 90px)}.admin-topbar-links .button{white-space:nowrap;font-size:10px}}
</style>
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
import { buildAuditCsv, buildAuditSnapshot, compareAuditSnapshots, extractSitemapPaths, isSameOriginUrl } from "../../lib/seo-audit-utils.js";
let accessToken="";
const el=(id)=>document.getElementById(id);
const headers=()=>({apikey:publishableKey,Authorization:"Bearer "+accessToken,"Content-Type":"application/json"});
async function api(path,options={}){const r=await fetch(supabaseUrl+path,{...options,headers:{...headers(),...(options.headers||{})}});const d=await r.json().catch(()=>null);if(!r.ok)throw new Error(d?.message||d?.msg||"Request failed.");return d}
el("login-form").addEventListener("submit",async e=>{e.preventDefault();const b=el("login-button");b.disabled=true;el("login-feedback").textContent="Checking administrator access…";try{const r=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:{apikey:publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email:el("admin-email").value.trim(),password:el("admin-password").value})});const s=await r.json();if(!r.ok||!s.access_token)throw new Error(s.msg||s.message||"Sign in failed.");accessToken=s.access_token;const admins=await api("/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(s.user.id));if(!admins?.length)throw new Error("This account is not authorised as an administrator.");el("login-panel").hidden=true;el("manager").hidden=false;}catch(err){el("login-feedback").textContent=err.message;}finally{b.disabled=false;}});
el("logout").addEventListener("click",async()=>{try{await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:headers()});}catch{}accessToken="";el("manager").hidden=true;el("login-panel").hidden=false;el("login-form").reset();});
const core=["/","/about-us","/about","/accommodation","/booking","/camping","/chagga-cultural-tour","/chemka-hot-springs","/day-trips","/experiences","/faq","/itinerary","/journal","/marangu-day-hike","/materuni-coffee-tour","/materuni-waterfall-tour","/moshi-day-trips","/privacy","/reviews","/sustainability","/terms","/travel-guide","/work-with-us"];
let lastAuditResults=[];let actualScope="core";let previousAuditSnapshot=null;
function safeCell(v){const td=document.createElement("td");td.textContent=v;td.style.padding="9px";td.style.borderBottom="1px solid #ddd";return td}
async function inspectPage(path){const url=new URL(path,location.origin);if(url.origin!==location.origin)throw new Error("Cross-origin URL blocked");const controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),12000);let response,html;try{response=await fetch(url.href,{credentials:"same-origin",redirect:"follow",signal:controller.signal});const contentLength=Number(response.headers.get("content-length")||0);if(contentLength>5_000_000)throw new Error("HTML page exceeds the 5 MB audit limit");html=await response.text();if(html.length>5_000_000)throw new Error("HTML page exceeds the 5 MB audit limit");}finally{clearTimeout(timeout);}if(!isSameOriginUrl(response.url,location.origin))throw new Error("Redirect outside this website blocked");const contentType=response.headers.get("content-type")||"";if(!response.ok)throw new Error("HTTP "+response.status);if(!contentType.includes("text/html"))throw new Error("Unexpected content type: "+contentType);const doc=new DOMParser().parseFromString(html,"text/html");const title=doc.querySelector("title")?.textContent?.trim()||"";const desc=doc.querySelector('meta[name="description"]')?.content?.trim()||"";const h1=doc.querySelectorAll("h1").length;const canonical=doc.querySelector('link[rel="canonical"]')?.href||"";const robots=(doc.querySelector('meta[name="robots"]')?.content||"").toLowerCase();const viewport=Boolean(doc.querySelector('meta[name="viewport"]'));const ogTitle=doc.querySelector('meta[property="og:title"]')?.content?.trim()||"";const images=[...doc.images];const missingAlt=images.filter(i=>!i.hasAttribute("alt")||!i.getAttribute("alt").trim()).length;const contentRoot=doc.querySelector("main,article,[role='main']")||doc.body;const contentCopy=contentRoot.cloneNode(true);contentCopy.querySelectorAll("script,style,noscript,nav,footer,header,form,[aria-hidden='true']").forEach(node=>node.remove());const wordCount=(contentCopy.textContent||"").trim().split(/\s+/).filter(Boolean).length;const internalLinkCount=[...doc.querySelectorAll("a[href]")].filter(a=>{try{return new URL(a.getAttribute("href"),url).origin===location.origin&&new URL(a.getAttribute("href"),url).pathname!==url.pathname}catch{return false}}).length;const issues=[];if(!title)issues.push("Missing title");else if(title.length<30||title.length>60)issues.push("Title length "+title.length);if(!desc)issues.push("Missing meta description");else if(desc.length<120||desc.length>160)issues.push("Description length "+desc.length);if(h1===0)issues.push("Missing H1");if(h1>1)issues.push("Multiple H1");if(!canonical)issues.push("Missing canonical");else if(new URL(canonical,location.origin).origin!==location.origin)issues.push("Canonical points outside this website");if(robots.includes("noindex"))issues.push("Page is marked noindex");if(!viewport)issues.push("Missing mobile viewport");if(!ogTitle)issues.push("Missing Open Graph title");if(missingAlt)issues.push(missingAlt+" image(s) missing alt");if(wordCount<300)issues.push("Short main content ("+wordCount+" words; heuristic)");if(internalLinkCount===0)issues.push("No contextual internal links detected");return {path,title,desc,h1,canonical,missingAlt,robots,viewport,ogTitle,status:response.status,wordCount,internalLinkCount,imageCount:images.length,issues};}
el("run-audit").addEventListener("click",async()=>{const b=el("run-audit");b.disabled=true;el("audit-status").textContent="Discovering and checking public pages…";el("audit-results").replaceChildren();try{let paths=core;actualScope="core";if(el("audit-scope").value==="sitemap"){const sr=await fetch("/sitemap.xml",{credentials:"same-origin"});if(sr.ok){const xmlText=await sr.text();const sitemapPaths=extractSitemapPaths(xmlText,location.origin,150);if(sitemapPaths.length){paths=sitemapPaths;actualScope="sitemap";}else el("audit-status").textContent="Sitemap contained no valid same-origin URLs; using core pages instead.";}else{el("audit-status").textContent="Sitemap could not be fetched; using core pages instead.";}}const results=[];for(let i=0;i<paths.length;i+=4){const batch=paths.slice(i,i+4);const checked=await Promise.all(batch.map(async p=>{try{return await inspectPage(p);}catch(err){return {path:p,title:"",desc:"",h1:0,canonical:"",missingAlt:0,wordCount:0,internalLinkCount:0,imageCount:0,issues:["Could not fetch: "+err.message]};}}));results.push(...checked);}lastAuditResults=results;el("export-audit").hidden=!results.length;el("export-audit-json").hidden=!results.length;el("compare-audits").hidden=!(results.length&&previousAuditSnapshot);const issueCount=results.reduce((n,r)=>n+r.issues.length,0);el("audit-count").textContent=results.length;el("audit-issues").textContent=issueCount;el("audit-h1").textContent=results.filter(r=>r.h1===0).length;el("audit-meta").textContent=results.filter(r=>!r.desc).length;const table=document.createElement("table");table.style.width="100%";table.style.borderCollapse="collapse";const head=document.createElement("tr");["Page","HTTP","Title","H1","Findings"].forEach(v=>{const th=document.createElement("th");th.textContent=v;th.style.textAlign="left";th.style.padding="9px";head.append(th);});table.append(head);results.forEach(r=>{const tr=document.createElement("tr");tr.append(safeCell(r.path),safeCell(r.status||"—"),safeCell(r.title||"—"),safeCell(r.h1),safeCell(r.issues.join(" · ")||"No basic on-page issues detected"));table.append(tr);});el("audit-results").append(table);el("audit-status").textContent="Completed at "+new Date().toLocaleString()+". Source: live same-origin HTML crawl · "+location.origin+". This is an on-page snapshot in this browser session, not Google ranking, traffic or backlink data.";}catch(err){el("audit-status").textContent="Audit failed: "+err.message;}finally{b.disabled=false;}});
el("export-audit").addEventListener("click",()=>{if(!lastAuditResults.length)return;const csv=buildAuditCsv(lastAuditResults);const blob=new Blob(["\\uFEFF"+csv],{type:"text/csv;charset=utf-8"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="materuni-hosts-seo-audit-"+new Date().toISOString().slice(0,10)+".csv";a.click();URL.revokeObjectURL(url);});
el("export-audit-json").addEventListener("click",()=>{if(!lastAuditResults.length)return;const snapshot=buildAuditSnapshot(lastAuditResults,{siteOrigin:location.origin,scope:actualScope,capturedAt:new Date().toISOString()});const blob=new Blob([JSON.stringify(snapshot,null,2)],{type:"application/json;charset=utf-8"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="materuni-hosts-seo-snapshot-"+new Date().toISOString().slice(0,10)+".json";a.click();URL.revokeObjectURL(url);});

el("previous-audit-file").addEventListener("change",async(e)=>{const file=e.target.files?.[0];previousAuditSnapshot=null;el("compare-audits").hidden=true;el("compare-status").textContent="";el("compare-results").replaceChildren();if(!file)return;try{if(file.size>2000000)throw new Error("Snapshot file is too large (maximum 2 MB).");const parsed=JSON.parse(await file.text());if(parsed.schemaVersion!==1||parsed.source!=="browser_live_crawl"||!Array.isArray(parsed.pages))throw new Error("Unsupported or invalid Materuni SEO snapshot.");previousAuditSnapshot=parsed;el("compare-status").textContent="Previous snapshot loaded ("+parsed.pages.length+" pages). Run a new live audit, then compare.";el("compare-audits").hidden=!lastAuditResults.length;}catch(err){el("compare-status").textContent="Could not load snapshot: "+err.message;}});
el("compare-audits").addEventListener("click",()=>{if(!previousAuditSnapshot||!lastAuditResults.length)return;try{const current=buildAuditSnapshot(lastAuditResults,{siteOrigin:location.origin,scope:actualScope,capturedAt:new Date().toISOString()});const diff=compareAuditSnapshots(previousAuditSnapshot,current);const box=el("compare-results");box.replaceChildren();const summary=document.createElement("p");summary.textContent="Compared "+diff.summary.previousPageCount+" previous pages with "+diff.summary.currentPageCount+" current pages: "+diff.summary.addedPages+" added · "+diff.summary.removedPages+" removed · "+diff.summary.changedPages+" changed · "+diff.summary.unchangedPages+" unchanged. New findings: "+diff.summary.newFindings+" · resolved findings: "+diff.summary.resolvedFindings+".";box.append(summary);const groups=[["Changed pages",diff.changed.map(x=>x.path+" — "+[...Object.keys(x.fields),...x.findings.added.map(v=>"New: "+v),...x.findings.resolved.map(v=>"Resolved: "+v)].join(", "))],["New pages",diff.added.map(x=>x.path)],["Removed pages",diff.removed],["Unchanged pages",diff.unchanged]];groups.forEach(([label,items])=>{const section=document.createElement("section");const h=document.createElement("h3");h.textContent=label+" ("+items.length+")";section.append(h);if(items.length){const ul=document.createElement("ul");items.forEach(item=>{const li=document.createElement("li");li.textContent=item;ul.append(li);});section.append(ul);}else{const p=document.createElement("p");p.textContent="None";section.append(p);}box.append(section);});el("compare-status").textContent="Comparison complete. This measures observed page and crawler changes only, not Google rankings or traffic.";}catch(err){el("compare-status").textContent="Comparison failed: "+err.message;}});
el("make-brief").addEventListener("click",()=>{const topic=el("topic").value.trim();if(!topic){el("topic").focus();return;}const audience=el("audience").value,intent=el("intent").value;const out=el("research-output");out.hidden=false;out.replaceChildren();const h=document.createElement("h3");h.textContent="Research brief: "+topic;out.append(h);const sections=[["Search intent",intent+" — answer the visitor's actual question before promoting an experience."],["Audience",audience],["Seed keyword",topic],["Related angles",["how to experience "+topic,"local Chagga traditions connected with "+topic,"what visitors should know before "+topic,"responsible ways to experience "+topic]],["Research tasks",["Validate query demand and country/device split in Google Search Console or a keyword provider.","Review current top-ranking pages and record what they answer well and what they omit.","Collect first-hand facts from local hosts; verify names, customs, access details and prices.","Map the article to one relevant experience page and useful supporting pages.","Check competing pages for freshness, sources, structure and unanswered visitor questions."]],["Editorial guardrails",["Do not invent cultural traditions, statistics, review quotes, prices or availability.","Use first-hand Materuni details and clearly distinguish verified facts from suggestions.","Avoid repeating generic travel copy; add original local insight and practical visitor guidance."]]];sections.forEach(([label,value])=>{const wrap=document.createElement("div");const strong=document.createElement("strong");strong.textContent=label;wrap.append(strong);if(Array.isArray(value)){const ul=document.createElement("ul");value.forEach(v=>{const li=document.createElement("li");li.textContent=v;ul.append(li);});wrap.append(ul);}else{const p=document.createElement("p");p.textContent=value;wrap.append(p);}out.append(wrap);});const copy=document.createElement("button");copy.className="button button-secondary";copy.type="button";copy.textContent="Copy research brief";copy.addEventListener("click",()=>{const txt=out.innerText;navigator.clipboard?.writeText(txt);copy.textContent="Copied (if clipboard permission granted)";});out.append(copy);});
el("blog-description").addEventListener("input",()=>el("description-count").textContent=el("blog-description").value.length+" / 160 characters");
function getDraft(){return {title:el("blog-title").value,keyword:el("blog-keyword").value,slug:el("blog-slug").value,description:el("blog-description").value,body:el("blog-body").value,updatedAt:new Date().toISOString()};}
let draftSaveTimer;let draftDirty=false;
function saveDraft(showMessage=true){try{localStorage.setItem("materuni-blog-draft",JSON.stringify(getDraft()));draftDirty=false;if(showMessage)el("blog-feedback").textContent="Draft saved in this browser on this device only.";return true;}catch(e){el("blog-feedback").textContent="Could not save draft: "+e.message;return false;}}
el("save-draft").addEventListener("click",()=>saveDraft(true));
["blog-title","blog-keyword","blog-slug","blog-description","blog-body"].forEach(id=>el(id).addEventListener("input",()=>{draftDirty=true;el("blog-feedback").textContent="Unsaved changes · saving automatically…";if(id==="blog-description")el("description-count").textContent=el("blog-description").value.length+" / 160 characters";clearTimeout(draftSaveTimer);draftSaveTimer=setTimeout(()=>saveDraft(false),650);}));
window.addEventListener("beforeunload",()=>{if(draftDirty)saveDraft(false);});
el("clear-draft").addEventListener("click",()=>{if(!confirm("Clear the saved draft and all text in this editor on this device?"))return;localStorage.removeItem("materuni-blog-draft");["blog-title","blog-keyword","blog-slug","blog-description","blog-body"].forEach(id=>el(id).value="");el("description-count").textContent="0 / 160 characters";draftDirty=false;el("blog-feedback").textContent="Local draft cleared from this device.";});
try{const saved=JSON.parse(localStorage.getItem("materuni-blog-draft")||"null");if(saved){el("blog-title").value=saved.title||"";el("blog-keyword").value=saved.keyword||"";el("blog-slug").value=saved.slug||"";el("blog-description").value=saved.description||"";el("blog-body").value=saved.body||"";el("description-count").textContent=el("blog-description").value.length+" / 160 characters";el("blog-feedback").textContent="A local draft was restored.";}}catch{}
el("export-draft").addEventListener("click",()=>{const d=getDraft();if(!d.title.trim()&&!d.body.trim()){el("blog-feedback").textContent="Add an article title or draft text before exporting.";return;}const md="# "+d.title+"\n\n**Primary keyword:** "+d.keyword+"\n\n**Slug:** "+d.slug+"\n\n**Meta description:** "+d.description+"\n\n"+d.body;const blob=new Blob([md],{type:"text/markdown;charset=utf-8"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download=((d.slug||"materuni-blog-draft").replace(/[^a-z0-9-]/gi,"-").replace(/-+/g,"-").replace(/^-|-$/g,"")||"materuni-blog-draft")+".md";a.click();URL.revokeObjectURL(url);});
</script>
</SiteLayout>
