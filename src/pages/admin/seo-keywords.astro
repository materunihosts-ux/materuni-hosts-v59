---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="SEO Keyword Studio | Materuni Hosts" description="Keyword research, CSV import and search opportunity tracking." noindex={true}>
<section class="page-hero"><span class="eyebrow">MATERUNI HOSTS · SEO STUDIO</span><h1>Keyword Research & Opportunities</h1><p>Manage target keywords, organise topics and track opportunities using your own research and Search Console exports.</p></section>
<section class="booking-wrap">
<div class="booking-panel" id="login-panel"><h2>Administrator sign in</h2><form id="login-form" class="form-grid"><div class="field full"><label>Email</label><input id="email" type="email" required autocomplete="username"></div><div class="field full"><label>Password</label><input id="password" type="password" required autocomplete="current-password"></div><div class="field full"><button class="button" id="login-btn">Sign in</button><p id="login-msg" class="muted" aria-live="polite"></p></div></form></div>
<div id="workspace" hidden>
<div class="admin-topbar"><div class="admin-topbar-links"><a class="button button-secondary" href="/admin/">← Dashboard</a><a class="button button-secondary" href="/admin/seo">Technical SEO</a></div><button class="button button-secondary" id="logout">Sign out</button></div>
<div class="stats"><article><span>Total keywords</span><strong id="total">0</strong></article><article><span>High priority</span><strong id="high">0</strong></article><article><span>Tracked</span><strong id="tracked">0</strong></article><article><span>Clusters</span><strong id="clusters">0</strong></article></div>
<div class="booking-panel panel"><div class="section-heading"><div><span class="eyebrow">IMPORT RESEARCH</span><h2>Import keyword CSV</h2><p class="muted">Supports keyword lists, keyword-metrics exports and Search Console-shaped query exports. Imported files are user-supplied and are not independently verified.</p></div></div><input id="csv" type="file" accept=".csv,text/csv"><button class="button" id="import-btn" type="button">Import CSV</button><p id="import-msg" class="muted" aria-live="polite"></p></div>
<div class="booking-panel panel"><span class="eyebrow">ADD TARGET</span><h2>Add keyword</h2><form id="add-form" class="form-grid"><div class="field full"><label>Keyword</label><input id="keyword" required maxlength="300" placeholder="e.g. Materuni waterfall tour"></div><div class="field"><label>Search volume</label><input id="volume" type="number" min="0"></div><div class="field"><label>Keyword difficulty</label><input id="difficulty" type="number" min="0" max="100" step="0.1"></div><div class="field"><label>Intent</label><select id="intent"><option value="informational">Informational</option><option value="commercial">Commercial</option><option value="transactional">Transactional</option><option value="navigational">Navigational</option></select></div><div class="field"><label>Priority</label><select id="priority"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select></div><div class="field full"><label>Target URL (optional)</label><input id="target-url" type="url" placeholder="https://materunihosts.com/..."></div><div class="field full"><button class="button" id="add-btn">Save keyword</button><p id="add-msg" class="muted" aria-live="polite"></p></div></form></div>
<div class="booking-panel panel"><div class="section-heading"><div><span class="eyebrow">KEYWORD LIBRARY</span><h2>Tracked keywords</h2></div><input id="search" type="search" placeholder="Search keywords…" aria-label="Search keywords"></div><div class="table-wrap"><table><thead><tr><th>Keyword</th><th>Cluster</th><th>Volume</th><th>Difficulty</th><th>Priority</th><th>Status</th><th>Source</th><th></th></tr></thead><tbody id="rows"><tr><td colspan="8">Sign in to load keywords.</td></tr></tbody></table></div><p id="list-msg" class="muted" aria-live="polite"></p></div>
</div></section>
<style>
.panel{margin-top:1.25rem;padding:clamp(16px,3vw,26px)}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:20px}.stats article{background:#FAF7F2;border:1px solid #E6DFD3;border-radius:12px;padding:16px}.stats span{display:block;color:#586258;font-size:12px}.stats strong{display:block;color:#1A3322;font-size:25px;margin-top:6px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:11px 9px;border-bottom:1px solid #E6DFD3;white-space:nowrap}th{color:#586258;font-size:11px;text-transform:uppercase}td button{border:1px solid #E6DFD3;background:#FAF7F2;border-radius:6px;padding:6px 9px;color:#1A3322}.section-heading input{max-width:240px}.muted{color:#687267}@media(max-width:650px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.section-heading{align-items:flex-start;flex-direction:column}}
</style>
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
import { classifyKeywordCsv, normalizeKeywordImportRow } from "../../lib/seo-keyword-import.js";
let token="";
const $=id=>document.getElementById(id);
const headers=()=>({apikey:publishableKey,Authorization:"Bearer "+token,"Content-Type":"application/json"});
async function api(path,options={}){const r=await fetch(supabaseUrl+path,{...options,headers:{...headers(),...(options.headers||{})}});const d=await r.json().catch(()=>null);if(!r.ok)throw new Error(d?.message||d?.details||d?.hint||"Request failed");return d}
function clusterFor(k){const s=k.toLowerCase();if(/waterfall|falls|hike/.test(s))return "Materuni Waterfall";if(/coffee|roast|brew/.test(s))return "Chagga Coffee";if(/chagga|culture|village|heritage|tradition/.test(s))return "Chagga Culture";if(/moshi|town|market/.test(s))return "Moshi Experiences";if(/cooking|food|banana|mbege/.test(s))return "Chagga Food";if(/kilimanjaro|mountain/.test(s))return "Kilimanjaro";return "Unassigned"}
function csvParse(text){const out=[];let row=[],v="",q=false;for(let i=0;i<text.length;i++){const c=text[i];if(c==='"'&&q&&text[i+1]==='"'){v+='"';i++}else if(c==='"')q=!q;else if(c===","&&!q){row.push(v);v=""}else if((c==="\n"||c==="\r")&&!q){if(c==="\r"&&text[i+1]==="\n")i++;row.push(v);if(row.some(x=>x.trim()))out.push(row);row=[];v=""}else v+=c}row.push(v);if(row.some(x=>x.trim()))out.push(row);return out}
function norm(x){return String(x||"").trim().toLowerCase().replace(/[^a-z0-9]+/g,"_").replace(/^_|_$/g,"")}
let records=[];
function render(){const term=$("search").value.toLowerCase();const filtered=records.filter(x=>(x.keyword||"").toLowerCase().includes(term));$("total").textContent=records.length;$("high").textContent=records.filter(x=>x.priority==="high").length;$("tracked").textContent=records.filter(x=>x.status==="tracking"||x.status==="optimising").length;$("clusters").textContent=new Set(records.map(x=>x.cluster).filter(Boolean)).size;const body=$("rows");body.replaceChildren();if(!filtered.length){const tr=document.createElement("tr"),td=document.createElement("td");td.colSpan=8;td.textContent="No keywords found.";tr.append(td);body.append(tr);return}filtered.forEach(x=>{const tr=document.createElement("tr");[x.keyword,x.cluster||"—",x.search_volume??"—",x.difficulty??"—",x.priority||"medium",x.status||"research",x.source==="manual"?"Manual":x.source==="csv_import"?"CSV import":x.source||"Unknown"].forEach(v=>{const td=document.createElement("td");td.textContent=v;tr.append(td)});const td=document.createElement("td"),btn=document.createElement("button");btn.textContent="Delete";btn.addEventListener("click",()=>removeKeyword(x.id));td.append(btn);tr.append(td);body.append(tr)})}
async function load(){records=await api("/rest/v1/seo_keywords?select=*&order=updated_at.desc");render()}
async function removeKeyword(id){if(!confirm("Delete this keyword?"))return;try{await api("/rest/v1/seo_keywords?id=eq."+encodeURIComponent(id),{method:"DELETE"});await load()}catch(e){$("list-msg").textContent=e.message}}
$("login-form").addEventListener("submit",async e=>{e.preventDefault();$("login-btn").disabled=true;$("login-msg").textContent="Checking access…";try{const r=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:{apikey:publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email:$("email").value.trim(),password:$("password").value})});const s=await r.json();if(!r.ok)throw new Error(s.msg||s.message||"Sign in failed");token=s.access_token;const a=await api("/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(s.user.id));if(!a.length)throw new Error("Account is not authorised as administrator");$("login-panel").hidden=true;$("workspace").hidden=false;await load()}catch(e){token="";$("login-msg").textContent=e.message}finally{$("login-btn").disabled=false}});
$("logout").addEventListener("click",()=>{token="";$("workspace").hidden=true;$("login-panel").hidden=false;$("login-form").reset()});
$("search").addEventListener("input",render);
$("add-form").addEventListener("submit",async e=>{e.preventDefault();$("add-btn").disabled=true;try{const keyword=$("keyword").value.trim();await api("/rest/v1/seo_keywords",{method:"POST",headers:{"Prefer":"return=minimal"},body:JSON.stringify({keyword,cluster:clusterFor(keyword),search_volume:$("volume").value?Number($("volume").value):null,difficulty:$("difficulty").value?Number($("difficulty").value):null,intent:$("intent").value,priority:$("priority").value,status:"research",source:"manual"})});$("add-form").reset();$("add-msg").textContent="Keyword saved.";await load()}catch(e){$("add-msg").textContent=e.message}finally{$("add-btn").disabled=false}});
$("import-btn").addEventListener("click",async()=>{const file=$("csv").files[0];if(!file){$("import-msg").textContent="Choose a CSV file first.";return}if(file.size>5_000_000){$("import-msg").textContent="CSV file is too large (maximum 5 MB).";return}$("import-btn").disabled=true;$("import-msg").textContent="Reading and validating CSV…";try{const grid=csvParse(await file.text());if(grid.length<2)throw new Error("CSV needs a header row and at least one data row.");const classified=classifyKeywordCsv(grid[0]);const known=new Set(records.map(x=>(x.keyword||"").trim().toLowerCase()));const batch=[];let skipped=0,rejected=0;for(const row of grid.slice(1)){const normalized=normalizeKeywordImportRow(row,classified.columns,location.origin);if(normalized.skip){skipped++;continue}if(normalized.error){rejected++;continue}const item=normalized.value;const key=item.keyword.toLowerCase();if(known.has(key)){skipped++;continue}known.add(key);item.cluster=clusterFor(item.keyword);item.notes=classified.provenanceLabel;batch.push(item)}let count=0;for(let i=0;i<batch.length;i+=100){const part=batch.slice(i,i+100);await api("/rest/v1/seo_keywords",{method:"POST",headers:{"Prefer":"return=minimal"},body:JSON.stringify(part)});count+=part.length}$("import-msg").textContent=classified.provenanceLabel+". Imported "+count+"; skipped "+skipped+" (blank/duplicate); rejected "+rejected+" invalid row(s). Imported source is user-supplied and has not been independently verified.";await load()}catch(e){$("import-msg").textContent="Import failed: "+e.message}finally{$("import-btn").disabled=false}});
</script>
</SiteLayout>