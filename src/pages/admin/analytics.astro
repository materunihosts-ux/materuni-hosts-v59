---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Analytics | Materuni Hosts" description="Private Materuni Hosts booking and guest analytics." noindex={true}>
<section class="page-hero analytics-hero"><span class="eyebrow">BUSINESS OS · PERFORMANCE INTELLIGENCE</span><h1>Know what is working.</h1><p>Understand booking demand, guest volume, experience interest and tagged enquiry sources. Figures come from the connected booking records, not simulated analytics.</p><div class="analytics-workspace-links"><a class="button" href="/admin/business-os">← Business OS</a><a class="button button-outline" href="/admin">Public Website Dashboard ↗</a></div></section>
<section class="booking-wrap">
  <div class="booking-panel" id="login-panel">
    <h2>Administrator sign in</h2>
    <form id="login-form" class="form-grid">
      <div class="field full"><label for="admin-email">Admin email</label><input id="admin-email" type="email" autocomplete="username" required></div>
      <div class="field full"><label for="admin-password">Password</label><input id="admin-password" type="password" autocomplete="current-password" required></div>
      <div class="field full"><button class="button" id="login-button" type="submit">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div>
    </form>
  </div>
  <div id="manager" hidden>
    <div class="booking-panel analytics-controls">
      <div class="section-heading"><div><span class="eyebrow">REPORTING CONTROLS</span><h2>Booking analytics</h2><p class="muted">The value shown is an estimate for confirmed bookings, not money collected.</p></div><div class="admin-shortcuts"><a class="button button-secondary" href="/admin/bookings">Bookings</a><a class="button button-secondary" href="/admin/conversations">Guest inbox</a><a class="button button-secondary" href="/admin/marketing">Growth studio</a><button class="button button-secondary" id="logout" type="button">Sign out</button></div></div>
      <form id="filter-form" class="form-grid">
        <div class="field"><label for="from-date">From</label><input id="from-date" type="date" required></div>
        <div class="field"><label for="to-date">To</label><input id="to-date" type="date" required></div>
        <div class="field full"><button class="button" type="submit" id="load-button">Update analytics</button><p id="feedback" class="muted" aria-live="polite"></p></div>
      </form>
    </div>
    <div class="analytics-grid" id="analytics-stats">
      <div class="admin-stat"><span>Total bookings</span><strong id="total-bookings">—</strong></div>
      <div class="admin-stat"><span>Confirmed</span><strong id="confirmed-bookings">—</strong></div>
      <div class="admin-stat"><span>New requests</span><strong id="new-bookings">—</strong></div>
      <div class="admin-stat"><span>Contacted</span><strong id="contacted-bookings">—</strong></div>
      <div class="admin-stat"><span>Cancelled</span><strong id="cancelled-bookings">—</strong></div>
      <div class="admin-stat"><span>Total guests</span><strong id="total-guests">—</strong></div>
      <div class="admin-stat"><span>Repeat customers</span><strong id="returning-guests">—</strong></div>
      <div class="admin-stat analytics-value"><span>Estimated confirmed value</span><strong id="confirmed-value">—</strong><small>USD · not cash received</small></div>
    </div>
    <div class="booking-panel" style="margin-top:1.5rem"><span class="eyebrow">DEMAND</span><h2>Most requested experiences</h2><div id="popular-experiences" class="popular-experiences"><p class="muted">Choose a date range to view demand.</p></div></div>
    <div class="booking-panel" style="margin-top:1.5rem"><span class="eyebrow">ACQUISITION</span><h2>Where enquiries come from</h2><p class="muted">Shows source tags recorded with booking enquiries. Only tagged sources can be attributed; older or untagged requests appear as Other / untracked.</p><div id="enquiry-sources" class="popular-experiences"><p class="muted">Choose a date range to view enquiry sources.</p></div></div>
  </div>
</section>

<style>
.analytics-hero{padding:clamp(26px,5vw,48px);border-radius:20px;background:linear-gradient(120deg,#1a3322,#314b36 72%,#52684b);color:#faf7f2}.analytics-hero .eyebrow{color:#dfc17e}.analytics-hero h1{font:500 clamp(34px,5vw,48px)/1.08 Georgia,serif;color:#faf7f2}.analytics-hero p{max-width:740px;color:#e5e8df;line-height:1.7}.analytics-workspace-links{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}.analytics-hero .button{display:inline-flex;background:#c5a059;color:#1a3322;border:1px solid #c5a059}.analytics-hero .button-outline{background:transparent;color:#faf7f2;border-color:#faf7f277}.analytics-controls{margin-top:18px}.analytics-controls .section-heading{align-items:flex-start;gap:18px}.analytics-controls .admin-shortcuts{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.analytics-grid{gap:12px}.analytics-grid .admin-stat{min-height:112px;border-radius:13px;border:1px solid #e6dfd3;box-shadow:0 5px 18px #24242108}.analytics-grid .admin-stat strong{font:600 26px Georgia,serif;color:#1a3322}.analytics-grid .analytics-value{background:#1a3322;color:#faf7f2}.analytics-grid .analytics-value span,.analytics-grid .analytics-value small{color:#e0e3d9}.analytics-grid .analytics-value strong{color:#f0d18a}.popular-row{padding:14px 0;border-bottom:1px solid #eee9e0}.popular-label{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:8px}.popular-label strong{color:#1a3322}.popular-label span{font-size:12px;color:#77766f}.popular-track{height:8px;border-radius:10px;background:#f0ece4;overflow:hidden}.popular-track span{display:block;height:100%;border-radius:10px;background:#c5a059}@media(max-width:700px){.analytics-hero{padding:26px 20px}.analytics-controls .section-heading{display:block}.analytics-controls .admin-shortcuts{justify-content:flex-start;margin-top:14px}.analytics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
let accessToken="";
const el=id=>document.getElementById(id);
const headers=()=>({apikey:publishableKey,Authorization:"Bearer "+accessToken,"Content-Type":"application/json"});
const dateString=d=>{const parts=new Intl.DateTimeFormat("en-GB",{timeZone:"Africa/Dar_es_Salaam",year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(d);const values=Object.fromEntries(parts.map(part=>[part.type,part.value]));return values.year+"-"+values.month+"-"+values.day;};
const now=new Date();
el("from-date").value=dateString(new Date(now.getFullYear(),now.getMonth(),1));
el("to-date").value=dateString(now);
async function api(path,options={}){const r=await fetch(supabaseUrl+path,{...options,headers:{...headers(),...(options.headers||{})}});const data=await r.json().catch(()=>null);if(!r.ok)throw new Error(data?.message||data?.details||"Request failed.");return data}
async function loadAnalytics(){
 const button=el("load-button");button.disabled=true;el("feedback").textContent="Loading analytics…";
 try{
  const from=el("from-date").value,to=el("to-date").value;if(!from||!to||to<from)throw new Error("Choose a valid date range.");
  const data=await api("/rest/v1/rpc/admin_get_analytics",{method:"POST",body:JSON.stringify({p_start_date:from,p_end_date:to})});
  [["total-bookings","total_bookings"],["confirmed-bookings","confirmed"],["new-bookings","new"],["contacted-bookings","contacted"],["cancelled-bookings","cancelled"],["total-guests","total_guests"],["returning-guests","returning_guests"]].forEach(([id,key])=>el(id).textContent=Number(data[key]||0).toLocaleString());
  el("confirmed-value").textContent="$"+Number(data.estimated_confirmed_value_usd||0).toLocaleString(undefined,{maximumFractionDigits:0});
  const list=el("popular-experiences");list.replaceChildren();
  const items=Array.isArray(data.popular_experiences)?data.popular_experiences:[];
  if(!items.length){list.append(Object.assign(document.createElement("p"),{className:"muted",textContent:"No booking activity in this period yet."}))}
  const max=Math.max(1,...items.map(x=>Number(x.bookings||0)));
  items.forEach(item=>{
   const row=document.createElement("div");row.className="popular-row";
   const label=document.createElement("div");label.className="popular-label";
   const name=document.createElement("strong");name.textContent=item.experience||"Experience";
   const count=document.createElement("span");count.textContent=Number(item.bookings||0)+" bookings · "+Number(item.guests||0)+" guests";
   label.append(name,count);
   const track=document.createElement("div");track.className="popular-track";
   const bar=document.createElement("span");bar.style.width=(Number(item.bookings||0)/max*100)+"%";track.append(bar);
   row.append(label,track);list.append(row);
  });
  // Read only the booking notes needed to measure which sales landing page generated the enquiry.
  try{
   const since=new Date(from+"T00:00:00+03:00").toISOString();
   const end=new Date(to+"T00:00:00+03:00");end.setDate(end.getDate()+1);
   const until=end.toISOString();
   const query=new URLSearchParams({select:"notes",and:"(created_at.gte."+since+",created_at.lt."+until+")",order:"created_at.asc",limit:"1000"});
   const sourceRows=[];
   for(let offset=0;offset<10000;offset+=1000){
    const page=await api("/rest/v1/bookings?"+query.toString(),{headers:{Range:offset+"-"+(offset+999),"Range-Unit":"items"}});
    if(!Array.isArray(page))throw new Error("Booking source data was not returned as a list.");
    sourceRows.push(...page);
    if(page.length<1000)break;
   }
   const counts={"Homepage leading package":0,"Camping page":0,"Day Trips page":0,"Other / untracked":0};
   sourceRows.forEach(row=>{
    const note=String(row.notes||"");
    if(note.includes("[Enquiry source: Homepage leading package"))counts["Homepage leading package"]++;
    else if(note.includes("[Enquiry source: Camping landing page"))counts["Camping page"]++;
    else if(note.includes("[Enquiry source: Day Trips landing page"))counts["Day Trips page"]++;
    else counts["Other / untracked"]++;
   });
   const sourceList=el("enquiry-sources");sourceList.replaceChildren();
   const maxSource=Math.max(1,...Object.values(counts));
   Object.entries(counts).forEach(([name,count])=>{
    const row=document.createElement("div");row.className="popular-row";
    const label=document.createElement("div");label.className="popular-label";
    const title=document.createElement("strong");title.textContent=name;
    const amount=document.createElement("span");amount.textContent=count+" enquiries";
    label.append(title,amount);
    const track=document.createElement("div");track.className="popular-track";
    const bar=document.createElement("span");bar.style.width=(count/maxSource*100)+"%";track.append(bar);
    row.append(label,track);sourceList.append(row);
   });
  }catch(sourceError){
   el("enquiry-sources").textContent="Source breakdown is temporarily unavailable; the main booking analytics are still current.";
   console.warn("Enquiry source analytics unavailable:",sourceError);
  }
  el("feedback").textContent="Analytics updated for "+from+" to "+to+".";
 }catch(error){el("feedback").textContent=error.message}
 finally{button.disabled=false}
}
el("login-form").addEventListener("submit",async event=>{
 event.preventDefault();const button=el("login-button");button.disabled=true;el("login-feedback").textContent="Verifying administrator…";
 try{
  const r=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:{apikey:publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email:el("admin-email").value.trim(),password:el("admin-password").value})});
  const session=await r.json();if(!r.ok)throw new Error(session.msg||session.message||"Sign in failed.");
  accessToken=session.access_token;const admins=await api("/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(session.user.id));
  if(!admins.length){accessToken="";throw new Error("This account is not authorised as an administrator.")}
  el("login-panel").hidden=true;el("manager").hidden=false;await loadAnalytics();
 }catch(error){el("login-feedback").textContent=error.message}finally{button.disabled=false}
});
el("filter-form").addEventListener("submit",event=>{event.preventDefault();loadAnalytics()});
el("logout").addEventListener("click",async()=>{try{await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:headers()})}catch{}accessToken="";el("manager").hidden=true;el("login-panel").hidden=false;el("login-form").reset()});
</script>
</SiteLayout>
