---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Guest Conversations | Materuni Hosts" description="Private guest concierge conversation inbox." noindex={true}>
<section class="page-hero"><span class="eyebrow">PRIVATE ADMIN</span><h1>Guest conversations</h1><p>Review visitor questions from the website concierge and follow up when a human host is needed.</p></section>
<style>.conversation-status{display:inline-flex;margin-top:.4rem;padding:.2rem .55rem;border-radius:99px;background:#eee9df;text-transform:capitalize;font-size:.75rem}.conversation-status.status-needs_human{background:#f5ecd7;color:#76551d}.conversation-status.status-resolved{background:#e1eee3;color:#214b2b}.conversation-status-actions{display:flex;gap:.5rem;flex-wrap:wrap;margin:1rem 0}.conversation-item{display:flex;flex-direction:column;align-items:flex-start;gap:.25rem;width:100%;text-align:left}</style>
<section class="booking-wrap">
  <div class="booking-panel" id="login-panel">
    <h2>Administrator sign in</h2>
    <form id="login-form" class="form-grid">
      <div class="field full"><label for="admin-email">Admin email</label><input id="admin-email" type="email" autocomplete="username" required></div>
      <div class="field full"><label for="admin-password">Password</label><input id="admin-password" type="password" autocomplete="current-password" required></div>
      <div class="field full"><button class="button" id="login-button" type="submit">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div>
    </form>
  </div>
  <div id="manager" hidden>
    <div class="section-heading"><div><span class="eyebrow">GUEST CRM</span><h2>Concierge inbox</h2><p class="muted">Website guest questions and assistant replies.</p></div><div class="admin-shortcuts"><a class="button button-secondary" href="/admin/analytics">Analytics</a><a class="button button-secondary" href="/admin/bookings">Bookings</a><a class="button button-secondary" href="/admin/tours">Tours & availability</a><button class="button button-secondary" id="logout" type="button">Sign out</button></div></div>
    <div class="conversation-layout">
      <div class="booking-panel"><div id="conversation-list" class="conversation-list"><p class="muted">Loading conversations…</p></div></div>
      <div class="booking-panel"><div id="conversation-detail"><p class="muted">Choose a conversation to read the messages.</p></div></div>
    </div>
  </div>
</section>
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
let accessToken="";
const el=id=>document.getElementById(id);
const headers=()=>({apikey:publishableKey,Authorization:"Bearer "+accessToken,"Content-Type":"application/json"});
async function api(path,options={}){const r=await fetch(supabaseUrl+path,{...options,headers:{...headers(),...(options.headers||{})}});const data=await r.json().catch(()=>null);if(!r.ok)throw new Error(data?.message||data?.details||"Request failed.");return data}
function node(tag,className,value){const n=document.createElement(tag);if(className)n.className=className;n.textContent=value==null?"":String(value);return n}
async function loadConversations(){
 const list=el("conversation-list");list.replaceChildren(node("p","muted","Loading conversations…"));
 try{
  const rows=await api("/rest/v1/rpc/admin_get_ai_conversations",{method:"POST",body:"{}"});
  list.replaceChildren();
  if(!rows.length){list.append(node("p","muted","No guest conversations yet."));return}
  rows.forEach(item=>{
   const button=document.createElement("button");button.type="button";button.className="conversation-item";
   button.append(node("strong","",item.guest_name||"Website visitor"),node("span","",String(item.language_code||"en").toUpperCase()+" · "+new Date(item.updated_at).toLocaleString()),node("small","conversation-status status-"+(item.conversation_status||"open"),(item.conversation_status||"open").replaceAll("_"," ")));
   if(item.guest_email)button.append(node("small","",item.guest_email));
   button.addEventListener("click",()=>loadMessages(item,button));list.append(button);
  });
 }catch(error){list.replaceChildren(node("p","muted",error.message))}
}
async function updateConversationStatus(id,status,feedback,button){
 button.disabled=true;feedback.textContent="Updating conversation…";
 try{
  await api("/rest/v1/rpc/admin_update_ai_conversation_status",{method:"POST",body:JSON.stringify({p_conversation_id:id,p_status:status})});
  const detail=el("conversation-detail");
  const statusLine=detail.querySelector(".conversation-current-status");
  if(statusLine)statusLine.textContent="Status: "+status.replaceAll("_"," ");
  detail.querySelectorAll("[data-conversation-status]").forEach(control=>{
   control.disabled=control.dataset.conversationStatus===status;
  });
  feedback.textContent="Conversation marked "+status.replaceAll("_"," ")+".";
  await loadConversations();
 }catch(error){feedback.textContent=error.message;button.disabled=false}
}
async function loadMessages(item,selected){
 document.querySelectorAll(".conversation-item").forEach(x=>x.classList.remove("active"));selected.classList.add("active");
 const detail=el("conversation-detail");detail.replaceChildren(node("p","muted","Loading messages…"));
 try{
  const rows=await api("/rest/v1/rpc/admin_get_ai_messages",{method:"POST",body:JSON.stringify({p_conversation_id:item.conversation_id})});
  detail.replaceChildren(node("h3","",item.guest_name||"Website visitor"));
  const statusLine=node("p","muted","Language: "+String(item.language_code||"en").toUpperCase()+" · Status: "+(item.conversation_status||"open").replaceAll("_"," "));
  statusLine.classList.add("conversation-current-status");
  detail.append(statusLine);
  if(item.guest_email){const email=document.createElement("a");email.href="mailto:"+encodeURIComponent(item.guest_email)+"?subject="+encodeURIComponent("Your Materuni Hosts enquiry");email.textContent="Email guest · "+item.guest_email;detail.append(email)}
  else detail.append(node("p","muted","No email address was shared in this conversation."));
  const actions=document.createElement("div");actions.className="conversation-status-actions";const feedback=node("p","muted","");feedback.setAttribute("aria-live","polite");
  [["open","Reopen"],["needs_human","Needs human follow-up"],["resolved","Mark resolved"]].forEach(([value,label])=>{const button=document.createElement("button");button.type="button";button.className="button button-secondary";button.textContent=label;button.dataset.conversationStatus=value;button.disabled=item.conversation_status===value;button.addEventListener("click",()=>updateConversationStatus(item.conversation_id,value,feedback,button));actions.append(button)});
  detail.append(actions,feedback);
  const transcript=document.createElement("div");transcript.className="conversation-transcript";
  rows.forEach(message=>{const article=document.createElement("article");article.className="conversation-message "+(message.sender_type==="assistant"?"assistant":"guest");article.append(node("small","",message.sender_type==="assistant"?"Concierge":"Guest"),node("p","",message.message),node("time","",new Date(message.created_at).toLocaleString()));transcript.append(article)});
  detail.append(transcript,node("p","muted conversation-note","For a direct personal follow-up, use the guest email above. This inbox does not send replies; status controls help your team track follow-up."));
 }catch(error){detail.replaceChildren(node("p","muted",error.message))}
}
el("login-form").addEventListener("submit",async event=>{
 event.preventDefault();const button=el("login-button");button.disabled=true;el("login-feedback").textContent="Verifying administrator…";
 try{
  const r=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:{apikey:publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email:el("admin-email").value.trim(),password:el("admin-password").value})});
  const session=await r.json();if(!r.ok)throw new Error(session.msg||session.message||"Sign in failed.");
  accessToken=session.access_token;
  const admins=await api("/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(session.user.id));
  if(!admins.length){accessToken="";throw new Error("This account is not authorised as an administrator.")}
  el("login-panel").hidden=true;el("manager").hidden=false;await loadConversations();
 }catch(error){el("login-feedback").textContent=error.message}finally{button.disabled=false}
});
el("logout").addEventListener("click",async()=>{try{await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:headers()})}catch{}accessToken="";el("manager").hidden=true;el("login-panel").hidden=false;el("login-form").reset()});
</script>
</SiteLayout>
