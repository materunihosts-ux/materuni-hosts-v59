let seoRoutes = JSON.parse(JSON.stringify(defaultRoutes));
let activePath = "/";

function updateHealthStats() {
  const titlesGood = seoRoutes.filter(r => r.title.length >= 30 && r.title.length <= 65).length;
  const descGood = seoRoutes.filter(r => r.description.length >= 120 && r.description.length <= 165).length;
  const score = Math.round(((titlesGood + descGood) / (seoRoutes.length * 2)) * 100);

  el("stat-routes").textContent = seoRoutes.length;
  el("stat-titles").textContent = `${titlesGood} / ${seoRoutes.length}`;
  el("stat-descriptions").textContent = `${descGood} / ${seoRoutes.length}`;
  el("stat-score").textContent = `${score}%`;
}

function renderRouteSidebar() {
  const container = el("route-list");
  container.replaceChildren();

  seoRoutes.forEach(r => {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "route-btn" + (r.path === activePath ? " active" : "");
    btn.innerHTML = `<strong>${r.name}</strong><small>${r.path}</small>`;
    btn.addEventListener("click", () => {
      activePath = r.path;
      renderRouteSidebar();
      populateActiveRouteForm();
    });
    container.append(btn);
  });
}

function populateActiveRouteForm() {
  const current = seoRoutes.find(r => r.path === activePath) || seoRoutes[0];
  el("active-route-badge").textContent = `ROUTE: ${current.path}`;
  el("active-route-name").textContent = current.name;
  el("active-route-desc").textContent = current.desc;
  el("preview-live-link").href = current.path;

  el("meta-title").value = current.title;
  el("meta-description").value = current.description;
  el("meta-og-image").value = current.image;
  el("meta-canonical").value = current.canonical;
  el("meta-robots").value = current.robots || "index,follow";
  el("meta-keywords").value = current.keywords || "";
  el("meta-schema").value = current.schema || "TourOperator";

  updateCountersAndPreviews();
}

function updateCountersAndPreviews() {
  const title = el("meta-title").value.trim();
  const desc = el("meta-description").value.trim();
  const img = el("meta-og-image").value.trim();
  const can = el("meta-canonical").value.trim();

  // Title counter
  const titleCount = title.length;
  const tCounter = el("title-counter");
  tCounter.textContent = `${titleCount} / 60 chars`;
  tCounter.className = "char-counter " + (titleCount >= 30 && titleCount <= 60 ? "good" : (titleCount < 30 ? "warn" : "bad"));

  // Description counter
  const descCount = desc.length;
  const dCounter = el("desc-counter");
  dCounter.textContent = `${descCount} / 160 chars`;
  dCounter.className = "char-counter " + (descCount >= 120 && descCount <= 160 ? "good" : (descCount < 120 ? "warn" : "bad"));

  // SERP preview
  el("preview-url").textContent = can || "https://materunihosts.com" + activePath;
  el("preview-title").textContent = title || "Materuni Hosts";
  el("preview-desc").textContent = desc || "Authentic Chagga cultural experiences.";

  // Social preview
  el("preview-og-title").textContent = title || "Materuni Hosts";
  el("preview-og-desc").textContent = desc || "Authentic Chagga cultural experiences.";
  if (img) el("preview-og-img").src = img;
}

// Live typing listeners
["meta-title", "meta-description", "meta-og-image", "meta-canonical"].forEach(id => {
  el(id)?.addEventListener("input", () => {
    updateCountersAndPreviews();
    const current = seoRoutes.find(r => r.path === activePath);
    if (current) {
      current.title = el("meta-title").value.trim();
      current.description = el("meta-description").value.trim();
      current.image = el("meta-og-image").value.trim();
      current.canonical = el("meta-canonical").value.trim();
      current.robots = el("meta-robots").value;
      current.keywords = el("meta-keywords").value.trim();
      current.schema = el("meta-schema").value;
      updateHealthStats();
    }
  });
});

el("meta-robots")?.addEventListener("change", () => {
  const current = seoRoutes.find(r => r.path === activePath);
  if (current) current.robots = el("meta-robots").value;
});

el("meta-schema")?.addEventListener("change", () => {
  const current = seoRoutes.find(r => r.path === activePath);
  if (current) current.schema = el("meta-schema").value;
});

// Image upload handling
el("og-upload-btn")?.addEventListener("click", () => el("og-file-input").click());
el("og-file-input")?.addEventListener("change", async (e) => {
  const file = e.target.files?.[0];
  if (!file) return;
  const feedback = el("og-upload-feedback");
  feedback.textContent = "Uploading image…";
  try {
    const filename = `seo_images/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.-]/g, "_")}`;
    const uploadRes = await fetch(`${supabaseUrl}/storage/v1/object/materuni-images/${filename}`, {
      method: "POST",
      headers: {
        "apikey": publishableKey,
        "Authorization": "Bearer " + accessToken,
        "Content-Type": file.type || "image/jpeg",
        "x-upsert": "false"
      },
      body: file
    });
    if (!uploadRes.ok) throw new Error("Upload failed.");
    const url = `${supabaseUrl}/storage/v1/object/public/materuni-images/${filename}`;
    el("meta-og-image").value = url;
    feedback.textContent = "✓ Image uploaded and applied!";
    updateCountersAndPreviews();
  } catch (err) {
    feedback.textContent = "Upload error: " + err.message;
  }
});

// Load saved SEO from Supabase
async function loadSeoSettings() {
  try {
    const rows = await api("/rest/v1/site_settings?select=setting_key,setting_value&setting_key=eq.seo_metadata");
    if (rows?.[0]?.setting_value) {
      const data = typeof rows[0].setting_value === "string" ? JSON.parse(rows[0].setting_value) : rows[0].setting_value;
      if (Array.isArray(data)) {
        data.forEach(savedItem => {
          const match = seoRoutes.find(r => r.path === savedItem.path);
          if (match) {
            Object.assign(match, savedItem);
          } else {
            seoRoutes.push(savedItem);
          }
        });
      }
    }
  } catch (e) {
    console.warn("Could not load saved SEO settings. Using built-in defaults.", e);
  }
  updateHealthStats();
  renderRouteSidebar();
  populateActiveRouteForm();
}

// Form submit
el("seo-form")?.addEventListener("submit", async (e) => {
  e.preventDefault();
  const btn = el("save-seo-btn");
  btn.disabled = true;
  el("save-feedback").textContent = "Saving and publishing SEO metadata…";

  try {
    const current = seoRoutes.find(r => r.path === activePath);
    if (current) {
      current.title = el("meta-title").value.trim();
      current.description = el("meta-description").value.trim();
      current.image = el("meta-og-image").value.trim();
      current.canonical = el("meta-canonical").value.trim();
      current.robots = el("meta-robots").value;
      current.keywords = el("meta-keywords").value.trim();
      current.schema = el("meta-schema").value;
    }

    await api("/rest/v1/site_settings?on_conflict=setting_key", {
      method: "POST",
      headers: { "Prefer": "resolution=merge-duplicates,return=minimal" },
      body: JSON.stringify({
        setting_key: "seo_metadata",
        setting_value: JSON.stringify(seoRoutes),
        updated_at: new Date().toISOString()
      })
    });

    el("save-feedback").textContent = "✓ SEO metadata successfully saved and published!";
    updateHealthStats();
    setTimeout(() => { if (el("save-feedback").textContent.startsWith("✓")) el("save-feedback").textContent = ""; }, 4000);
  } catch (err) {
    el("save-feedback").textContent = "Error saving SEO: " + err.message;
  } finally {
    btn.disabled = false;
  }
});

// Sign in
el("login-form")?.addEventListener("submit", async (e) => {
  e.preventDefault();
  const b = el("login-button");
  b.disabled = true;
  el("login-feedback").textContent = "Authenticating…";
  try {
    const r = await fetch(supabaseUrl + "/auth/v1/token?grant_type=password", {
      method: "POST",
      headers: { apikey: publishableKey, "Content-Type": "application/json" },
      body: JSON.stringify({ email: el("admin-email").value.trim(), password: el("admin-password").value })
    });
    const session = await r.json();
    if (!r.ok || !session?.access_token) throw new Error(session?.msg || session?.message || "Sign in failed.");
    accessToken = session.access_token;

    const admins = await api("/rest/v1/admin_users?select=user_id&user_id=eq." + encodeURIComponent(session.user.id));
    if (!admins.length) throw new Error("Account is not authorized as an administrator.");

    el("login-panel").hidden = true;
    el("manager").hidden = false;
    await loadSeoSettings();
  } catch (err) {
    el("login-feedback").textContent = err.message;
  } finally {
    b.disabled = false;
  }
});

el("logout")?.addEventListener("click", async () => {
  try { await fetch(supabaseUrl + "/auth/v1/logout", { method: "POST", headers: headers() }); } catch {}
  accessToken = "";
  el("manager").hidden = true;
  el("login-panel").hidden = false;
  el("login-form").reset();
});

el("run-audit-btn")?.addEventListener("click", () => {
  updateHealthStats();
  el("save-feedback").textContent = "Audit refreshed. All 14 routes evaluated.";
});
</script>
</SiteLayout>
