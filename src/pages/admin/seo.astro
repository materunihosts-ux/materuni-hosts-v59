---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="SEO & Metadata Manager | Materuni Hosts Admin" description="Private Materuni Hosts SEO and Open Graph metadata control center." noindex={true}>
<section class="page-hero">
  <span class="eyebrow">PRIVATE ADMIN · SEARCH & SOCIAL META</span>
  <h1>SEO & Metadata Management Center</h1>
  <p>Control search engine titles, meta descriptions, OpenGraph social share previews, canonical URLs, and indexability across all public Materuni Hosts routes.</p>
</section>

<section class="booking-wrap">
  <!-- Login Panel -->
  <div class="booking-panel" id="login-panel">
    <h2>Administrator sign in</h2>
    <p class="muted">Access is limited to approved Materuni Hosts administrators.</p>
    <form id="login-form" class="form-grid">
      <div class="field full"><label for="admin-email">Admin email</label><input id="admin-email" type="email" autocomplete="username" required></div>
      <div class="field full"><label for="admin-password">Password</label><input id="admin-password" type="password" autocomplete="current-password" required></div>
      <div class="field full"><button class="button" id="login-button" type="submit">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div>
    </form>
  </div>

  <!-- Manager Workspace -->
  <div id="manager" hidden>
    <!-- Topbar Shortcuts -->
    <div class="admin-topbar">
      <div class="admin-topbar-links">
        <a class="button button-secondary" href="/admin/">← Dashboard</a>
        <a class="button button-secondary" href="/admin/content">Content Manager</a>
        <a class="button button-secondary" href="/admin/tours">Tour Catalog</a>
        <a class="button button-secondary" href="/admin/settings">Settings</a>
        <a class="button button-secondary" href="/sitemap.xml" target="_blank" rel="noopener">View sitemap.xml ↗</a>
        <a class="button button-secondary" href="/robots.txt" target="_blank" rel="noopener">View robots.txt ↗</a>
      </div>
      <button class="button button-secondary" id="logout" type="button">Sign out</button>
    </div>

    <!-- SEO Health Summary -->
    <div class="booking-panel" style="margin-top:1.5rem">
      <div class="section-heading">
        <div>
          <span class="eyebrow" style="color:#C5A059">SEARCH ENGINE VISIBILITY</span>
          <h2>Technical SEO & Health Audit</h2>
          <p class="muted">Live status of crawlability, structured data schemas, and OpenGraph tags across public routes.</p>
        </div>
        <button class="button button-secondary" id="run-audit-btn" type="button">↻ Re-check All Pages</button>
      </div>

      <div class="admin-stats" style="margin-top:1rem">
        <div class="admin-stat"><span>Tracked routes</span><strong id="stat-routes">14</strong></div>
        <div class="admin-stat"><span>Optimal titles</span><strong id="stat-titles" style="color:#2a7e43">—</strong></div>
        <div class="admin-stat"><span>Optimal descriptions</span><strong id="stat-descriptions" style="color:#2a7e43">—</strong></div>
        <div class="admin-stat"><span>Health index</span><strong id="stat-score" style="color:#C5A059">—</strong></div>
      </div>
    </div>

    <!-- Route Selector & Editor -->
    <div class="seo-layout-grid" style="margin-top:1.5rem">
      <!-- Route List Sidebar -->
      <div class="booking-panel route-sidebar">
        <span class="eyebrow">SELECT PUBLIC ROUTE</span>
        <h3 style="margin:6px 0 14px;font-size:18px">Pages ({14})</h3>
        <div class="route-list" id="route-list" role="tablist">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Editor Panel -->
      <div class="booking-panel editor-panel">
        <div class="section-heading">
          <div>
            <span class="eyebrow" id="active-route-badge">ROUTE: /</span>
            <h2 id="active-route-name">Homepage</h2>
            <p class="muted" id="active-route-desc">Primary brand entry point for Materuni Hosts.</p>
          </div>
          <a class="button button-secondary" id="preview-live-link" href="/" target="_blank" rel="noopener">View Live Page ↗</a>
        </div>

        <form id="seo-form" class="form-grid" style="margin-top:1rem">
          <!-- Meta Title -->
          <div class="field full">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <label for="meta-title" style="font-weight:700">Page & Meta Title (&lt;title&gt;, og:title)</label>
              <span id="title-counter" class="char-counter">0 / 60 chars</span>
            </div>
            <input id="meta-title" type="text" maxlength="80" required />
            <small class="muted">Optimal range: 30–60 characters. Must be specific, descriptive, and contain primary keywords.</small>
          </div>

          <!-- Meta Description -->
          <div class="field full">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <label for="meta-description" style="font-weight:700">Meta Description (og:description)</label>
              <span id="desc-counter" class="char-counter">0 / 160 chars</span>
            </div>
            <textarea id="meta-description" rows="3" maxlength="200" required></textarea>
            <small class="muted">Optimal range: 120–160 characters. Clear summary with an actionable invitation (e.g. explore, plan, discover).</small>
          </div>

          <!-- OpenGraph Social Image -->
          <div class="field full">
            <label for="meta-og-image" style="font-weight:700">Social Share Card Image (og:image, twitter:image)</label>
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:4px">
              <input id="meta-og-image" type="url" placeholder="https://..." style="flex:1;min-width:240px" required />
              <input type="file" id="og-file-input" accept="image/jpeg,image/png,image/webp" style="display:none" />
              <button type="button" class="button button-secondary" id="og-upload-btn">📷 Upload image</button>
            </div>
            <small class="muted">Recommended aspect ratio: 1.91:1 (1200×630px). High-resolution authentic photography.</small>
            <p id="og-upload-feedback" class="muted" style="font-size:12px;margin:3px 0 0"></p>
          </div>

          <!-- Canonical URL & Robots -->
          <div class="field">
            <label for="meta-canonical" style="font-weight:700">Canonical URL</label>
            <input id="meta-canonical" type="url" placeholder="https://materunihosts.com/..." required />
            <small class="muted">Prevents duplicate content issues.</small>
          </div>

          <div class="field">
            <label for="meta-robots" style="font-weight:700">Robots Directive</label>
            <select id="meta-robots">
              <option value="index,follow">index, follow (Standard Public)</option>
              <option value="noindex,nofollow">noindex, nofollow (Private/Draft)</option>
              <option value="noindex,follow">noindex, follow (Archived/Staging)</option>
            </select>
            <small class="muted">Instructs search engine bots how to crawl this page.</small>
          </div>

          <!-- Target Keywords & Schema Type -->
          <div class="field">
            <label for="meta-keywords" style="font-weight:700">Focus Keywords (Reference)</label>
            <input id="meta-keywords" type="text" placeholder="e.g. Materuni waterfall, Chagga coffee, Kilimanjaro hike" />
            <small class="muted">Primary search terms targeted for this landing experience.</small>
          </div>

          <div class="field">
            <label for="meta-schema" style="font-weight:700">Schema.org Structured Data Type</label>
            <select id="meta-schema">
              <option value="TourOperator">TourOperator (LocalBusiness)</option>
              <option value="TouristTrip">TouristTrip (Guided Hike/Tour)</option>
              <option value="Campground">Campground (Accommodation/Stay)</option>
              <option value="FAQPage">FAQPage (Question & Answer)</option>
              <option value="WebPage">WebPage (General Content)</option>
            </select>
            <small class="muted">Generates rich results and Google knowledge panels.</small>
          </div>

          <!-- Live Google Search Preview -->
          <div class="field full" style="margin-top:1.5rem">
            <span class="eyebrow">SERP SIMULATOR</span>
            <h3 style="margin:4px 0 10px;font-size:16px">Google Search Result Preview</h3>
            <div class="google-snippet-preview">
              <div class="snippet-header">
                <span class="snippet-favicon">🌱</span>
                <div class="snippet-site-info">
                  <span class="snippet-site-name">Materuni Hosts</span>
                  <span class="snippet-url" id="preview-url">https://materunihosts.com</span>
                </div>
              </div>
              <h4 class="snippet-title" id="preview-title">Materuni Waterfall Tours | Guided Hikes & Chagga Culture</h4>
              <p class="snippet-desc" id="preview-desc">Join a Materuni Waterfall tour near Moshi, Tanzania. Walk forest trails with local hosts and discover Chagga coffee, village culture and local food.</p>
            </div>
          </div>

          <!-- Live Social Card Preview -->
          <div class="field full" style="margin-top:1rem">
            <span class="eyebrow">SOCIAL CARD SIMULATOR</span>
            <h3 style="margin:4px 0 10px;font-size:16px">OpenGraph Preview (WhatsApp, Facebook, Twitter, LinkedIn)</h3>
            <div class="social-card-preview">
              <img id="preview-og-img" src="https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/hero_image/1791995544192-materuni-waterfall.jpg" alt="Social preview" />
              <div class="social-card-body">
                <span class="social-card-domain">MATERUNIHOSTS.COM</span>
                <h4 class="social-card-title" id="preview-og-title">Title preview</h4>
                <p class="social-card-desc" id="preview-og-desc">Description preview</p>
              </div>
            </div>
          </div>

          <!-- Save Actions -->
          <div class="field full" style="margin-top:1.5rem">
            <button class="button" id="save-seo-btn" type="submit" style="padding:14px 28px;font-size:14px">💾 Save & Publish SEO Settings</button>
            <p id="save-feedback" class="muted" style="margin-top:8px" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
.seo-layout-grid {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  gap: 20px;
}
.route-sidebar {
  padding: 20px;
}
.route-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-height: 700px;
  overflow-y: auto;
}
.route-btn {
  text-align: left;
  background: #FAF7F2;
  border: 1px solid #E6DFD3;
  padding: 10px 14px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s ease;
  font-family: inherit;
}
.route-btn:hover {
  background: #fff;
  border-color: #C5A059;
}
.route-btn.active {
  background: #1A3322;
  color: #FAF7F2;
  border-color: #1A3322;
}
.route-btn strong {
  display: block;
  font-size: 13px;
}
.route-btn small {
  display: block;
  font-size: 11px;
  opacity: 0.8;
  margin-top: 2px;
}
.char-counter {
  font-size: 11px;
  font-weight: 700;
  color: #586258;
}
.char-counter.good {
  color: #2a7e43;
}
.char-counter.warn {
  color: #b45309;
}
.char-counter.bad {
  color: #b91c1c;
}

/* SERP Preview */
.google-snippet-preview {
  background: #fff;
  border: 1px solid #E6DFD3;
  border-radius: 12px;
  padding: 18px;
  max-width: 650px;
}
.snippet-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}
.snippet-site-name {
  font-size: 14px;
  color: #202124;
  font-weight: 500;
}
.snippet-url {
  font-size: 12px;
  color: #4d5156;
  margin-left: 4px;
}
.snippet-title {
  color: #1a0dab;
  font-size: 20px;
  line-height: 1.3;
  margin: 0 0 4px;
  cursor: pointer;
  font-family: sans-serif;
  font-weight: 400;
}
.snippet-title:hover {
  text-decoration: underline;
}
.snippet-desc {
  font-size: 14px;
  line-height: 1.58;
  color: #4d5156;
  margin: 0;
  font-family: sans-serif;
}

/* Social Preview */
.social-card-preview {
  border: 1px solid #E6DFD3;
  border-radius: 12px;
  overflow: hidden;
  max-width: 580px;
  background: #FAF7F2;
}
.social-card-preview img {
  width: 100%;
  height: 280px;
  object-fit: cover;
  display: block;
}
.social-card-body {
  padding: 16px;
}
.social-card-domain {
  font-size: 11px;
  font-weight: 700;
  color: #7A756B;
  letter-spacing: 0.08em;
}
.social-card-title {
  font-size: 17px;
  font-weight: 700;
  color: #1A3322;
  margin: 4px 0 6px;
  line-height: 1.3;
}
.social-card-desc {
  font-size: 13px;
  color: #586258;
  margin: 0;
  line-height: 1.5;
}

@media (max-width: 860px) {
  .seo-layout-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
let accessToken = "";
const el = id => document.getElementById(id);
const headers = () => ({ apikey: publishableKey, Authorization: "Bearer " + accessToken, "Content-Type": "application/json" });

async function api(path, options = {}) {
  const r = await fetch(supabaseUrl + path, { ...options, headers: { ...headers(), ...(options.headers || {}) } });
  const data = await r.json().catch(() => null);
  if (!r.ok) throw new Error(data?.message || data?.details || "Request failed.");
  return data;
}

