---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Google Search Console | Materuni Hosts" description="Private, read-only Google Search Console performance reports." noindex={true}>
<main class="gsc-shell">
  <header class="top"><a href="/admin/marketing">← Marketing & SEO Studio</a><span class="eyebrow">MATERUNI INTELLIGENCE OS · READ ONLY</span></header>
  <section class="intro"><p class="eyebrow">GOOGLE SEARCH CONSOLE</p><h1>Search performance, grounded in data.</h1><p>View real clicks, impressions, click-through rate and average position from the connected Search Console property. No ranking estimates or sample metrics are displayed.</p></section>
  <section id="login-panel" class="panel login"><h2>Administrator sign in</h2><form id="login-form"><label for="email">Administrator email</label><input id="email" type="email" autocomplete="username" required><label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required><button id="login-button">Sign in securely</button><p id="login-feedback" role="status"></p></form></section>
  <section id="workspace" hidden>
    <div class="panel controls"><div class="controls-grid"><div><label for="start-date">Start date</label><input id="start-date" type="date"></div><div><label for="end-date">End date</label><input id="end-date" type="date"></div><div><label for="dimension">Report by</label><select id="dimension"><option value="query">Search queries</option><option value="page">Landing pages</option></select></div><div><button id="run-report" class="primary">Load Google report →</button></div></div><p id="report-status" role="status" class="status">Sign in to check the connection and load a report.</p></div>
    <div id="report" hidden>
      <div class="metrics"><article class="metric"><span>Clicks returned</span><strong id="clicks">—</strong></article><article class="metric"><span>Impressions returned</span><strong id="impressions">—</strong></article><article class="metric"><span>CTR (returned rows)</span><strong id="ctr">—</strong></article><article class="metric"><span>Average position*</span><strong id="position">—</strong></article></div>
      <div class="panel table-panel"><div class="table-head"><div><h2 id="table-title">Search queries</h2><p id="report-meta" class="muted"></p></div><button id="export-csv" class="secondary">Export CSV</button></div><div class="table-scroll"><table><thead><tr><th id="key-heading">Search query</th><th>Clicks</th><th>Impressions</th><th>CTR</th><th>Avg. position</th></tr></thead><tbody id="rows"></tbody></table></div><p class="footnote">* Average position is the mean of the returned row positions, not a weighted property-wide average. Totals above sum only the top 250 returned rows. Search Console may omit anonymised queries.</p></div>
    </div>
  </section>
</main>
</SiteLayout>
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
const el=(id)=>document.getElementById(id);let token="";let latest=null;
const baseHeaders=()=>({apikey:publishableKey,"Content-Type":"application/json"});
function isoDate(d){return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")}
const today=new Date();const end=new Date(today);end.setDate(end.getDate()-3);const start=new Date(end);start.setDate(start.getDate()-27);
el("start-date").value=isoDate(start);el("end-date").value=isoDate(end);
el("login-form").addEventListener("submit",async e=>{e.preventDefault();const b=el("login-button");b.disabled=true;el("login-feedback").textContent="Verifying administrator access…";try{const r=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:baseHeaders(),body:JSON.stringify({email:el("email").value.trim(),password:el("password").value})});const s=await r.json();if(!r.ok||!s.access_token)throw new Error(s.msg||s.message||"Sign in failed.");token=s.access_token;const a=await fetch(supabaseUrl+"/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(s.user.id),{headers:{apikey:publishableKey,Authorization:"Bearer "+token}});const admins=await a.json();if(!a.ok||!Array.isArray(admins)||!admins.length)throw new Error("This account is not on the administrator allowlist.");el("login-panel").hidden=true;el("workspace").hidden=false;el("report-status").textContent="Administrator verified. Load a report to test the Google connection.";}catch(err){token="";el("login-feedback").textContent=err.message;}finally{b.disabled=false;}});
function csvEscape(v){const s=String(v??"");return '"'+s.replace(/"/g,'""')+'"'}
el("run-report").addEventListener("click",async()=>{const b=el("run-report");b.disabled=true;el("report-status").textContent="Requesting verified Search Console data…";el("report").hidden=true;try{const r=await fetch("/api/google-search-console",{method:"POST",headers:{...baseHeaders(),Authorization:"Bearer "+token},body:JSON.stringify({startDate:el("start-date").value,endDate:el("end-date").value,dimension:el("dimension").value})});const d=await r.json();if(!r.ok)throw new Error(d.error||"Google report failed.");latest=d;el("clicks").textContent=d.totals.clicks.toLocaleString();el("impressions").textContent=d.totals.impressions.toLocaleString();el("ctr").textContent=(d.totals.ctr*100).toFixed(2)+"%";el("position").textContent=d.totals.averagePosition.toFixed(1);el("table-title").textContent=el("dimension").value==="query"?"Top search queries":"Top landing pages";el("key-heading").textContent=el("dimension").value==="query"?"Search query":"Landing page";el("report-meta").textContent=d.property+" · "+d.startDate+" to "+d.endDate+" · "+d.returnedRows+" rows · fetched "+new Date(d.fetchedAt).toLocaleString();const tbody=el("rows");tbody.replaceChildren();for(const row of d.rows){const tr=document.createElement("tr");for(const value of [row.key,row.clicks.toLocaleString(),row.impressions.toLocaleString(),(row.ctr*100).toFixed(2)+"%",row.position.toFixed(1)]){const td=document.createElement("td");td.textContent=value;tr.append(td);}tbody.append(tr);}el("report").hidden=false;el("report-status").textContent=d.note;}catch(err){el("report-status").textContent=err.message;}finally{b.disabled=false;}});
el("export-csv").addEventListener("click",()=>{if(!latest)return;const lines=[["Key","Clicks","Impressions","CTR","Average position"],...latest.rows.map(r=>[r.key,r.clicks,r.impressions,r.ctr,r.position])].map(row=>row.map(csvEscape).join(",")).join("\r\n");const blob=new Blob(["\uFEFF"+lines],{type:"text/csv;charset=utf-8"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="materuni-search-console-"+latest.dimension+"-"+latest.startDate+"-"+latest.endDate+".csv";a.click();URL.revokeObjectURL(url);});
</script>
<style>
.gsc-shell{max-width:1160px;margin:auto;padding:30px 18px 76px;color:#242421}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:34px}.top a{color:#1a3322;font-weight:700;text-decoration:none}.eyebrow{font-size:11px;letter-spacing:.15em;font-weight:750;color:#a17d40}.intro{max-width:760px;margin:0 auto 28px;text-align:center}.intro h1{font:600 clamp(34px,5vw,54px)/1.08 Georgia,serif;color:#1a3322;margin:8px 0 14px}.intro>p:last-child{color:#68675f;line-height:1.7}.panel{background:#fff;border:1px solid #e6dfd3;border-radius:14px;padding:clamp(18px,3vw,26px)}.login{max-width:450px;margin:28px auto}.login form{display:grid;gap:10px}.gsc-shell label{display:block;font-size:13px;font-weight:700;margin:10px 0 7px}.gsc-shell input,.gsc-shell select{width:100%;min-height:44px;padding:10px 12px;border:1px solid #d8d1c5;border-radius:8px;background:white;font:inherit}.gsc-shell button{min-height:44px;padding:10px 16px;border:0;border-radius:8px;font-weight:700;cursor:pointer}.gsc-shell button:disabled{opacity:.55}.primary{background:#1a3322;color:#faf7f2;width:100%}.secondary{background:#f2eee5;color:#1a3322}.controls-grid{display:grid;grid-template-columns:1fr 1fr 1fr 1.2fr;gap:12px;align-items:end}.controls-grid label{margin-top:0}.status{font-size:13px;line-height:1.6;color:#6c5a37;margin:14px 0 0}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:16px 0}.metric{padding:18px;border:1px solid #e6dfd3;border-radius:12px;background:#fff}.metric span{display:block;color:#777166;font-size:12px}.metric strong{display:block;color:#1a3322;font:600 clamp(22px,3vw,30px) Georgia,serif;margin-top:10px;overflow-wrap:anywhere}.table-panel{margin-top:12px}.table-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.table-head h2{font:600 23px Georgia,serif;color:#1a3322;margin:0}.muted,.footnote{color:#777166;font-size:12px;line-height:1.6}.table-scroll{overflow:auto;margin-top:16px}table{border-collapse:collapse;width:100%;min-width:620px;font-size:13px}th,td{text-align:left;padding:11px 10px;border-bottom:1px solid #eee8df}th{background:#faf7f2;color:#1a3322;white-space:nowrap}td:first-child{max-width:430px;overflow-wrap:anywhere}.footnote{margin-top:14px}@media(max-width:760px){.gsc-shell{padding:22px 14px 60px}.intro{text-align:left}.controls-grid{grid-template-columns:1fr 1fr}.metrics{grid-template-columns:1fr 1fr}}@media(max-width:420px){.controls-grid{grid-template-columns:1fr}.metrics{gap:8px}.metric{padding:13px}}
</style>
