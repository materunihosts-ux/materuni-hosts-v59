---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Public Website Dashboard | Materuni Hosts" description="Manage the Materuni Hosts public website, content, media and search presentation." noindex={true}>
<section class="page-hero site-dashboard-hero"><span class="eyebrow">MATERUNI HOSTS · WEBSITE CONTROL</span><h1>Public Website Dashboard</h1><p>Keep the public Materuni Hosts website accurate, engaging and technically healthy. Manage pages, stories, experiences, photography and search appearance here.</p><div class="site-hero-actions"><a class="button" href="/" target="_blank" rel="noopener">View public website ↗</a><a class="button button-secondary" href="/admin/business-os">Open Business OS →</a></div></section>
<section class="booking-wrap" style="margin-top:1rem"><div class="site-os-note"><div><span class="eyebrow">SEPARATE WORKSPACE</span><h2>Business operations & marketing live in the OS</h2><p class="muted">Use the Business OS for bookings, guest CRM, SEO opportunities, marketing campaigns, AI assistance, workflows and performance insights. This dashboard is only for the public-facing website. It does not manage bookings, guest follow-ups or marketing campaigns.</p></div><a class="button" href="/admin/business-os">Go to Business OS ↗</a></div></section>
<section class="booking-wrap">
 <div class="booking-panel" id="login-panel">
  <h2>Administrator sign in</h2><p class="muted">Access is limited to approved Materuni Hosts administrators.</p>
  <form id="login-form" class="form-grid">
   <div class="field full"><label for="admin-email">Admin email</label><input id="admin-email" type="email" autocomplete="username" required></div>
   <div class="field full"><label for="admin-password">Password</label><input id="admin-password" type="password" autocomplete="current-password" required></div>
   <div class="field full"><button class="button" id="login-button" type="submit">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div>
  </form>
 </div>
 <div id="manager" hidden>
  <div class="booking-panel" style="margin-top:1.25rem">
   <span class="eyebrow">YOUR WEBSITE TOOLKIT</span><h2>What would you like to update?</h2><p class="muted">Choose the part of the public website you want to improve. Business operations and marketing workflows are managed in the Business OS.</p>
   <div class="admin-module-tools"><label class="visually-hidden" for="module-search">Search dashboard modules</label><input id="module-search" type="search" placeholder="Find a website task — pages, images, SEO, settings…" autocomplete="off"><span id="module-count" class="muted" aria-live="polite">6 website tools</span></div>\n   <p id="module-empty" class="muted" hidden>No modules match that search. Try another word.</p>\n   <div class="admin-home-grid site-tools-grid" id="admin-module-grid">
    <a class="admin-home-card admin-home-primary" href="/admin/content"><span class="admin-home-icon">01</span><span><strong>Website Content & Stories</strong><small>Edit brand story, host profiles, cultural pages and FAQs</small></span><span class="admin-home-arrow">→</span></a>
    <a class="admin-home-card admin-home-primary" href="/admin/landing-pages"><span class="admin-home-icon">02</span><span><strong>Landing Pages</strong><small>Manage public page messaging, structure and calls to action</small></span><span class="admin-home-arrow">→</span></a>
    <a class="admin-home-card admin-home-primary" href="/admin/tours"><span class="admin-home-icon">03</span><span><strong>Experiences & Published Prices</strong><small>Keep experience descriptions, inclusions and public prices accurate</small></span><span class="admin-home-arrow">→</span></a>
    <a class="admin-home-card admin-home-primary" href="/admin/media"><span class="admin-home-icon">04</span><span><strong>Photography & Media Library</strong><small>Manage authentic Materuni photos and website media assets</small></span><span class="admin-home-arrow">→</span></a>
    <a class="admin-home-card admin-home-primary" href="/admin/business-details"><span class="admin-home-icon">05</span><span><strong>Host Details & Guest Policies</strong><small>Keep public-facing host information, practical details and guest policies accurate</small></span><span class="admin-home-arrow">→</span></a>
    <a class="admin-home-card admin-home-primary" href="/admin/settings"><span class="admin-home-icon">06</span><span><strong>Website Settings</strong><small>Manage website-wide details, contact links and site preferences</small></span><span class="admin-home-arrow">→</span></a>
   </div>
   <div class="admin-home-footer"><span>Need to leave the dashboard?</span><button class="button button-secondary" id="logout" type="button">Sign out</button></div>
  </div>

 </div>
</section>

<style>
.site-dashboard-hero{padding:clamp(26px,5vw,54px);border-radius:22px;background:linear-gradient(120deg,#1a3322 0%,#294936 64%,#52684b 100%);color:#faf7f2;position:relative;overflow:hidden}.site-dashboard-hero:after{content:"";position:absolute;width:340px;height:340px;border:1px solid #c5a05955;border-radius:50%;right:-80px;top:-140px;box-shadow:0 0 0 35px #c5a05912,0 0 0 75px #c5a0590b}.site-dashboard-hero .eyebrow{color:#dfc17e}.site-dashboard-hero h1{font:500 clamp(32px,5vw,52px)/1.05 Georgia,serif;max-width:700px;color:#faf7f2}.site-dashboard-hero p{max-width:700px;color:#e5e8df;line-height:1.75}.site-hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.site-dashboard-hero .button{background:#c5a059;color:#1a3322;border:1px solid #c5a059}.site-dashboard-hero .button-secondary{background:transparent;color:#faf7f2;border-color:#faf7f266}.site-os-note{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:22px 24px;border:1px solid #e6dfd3;border-radius:16px;background:#faf7f2}.site-os-note h2{font:500 23px Georgia,serif;color:#1a3322;margin:0 0 7px}.site-os-note p{max-width:740px;margin:0}.site-os-note .button{flex:none}.site-tools-grid{grid-template-columns:repeat(2,minmax(0,1fr))}#ops-snapshot,#legacy-bookings{display:none!important}.site-tools-grid .admin-home-card{min-height:110px;border-radius:14px;padding:18px}.site-tools-grid .admin-home-card[hidden]{display:none!important}.site-tools-grid .admin-home-card strong{font-size:15px}.site-tools-grid .admin-home-card small{line-height:1.55}.admin-module-tools{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.admin-module-tools input{flex:1;min-width:220px}.site-tools-grid .admin-home-card:hover{transform:translateY(-2px);box-shadow:0 12px 26px #24242110;border-color:#c5a059}@media(max-width:650px){.site-os-note{align-items:flex-start;flex-direction:column}.site-tools-grid{grid-template-columns:1fr}.site-dashboard-hero{padding:27px 22px}}
</style>
<script>
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
let accessToken="";
const el=(id:string): any=>document.getElementById(id);
const headers=()=>({apikey:publishableKey,Authorization:"Bearer "+accessToken,"Content-Type":"application/json"});
el("login-form").addEventListener("submit",async e=>{
 e.preventDefault();const button=el("login-button");button.disabled=true;el("login-feedback").textContent="Verifying administrator access…";
 try{
  const response=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:{apikey:publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email:el("admin-email").value.trim(),password:el("admin-password").value})});
  const session=await response.json();if(!response.ok||!session.access_token||!session.user?.id)throw new Error(session.msg||session.message||"Sign in failed.");
  accessToken=session.access_token;
  const check=await fetch(supabaseUrl+"/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(session.user.id),{headers:{apikey:publishableKey,Authorization:"Bearer "+accessToken,Accept:"application/json"}});
  const admins=await check.json();if(!check.ok||!Array.isArray(admins)||!admins.length)throw new Error("This account is not authorised as an administrator.");
  el("login-panel").hidden=true;el("manager").hidden=false;
 }catch(error){accessToken="";el("login-feedback").textContent=error instanceof Error?error.message:"Unable to sign in.";}finally{button.disabled=false;}
});
const moduleSearch=el("module-search");
const moduleCards=[...document.querySelectorAll<HTMLElement>("#admin-module-grid .admin-home-card")];
function filterModules(){const q=moduleSearch.value.trim().toLocaleLowerCase();let visible=0;moduleCards.forEach(card=>{const match=card.textContent.toLocaleLowerCase().includes(q);card.hidden=!match;if(match)visible++;});el("module-count").textContent=visible+" of "+moduleCards.length+" website tools";el("module-empty").hidden=visible!==0;}
moduleSearch.addEventListener("input",filterModules);
el("logout").addEventListener("click",async()=>{try{if(accessToken)await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:headers()});}catch{}accessToken="";el("manager").hidden=true;el("login-panel").hidden=false;(el("login-form") as HTMLFormElement).reset();el("login-feedback").textContent="You have signed out.";});
</script>

</SiteLayout>