---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Approval Center | Materuni Hosts" description="Approval policy preview for Materuni Hosts Business OS." noindex={true}>
<main class="approval-shell">
  <header class="top"><a href="/admin/business-os">← Business OS</a><span class="eyebrow">PRIVATE WORKSPACE · GOVERNANCE</span></header>
  <section class="intro"><p class="eyebrow">MATERUNI HOSTS · APPROVAL CENTER</p><h1>Nothing important happens without your say.</h1><p>This preview defines which actions must wait for a human decision. It does not execute, publish, send, spend or change business records.</p></section>
  <section id="login-panel" class="panel login">
    <h2>Administrator sign in</h2>
    <form id="login-form"><label for="email">Admin email</label><input id="email" type="email" autocomplete="username" required><label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required><button>Sign in</button><p id="login-feedback" role="status"></p></form>
  </section>
  <section id="workspace" hidden>
    <div class="status-strip"><span class="dot"></span><div><strong>Policy preview only</strong><p>Approval records and execution controls are not connected to the database yet.</p></div></div>
    <div class="section-head"><div><p class="eyebrow">APPROVAL MATRIX</p><h2>Actions requiring approval</h2></div></div>
    <div class="policy-grid">
      <article class="policy"><span class="number">01</span><h3>Guest communications</h3><p>One-to-one or bulk messages, WhatsApp replies, email campaigns and automated follow-ups.</p><span class="required">Approval required</span></article>
      <article class="policy"><span class="number">02</span><h3>Public content</h3><p>Publishing or materially editing website pages, social posts, images, offers and public announcements.</p><span class="required">Approval required</span></article>
      <article class="policy"><span class="number">03</span><h3>Advertising & spending</h3><p>Budgets, bids, campaign activation, paid subscriptions and any action that commits money.</p><span class="required">Approval required</span></article>
      <article class="policy"><span class="number">04</span><h3>Bookings & guest records</h3><p>Confirming, cancelling, deleting or changing bookings and modifying guest information.</p><span class="required">Approval required</span></article>
      <article class="policy"><span class="number">05</span><h3>Prices & payments</h3><p>Official tour prices, discounts, payment settings, refunds and payment-provider configuration.</p><span class="required">Approval required</span></article>
      <article class="policy"><span class="number">06</span><h3>Integrations & access</h3><p>Connecting accounts, granting permissions, rotating credentials and changing administrator access.</p><span class="required">Approval required</span></article>
    </div>
    <section class="panel safe-panel"><p class="eyebrow">LOW-RISK WORK</p><h2>What AI can prepare without approval</h2><div class="safe-list"><span>SEO research and recommendations</span><span>Internal summaries and analysis</span><span>Draft captions and content calendars</span><span>Draft guest replies not yet sent</span><span>Internal reports and checklists</span></div><p class="fine">These remain subject to administrator access, privacy rules and fact-checking. Drafting never grants permission to publish or send.</p></section>
    <section class="panel controls"><p class="eyebrow">CONTROL RULES</p><h2>How an approval must work</h2><ol><li><strong>Exact proposal:</strong> the approver sees the complete action and its destination, audience, content and cost.</li><li><strong>Payload lock:</strong> approval applies only to the exact proposal version. Any edit invalidates the previous approval.</li><li><strong>Separation:</strong> the person requesting a high-impact action cannot approve their own request.</li><li><strong>Expiry:</strong> approvals expire after a defined period and cannot be reused.</li><li><strong>One-time execution:</strong> an approved action uses an idempotency key and is re-authorised immediately before execution.</li><li><strong>Audit:</strong> request, decision, execution result and failure are recorded without storing secrets or unnecessary guest data.</li></ol></section>
    <section class="panel readiness"><div><p class="eyebrow">IMPLEMENTATION STATUS</p><h2>Governance foundation</h2></div><div class="readiness-row"><span>Approval policy</span><b class="done">Defined in preview</b></div><div class="readiness-row"><span>Database approval queue</span><b>Not connected</b></div><div class="readiness-row"><span>Immutable audit trail</span><b>Not connected</b></div><div class="readiness-row"><span>Action execution worker</span><b>Disabled</b></div><p class="fine">This page is a policy preview, not an active approval queue. No approval can currently authorise an external action.</p></section>
    <button id="logout" class="quiet">Sign out</button>
  </section>
</main>
</SiteLayout>
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
const el=(id)=>document.getElementById(id);
const headers=()=>({apikey:publishableKey,"Content-Type":"application/json"});
el("login-form").addEventListener("submit",async e=>{e.preventDefault();const b=e.currentTarget.querySelector("button");b.disabled=true;el("login-feedback").textContent="Checking administrator access…";try{const r=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:headers(),body:JSON.stringify({email:el("email").value.trim(),password:el("password").value})});const s=await r.json();if(!r.ok||!s.access_token)throw new Error(s.msg||s.message||"Sign in failed.");const a=await fetch(supabaseUrl+"/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(s.user.id),{headers:{apikey:publishableKey,Authorization:"Bearer "+s.access_token}});const admins=await a.json();if(!a.ok||!Array.isArray(admins)||!admins.length)throw new Error("Administrator access is required.");sessionToken=s.access_token;el("login-panel").hidden=true;el("workspace").hidden=false;}catch(err){el("login-feedback").textContent=err.message;}finally{b.disabled=false;}});
let sessionToken="";
el("logout").addEventListener("click",async()=>{try{if(sessionToken)await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:{apikey:publishableKey,Authorization:"Bearer "+sessionToken}});}catch{}sessionToken="";el("workspace").hidden=true;el("login-panel").hidden=false;el("login-form").reset();el("login-feedback").textContent="Signed out.";});
</script>
<style>
.approval-shell{max-width:1120px;margin:auto;padding:32px 18px 76px;color:#242421}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:32px}.top a{color:#1a3322;text-decoration:none;font-weight:700}.eyebrow{font-size:11px;letter-spacing:.16em;font-weight:750;color:#a17d40;margin:0 0 10px}.intro{max-width:760px;margin:0 auto 30px;text-align:center}.intro h1{font:600 clamp(36px,5vw,58px)/1.08 Georgia,serif;color:#1a3322;margin:0 0 14px}.intro>p:last-child{font-size:15px;line-height:1.7;color:#68675f}.panel{background:#fff;border:1px solid #e6dfd3;border-radius:14px;padding:clamp(20px,3vw,28px);margin-top:18px}.login{max-width:440px;margin:30px auto}.login form{display:grid;gap:9px}.approval-shell label{font-size:13px;font-weight:650;margin-top:9px}.approval-shell input{padding:13px;border:1px solid #d8d1c5;border-radius:8px;font:inherit}.approval-shell button{border:0;border-radius:8px;padding:12px 16px;font-weight:700;cursor:pointer}.login button{background:#1a3322;color:#fff}.login p{font-size:13px;color:#8a4c27}.status-strip{display:flex;gap:13px;align-items:center;padding:16px 18px;background:#f5f1e9;border:1px solid #e6dfd3;border-radius:10px}.dot{width:10px;height:10px;border-radius:50%;background:#b18a42;flex:none}.status-strip p{margin:4px 0 0;font-size:13px;color:#68675f}.section-head{margin:34px 0 16px}.section-head h2,.panel h2{font:600 25px Georgia,serif;color:#1a3322;margin:0 0 15px}.policy-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.policy{padding:21px;border:1px solid #e6dfd3;border-radius:12px;background:#fff}.number{font:22px Georgia,serif;color:#b08b4b}.policy h3{font:600 19px Georgia,serif;color:#1a3322;margin:14px 0 8px}.policy p{font-size:13px;line-height:1.65;color:#68675f;min-height:64px}.required{display:inline-block;padding:7px 9px;border-radius:20px;background:#f5f1e9;color:#745b30;font-size:11px;font-weight:700}.safe-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.safe-list span{padding:12px;background:#faf7f2;border-radius:8px;font-size:13px;color:#4e554b}.fine{font-size:12px;line-height:1.6;color:#777166;margin-bottom:0}.controls ol{padding-left:20px;color:#5e5d56;line-height:1.75;font-size:14px}.controls li{padding:4px 0}.controls strong{color:#292b26}.readiness-row{display:flex;justify-content:space-between;gap:15px;padding:13px 0;border-bottom:1px solid #eee9e0;font-size:13px}.readiness-row b{font-size:12px;color:#777166}.readiness-row .done{color:#446449}.quiet{margin-top:20px;background:#f2eee5;color:#1a3322}@media(max-width:760px){.approval-shell{padding:22px 14px 55px}.intro{text-align:left}.intro h1{font-size:37px}.policy-grid{grid-template-columns:1fr}.policy p{min-height:0}.safe-list{grid-template-columns:1fr}.readiness-row{align-items:flex-start}.readiness-row b{text-align:right}}
</style>
