---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Website Content Manager | Materuni Hosts Admin" description="Manage public About Us, FAQ, and homepage content." noindex={true}>
<section class="page-hero">
  <span class="eyebrow">PRIVATE ADMIN · WEBSITE EDITOR</span>
  <h1>Website Content & About Us Manager</h1>
  <p>Edit the About Us story, founder notes, local host guides, FAQs, homepage messaging, and multilingual translations.</p>
</section>

<section class="booking-wrap">
  <div class="booking-panel" id="login-panel">
    <h2>Administrator sign in</h2>
    <p class="muted">Only approved Materuni Hosts administrators can edit website content.</p>
    <form id="login-form" class="form-grid">
      <div class="field full"><label for="admin-email">Admin email</label><input id="admin-email" type="email" autocomplete="username" required></div>
      <div class="field full"><label for="admin-password">Password</label><input id="admin-password" type="password" autocomplete="current-password" required></div>
      <div class="field full"><button class="button" id="login-button" type="submit">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div>
    </form>
  </div>

  <div id="manager" hidden>
    <!-- Topbar Shortcuts -->
    <div class="admin-topbar">
      <div class="admin-topbar-links">
        <a class="button button-secondary" href="/admin/">← Dashboard</a>
        <a class="button button-secondary" href="/admin/tours">Tours & Photos</a>
        <a class="button button-secondary" href="/admin/media">Media Library</a>
        <a class="button button-secondary" href="/about-us" target="_blank" rel="noopener">Preview About Us ↗</a>
        <a class="button button-secondary" href="/faq" target="_blank" rel="noopener">Preview FAQs ↗</a>
        <a class="button button-secondary" href="/" target="_blank" rel="noopener">Preview Homepage ↗</a>
      </div>
      <button class="button button-secondary" id="logout" type="button">Sign out</button>
    </div>

    <!-- ABOUT US PAGE EDITOR -->
    <div class="booking-panel" id="about-us-panel" style="margin-top:1.5rem">
      <div class="section-heading">
        <div>
          <span class="eyebrow" style="color:#C5A059">PUBLIC ABOUT US PAGE</span>
          <h2>Edit About Us Story & Local Hosts</h2>
          <p class="muted">Update the company introduction, Saidi Materu's founder story, team host bios, photography, and community values.</p>
        </div>
        <a class="button button-secondary" href="/about-us" target="_blank" rel="noopener">View Live Page ↗</a>
      </div>

      <form id="about-form" class="form-grid">
        <!-- Hero Section -->
        <div class="field full section-subheading">
          <strong>1. Hero Header & Story</strong>
        </div>
        <div class="field"><label for="about-hero-eyebrow">Hero Eyebrow</label><input id="about-hero-eyebrow" required maxlength="120"></div>
        <div class="field"><label for="about-hero-title">Hero Headline</label><input id="about-hero-title" required maxlength="140"></div>
        <div class="field full"><label for="about-hero-p1">Hero Paragraph 1</label><textarea id="about-hero-p1" rows="3" required></textarea></div>
        <div class="field full"><label for="about-hero-p2">Hero Paragraph 2</label><textarea id="about-hero-p2" rows="3" required></textarea></div>
        
        <!-- Hero Photo -->
        <div class="field full image-manager-box">
          <label style="font-weight:700">About Us Main Photograph</label>
          <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:6px">
            <input type="file" id="about-hero-file" accept="image/jpeg,image/png,image/webp" style="display:none" />
            <button type="button" class="button button-secondary" id="about-hero-upload-btn">📷 Upload photo</button>
            <input id="about-hero-image" type="url" placeholder="https://..." style="flex:1;min-width:240px" />
          </div>
          <p id="about-hero-status" class="muted" style="font-size:12px;margin:4px 0 0" aria-live="polite"></p>
        </div>

        <!-- Founder Story Section -->
        <div class="field full section-subheading" style="margin-top:1rem">
          <strong>2. Founder Story (Saidi Materu)</strong>
        </div>
        <div class="field"><label for="about-founder-eyebrow">Founder Eyebrow</label><input id="about-founder-eyebrow" required maxlength="120"></div>
        <div class="field"><label for="about-founder-title">Founder Heading</label><input id="about-founder-title" required maxlength="140"></div>
        <div class="field full"><label for="about-founder-p1">Founder Story Paragraph 1</label><textarea id="about-founder-p1" rows="3" required></textarea></div>
        <div class="field full"><label for="about-founder-p2">Founder Story Paragraph 2</label><textarea id="about-founder-p2" rows="3" required></textarea></div>
        <div class="field full"><label for="about-founder-p3">Founder Story Paragraph 3</label><textarea id="about-founder-p3" rows="3" required></textarea></div>
        <div class="field full"><label for="about-founder-purpose">Founder Purpose Quote</label><textarea id="about-founder-purpose" rows="2" required></textarea></div>

        <!-- Local Hosts & Guides Team -->
        <div class="field full section-subheading" style="margin-top:1rem">
          <strong>3. Local Hosts & Guides Team</strong>
          <p class="muted" style="font-size:13px;font-weight:normal;margin:4px 0 0">Present authentic Chagga hosts with their role, local expertise, and portrait photo.</p>
        </div>
        <div class="field full" id="team-members-container">
          <!-- Dynamic team member cards injected here -->
        </div>
        <div class="field full" style="margin-top:4px">
          <button type="button" class="button button-secondary" id="add-team-member">+ Add Another Guide / Host</button>
        </div>

        <!-- Core Guiding Values -->
        <div class="field full section-subheading" style="margin-top:1rem">
          <strong>4. Guiding Principles & Values</strong>
        </div>
        <div class="field"><label for="about-val-1-title">Value 01 Title</label><input id="about-val-1-title" required></div>
        <div class="field"><label for="about-val-1-desc">Value 01 Description</label><input id="about-val-1-desc" required></div>
        <div class="field"><label for="about-val-2-title">Value 02 Title</label><input id="about-val-2-title" required></div>
        <div class="field"><label for="about-val-2-desc">Value 02 Description</label><input id="about-val-2-desc" required></div>
        <div class="field"><label for="about-val-3-title">Value 03 Title</label><input id="about-val-3-title" required></div>
        <div class="field"><label for="about-val-3-desc">Value 03 Description</label><input id="about-val-3-desc" required></div>
        <div class="field"><label for="about-val-4-title">Value 04 Title</label><input id="about-val-4-title" required></div>
        <div class="field"><label for="about-val-4-desc">Value 04 Description</label><input id="about-val-4-desc" required></div>

        <!-- Village Note -->
        <div class="field full section-subheading" style="margin-top:1rem">
          <strong>5. Village Community Statement</strong>
        </div>
        <div class="field full"><label for="about-community-note">Bottom Banner Note</label><input id="about-community-note" required maxlength="250"></div>

        <div class="field full" style="margin-top:14px">
          <button class="button" id="save-about" type="submit" style="font-size:14px;padding:12px 24px">✨ Publish About Us Changes</button>
          <p id="about-feedback" class="muted" style="margin-top:8px" aria-live="polite"></p>
        </div>
      </form>
    </div>

    <!-- FAQ SECTION -->
    <div class="booking-panel" style="margin-top:1.5rem">
      <div class="section-heading">
        <div>
          <span class="eyebrow">CONTENT MANAGEMENT</span>
          <h2>Frequently Asked Questions</h2>
          <p class="muted">Edit the answers guests see on the public FAQ page.</p>
        </div>
      </div>
      <div id="faq-editor" class="form-grid"></div>
      <div class="actions" style="margin-top:1.2rem">
        <button class="button button-secondary" id="add-faq" type="button">Add a question</button>
        <button class="button" id="save-faq" type="button">Publish FAQ changes</button>
      </div>
      <p id="content-feedback" class="muted" aria-live="polite"></p>
    </div>

    <!-- HOMEPAGE COPY -->
    <div class="booking-panel" style="margin-top:1.25rem">
      <span class="eyebrow">HOMEPAGE COPY</span>
      <h2>Edit Homepage Messaging</h2>
      <p class="muted">Update text shown on the homepage.</p>
      <form id="home-copy-form" class="form-grid">
        <div class="field full"><label for="home-hero-title">Hero headline</label><input id="home-hero-title" maxlength="120" required></div>
        <div class="field full"><label for="home-hero-intro">Hero introduction</label><textarea id="home-hero-intro" rows="3" maxlength="500" required></textarea></div>
        <div class="field full"><label for="home-experiences-title">Experiences section heading</label><input id="home-experiences-title" maxlength="120" required></div>
        <div class="field full"><label for="home-experiences-intro">Experiences section introduction</label><textarea id="home-experiences-intro" rows="3" maxlength="500" required></textarea></div>
        <div class="field full"><label for="home-story-title">Story section heading</label><input id="home-story-title" maxlength="120" required></div>
        <div class="field full"><label for="home-story-desc">Story section paragraph</label><textarea id="home-story-desc" rows="4" maxlength="900" required></textarea></div>
        <div class="field full"><label for="home-story-desc2">Story section second paragraph</label><textarea id="home-story-desc2" rows="3" maxlength="500" required></textarea></div>
        <div class="field full"><button class="button" id="save-home-copy" type="submit">Publish homepage copy</button><p id="home-copy-feedback" class="muted" aria-live="polite"></p></div>
      </form>
    </div>

    <!-- MULTILINGUAL CONTENT -->
    <div class="booking-panel" style="margin-top:1.25rem">
      <span class="eyebrow">MULTILINGUAL CONTENT</span>
      <h2>Website Translations</h2>
      <p class="muted">Manage Spanish, French and German text across pages.</p>
      <div class="form-grid">
        <div class="field"><label for="translation-language">Edit language</label><select id="translation-language"><option value="es">Spanish · Español</option><option value="fr">French · Français</option><option value="de">German · Deutsch</option></select></div>
        <div class="field"><label>Translation status</label><p id="translation-status" class="muted" role="status">Load translations after signing in.</p></div>
      </div>
      <div id="translation-editor" class="form-grid" style="margin-top:1rem"></div>
      <div class="actions" style="margin-top:1rem"><button class="button" id="save-translations" type="button">Publish selected language</button></div>
      <p id="translation-feedback" class="muted" aria-live="polite"></p>
    </div>

    <!-- OUR APPROACH PAGE -->
    <div class="booking-panel" style="margin-top:1.25rem">
      <span class="eyebrow">OUR APPROACH PAGE</span>
      <h2>Edit Sustainability & Culture Content</h2>
      <p class="muted">Update the public Our Approach page copy.</p>
      <form id="approach-form" class="form-grid">
        <div class="field full"><label for="approach-title">Page headline</label><input id="approach-title" maxlength="120" required></div>
        <div class="field full"><label for="approach-intro">Introduction</label><textarea id="approach-intro" rows="3" maxlength="700" required></textarea></div>
        <div class="field full"><label for="approach-section-title">Main section heading</label><input id="approach-section-title" maxlength="150" required></div>
        <div class="field full"><label for="approach-section-intro">Main section text</label><textarea id="approach-section-intro" rows="4" maxlength="1000" required></textarea></div>
        <div class="field full"><label for="approach-cta-title">Closing heading</label><input id="approach-cta-title" maxlength="120" required></div>
        <div class="field full"><label for="approach-cta-text">Closing text</label><textarea id="approach-cta-text" rows="3" maxlength="500" required></textarea></div>
        <div class="field full"><button class="button" id="save-approach" type="submit">Publish Our Approach changes</button><p id="approach-feedback" class="muted" aria-live="polite"></p></div>
      </form>
    </div>
  </div>
</section>

<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../../lib/supabase-public";
const bucket = "materuni-images";
let accessToken = "";
const el = id => document.getElementById(id);
const headers = () => ({ apikey: publishableKey, Authorization: "Bearer " + accessToken, "Content-Type": "application/json" });

async function api(path, options = {}) {
  const r = await fetch(supabaseUrl + path, { ...options, headers: { ...headers(), ...(options.headers || {}) } });
  const data = await r.json().catch(() => null);
  if (!r.ok) throw new Error(data?.message || data?.details || "Request failed.");
  return data;
}

// WebP optimizer
async function makeOptimizedWebP(source, maxSide = 1400) {
  const bitmap = await createImageBitmap(source);
  const scale = Math.min(1, maxSide / Math.max(bitmap.width, bitmap.height));
  const width = Math.max(1, Math.round(bitmap.width * scale));
  const height = Math.max(1, Math.round(bitmap.height * scale));
  const canvas = document.createElement("canvas");
  canvas.width = width;
  canvas.height = height;
  const ctx = canvas.getContext("2d");
  if (!ctx) { bitmap.close?.(); throw new Error("Browser canvas unavailable."); }
  ctx.drawImage(bitmap, 0, 0, width, height);
  bitmap.close?.();
  const blob = await new Promise(resolve => canvas.toBlob(resolve, "image/webp", 0.82));
  if (!blob) throw new Error("Could not compress to WebP.");
  return blob;
}

async function uploadImage(blob, folder = "about_images") {
  const filename = `${folder}/${Date.now()}-${Math.random().toString(36).substring(2, 7)}.webp`;
  const upload = await fetch(supabaseUrl + `/storage/v1/object/${bucket}/${filename}`, {
    method: "POST",
    headers: {
      "apikey": publishableKey,
      "Authorization": "Bearer " + accessToken,
      "Content-Type": "image/webp",
      "x-upsert": "false",
      "Cache-Control": "31536000"
    },
    body: blob
  });
  const res = await upload.json().catch(() => null);
  if (!upload.ok) throw new Error(res?.message || res?.error || "Image upload failed.");
  return supabaseUrl + `/storage/v1/object/public/${bucket}/${filename}`;
}

// ================= ABOUT US CONTENT LOGIC =================
const aboutDefaults = {
  heroEyebrow: "ABOUT MATERUNI HOSTS · MATERUNI VILLAGE",
  heroTitle: "Experience Materuni through the people who call it home.",
  heroP1: "Materuni Hosts was founded by Saidi Materu with a simple purpose: to welcome visitors to discover the natural beauty, culture and everyday life of Materuni Village in a thoughtful and personal way.",
  heroP2: "Based in the foothills of Mount Kilimanjaro, near Moshi, we bring guests closer to the place through local experiences, genuine hospitality and time spent exploring with people who know the area.",
  heroImage: `${supabaseUrl}/storage/v1/object/public/materuni-images/story_image/1791995912146-materuni-community.jpg`,
  founderEyebrow: "A NOTE ABOUT OUR FOUNDER",
  founderTitle: "Founded by Saidi Materu.",
  founderP1: "Materuni Hosts was established by Saidi Materu to help visitors experience more than a destination. The idea is to create opportunities for guests to connect with Materuni: its landscapes, its people, its food and the traditions that shape local life.",
  founderP2: "That local perspective guides how we welcome guests and shape our experiences. We want visitors to feel comfortable asking questions, learning at their own pace and understanding the place with respect. Every visit should feel personal, well explained and thoughtfully arranged.",
  founderP3: "Our story is closely connected to Materuni itself. Rather than offering only one kind of tour, we invite guests to choose from a range of experiences that reveal different sides of the village and the wider Kilimanjaro area.",
  founderPurpose: "To share the beauty and culture of Materuni through welcoming, meaningful experiences led with local knowledge and respect.",
  team: [
    {
      name: "Saidi Materu",
      role: "Founder & Lead Mountain Host",
      bio: "Lifelong Materuni resident with 12+ years sharing Chagga history, waterfall trekking, and coffee culture.",
      image: `${supabaseUrl}/storage/v1/object/public/materuni-images/story_image/1791995912146-materuni-community.jpg`
    },
    {
      name: "Elia",
      role: "Chagga Coffee Specialist",
      bio: "Guiding the artisanal roasting ceremony over woodfire with ancestral songs and pestle grinding.",
      image: `${supabaseUrl}/storage/v1/object/public/materuni-images/coffee_image/1791998412318-materuni-tour.jpg`
    },
    {
      name: "Amani",
      role: "Forest & Trail Guide",
      bio: "Expert on native Kilimanjaro plants, birdlife, waterfall safety, and the scenic foothills paths.",
      image: `${supabaseUrl}/storage/v1/object/public/materuni-images/story_image/1791601761441-q3iog8mni3r.jpg`
    }
  ],
  val1Title: "Local connection",
  val1Desc: "We place local hosts, knowledge and perspectives at the heart of the guest experience.",
  val2Title: "Respect for culture",
  val2Desc: "We share Chagga traditions and everyday village life with care, openness and respect.",
  val3Title: "Care for nature",
  val3Desc: "We encourage visitors to appreciate the landscapes and natural environment of Materuni responsibly.",
  val4Title: "Clear communication",
  val4Desc: "We aim to explain each experience, its inclusions and arrangements clearly before guests book.",
  communityNote: "Authentic local Chagga hosts born and raised in Materuni Village · Moshi, Kilimanjaro, Tanzania"
};

let aboutData = JSON.parse(JSON.stringify(aboutDefaults));

function renderTeamMembers() {
  const container = el("team-members-container");
  container.replaceChildren();

  aboutData.team.forEach((member, idx) => {
    const card = document.createElement("div");
    card.className = "notice";
    card.style.marginTop = "10px";
    card.style.padding = "16px";
    card.style.background = "#fff";
    card.style.border = "1px solid #e6dfd3";
    card.style.borderRadius = "12px";

    const top = document.createElement("div");
    top.style.display = "flex";
    top.style.justifyContent = "space-between";
    top.style.alignItems = "center";
    top.style.marginBottom = "10px";

    const title = document.createElement("strong");
    title.textContent = `Host #${idx + 1}: ${member.name || "Guide"}`;

    const removeBtn = document.createElement("button");
    removeBtn.type = "button";
    removeBtn.className = "button button-secondary";
    removeBtn.textContent = "Remove";
    removeBtn.style.padding = "4px 10px";
    removeBtn.style.fontSize = "12px";
    removeBtn.addEventListener("click", () => {
      aboutData.team.splice(idx, 1);
      renderTeamMembers();
    });

    top.append(title, removeBtn);

    const grid = document.createElement("div");
    grid.className = "form-grid";

    // Name
    const nameWrap = document.createElement("div");
    nameWrap.className = "field";
    nameWrap.innerHTML = `<label>Host Full Name *</label><input type="text" value="${member.name}" required />`;
    const nameIn = nameWrap.querySelector("input");
    nameIn.addEventListener("input", () => { member.name = nameIn.value; title.textContent = `Host #${idx + 1}: ${member.name}`; });

    // Role
    const roleWrap = document.createElement("div");
    roleWrap.className = "field";
    roleWrap.innerHTML = `<label>Role / Specialization *</label><input type="text" value="${member.role}" required />`;
    const roleIn = roleWrap.querySelector("input");
    roleIn.addEventListener("input", () => { member.role = roleIn.value; });

    // Bio
    const bioWrap = document.createElement("div");
    bioWrap.className = "field full";
    bioWrap.innerHTML = `<label>Bio / Background *</label><textarea rows="2" required>${member.bio}</textarea>`;
    const bioIn = bioWrap.querySelector("textarea");
    bioIn.addEventListener("input", () => { member.bio = bioIn.value; });

    // Image
    const imgWrap = document.createElement("div");
    imgWrap.className = "field full";
    imgWrap.innerHTML = `
      <label>Portrait Photo URL</label>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <input type="url" value="${member.image}" placeholder="https://..." style="flex:1;min-width:200px" />
        <button type="button" class="button button-secondary member-upload-btn" style="padding:6px 12px;font-size:12px">Upload Photo</button>
      </div>
      <p class="muted member-upload-status" style="font-size:11px;margin:3px 0 0"></p>
    `;
    const imgIn = imgWrap.querySelector("input");
    imgIn.addEventListener("input", () => { member.image = imgIn.value; });

    const fileIn = document.createElement("input");
    fileIn.type = "file";
    fileIn.accept = "image/jpeg,image/png,image/webp";
    fileIn.style.display = "none";
    imgWrap.append(fileIn);

    const uploadBtn = imgWrap.querySelector(".member-upload-btn");
    const statusP = imgWrap.querySelector(".member-upload-status");
    uploadBtn.addEventListener("click", () => fileIn.click());
    fileIn.addEventListener("change", async (e) => {
      const f = e.target.files?.[0];
      if (!f) return;
      statusP.textContent = "Uploading…";
      try {
        const opt = await makeOptimizedWebP(f, 600);
        const url = await uploadImage(opt, "host_photos");
        imgIn.value = url;
        member.image = url;
        statusP.textContent = "✓ Photo uploaded!";
      } catch (err) {
        statusP.textContent = "Error: " + err.message;
      }
    });

    grid.append(nameWrap, roleWrap, bioWrap, imgWrap);
    card.append(top, grid);
    container.append(card);
  });
}

el("add-team-member")?.addEventListener("click", () => {
  aboutData.team.push({
    name: "New Local Guide",
    role: "Mountain & Cultural Guide",
    bio: "Passionate Materuni local sharing village traditions and Kilimanjaro hiking trails.",
    image: `${supabaseUrl}/storage/v1/object/public/materuni-images/story_image/1791995912146-materuni-community.jpg`
  });
  renderTeamMembers();
});

// Hero photo uploader
el("about-hero-upload-btn")?.addEventListener("click", () => el("about-hero-file")?.click());
el("about-hero-file")?.addEventListener("change", async (e) => {
  const f = e.target.files?.[0];
  if (!f) return;
  const status = el("about-hero-status");
  status.textContent = "Compressing and uploading hero photo…";
  try {
    const opt = await makeOptimizedWebP(f, 1600);
    const url = await uploadImage(opt, "about_hero");
    el("about-hero-image").value = url;
    status.textContent = "✓ Hero image uploaded successfully!";
  } catch (err) {
    status.textContent = "Upload failed: " + err.message;
  }
});

async function loadAboutUs() {
  try {
    const rows = await api("/rest/v1/site_settings?select=setting_key,setting_value&setting_key=eq.about_us_content");
    if (rows?.[0]?.setting_value) {
      const parsed = typeof rows[0].setting_value === "string" ? JSON.parse(rows[0].setting_value) : rows[0].setting_value;
      if (parsed && typeof parsed === "object") {
        aboutData = { ...aboutDefaults, ...parsed, team: parsed.team || aboutDefaults.team };
      }
    }
  } catch (e) {
    console.warn("Could not load about_us_content:", e);
  }

  // Populate inputs
  el("about-hero-eyebrow").value = aboutData.heroEyebrow;
  el("about-hero-title").value = aboutData.heroTitle;
  el("about-hero-p1").value = aboutData.heroP1;
  el("about-hero-p2").value = aboutData.heroP2;
  el("about-hero-image").value = aboutData.heroImage;

  el("about-founder-eyebrow").value = aboutData.founderEyebrow;
  el("about-founder-title").value = aboutData.founderTitle;
  el("about-founder-p1").value = aboutData.founderP1;
  el("about-founder-p2").value = aboutData.founderP2;
  el("about-founder-p3").value = aboutData.founderP3;
  el("about-founder-purpose").value = aboutData.founderPurpose;

  el("about-val-1-title").value = aboutData.val1Title;
  el("about-val-1-desc").value = aboutData.val1Desc;
  el("about-val-2-title").value = aboutData.val2Title;
  el("about-val-2-desc").value = aboutData.val2Desc;
  el("about-val-3-title").value = aboutData.val3Title;
  el("about-val-3-desc").value = aboutData.val3Desc;
  el("about-val-4-title").value = aboutData.val4Title;
  el("about-val-4-desc").value = aboutData.val4Desc;

  el("about-community-note").value = aboutData.communityNote;

  renderTeamMembers();
}

el("about-form")?.addEventListener("submit", async (e) => {
  e.preventDefault();
  const btn = el("save-about");
  const feedback = el("about-feedback");
  btn.disabled = true;
  feedback.textContent = "Publishing About Us content…";

  try {
    const payload = {
      heroEyebrow: el("about-hero-eyebrow").value.trim(),
      heroTitle: el("about-hero-title").value.trim(),
      heroP1: el("about-hero-p1").value.trim(),
      heroP2: el("about-hero-p2").value.trim(),
      heroImage: el("about-hero-image").value.trim() || aboutDefaults.heroImage,
      founderEyebrow: el("about-founder-eyebrow").value.trim(),
      founderTitle: el("about-founder-title").value.trim(),
      founderP1: el("about-founder-p1").value.trim(),
      founderP2: el("about-founder-p2").value.trim(),
      founderP3: el("about-founder-p3").value.trim(),
      founderPurpose: el("about-founder-purpose").value.trim(),
      team: aboutData.team,
      val1Title: el("about-val-1-title").value.trim(),
      val1Desc: el("about-val-1-desc").value.trim(),
      val2Title: el("about-val-2-title").value.trim(),
      val2Desc: el("about-val-2-desc").value.trim(),
      val3Title: el("about-val-3-title").value.trim(),
      val3Desc: el("about-val-3-desc").value.trim(),
      val4Title: el("about-val-4-title").value.trim(),
      val4Desc: el("about-val-4-desc").value.trim(),
      communityNote: el("about-community-note").value.trim()
    };

    // Ensure founder name is retained
    if (!payload.founderTitle.includes("Saidi Materu")) {
      payload.founderTitle = "Founded by Saidi Materu.";
    }

    await api("/rest/v1/site_settings?on_conflict=setting_key", {
      method: "POST",
      headers: { "Prefer": "resolution=merge-duplicates,return=minimal" },
      body: JSON.stringify({
        setting_key: "about_us_content",
        setting_value: JSON.stringify(payload),
        updated_at: new Date().toISOString()
      })
    });

    feedback.textContent = "✓ About Us page content published successfully! The public page now displays these updates.";
  } catch (err) {
    feedback.textContent = "Error saving: " + err.message;
  } finally {
    btn.disabled = false;
  }
});

// ================= FAQs LOGIC =================
const defaults = [
  ["Where is Materuni Village?", "Materuni Village is in the Kilimanjaro region of northern Tanzania, near Moshi, on the forested slopes of Mount Kilimanjaro. It is a village visit rather than a town-centre attraction, so agree your transport and pickup point before travelling."],
  ["Which experiences can I book?", "Our five featured experiences are Materuni Waterfall & Chagga Culture ($75), Traditional Coffee Experience ($65), Traditional Chagga Cooking Class ($85), Materuni Camping ($110) and Ultimate ($135), all priced per person."],
  ["How do I make a booking?", "Open the availability page, choose your experience, preferred date and one of the time slots shown for your group size. Enter your contact details and send the request. The selected spaces are held in the availability calendar while the request is pending. We will review it and contact you to confirm the arrangements; it is not a confirmed reservation until you receive confirmation."],
  ["When do I pay?", "There is no live card payment on the website at this stage. After your request is reviewed and arrangements are confirmed, our team will send the payment instructions."],
  ["Are the prices per person?", "Yes. The published prices are per person. Your total estimate depends on the number of guests and the experiences selected."],
  ["Is transport from Moshi included?", "Transport from Moshi is not included in the published experience prices unless we have specifically agreed it with you. Add your hotel or preferred pickup point to the booking form so we can discuss the options before your visit."],
  ["Can I combine more than one experience?", "Yes. Use the itinerary builder to select several experiences and send your suggested plan to a local host. We will review the timing and confirm a practical sequence."],
  ["Are meals included?", "Meal inclusions vary by experience. Check the 'What's included' list on the experience you select. Please tell us about allergies, dietary preferences or food restrictions in your booking notes; we will discuss what can be accommodated before confirming."],
  ["What should I tell you about accessibility or dietary needs?", "Please add mobility, dietary, children’s or other special requirements to the booking notes. We will discuss what can be arranged before confirming."],
  ["Can I change or cancel a booking?", "Send us your booking reference as soon as possible by WhatsApp or email. We will review the booking status and explain the options available. Any change is subject to availability and confirmation by your host."]
];

let faqItems = defaults.map(([question, answer]) => ({ question, answer }));

function renderFaq() {
  const root = el("faq-editor");
  root.replaceChildren();
  faqItems.forEach((item, index) => {
    const card = document.createElement("section");
    card.className = "notice";
    card.style.marginTop = "0.7rem";
    const heading = document.createElement("strong");
    heading.textContent = "Question " + (index + 1);
    const qWrap = document.createElement("div");
    qWrap.className = "field full";
    qWrap.style.marginTop = ".7rem";
    const qLabel = document.createElement("label");
    qLabel.textContent = "Question";
    const q = document.createElement("input");
    q.maxLength = 180;
    q.required = true;
    q.value = item.question;
    q.addEventListener("input", () => item.question = q.value);
    qWrap.append(qLabel, q);

    const aWrap = document.createElement("div");
    aWrap.className = "field full";
    aWrap.style.marginTop = ".7rem";
    const aLabel = document.createElement("label");
    aLabel.textContent = "Answer";
    const a = document.createElement("textarea");
    a.rows = 4;
    a.maxLength = 1200;
    a.required = true;
    a.value = item.answer;
    a.addEventListener("input", () => item.answer = a.value);
    aWrap.append(aLabel, a);

    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "button button-secondary";
    remove.textContent = "Remove question";
    remove.style.marginTop = ".7rem";
    remove.addEventListener("click", () => { faqItems.splice(index, 1); renderFaq(); });

    card.append(heading, qWrap, aWrap, remove);
    root.append(card);
  });
}

async function loadFaq() {
  const rows = await api("/rest/v1/site_settings?select=setting_key,setting_value&setting_key=eq.faq_items");
  if (rows?.[0]?.setting_value) {
    try {
      const parsed = typeof rows[0].setting_value === "string" ? JSON.parse(rows[0].setting_value) : rows[0].setting_value;
      if (Array.isArray(parsed) && parsed.length <= 30 && parsed.every(x => typeof x.question === "string" && typeof x.answer === "string")) faqItems = parsed;
    } catch {
      el("content-feedback").textContent = "Saved FAQ content could not be read. Showing the built-in FAQ copy instead.";
    }
  }
  renderFaq();
}

el("add-faq")?.addEventListener("click", () => {
  if (faqItems.length >= 30) {
    el("content-feedback").textContent = "A maximum of 30 FAQ entries is allowed.";
    return;
  }
  faqItems.push({ question: "", answer: "" });
  renderFaq();
});

el("save-faq")?.addEventListener("click", async () => {
  const button = el("save-faq");
  button.disabled = true;
  el("content-feedback").textContent = "Publishing FAQ content…";
  try {
    faqItems = faqItems.map(x => ({ question: x.question.trim(), answer: x.answer.trim() }));
    if (!faqItems.length || faqItems.some(x => !x.question || !x.answer)) throw new Error("Every FAQ entry needs both a question and an answer.");
    if (faqItems.some(x => x.question.length > 180 || x.answer.length > 1200)) throw new Error("A question or answer is longer than the allowed limit.");
    await api("/rest/v1/site_settings?on_conflict=setting_key", {
      method: "POST",
      headers: { "Prefer": "resolution=merge-duplicates,return=minimal" },
      body: JSON.stringify({ setting_key: "faq_items", setting_value: JSON.stringify(faqItems), updated_at: new Date().toISOString() })
    });
    el("content-feedback").textContent = "✓ Published successfully. The public FAQ page will use the updated content.";
  } catch (error) {
    el("content-feedback").textContent = error.message;
  } finally {
    button.disabled = false;
  }
});

// ================= HOMEPAGE COPY LOGIC =================
const homeCopyFields = { hero_title: "home-hero-title", hero_intro: "home-hero-intro", experiences_title: "home-experiences-title", experiences_intro: "home-experiences-intro", story_title: "home-story-title", story_desc: "home-story-desc", story_desc2: "home-story-desc2" };
async function loadHomeCopy() {
  const ids = Object.keys(homeCopyFields);
  const rows = await api("/rest/v1/site_content?select=id,content&id=in.(" + ids.map(encodeURIComponent).join(",") + ")");
  for (const row of rows) {
    const id = homeCopyFields[row.id];
    if (id && el(id)) el(id).value = row.content || "";
  }
}
el("home-copy-form")?.addEventListener("submit", async event => {
  event.preventDefault();
  const button = el("save-home-copy");
  button.disabled = true;
  el("home-copy-feedback").textContent = "Publishing homepage text…";
  try {
    const rows = Object.entries(homeCopyFields).map(([key, id]) => ({ id: key, content: el(id).value.trim(), updated_at: new Date().toISOString() }));
    if (rows.some(row => !row.content)) throw new Error("Please complete all homepage text fields.");
    await api("/rest/v1/site_content?on_conflict=id", { method: "POST", headers: { "Content-Type": "application/json", "Prefer": "resolution=merge-duplicates,return=minimal" }, body: JSON.stringify(rows) });
    el("home-copy-feedback").textContent = "✓ Homepage copy published successfully.";
  } catch (error) {
    el("home-copy-feedback").textContent = error.message;
  } finally {
    button.disabled = false;
  }
});

// ================= MULTILINGUAL LOGIC =================
const translationKeys = {
  hero_title: { label: "Hero headline", type: "input", max: 120 },
  hero_intro: { label: "Hero introduction", type: "textarea", max: 500 },
  experiences_title: { label: "Experiences heading", type: "input", max: 120 },
  experiences_intro: { label: "Experiences introduction", type: "textarea", max: 500 },
  experiences_page_title: { label: "Experiences page headline", type: "input", max: 140 },
  experiences_page_intro: { label: "Experiences page introduction", type: "textarea", max: 500 }
};
const defaultTranslations = {
  es: { hero_title: "Acércate al corazón de la cultura chagga.", hero_intro: "Descubre la cascada, el café y la vida del pueblo con anfitriones locales en Materuni." },
  fr: { hero_title: "Au cœur de la culture chagga.", hero_intro: "Découvrez la cascade, le café et la vie du village avec des hôtes locaux à Materuni." },
  de: { hero_title: "Erleben Sie das Herz der Chagga-Kultur.", hero_intro: "Entdecken Sie Wasserfall, Kaffee und das Dorfleben mit lokalen Gastgebern in Materuni." }
};
let languageContent = JSON.parse(JSON.stringify(defaultTranslations));
function renderTranslations() {
  const locale = el("translation-language").value, root = el("translation-editor");
  root.replaceChildren();
  Object.entries(translationKeys).forEach(([key, meta]) => {
    const wrap = document.createElement("div");
    wrap.className = "field full";
    const label = document.createElement("label");
    label.textContent = meta.label;
    const field = document.createElement(meta.type === "textarea" ? "textarea" : "input");
    field.id = "translation-" + key;
    field.maxLength = meta.max;
    field.value = languageContent[locale]?.[key] || "";
    if (meta.type === "textarea") field.rows = 3;
    wrap.append(label, field);
    root.append(wrap);
  });
}
async function loadTranslations() {
  const rows = await api("/rest/v1/site_settings?select=setting_key,setting_value&setting_key=eq.language_content");
  if (rows?.[0]?.setting_value) {
    try {
      const parsed = JSON.parse(rows[0].setting_value);
      if (parsed && typeof parsed === "object") languageContent = { ...languageContent, ...parsed };
    } catch {}
  }
  renderTranslations();
}
el("translation-language")?.addEventListener("change", renderTranslations);
el("save-translations")?.addEventListener("click", async () => {
  const button = el("save-translations"), locale = el("translation-language").value;
  button.disabled = true;
  el("translation-feedback").textContent = "Publishing translations…";
  try {
    const next = {};
    for (const [key, meta] of Object.entries(translationKeys)) {
      const value = el("translation-" + key).value.trim();
      if (value.length > meta.max) throw new Error(meta.label + " is too long.");
      next[key] = value;
    }
    languageContent[locale] = { ...(languageContent[locale] || {}), ...next };
    await api("/rest/v1/site_settings?on_conflict=setting_key", {
      method: "POST",
      headers: { "Prefer": "resolution=merge-duplicates,return=minimal" },
      body: JSON.stringify({ setting_key: "language_content", setting_value: JSON.stringify(languageContent), updated_at: new Date().toISOString() })
    });
    renderTranslations();
    el("translation-feedback").textContent = "✓ Translations published for " + locale.toUpperCase();
  } catch (error) {
    el("translation-feedback").textContent = error.message;
  } finally {
    button.disabled = false;
  }
});

// ================= APPROACH LOGIC =================
const approachDefaults = { "title": "Good travel begins with respect for place.", "intro": "A visit to Materuni should feel personal, respectful and grounded in the place itself.", "sectionTitle": "Local culture is not a performance. It is a living way of life.", "sectionIntro": "Rather than rushing from one photo stop to the next, we invite guests to slow down.", "ctaTitle": "Come as a guest. Leave as a friend.", "ctaText": "Discover Materuni at a thoughtful pace." };
const approachFields = { title: "approach-title", intro: "approach-intro", sectionTitle: "approach-section-title", sectionIntro: "approach-section-intro", ctaTitle: "approach-cta-title", ctaText: "approach-cta-text" };
async function loadApproach() {
  const rows = await api("/rest/v1/site_settings?select=setting_key,setting_value&setting_key=eq.approach_content");
  let data = approachDefaults;
  if (rows?.[0]?.setting_value) {
    try {
      const parsed = typeof rows[0].setting_value === "string" ? JSON.parse(rows[0].setting_value) : rows[0].setting_value;
      if (parsed && typeof parsed === "object") data = { ...approachDefaults, ...parsed };
    } catch {}
  }
  for (const [key, id] of Object.entries(approachFields)) if (el(id)) el(id).value = typeof data[key] === "string" ? data[key] : approachDefaults[key];
}
el("approach-form")?.addEventListener("submit", async event => {
  event.preventDefault();
  const button = el("save-approach");
  button.disabled = true;
  el("approach-feedback").textContent = "Publishing…";
  try {
    const data = {};
    for (const [key, id] of Object.entries(approachFields)) {
      data[key] = el(id).value.trim();
      if (!data[key]) throw new Error("Please complete every content field.");
    }
    await api("/rest/v1/site_settings?on_conflict=setting_key", {
      method: "POST",
      headers: { "Prefer": "resolution=merge-duplicates,return=minimal" },
      body: JSON.stringify({ setting_key: "approach_content", setting_value: JSON.stringify(data), updated_at: new Date().toISOString() })
    });
    el("approach-feedback").textContent = "✓ Our Approach page content published successfully.";
  } catch (error) {
    el("approach-feedback").textContent = error.message;
  } finally {
    button.disabled = false;
  }
});

// Admin sign-in
el("login-form")?.addEventListener("submit", async e => {
  e.preventDefault();
  const button = el("login-button");
  button.disabled = true;
  el("login-feedback").textContent = "Verifying administrator…";
  try {
    const response = await fetch(supabaseUrl + "/auth/v1/token?grant_type=password", {
      method: "POST",
      headers: { apikey: publishableKey, "Content-Type": "application/json" },
      body: JSON.stringify({ email: el("admin-email").value.trim(), password: el("admin-password").value })
    });
    const session = await response.json();
    if (!response.ok) throw new Error(session.msg || session.message || "Sign in failed.");
    accessToken = session.access_token;
    const admins = await api("/rest/v1/admin_users?select=user_id&user_id=eq." + encodeURIComponent(session.user.id));
    if (!admins.length) {
      accessToken = "";
      throw new Error("This account is not authorised as an administrator.");
    }
    el("login-panel").hidden = true;
    el("manager").hidden = false;
    await Promise.all([loadAboutUs(), loadFaq(), loadApproach(), loadHomeCopy(), loadTranslations()]);
  } catch (error) {
    el("login-feedback").textContent = error.message;
  } finally {
    button.disabled = false;
  }
});

el("logout")?.addEventListener("click", async () => {
  try {
    await fetch(supabaseUrl + "/auth/v1/logout", { method: "POST", headers: headers() });
  } catch {}
  accessToken = "";
  el("manager").hidden = true;
  el("login-panel").hidden = false;
  el("login-form").reset();
});
</script>

