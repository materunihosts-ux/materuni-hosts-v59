---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Website Content Manager | Materuni Hosts Admin" description="Manage public FAQ content." noindex={true}>
<section class="page-hero"><span class="eyebrow">PRIVATE ADMIN · WEBSITE EDITOR</span><h1>Website content manager</h1><p>Keep guest information accurate and up to date. Changes to FAQs are published to the public website after saving.</p></section>
<section class="booking-wrap">
 <div class="booking-panel" id="login-panel">
  <h2>Administrator sign in</h2><p class="muted">Only approved Materuni Hosts administrators can edit website content.</p>
  <form id="login-form" class="form-grid">
   <div class="field full"><label for="admin-email">Admin email</label><input id="admin-email" type="email" autocomplete="username" required></div>
   <div class="field full"><label for="admin-password">Password</label><input id="admin-password" type="password" autocomplete="current-password" required></div>
   <div class="field full"><button class="button" id="login-button" type="submit">Sign in securely</button><p id="login-feedback" class="muted" aria-live="polite"></p></div>
  </form>
 </div>
 <div id="manager" hidden>
  <div class="booking-panel">
   <div class="section-heading"><div><span class="eyebrow">CONTENT MANAGEMENT</span><h2>Frequently asked questions</h2><p class="muted">Edit the answers guests see on the public FAQ page. Keep wording factual and avoid promising availability or services that have not been confirmed.</p></div><button class="button button-secondary" id="logout" type="button">Sign out</button></div>
   <div class="admin-shortcuts" style="margin-bottom:1.2rem"><a class="button button-secondary" href="/admin/">Dashboard</a><a class="button button-secondary" href="/faq" target="_blank" rel="noopener">Preview public FAQs</a><a class="button button-secondary" href="/admin/settings">Social links</a><a class="button button-secondary" href="/admin/media">Photo library</a></div>
   <div id="faq-editor" class="form-grid"></div>
   <div class="actions" style="margin-top:1.2rem"><button class="button button-secondary" id="add-faq" type="button">Add a question</button><button class="button" id="save-faq" type="button">Publish FAQ changes</button></div>
   <p id="content-feedback" class="muted" aria-live="polite"></p>
  </div>
  <div class="booking-panel" style="margin-top:1.25rem">
   <span class="eyebrow">HOMEPAGE COPY</span><h2>Edit homepage messaging</h2>
   <p class="muted">Update text shown on the homepage. Package prices and booking terms remain controlled by the approved experience catalogue and booking system.</p>
   <form id="home-copy-form" class="form-grid">
    <div class="field full"><label for="home-hero-title">Hero headline</label><input id="home-hero-title" maxlength="120" required></div>
    <div class="field full"><label for="home-hero-intro">Hero introduction</label><textarea id="home-hero-intro" rows="3" maxlength="500" required></textarea></div>
    <div class="field full"><label for="home-experiences-title">Experiences section heading</label><input id="home-experiences-title" maxlength="120" required></div>
    <div class="field full"><label for="home-experiences-intro">Experiences section introduction</label><textarea id="home-experiences-intro" rows="3" maxlength="500" required></textarea></div>
    <div class="field full"><label for="home-story-title">Story section heading</label><input id="home-story-title" maxlength="120" required></div>
    <div class="field full"><label for="home-story-desc">Story section paragraph</label><textarea id="home-story-desc" rows="4" maxlength="900" required></textarea></div>
    <div class="field full"><label for="home-story-desc2">Story section second paragraph</label><textarea id="home-story-desc2" rows="3" maxlength="500" required></textarea></div>
    <div class="field full"><button class="button" id="save-home-copy" type="submit">Publish homepage copy</button><p id="home-copy-feedback" class="muted" aria-live="polite"></p></div>
   </form>
  </div>
  <div class="booking-panel" style="margin-top:1.25rem">
   <span class="eyebrow">MULTILINGUAL CONTENT</span><h2>Homepage translations</h2>
   <p class="muted">Manage translated homepage text for Spanish, French and German. The language selector uses these saved translations; blank fields fall back to English. Translate carefully and keep prices and booking conditions consistent.</p>
   <div class="form-grid">
    <div class="field"><label for="translation-language">Edit language</label><select id="translation-language"><option value="es">Spanish · Español</option><option value="fr">French · Français</option><option value="de">German · Deutsch</option></select></div>
    <div class="field"><label>Translation status</label><p id="translation-status" class="muted" role="status">Load translations after signing in.</p></div>
   </div>
   <div id="translation-editor" class="form-grid" style="margin-top:1rem"></div>
   <div class="actions" style="margin-top:1rem"><button class="button" id="save-translations" type="button">Publish selected language</button></div>
   <p id="translation-feedback" class="muted" aria-live="polite"></p>
  </div>
  <div class="booking-panel" style="margin-top:1.25rem">
   <span class="eyebrow">OUR APPROACH PAGE</span><h2>Edit sustainability & culture content</h2>
   <p class="muted">These fields update the public Our Approach page. Keep the copy grounded in real practices and avoid unsupported environmental or community impact claims.</p>
   <form id="approach-form" class="form-grid">
    <div class="field full"><label for="approach-title">Page headline</label><input id="approach-title" maxlength="120" required></div>
    <div class="field full"><label for="approach-intro">Introduction</label><textarea id="approach-intro" rows="3" maxlength="700" required></textarea></div>
    <div class="field full"><label for="approach-section-title">Main section heading</label><input id="approach-section-title" maxlength="150" required></div>
    <div class="field full"><label for="approach-section-intro">Main section text</label><textarea id="approach-section-intro" rows="4" maxlength="1000" required></textarea></div>
    <div class="field full"><label for="approach-cta-title">Closing heading</label><input id="approach-cta-title" maxlength="120" required></div>
    <div class="field full"><label for="approach-cta-text">Closing text</label><textarea id="approach-cta-text" rows="3" maxlength="500" required></textarea></div>
    <div class="field full"><button class="button" id="save-approach" type="submit">Publish Our Approach changes</button><p id="approach-feedback" class="muted" aria-live="polite"></p></div>
   </form>
  </div>
 </div>
</section>
<script>
// @ts-nocheck
const supabaseUrl="https://sskmzswoeljxwojcszta.supabase.co";
const publishableKey="sb_publishable_G9ru4P_yKzievqiXjXEEbQ_p28cB_NZ";
let accessToken="";
const el=id=>document.getElementById(id);
const defaults=[
["Where is Materuni Village?","Materuni Village is in the Kilimanjaro region of northern Tanzania, near Moshi, on the forested slopes of Mount Kilimanjaro. It is a village visit rather than a town-centre attraction, so agree your transport and pickup point before travelling."],
["Which experiences can I book?","Our six featured experiences are Waterfalls & Coffee Tour ($65), Coffee & Chagga Culture Tour ($50), Cooking & Culture ($70), Waterfall Hike & Cultural Day Trip ($75), Overnight Camping ($110) and Ultimate ($135), all priced per person."],
["How do I make a booking?","Open the availability page, choose your experience, preferred date and one of the time slots shown for your group size. Enter your contact details and send the request. We will review it and contact you to confirm the arrangements. The request itself does not reserve a place."],
["When do I pay?","There is no live card payment on the website at this stage. After your request is reviewed and arrangements are confirmed, our team will send the payment instructions."],
["Are the prices per person?","Yes. The published prices are per person. Your total estimate depends on the number of guests and the experiences selected."],
["Is transport from Moshi included?","Transport from Moshi is not included in the published experience prices unless we have specifically agreed it with you. Add your hotel or preferred pickup point to the booking form so we can discuss the options before your visit."],
["Can I combine more than one experience?","Yes. Use the itinerary builder to select several experiences and send your suggested plan to a local host. We will review the timing and confirm a practical sequence."],
["Are meals included?","Meal inclusions vary by experience. Check the 'What's included' list on the experience you select. Please tell us about allergies, dietary preferences or food restrictions in your booking notes; we will discuss what can be accommodated before confirming."],
["What should I tell you about accessibility or dietary needs?","Please add mobility, dietary, children’s or other special requirements to the booking notes. We will discuss what can be arranged before confirming."],
["Can I change or cancel a booking?","Send us your booking reference as soon as possible by WhatsApp or email. We will review the booking status and explain the options available. Any change is subject to availability and confirmation by your host."]
];
const headers=()=>({apikey:publishableKey,Authorization:"Bearer "+accessToken,"Content-Type":"application/json"});
async function api(path,options={}){const r=await fetch(supabaseUrl+path,{...options,headers:{...headers(),...(options.headers||{})}});const data=await r.json().catch(()=>null);if(!r.ok)throw new Error(data?.message||data?.details||"Request failed.");return data}
let faqItems=defaults.map(([question,answer])=>({question,answer}));
function renderFaq(){
 const root=el("faq-editor");root.replaceChildren();
 faqItems.forEach((item,index)=>{
  const card=document.createElement("section");card.className="notice";card.style.marginTop="0.7rem";
  const heading=document.createElement("strong");heading.textContent="Question "+(index+1);
  const qWrap=document.createElement("div");qWrap.className="field full";qWrap.style.marginTop=".7rem";
  const qLabel=document.createElement("label");qLabel.textContent="Question";const q=document.createElement("input");q.maxLength=180;q.required=true;q.value=item.question;q.setAttribute("aria-label","FAQ question "+(index+1));q.addEventListener("input",()=>item.question=q.value);qWrap.append(qLabel,q);
  const aWrap=document.createElement("div");aWrap.className="field full";aWrap.style.marginTop=".7rem";
  const aLabel=document.createElement("label");aLabel.textContent="Answer";const a=document.createElement("textarea");a.rows=4;a.maxLength=1200;a.required=true;a.value=item.answer;a.setAttribute("aria-label","FAQ answer "+(index+1));a.addEventListener("input",()=>item.answer=a.value);aWrap.append(aLabel,a);
  const remove=document.createElement("button");remove.type="button";remove.className="button button-secondary";remove.textContent="Remove question";remove.style.marginTop=".7rem";remove.addEventListener("click",()=>{faqItems.splice(index,1);renderFaq()});
  card.append(heading,qWrap,aWrap,remove);root.append(card);
 });
}

const approachDefaults={"title":"Good travel begins with respect for place.","intro":"A visit to Materuni should feel personal, respectful and grounded in the place itself. Our approach is to create space for guests to learn from local hosts, take part in everyday traditions and enjoy the landscape without treating the village as a backdrop.","sectionTitle":"Local culture is not a performance. It is a living way of life.","sectionIntro":"Rather than rushing from one photo stop to the next, we invite guests to slow down: learn how coffee is prepared, share food, ask questions and hear about the customs and stories that give Materuni its character. Each visit is an opportunity for exchange, with respect for the people and places involved.","ctaTitle":"Come as a guest. Leave as a friend.","ctaText":"Discover Materuni at a thoughtful pace, with a warm welcome from local hosts."};
const approachFields={title:"approach-title",intro:"approach-intro",sectionTitle:"approach-section-title",sectionIntro:"approach-section-intro",ctaTitle:"approach-cta-title",ctaText:"approach-cta-text"};

const homeCopyFields={hero_title:"home-hero-title",hero_intro:"home-hero-intro",experiences_title:"home-experiences-title",experiences_intro:"home-experiences-intro",story_title:"home-story-title",story_desc:"home-story-desc",story_desc2:"home-story-desc2"};
async function loadHomeCopy(){
 const ids=Object.keys(homeCopyFields);
 const rows=await api("/rest/v1/site_content?select=id,content&id=in.("+ids.map(encodeURIComponent).join(",")+")");
 for(const row of rows){const id=homeCopyFields[row.id];if(id)el(id).value=row.content||""}
}
el("home-copy-form").addEventListener("submit",async event=>{
 event.preventDefault();const button=el("save-home-copy");button.disabled=true;el("home-copy-feedback").textContent="Publishing homepage text…";
 try{
  const rows=Object.entries(homeCopyFields).map(([key,id])=>({id:key,content:el(id).value.trim(),updated_at:new Date().toISOString()}));
  if(rows.some(row=>!row.content))throw new Error("Please complete all homepage text fields.");
  await api("/rest/v1/site_content?on_conflict=id",{method:"POST",headers:{"Content-Type":"application/json","Prefer":"resolution=merge-duplicates,return=minimal"},body:JSON.stringify(rows)});
  el("home-copy-feedback").textContent="Homepage copy published successfully.";
 }catch(error){el("home-copy-feedback").textContent=error.message}finally{button.disabled=false}
});

const translationKeys={
 hero_title:{label:"Hero headline",type:"input",max:120},
 hero_intro:{label:"Hero introduction",type:"textarea",max:500},
 experiences_title:{label:"Experiences heading",type:"input",max:120},
 experiences_intro:{label:"Experiences introduction",type:"textarea",max:500},
 story_title:{label:"Story heading",type:"input",max:120},
 story_desc:{label:"Story paragraph",type:"textarea",max:900},
 story_desc2:{label:"Story second paragraph",type:"textarea",max:500}
};
let languageContent={es:{},fr:{},de:{}};
function renderTranslations(){
 const locale=el("translation-language").value,root=el("translation-editor");root.replaceChildren();
 Object.entries(translationKeys).forEach(([key,meta])=>{
  const wrap=document.createElement("div");wrap.className="field full";
  const label=document.createElement("label");label.textContent=meta.label;
  const field=document.createElement(meta.type==="textarea"?"textarea":"input");field.id="translation-"+key;field.maxLength=meta.max;field.value=languageContent[locale]?.[key]||"";
  if(meta.type==="textarea")field.rows=3;
  wrap.append(label,field);root.append(wrap);
 });
 el("translation-status").textContent=Object.values(translationKeys).filter((_,i)=>Boolean(languageContent[locale]?.[Object.keys(translationKeys)[i]]?.trim())).length+" of "+Object.keys(translationKeys).length+" fields translated";
}
async function loadTranslations(){
 const rows=await api("/rest/v1/site_settings?select=setting_key,setting_value&setting_key=eq.language_content");
 if(rows?.[0]?.setting_value){try{const parsed=JSON.parse(rows[0].setting_value);if(parsed&&typeof parsed==="object")languageContent={...languageContent,...parsed}}catch{el("translation-feedback").textContent="Saved translations could not be read."}}
 renderTranslations();
}
el("translation-language").addEventListener("change",renderTranslations);
el("save-translations").addEventListener("click",async()=>{
 const button=el("save-translations"),locale=el("translation-language").value;button.disabled=true;el("translation-feedback").textContent="Publishing translations…";
 try{
  const next={};for(const [key,meta] of Object.entries(translationKeys)){const value=el("translation-"+key).value.trim();if(value.length>meta.max)throw new Error(meta.label+" is too long.");next[key]=value}
  languageContent[locale]=next;
  await api("/rest/v1/site_settings?on_conflict=setting_key",{method:"POST",headers:{"Prefer":"resolution=merge-duplicates,return=minimal"},body:JSON.stringify({setting_key:"language_content",setting_value:JSON.stringify(languageContent),updated_at:new Date().toISOString()})});
  renderTranslations();el("translation-feedback").textContent="Translations published. Visitors selecting "+locale.toUpperCase()+" will see the saved homepage copy.";
 }catch(error){el("translation-feedback").textContent=error.message}finally{button.disabled=false}
});
async function loadApproach(){
 const rows=await api("/rest/v1/site_settings?select=setting_key,setting_value&setting_key=eq.approach_content");
 let data=approachDefaults;
 if(rows?.[0]?.setting_value){try{const parsed=JSON.parse(rows[0].setting_value);if(parsed&&typeof parsed==="object")data={...approachDefaults,...parsed}}catch{}}
 for(const [key,id] of Object.entries(approachFields))el(id).value=typeof data[key]==="string"?data[key]:approachDefaults[key];
}
el("approach-form").addEventListener("submit",async event=>{
 event.preventDefault();const button=el("save-approach");button.disabled=true;el("approach-feedback").textContent="Publishing page content…";
 try{
  const data={};for(const [key,id] of Object.entries(approachFields)){data[key]=el(id).value.trim();if(!data[key])throw new Error("Please complete every content field.");}
  await api("/rest/v1/site_settings?on_conflict=setting_key",{method:"POST",headers:{"Prefer":"resolution=merge-duplicates,return=minimal"},body:JSON.stringify({setting_key:"approach_content",setting_value:JSON.stringify(data),updated_at:new Date().toISOString()})});
  el("approach-feedback").textContent="Our Approach page content published successfully.";
 }catch(error){el("approach-feedback").textContent=error.message}finally{button.disabled=false}
});

async function loadFaq(){
 const rows=await api("/rest/v1/site_settings?select=setting_key,setting_value&setting_key=eq.faq_items");
 if(rows?.[0]?.setting_value){try{const parsed=JSON.parse(rows[0].setting_value);if(Array.isArray(parsed)&&parsed.length<=30&&parsed.every(x=>typeof x.question==="string"&&typeof x.answer==="string"))faqItems=parsed}catch{el("content-feedback").textContent="Saved FAQ content could not be read. Showing the built-in FAQ copy instead."}}
 renderFaq();
}
el("login-form").addEventListener("submit",async e=>{
 e.preventDefault();const button=el("login-button");button.disabled=true;el("login-feedback").textContent="Verifying administrator…";
 try{
  const response=await fetch(supabaseUrl+"/auth/v1/token?grant_type=password",{method:"POST",headers:{apikey:publishableKey,"Content-Type":"application/json"},body:JSON.stringify({email:el("admin-email").value.trim(),password:el("admin-password").value})});
  const session=await response.json();if(!response.ok)throw new Error(session.msg||session.message||"Sign in failed.");
  accessToken=session.access_token;
  const admins=await api("/rest/v1/admin_users?select=user_id&user_id=eq."+encodeURIComponent(session.user.id));
  if(!admins.length){accessToken="";throw new Error("This account is not authorised as an administrator.");}
  el("login-panel").hidden=true;el("manager").hidden=false;await Promise.all([loadFaq(),loadApproach(),loadHomeCopy(),loadTranslations()]);
 }catch(error){el("login-feedback").textContent=error.message}finally{button.disabled=false}
});
el("add-faq").addEventListener("click",()=>{if(faqItems.length>=30){el("content-feedback").textContent="A maximum of 30 FAQ entries is allowed.";return}faqItems.push({question:"",answer:""});renderFaq()});
el("save-faq").addEventListener("click",async()=>{
 const button=el("save-faq");button.disabled=true;el("content-feedback").textContent="Publishing FAQ content…";
 try{
  faqItems=faqItems.map(x=>({question:x.question.trim(),answer:x.answer.trim()}));
  if(!faqItems.length||faqItems.some(x=>!x.question||!x.answer))throw new Error("Every FAQ entry needs both a question and an answer.");
  if(faqItems.some(x=>x.question.length>180||x.answer.length>1200))throw new Error("A question or answer is longer than the allowed limit.");
  await api("/rest/v1/site_settings?on_conflict=setting_key",{method:"POST",headers:{"Prefer":"resolution=merge-duplicates,return=minimal"},body:JSON.stringify({setting_key:"faq_items",setting_value:JSON.stringify(faqItems),updated_at:new Date().toISOString()})});
  el("content-feedback").textContent="Published successfully. The public FAQ page will use the updated content.";
 }catch(error){el("content-feedback").textContent=error.message}finally{button.disabled=false}
});
el("logout").addEventListener("click",async()=>{try{await fetch(supabaseUrl+"/auth/v1/logout",{method:"POST",headers:headers()})}catch{}accessToken="";el("manager").hidden=true;el("login-panel").hidden=false;el("login-form").reset()});
</script>
</SiteLayout>
