---
import SiteLayout from "../layouts/SiteLayout.astro";
import { supabaseUrl } from "../lib/supabase-public";
const base = `${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const hero = base + "waterfall_image/1791601414950-ew7ak42gjka.jpg";
---
<SiteLayout title="Materuni Day Trips | Waterfall, Coffee & Chagga Culture" description="Plan a day trip in Materuni Village near Moshi. Explore the 95-metre waterfall, Chagga coffee traditions, local cooking and village culture with local hosts." preloadImage={hero}>
<style>
.day{color:#30372f}.hero{position:relative;min-height:560px;display:flex;align-items:flex-end;background:#1a3322 center/cover no-repeat}.hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,31,21,.88),rgba(12,31,21,.32) 70%)}.hero-copy{position:relative;z-index:1;padding:clamp(46px,8vw,105px);max-width:850px;color:white}.kicker{font:800 10px/1.5 Manrope,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#e2c68c}.hero h1{color:white;font-size:clamp(46px,6.5vw,78px);line-height:.98;max-width:11ch;margin:18px 0}.hero p{color:#edf0e9;max-width:60ch;line-height:1.85}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:22px}.actions .button{min-height:52px}.intro{padding:34px 22px;text-align:center;background:#f5f0e7}.intro p{max-width:760px;margin:auto;color:#657066;line-height:1.85}.section{padding:clamp(52px,7vw,90px) clamp(22px,7vw,100px)}.heading{text-align:center;max-width:760px;margin:0 auto 36px}.heading h2{font-size:clamp(34px,4.5vw,54px);margin:12px auto}.heading p{color:#687168;line-height:1.85;margin:0 auto}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;max-width:1180px;margin:auto}.card{display:grid;grid-template-columns:minmax(175px,.8fr) minmax(0,1.2fr);background:white;border:1px solid #e5ded2;border-radius:16px;overflow:hidden;box-shadow:0 10px 28px #1a33220d}.card img{width:100%;height:100%;min-height:320px;object-fit:cover}.body{padding:22px;display:flex;flex-direction:column;align-items:flex-start}.body h3{font-size:28px;margin:10px 0}.price{font:600 32px Cormorant Garamond,serif;color:#1a3322}.price small{font:800 9px Manrope,sans-serif;letter-spacing:.12em;color:#687168}.body p{font-size:13px;color:#657066;line-height:1.75}.body ul{padding-left:18px;color:#526054;font-size:12px;line-height:1.8}.body .button{margin-top:auto;min-height:48px}.note{max-width:1000px;margin:25px auto 0;color:#737970;font-size:12px;line-height:1.75}.cross-sell{max-width:1180px;margin:30px auto 0;padding:26px 30px;display:flex;align-items:center;justify-content:space-between;gap:20px;background:#fff;border:1px solid #e2d9ca;border-left:4px solid #c5a059;border-radius:12px}.cross-sell h3{font:600 26px Cormorant Garamond,serif;color:#1a3322;margin:0 0 5px}.cross-sell p{font-size:13px;color:#657066;line-height:1.7;margin:0}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1100px;margin:auto}.steps article{padding:25px;background:#f4efe6;border:1px solid #e7dfd2;border-radius:14px}.steps b{font:600 28px Cormorant Garamond,serif;color:#a27b3e}.steps h3{font-size:23px;margin:9px 0}.steps p{color:#667168;font-size:13px;line-height:1.8}.faq{max-width:850px;margin:auto}.faq details{padding:18px 0;border-bottom:1px solid #e4ddd1}.faq summary{font-weight:800;color:#1a3322;cursor:pointer}.faq details p{color:#687168;line-height:1.8}.final{background:#1a3322;color:white;text-align:center;padding:70px 22px}.final h2{color:white;font-size:clamp(36px,5vw,56px);max-width:17ch;margin:0 auto 14px}.final p{color:#e1e7e0;margin:0 auto;line-height:1.8}@media(max-width:1000px){.grid{grid-template-columns:1fr}.card{grid-template-columns:minmax(170px,.7fr) minmax(0,1.3fr)}}@media(max-width:680px){.cross-sell{display:block;padding:22px}.cross-sell .button{display:flex;margin-top:15px;justify-content:center}.hero{min-height:560px}.hero-copy{padding:52px 22px}.card{grid-template-columns:1fr}.card img{height:225px;min-height:0}.steps{grid-template-columns:1fr}.actions{display:grid}.actions .button{width:100%}.section{padding-inline:20px}}
</style>
<div class="day">
<section class="hero" aria-labelledby="day-title" style={`background-image:url("${hero}")`}><div class="hero-copy"><span class="kicker">WATERFALL · COFFEE · CHAGGA CULTURE</span><h1 id="day-title">A day in Materuni, made memorable.</h1><p>Walk to a forest waterfall, learn how Chagga coffee is prepared, taste local food and meet the people who make Materuni special. Choose the experience that fits your day, then let your local host help with the details.</p><div class="actions"><a class="button light" href="#day-trip-options">Explore day trips</a><a class="button secondary" href="/booking">Check availability</a></div></div></section>
<section class="intro"><p>All experiences take place in and around Materuni Village, near Moshi in the Kilimanjaro foothills. Published prices are per person; transport is arranged separately unless agreed with your host.</p></section>
<section class="section" id="day-trip-options"><div class="heading"><span class="kicker">FIND YOUR MATERUNI MOMENT</span><h2>Choose the day trip that feels like you.</h2><p>From the waterfall trail to hands-on coffee and cooking, each visit offers a different way to connect with village life.</p></div><div class="grid">
<article class="card"><img src={hero} alt="Materuni Waterfall and forest trail" loading="lazy" width="640" height="520"><div class="body"><span class="kicker">SIGNATURE DAY TRIP</span><h3>Waterfall Hike & Cultural Day Trip</h3><div class="price">$75 <small>PER PERSON</small></div><p>A fuller Materuni day combining the rainforest waterfall hike with coffee, village culture and a relaxed local lunch.</p><ul><li>Guided hike to the 95-metre waterfall</li><li>Chagga coffee experience</li><li>Local lunch and traditional dance</li></ul><a class="button" href="/booking?experience=Materuni%20Waterfall%20Hike%20%26%20Cultural%20Day%20Trip">Choose this day trip</a></div></article>
<article class="card"><img src={base+"coffee_image/1791601540965-5mt58f2ipoe.jpg"} alt="Traditional Chagga coffee preparation" loading="lazy" width="640" height="520"><div class="body"><span class="kicker">CULTURE & COFFEE</span><h3>Traditional Coffee Experience</h3><div class="price">$65 <small>PER PERSON</small></div><p>Discover the journey from bean to cup through local coffee traditions, village nature and time with your hosts.</p><ul><li>Roast, grind and brew coffee</li><li>Guided village nature walk</li><li>Traditional dance and local lunch</li></ul><a class="button" href="/booking?experience=Traditional%20Coffee%20Experience">Choose coffee experience</a></div></article>
<article class="card"><img src={base+"cooking_image/1791601646297-7th6jahyw0w.jpg"} alt="Traditional Chagga cooking with local hosts" loading="lazy" width="640" height="520"><div class="body"><span class="kicker">HANDS-ON FOOD CULTURE</span><h3>Traditional Chagga Cooking Class</h3><div class="price">$85 <small>PER PERSON</small></div><p>Join your hosts in preparing local dishes and learn about the ingredients, methods and traditions behind Chagga food.</p><ul><li>Traditional firewood cooking</li><li>Prepare local dishes with hosts</li><li>Coffee-making and village culture</li></ul><a class="button" href="/booking?experience=Traditional%20Chagga%20Cooking%20Class">Choose cooking class</a></div></article>
<article class="card"><img src={base+"culturalday_image/1791604657693-kcwbk80tcfs.jpg"} alt="Guided cultural day in Materuni Village" loading="lazy" width="640" height="520"><div class="body"><span class="kicker">WATERFALL & VILLAGE LIFE</span><h3>Materuni Waterfall & Chagga Culture</h3><div class="price">$75 <small>PER PERSON</small></div><p>Combine a guided walk to the waterfall with a bean-to-cup coffee experience and an introduction to Chagga traditions.</p><ul><li>Guided rainforest waterfall hike</li><li>Hands-on coffee-making</li><li>Traditional songs, dance and local lunch</li></ul><a class="button" href="/booking?experience=Waterfall%20%26%20Chagga%20Culture">Choose this experience</a></div></article>
</div><aside class="cross-sell"><div><h3>Have more time? Make it an overnight stay.</h3><p>Stay in the village, share local food and enjoy a slower Materuni experience around camp.</p></div><a class="button" href="/camping">Discover Materuni Camping</a></aside><p class="note">Prices are per person. Exact inclusions can vary by package; review details with your host before confirming. Transport, personal purchases and tips are not included unless agreed separately. Swimming at the waterfall depends on conditions and should only be attempted when safe.</p></section>
<section class="section" style="background:#f5f0e7"><div class="heading"><span class="kicker">SIMPLE FROM FIRST MESSAGE TO ARRIVAL</span><h2>How planning your visit works</h2></div><div class="steps"><article><b>01</b><h3>Choose your experience</h3><p>Select a day trip and tell us your preferred date, group size and interests.</p></article><article><b>02</b><h3>Confirm the details</h3><p>Your local host checks availability and discusses pickup, timing, dietary needs and extras.</p></article><article><b>03</b><h3>Enjoy Materuni</h3><p>Arrive in the village and enjoy your chosen experience with your local hosts.</p></article></div></section>
<section class="section"><div class="heading"><span class="kicker">QUESTIONS BEFORE YOU BOOK?</span><h2>Useful things to know</h2></div><div class="faq"><details><summary>How long does a Materuni day trip take?</summary><p>Duration depends on the experience, walking pace and time you wish to spend in the village. Tell us how much time you have and we can suggest a suitable option.</p></details><details><summary>Can I combine the waterfall and coffee tour?</summary><p>Yes. The Waterfall Hike & Cultural Day Trip combines the guided waterfall walk with coffee and cultural activities.</p></details><details><summary>Is transport included?</summary><p>Transport is not included in published package prices unless arranged separately. Share your pickup point when you enquire.</p></details><details><summary>Can you accommodate dietary needs?</summary><p>Please tell us about dietary requirements or allergies in your booking request so your host can discuss arrangements before confirming.</p></details></div></section>
<section class="final"><span class="kicker">YOUR DAY, YOUR WAY</span><h2>Make a little space for Materuni.</h2><p>Tell us which experience caught your eye. We will help you check the date and plan your visit.</p><div class="actions" style="justify-content:center"><a class="button light" href="/booking">Check day-trip availability</a><a class="button secondary" href="https://wa.me/255612068540" target="_blank" rel="noopener noreferrer">Ask a local host</a></div></section>
</div>
</SiteLayout>