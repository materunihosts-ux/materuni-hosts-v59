---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image, getImage } from "astro:assets";
import { supabaseUrl } from "../lib/supabase-public";
const base = `${supabaseUrl}/storage/v1/object/public/materuni-images/`;
const heroSource = base + "culturalday_image/1791994608797-materuni-waterfall-hike-trail.jpg";
const heroOptimized = await getImage({ src: heroSource, width: 1200, height: 800, format: "webp", quality: 76 });
const hero = heroOptimized.src;
---
<SiteLayout title="Materuni Day Trips | Waterfall, Coffee, Cooking & Culture" description="Explore Materuni day trips near Moshi: waterfall hikes, Chagga coffee, cooking, Moshi town tours and Rau Forest nature walks with local hosts." preloadImage={hero}>
<style>.group-discount-panel{max-width:1180px;margin:30px auto;padding:28px;background:#f4efe6;border:1px solid #e3dacb;border-radius:16px}.group-discount-heading{text-align:center;max-width:680px;margin:0 auto 22px}.group-discount-heading .eyebrow{color:#755523;font:800 10px/1.5 Manrope,sans-serif;letter-spacing:.16em}.group-discount-heading h3{margin:8px 0;color:#1a3322;font:600 clamp(27px,3vw,36px) "Cormorant Garamond",serif}.group-discount-heading p,.group-discount-foot{color:#657066;font-size:13px;line-height:1.75}.group-discount-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.group-discount-grid>div{display:flex;flex-direction:column;justify-content:center;gap:7px;min-height:92px;padding:14px 10px;text-align:center;background:#fff;border:1px solid #e5ded2;border-radius:12px}.group-discount-grid strong{color:#1a3322;font-size:14px}.group-discount-grid span{color:#657066;font-size:12px;line-height:1.45}.group-discount-grid .group-custom{background:#1a3322;border-color:#1a3322}.group-discount-grid .group-custom strong,.group-discount-grid .group-custom span{color:#fff}.group-discount-foot{margin:18px 0 12px;text-align:center}.group-discount-panel>.button{display:flex;width:max-content;max-width:100%;min-height:46px;align-items:center;justify-content:center;margin:0 auto;padding:0 22px}@media(max-width:760px){.group-discount-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.group-discount-grid .group-custom{grid-column:1/-1}.group-discount-panel{padding:20px;margin:24px 0}}
.day{color:#30372f}.hero{position:relative;min-height:560px;display:flex;align-items:flex-end;background:#1a3322 center/cover no-repeat}.hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,31,21,.88),rgba(12,31,21,.32) 70%)}.hero-copy{position:relative;z-index:1;padding:clamp(46px,8vw,105px);max-width:850px;color:white}.kicker{font:800 10px/1.5 Manrope,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#e2c68c}.hero h1{color:white;font-size:clamp(46px,6.5vw,78px);line-height:.98;max-width:11ch;margin:18px 0}.hero p{color:#edf0e9;max-width:60ch;line-height:1.85}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:22px}.actions .button{min-height:52px}.intro{padding:34px 22px;text-align:center;background:#f5f0e7}.intro p{max-width:760px;margin:auto;color:#657066;line-height:1.85}.section{padding:clamp(52px,7vw,90px) clamp(22px,7vw,100px)}.heading{text-align:center;max-width:760px;margin:0 auto 36px}.heading h2{font-size:clamp(34px,4.5vw,54px);margin:12px auto}.heading p{color:#687168;line-height:1.85;margin:0 auto}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;max-width:1180px;margin:auto}.card{display:grid;grid-template-columns:minmax(175px,.8fr) minmax(0,1.2fr);background:white;border:1px solid #e5ded2;border-radius:16px;overflow:hidden;box-shadow:0 10px 28px #1a33220d}.card.no-image{grid-template-columns:1fr}.card img{width:100%;height:100%;min-height:320px;object-fit:cover}.body{padding:22px;display:flex;flex-direction:column;align-items:flex-start}.body h3{font-size:28px;margin:10px 0}.price{font:600 32px Cormorant Garamond,serif;color:#1a3322}.price small{font:800 9px Manrope,sans-serif;letter-spacing:.12em;color:#687168}.body p{font-size:13px;color:#657066;line-height:1.75}.body ul{padding-left:18px;color:#526054;font-size:12px;line-height:1.8}.body .button{margin-top:auto;min-height:48px}.note{max-width:1000px;margin:25px auto 0;color:#737970;font-size:12px;line-height:1.75}.cross-sell{max-width:1180px;margin:30px auto 0;padding:26px 30px;display:flex;align-items:center;justify-content:space-between;gap:20px;background:#fff;border:1px solid #e2d9ca;border-left:4px solid #c5a059;border-radius:12px}.cross-sell h3{font:600 26px Cormorant Garamond,serif;color:#1a3322;margin:0 0 5px}.cross-sell p{font-size:13px;color:#657066;line-height:1.7;margin:0}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1100px;margin:auto}.steps article{padding:25px;background:#f4efe6;border:1px solid #e7dfd2;border-radius:14px}.steps b{font:600 28px Cormorant Garamond,serif;color:#a27b3e}.steps h3{font-size:23px;margin:9px 0}.steps p{color:#667168;font-size:13px;line-height:1.8}.faq{max-width:850px;margin:auto}.faq details{padding:18px 0;border-bottom:1px solid #e4ddd1}.faq summary{font-weight:800;color:#1a3322;cursor:pointer}.faq details p{color:#687168;line-height:1.8}.final{background:#1a3322;color:white;text-align:center;padding:70px 22px}.final h2{color:white;font-size:clamp(36px,5vw,56px);max-width:17ch;margin:0 auto 14px}.final p{color:#e1e7e0;margin:0 auto;line-height:1.8}@media(max-width:1000px){.grid{grid-template-columns:1fr}.card{grid-template-columns:minmax(170px,.7fr) minmax(0,1.3fr)}}@media(max-width:680px){.cross-sell{display:block;padding:22px}.cross-sell .button{display:flex;margin-top:15px;justify-content:center}.hero{min-height:560px}.hero-copy{padding:52px 22px}.card{grid-template-columns:1fr}.card img{height:225px;min-height:0}.steps{grid-template-columns:1fr}.actions{display:grid}.actions .button{width:100%}.section{padding-inline:20px}}
</style>
<div class="day">
<section class="hero" aria-labelledby="day-title" style={`background-image:url("${hero}")`}><div class="hero-copy"><span class="kicker" data-i18n="day_eyebrow">WATERFALL · COFFEE · CHAGGA CULTURE</span><h1 id="day-title" data-i18n="day_title">A day in Materuni, made memorable.</h1><p data-i18n="day_intro">Walk to a forest waterfall, learn how Chagga coffee is prepared, taste local food and meet the people who make Materuni special. Choose the experience that fits your day, then let your local host help with the details.</p><div class="actions"><a class="button light" href="#day-trip-options" data-i18n="day_explore_cta">Explore day trips</a><a class="button secondary" href="/booking?source=day-trips" data-i18n="day_check_cta">Check availability</a></div></div></section>
<section class="intro"><p data-i18n="day_intro_band">All experiences take place in and around Materuni Village, near Moshi in the Kilimanjaro foothills. Published prices are per person; transport is arranged separately unless agreed with your host.</p></section>
<section class="section" id="day-trip-options"><div class="heading"><span class="kicker">FIND YOUR MATERUNI MOMENT</span><h2 data-i18n="day_options_title">Choose the day trip that feels like you.</h2><p data-i18n="day_options_intro">From the waterfall trail to hands-on coffee and cooking, each visit offers a different way to connect with village life.</p></div><div class="grid">
<article class="card" data-experience-key="Traditional Coffee Experience"><Image src={base+"coffee_image/1791994933291-materuni-coffe-picking-lesson.jpg"} alt="Coffee picking lesson in the Materuni coffee-growing area" loading="lazy" decoding="async" width={640} height={520} format="webp" quality={76} /><div class="body"><span class="kicker">CULTURE & COFFEE</span><h3 data-i18n="day_coffee_title">Coffee</h3><div class="price">$41 <small>PER PERSON</small></div><p class="product-best-for" data-i18n="day_duration_coffee">Duration · 4–5 hours</p><p>Discover the journey from bean to cup through local coffee traditions, village nature and time with your hosts.</p><ul><li>Roast, grind and brew coffee</li><li>Guided village nature walk</li><li>Traditional dance and local lunch</li></ul><a class="button" href="/booking?source=day-trips&experience=Traditional%20Coffee%20Experience">Choose coffee experience</a></div></article>
<article class="card no-image" data-experience-key="Traditional Chagga Cooking Class"><div class="body"><span class="kicker">HANDS-ON FOOD CULTURE</span><h3 data-i18n="day_cooking_title">Cooking</h3><div class="price">$55 <small>PER PERSON</small></div><p class="product-best-for" data-i18n="day_duration_cooking">Duration · 5–6 hours</p><p>Join your hosts in preparing local dishes and learn about the ingredients, methods and traditions behind Chagga food.</p><ul><li>Traditional firewood cooking</li><li>Prepare local dishes with hosts</li><li>Coffee-making and village culture</li></ul><a class="button" href="/booking?source=day-trips&experience=Traditional%20Chagga%20Cooking%20Class">Choose cooking class</a></div></article>
<article class="card" data-experience-key="Waterfall & Chagga Culture"><Image src={base+"waterfall_image/1791998303073-materuni-waterfall-hike.jpg"} alt="Materuni Waterfall and Chagga cultural day" loading="lazy" decoding="async" width={640} height={520} format="webp" quality={76} /><div class="body"><span class="kicker">SIGNATURE WATERFALL DAY</span><h3 data-i18n="day_culture_title">Waterfall + Culture</h3><div class="price">$45 <small>PER PERSON</small></div><p class="product-best-for" data-i18n="day_duration_waterfall">Duration · 7–8 hours</p><p>Spend a full day discovering Materuni at a thoughtful pace: follow a guided forest trail to the waterfall, learn Chagga coffee traditions, enjoy local food and make time for village culture.</p><ul><li>Guided forest hike to Materuni Waterfall</li><li>Chagga coffee-making and tasting</li><li>Village culture, traditional dance and local lunch</li></ul><a class="button" href="/booking?source=day-trips&experience=Waterfall%20%26%20Chagga%20Culture">Choose this day experience</a></div></article>
</div><aside class="group-discount-panel" aria-labelledby="group-discount-title"><div class="group-discount-heading"><span class="eyebrow">SAVE MORE AS A GROUP</span><h3 id="group-discount-title">Direct group discounts</h3><p>Your discount is applied automatically to the per-person package price when you book.</p></div><div class="group-discount-grid"><div><strong>1–3 guests</strong><span>Standard rate</span></div><div><strong>4–5 guests</strong><span>5% off per person</span></div><div><strong>6–9 guests</strong><span>8% off per person</span></div><div><strong>10–14 guests</strong><span>10% off per person</span></div><div class="group-custom"><strong>15+ guests</strong><span>Custom group quotation</span></div></div><p class="group-discount-foot">See your discounted price per guest, total group savings and estimated group total in the booking form. These direct discounts do not apply to STO rates. Transport and separately agreed extras are excluded.</p><a class="button" href="/booking">Check your group price</a></aside><aside class="cross-sell"><div><h3 data-i18n="day_cross_title">Have more time? Make it an overnight stay.</h3><p data-i18n="day_cross_intro">Stay in the village, share local food and enjoy a slower Materuni experience around camp.</p></div><a class="button" href="/camping" data-i18n="day_cross_cta">Discover Materuni Camping</a></aside><p class="note">Door-to-door private transfers from Moshi ($25/vehicle), KIA ($50/vehicle) or Arusha ($80/vehicle) can be selected directly when booking. Your host confirms the final amount before payment. Swimming at the waterfall depends on conditions and should only be attempted when safe.</p></section>
<section class="section" style="background:#f5f0e7"><div class="heading"><span class="kicker">SIMPLE FROM FIRST MESSAGE TO ARRIVAL</span><h2 data-i18n="day_steps_title">How planning your visit works</h2></div><div class="steps"><article><b>01</b><h3 data-i18n="day_step_one">Choose your experience</h3><p data-i18n="day_step_one_body">Select a day trip and tell us your preferred date, group size and interests.</p></article><article><b>02</b><h3 data-i18n="day_step_two">Confirm the details</h3><p data-i18n="day_step_two_body">Your local host checks availability and discusses pickup, timing, dietary needs and extras.</p></article><article><b>03</b><h3 data-i18n="day_step_three">Enjoy Materuni</h3><p data-i18n="day_step_three_body">Arrive in the village and enjoy your chosen experience with your local hosts.</p></article></div></section>
<section class="section"><div class="heading"><span class="kicker">QUESTIONS BEFORE YOU BOOK?</span><h2 data-i18n="day_faq_title">Useful things to know</h2></div><div class="faq"><details><summary>How long does the Materuni waterfall and culture day take?</summary><p>Allow 7–8 hours for the combined waterfall and Chagga culture day. The coffee experience takes around 4–5 hours and the cooking class around 5–6 hours. Your host will confirm the practical schedule for your date.</p></details><details><summary>Can I combine the waterfall and coffee tour?</summary><p>Yes. Materuni Waterfall & Chagga Culture combines the guided waterfall walk with coffee and cultural activities.</p></details><details><summary>Is transport included?</summary><p>Transport is not included in published package prices unless arranged separately. Share your pickup point when you enquire.</p></details><details><summary>Can you accommodate dietary needs?</summary><p>Please tell us about dietary requirements or allergies in your booking request so your host can discuss arrangements before confirming.</p></details></div></section>
<section class="final"><span class="kicker">YOUR DAY, YOUR WAY</span><h2 data-i18n="day_final_title">Make a little space for Materuni.</h2><p data-i18n="day_final_intro">Tell us which experience caught your eye. We will help you check the date and plan your visit.</p><div class="actions" style="justify-content:center"><a class="button light" href="/booking?source=day-trips" data-i18n="day_final_cta">Check day-trip availability</a><a class="button secondary" href="https://wa.me/255612068540?text=Hello%20Materuni%20Hosts%2C%20I%27m%20interested%20in%20Materuni%20day%20trips.%20Please%20share%20the%20options. " target="_blank" rel="noopener noreferrer">Ask a local host</a></div></section>
</div>
<style>
.product-best-for{margin:.35rem 0 .8rem;color:#1a3322;font-size:12px;font-weight:700;line-height:1.6}
.group-discount-panel{margin-top:30px}.shared-standard{max-width:1180px;margin:28px auto 0;padding:24px 28px;background:#f4efe6;border:1px solid #e6dfd3;border-radius:16px}
.shared-standard h3{margin:0 0 14px;color:#1a3322;font:600 clamp(22px,3vw,30px) "Cormorant Garamond",serif}
.shared-standard ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 24px;margin:0;padding-left:18px;color:#425347;font-size:13px;line-height:1.7}
@media(max-width:620px){.shared-standard{padding:20px}.shared-standard ul{grid-template-columns:1fr}}
</style>
<script>
 // @ts-nocheck
 import { supabaseUrl, publishableKey } from "../lib/supabase-public";
 const catalogueHeaders={apikey:publishableKey,Authorization:"Bearer "+publishableKey};
const dayTripPhotoByKey = {};
function makeDayTripCard(item){
  const card=document.createElement("article");card.className="card";card.dataset.experienceKey=item.experience_key;
  const selectedImage=item.experience_key==="Traditional Chagga Cooking Class"?"":(dayTripPhotoByKey[item.experience_key]||item.image_url);
  if(selectedImage&&/^https:\/\//i.test(selectedImage)){
   const image=document.createElement("img");image.src=selectedImage;image.alt=item.experience_key==="Traditional Chagga Cooking Class"?"Women preparing food over an open fire in Tanzania":item.display_name||"Materuni experience";image.loading="lazy";image.decoding="async";image.width=640;image.height=520;card.append(image);
  }else{card.classList.add("no-image");}
  const body=document.createElement("div");body.className="body";
  const kicker=document.createElement("span");kicker.className="kicker";kicker.textContent=(item.product_tagline||"LOCAL MATERUNI EXPERIENCE").toUpperCase();
  const heading=document.createElement("h3");heading.textContent=item.display_name||"Materuni experience";
  const price=document.createElement("div");price.className="price";price.textContent="$"+Number(item.price_usd).toFixed(0)+" ";
  const per=document.createElement("small");per.textContent="PER PERSON";price.append(per);
  const description=document.createElement("p");description.textContent=item.full_description||item.short_description||"Discover Materuni with your local hosts.";
  const duration=document.createElement("p");duration.className="product-best-for";duration.textContent="Duration · "+(item.duration_label||"Full day");
  const list=document.createElement("ul");(Array.isArray(item.unique_amenities)?item.unique_amenities:[]).forEach(value=>{const li=document.createElement("li");li.textContent=value;list.append(li)});
  const link=document.createElement("a");link.className="button";link.href="/booking?source=day-trips&experience="+encodeURIComponent(item.experience_key);link.textContent="Choose this experience";
  body.append(kicker,heading,price,description,duration,list,link);card.append(body);return card;
}
 async function syncDayTripProducts(){
  try{
   const response=await fetch(`${supabaseUrl}/rest/v1/experience_catalog?select=experience_key,display_name,price_usd,duration_label,short_description,full_description,image_url,product_tagline,best_for,signature_moments,unique_amenities,is_active`,{headers:catalogueHeaders,cache:"no-store"});
   if(!response.ok)throw new Error("Day-trip catalogue unavailable");
   const items=await response.json();
   items.filter(item=>item.is_active).forEach(item=>{
    let card=document.querySelector('[data-experience-key="'+CSS.escape(item.experience_key)+'"]');
    if(!card){
     if(item.experience_key==="Camping & Village Life")return;
     card=makeDayTripCard(item);
     document.querySelector("#day-trip-options .grid")?.append(card);
    }
    const body=card.querySelector(".body");
    const heading=card.querySelector("h3");if(heading)heading.textContent=item.display_name;
    const price=card.querySelector(".price");if(price){price.textContent="$"+Number(item.price_usd).toFixed(0)+" ";const small=document.createElement("small");small.textContent="PER PERSON";price.append(small);}
    const description=body?.querySelector("p:not(.product-best-for)");if(description)description.textContent=item.full_description||item.short_description||"Discover Materuni with your local hosts.";
    const duration=card.querySelector(".product-best-for");if(duration&&item.duration_label)duration.textContent="Duration · "+item.duration_label;
    const image=card.querySelector("img");const selectedImage=item.experience_key==="Traditional Chagga Cooking Class"?"":(dayTripPhotoByKey[item.experience_key]||item.image_url);if(image&&selectedImage&&/^https:\/\//i.test(selectedImage))image.src=selectedImage;
    const kicker=body?.querySelector(".kicker");if(kicker&&item.product_tagline)kicker.textContent=item.product_tagline.toUpperCase();
    const list=body?.querySelector("ul");if(list)list.replaceChildren(...(Array.isArray(item.unique_amenities)?item.unique_amenities:[]).map(value=>{const li=document.createElement("li");li.textContent=value;return li;}));
    const old=body?.querySelector("[data-best-for]");if(old)old.remove();
    if(item.best_for){const best=document.createElement("p");best.dataset.bestFor="true";best.className="product-best-for";best.textContent="BEST FOR · "+item.best_for;list?.insertAdjacentElement("beforebegin",best);}
   });
   const sharedResponse=await fetch(`${supabaseUrl}/rest/v1/site_settings?select=setting_value&setting_key=eq.experience_shared_inclusions`,{headers:catalogueHeaders,cache:"no-store"});
   if(sharedResponse.ok){const rows=await sharedResponse.json(),raw=rows?.[0]?.setting_value,shared=typeof raw==="string"?JSON.parse(raw):raw;const grid=document.querySelector("#day-trip-options .grid");if(Array.isArray(shared)&&shared.length&&grid&&!document.querySelector("[data-shared-inclusions]")){const panel=document.createElement("aside");panel.className="shared-standard";panel.dataset.sharedInclusions="true";const h=document.createElement("h3");h.textContent="Included in every Materuni Hosts experience";const ul=document.createElement("ul");shared.forEach(value=>{const li=document.createElement("li");li.textContent=value;ul.append(li)});panel.append(h,ul);grid.insertAdjacentElement("afterend",panel);}}
  }catch(error){console.warn("Using built-in day-trip content.",error)}
 }
 syncDayTripProducts();
 const pageFields={"hero_title":".day .hero h1","hero_intro":".day .hero-copy>p","intro_band":".day .intro p","options_title":"#day-trip-options .heading h2","options_intro":"#day-trip-options .heading p","final_title":".day .final h2","final_intro":".day .final>p","final_cta":".day .final a.button.light"};
 let landingContent=null;
 function applyLandingCopy(){
  const locale=(localStorage.getItem("materuni-language")||"en").toLowerCase();
  if(locale!=="en"||!landingContent)return;
  Object.entries(pageFields).forEach(([key,selector])=>{const value=landingContent[key];const node=document.querySelector(selector);if(node&&typeof value==="string"&&value.trim())node.textContent=value});
 }
 fetch(`${supabaseUrl}/rest/v1/site_settings?select=setting_value&setting_key=eq.landing_pages_content`,{headers:{apikey:publishableKey,Authorization:"Bearer "+publishableKey},cache:"no-store"})
  .then(response=>response.ok?response.json():[])
  .then(rows=>{
   const raw=rows?.[0]?.setting_value;if(!raw)return;
   const saved=typeof raw==="string"?JSON.parse(raw):raw;const content=saved?.day;if(!content||typeof content!=="object")return;
   landingContent=content;applyLandingCopy();
  }).catch(error=>console.warn("Optional landing-page content unavailable; showing built-in copy.",error));
 document.getElementById("site-language")?.addEventListener("change",applyLandingCopy);
</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"Materuni Day Trips and Local Chagga Experiences","description":"Guided Materuni tours near Moshi including the waterfall, Chagga coffee, traditional cooking, Moshi town and Rau Forest nature experiences.","provider":{"@type":"Organization","name":"Materuni Hosts","url":"https://materunihosts.com"},"areaServed":[{"@type":"Place","name":"Materuni Village, Kilimanjaro Region, Tanzania"},{"@type":"City","name":"Moshi, Kilimanjaro Region, Tanzania"},{"@type":"Place","name":"Rau Forest, Moshi, Tanzania"}],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Materuni day trip experiences","itemListElement":[{"@type":"Offer","name":"Materuni Waterfall & Chagga Village Experience","price":"45","priceCurrency":"USD","description":"Per person; includes the shared Materuni day experience, complimentary Mbege tasting and traditional dance."},{"@type":"Offer","name":"Materuni Coffee & Chagga Culture Experience","price":"41","priceCurrency":"USD","description":"Per person; includes the shared Materuni day experience and an in-depth coffee session."},{"@type":"Offer","name":"Materuni Chagga Cooking & Village Experience","price":"55","priceCurrency":"USD","description":"Per person; includes the shared Materuni day experience and hands-on cooking with local ingredients."},{"@type":"Offer","name":"Materuni & Moshi Town Cultural Tour","price":"59","priceCurrency":"USD","description":"Per person; includes the shared Materuni day experience and a guided Moshi town visit."},{"@type":"Offer","name":"Materuni & Rau Forest Nature Experience","price":"50","priceCurrency":"USD","description":"Per person plus a USD 15 Rau Forest entrance fee per guest."}]}}</script>
