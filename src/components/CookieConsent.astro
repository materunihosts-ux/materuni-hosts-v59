---
---
<div class="cookie-consent" id="cookie-consent" role="dialog" aria-modal="false" aria-labelledby="cookie-title" hidden>
  <div class="cookie-copy">
    <p id="cookie-title">We use cookies and optional analytics to improve your experience. <a href="/privacy">Privacy policy</a></p>
  </div>
  <div class="cookie-actions">
    <button type="button" class="cookie-btn cookie-btn-accept" data-cookie-accept>Accept</button>
    <button type="button" class="cookie-btn cookie-btn-reject" data-cookie-reject>Reject</button>
    <button type="button" class="cookie-btn-link" data-cookie-settings aria-label="Cookie preferences">Settings</button>
  </div>
  <div class="cookie-settings" id="cookie-settings" hidden>
    <label><input type="checkbox" checked disabled /> Essential (active)</label>
    <label><input type="checkbox" id="cookie-analytics" /> Analytics</label>
    <button type="button" data-cookie-save>Save</button>
  </div>
</div>
<button class="cookie-reopen" type="button" data-cookie-reopen aria-label="Open privacy settings">Privacy settings</button>
<style>
.cookie-consent{position:fixed;z-index:10000;inset:auto 16px 16px 16px;max-width:880px;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 18px;color:#242421;background:#FAF7F2;border:1px solid #C5A059;border-radius:12px;box-shadow:0 8px 30px rgba(0,0,0,.2)}
.cookie-copy p{margin:0;font:500 14px/1.6 var(--sans);color:#1A3322}
.cookie-copy a{color:#80652F;font-weight:700;text-decoration:underline}
.cookie-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
.cookie-btn{min-height:44px;min-width:88px;padding:9px 16px;border-radius:999px;font:800 13px/1.35 var(--sans);cursor:pointer;border:1px solid #1A3322}
.cookie-btn-accept{background:#1A3322;color:#FAF7F2}
.cookie-btn-reject{background:transparent;color:#1A3322}
.cookie-btn-link{background:none;border:none;color:#665f52;font:700 13px/1.4 var(--sans);text-decoration:underline;cursor:pointer;padding:8px}
.cookie-settings{display:flex;align-items:center;gap:14px;flex-wrap:wrap;font:600 13px/1.5 var(--sans);width:100%;margin-top:10px}
.cookie-settings label{display:flex;align-items:center;gap:4px}
.cookie-settings button{min-height:40px;padding:8px 16px;border-radius:999px;border:1px solid #1A3322;background:#1A3322;color:#fff;font-size:13px;font-weight:800;cursor:pointer}
@media(max-width:600px){
  .cookie-consent{inset:auto 8px 8px 8px;flex-direction:column;align-items:stretch;padding:10px 14px;gap:8px;border-radius:10px}
  .cookie-copy p{font-size:13px;line-height:1.5;text-align:center}
  .cookie-actions{display:grid;grid-template-columns:1fr 1fr auto;gap:8px;width:100%}
  .cookie-btn{min-height:44px;width:100%;padding:8px 10px;text-align:center}
}
</style>
<script is:inline>
(() => {
  const key = "materuni-cookie-consent-v1";
  // Queue conversion-friendly events for the consent-gated GTM container.
  // No guest names, emails, phone numbers or booking references are sent.
  document.addEventListener("click", (event) => {
    const link = event.target instanceof Element ? event.target.closest('a[href*="wa.me"]') : null;
    if (!link) return;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: "whatsapp_click", link_url: "https://wa.me/" });
  });
  const banner = document.getElementById("cookie-consent");
  if (!banner) return;
  const settings = document.getElementById("cookie-settings");
  const analytics = document.getElementById("cookie-analytics");
  const loadAnalytics = () => {
    if (window.__materuniGtmLoaded) return;
    window.__materuniGtmLoaded = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function(){ window.dataLayer.push(arguments); };
    window.gtag("consent", "default", { analytics_storage: "denied", ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied", functionality_storage: "granted", security_storage: "granted" });
    window.gtag("consent", "update", { analytics_storage: "granted", ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied" });
    window.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
    const script = document.createElement("script");
    script.async = true;
    script.src = "https://www.googletagmanager.com/gtm.js?id=GTM-TLB463PS";
    document.head.appendChild(script);
  };
  const apply = (choice) => {
    localStorage.setItem(key, JSON.stringify({ analytics: !!choice.analytics, savedAt: new Date().toISOString() }));
    banner.hidden = true;
    if (choice.analytics) loadAnalytics();
  };
  let saved = null;
  try { saved = JSON.parse(localStorage.getItem(key) || "null"); } catch {}
  if (!saved || typeof saved.analytics !== "boolean") banner.hidden = false;
  else if (saved.analytics) loadAnalytics();
  banner.querySelector("[data-cookie-accept]")?.addEventListener("click", () => apply({ analytics: true }));
  banner.querySelector("[data-cookie-reject]")?.addEventListener("click", () => apply({ analytics: false }));
  banner.querySelector("[data-cookie-settings]")?.addEventListener("click", () => { settings.hidden = !settings.hidden; });
  banner.querySelector("[data-cookie-save]")?.addEventListener("click", () => apply({ analytics: analytics.checked }));
  document.querySelector("[data-cookie-reopen]")?.addEventListener("click", () => {
    analytics.checked = !!saved?.analytics;
    settings.hidden = true;
    banner.hidden = false;
  });
})();
</script>
