---
import globalStyles from "../styles/global.css?url";
import CookieConsent from "../components/CookieConsent.astro";
import { supabaseUrl } from "../lib/supabase-public";
import { siteContent } from "../data/site-content";
import { seoDefaults } from "../data/seo";
import { primaryNavigation, primaryNavigationCta, supportedLanguages } from "../data/navigation";
import { pageFallbacks } from "../data/translations";
const {
  title = seoDefaults.title,
  description = seoDefaults.description,
  noindex = false,
  nofollow = false,
  robots = null,
  preloadImage = null,
  canonicalOverride = null,
  canonical = null
} = Astro.props;

const pathname = Astro.url.pathname;
const isAdmin = pathname.startsWith("/admin");
const is404 = pathname.startsWith("/404");
const isVercelPreview = Astro.url.hostname.endsWith(".vercel.app") && Astro.url.hostname !== "materunihosts.com";
const shouldNoindex = noindex || isAdmin || is404 || isVercelPreview;

// Protected and non-canonical environments must never be made indexable
// by a page-level robots override.
let robotsMeta: string;
if (isAdmin || is404 || isVercelPreview) {
  robotsMeta = "noindex,nofollow";
} else if (typeof robots === "string" && robots.trim()) {
  robotsMeta = robots.trim();
} else if (noindex && nofollow) {
  robotsMeta = "noindex,nofollow";
} else if (noindex && !nofollow) {
  robotsMeta = "noindex,follow";
} else if (!noindex && nofollow) {
  robotsMeta = "index,nofollow";
} else {
  robotsMeta = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
}

const cleanPath = pathname === "/" ? "/" : pathname.replace(/\/+$/, "");
const canonicalUrl = new URL(cleanPath, seoDefaults.siteUrl);
const canonicalTarget = canonicalOverride ?? canonical;
const canonicalHref = canonicalTarget ? new URL(canonicalTarget, seoDefaults.siteUrl).toString() : canonicalUrl.toString();
const breadcrumbLabels: Record<string, string> = {
  experiences: "Experiences",
  about: "Our story",
  "about-us": "Our story",
  camping: "Materuni Camping",
  "day-trips": "Materuni Day Trips",
  itinerary: "Build itinerary",
  booking: "Check availability",
  reviews: "Guest reviews",
  faq: "Frequently asked questions",
  sustainability: "Our approach",
  "travel-guide": "Travel guide",
  privacy: "Privacy policy",
  terms: "Booking terms"
};
const breadcrumbParts = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = [{ "@type": "ListItem", position: 1, name: "Home", item: siteContent.url }];
if (!shouldNoindex) {
  breadcrumbParts.forEach((part, index) => {
    const label = breadcrumbLabels[part];
    if (label) breadcrumbItems.push({
      "@type": "ListItem",
      position: breadcrumbItems.length + 1,
      name: label,
      item: new URL("/" + breadcrumbParts.slice(0, index + 1).join("/"), "https://materunihosts.com").toString()
    });
  });
}

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems
};
const socialImage = preloadImage ?? seoDefaults.socialImage;
const webPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonicalHref,
  "inLanguage": "en",
  "isPartOf": {
    "@type": "WebSite",
    "name": siteContent.name,
    "url": "https://materunihosts.com/"
  },
  "about": {
    "@type": "Place",
    "name": "Materuni Village, Moshi, Kilimanjaro, Tanzania"
  },
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": socialImage
  }
};
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TourOperator",
  "@id": "https://materunihosts.com/#localbusiness",
  "name": siteContent.name,
  "url": siteContent.url,
  "logo": siteContent.logo,
  "image": socialImage,
  "description": siteContent.description,
  "telephone": siteContent.telephone,
  "email": siteContent.email,
  "currenciesAccepted": siteContent.currency.join(", "),
  "address": { "@type": "PostalAddress", ...siteContent.address },
  "areaServed": { "@type": "Place", "name": siteContent.areaServed },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": siteContent.telephone,
    "email": siteContent.email,
    "contactType": "customer service",
    "availableLanguage": siteContent.language
  }
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500..700&family=Manrope:wght@400..700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href={globalStyles} />
<title>{title}</title><meta name="description" content={description} /><meta name="theme-color" content="#1A3322" /><link rel="canonical" href={canonicalHref} /><meta name="robots" content={robotsMeta} /><meta name="googlebot" content={robotsMeta} /><meta property="og:type" content="website" /><meta property="og:site_name" content="Materuni Hosts" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalHref} /><meta property="og:image" content={socialImage.startsWith("http") ? socialImage : `https://materunihosts.com${socialImage.startsWith("/") ? "" : "/"}${socialImage}`} /><meta property="og:locale" content="en_TZ" /><meta property="og:image:alt" content="Materuni Hosts authentic village experiences in Materuni, Tanzania" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage.startsWith("http") ? socialImage : `https://materunihosts.com${socialImage.startsWith("/") ? "" : "/"}${socialImage}`} />{!shouldNoindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}{!shouldNoindex && <script type="application/ld+json" set:html={JSON.stringify(webPageData)} />}{!shouldNoindex && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />}{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
<link rel="icon" type="image/svg+xml" href="/materuni-hosts-logo-round.svg" /><link rel="apple-touch-icon" href="/materuni-hosts-logo-round.jpg" /><link rel="preconnect" href={supabaseUrl} crossorigin />

<style is:global>
body.admin-shell .site-header,body.admin-shell .site-footer,body.admin-shell .mh-concierge{display:none!important}
body.admin-shell{min-height:100vh}body.admin-shell .admin-main{width:100%;max-width:1440px;margin:0 auto;padding:clamp(18px,3vw,42px);min-height:calc(100vh - 58px)}body.admin-shell .admin-main>.page-hero{margin:0 0 22px;padding:0;background:transparent}body.admin-shell .admin-main .booking-wrap{width:100%;max-width:none;margin:0;padding:0}body.admin-shell .admin-main .booking-panel{border:1px solid #e1d9cc;border-radius:16px;box-shadow:0 12px 36px rgba(26,51,34,.07)}body.admin-shell .admin-main .button{min-height:42px}
body.admin-shell{background:#f4f0e8}
body.admin-shell .admin-topbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:14px clamp(18px,4vw,56px);background:#1A3322;color:#FAF7F2;border-bottom:1px solid #C5A059}
body.admin-shell .admin-brand{font-family:Manrope,sans-serif;font-weight:800;letter-spacing:.02em;color:inherit;text-decoration:none}
body.admin-shell .admin-brand span{font-size:.65rem;letter-spacing:.16em;color:#C5A059;margin-left:.55rem}
body.admin-shell .admin-view-site{color:#FAF7F2;text-decoration:none;border:1px solid rgba(250,247,242,.45);border-radius:999px;padding:.6rem .95rem;font-size:.82rem;font-weight:700}
body.admin-shell .admin-view-site:hover{background:rgba(250,247,242,.12)}
body.admin-shell #main-content{min-height:calc(100vh - 58px)}
@media(max-width:600px){body.admin-shell .admin-topbar{padding:12px 16px}body.admin-shell .admin-view-site{font-size:.75rem;padding:.55rem .7rem}}
</style>
</head>
<body class={Astro.url.pathname.startsWith("/admin") ? "admin-shell" : "public-shell"}>
<a class="skip-link" href="#main-content">Skip to content</a>
{!isAdmin && <header class="site-header"><a class="brand" href="/" aria-label="Materuni Hosts home"><img class="brand-logo" src="/materuni-hosts-logo-round.svg" alt="Materuni Hosts logo" width="86" height="86" loading="eager" decoding="async" /><span class="brand-lockup"><strong>Materuni Hosts</strong><small>LOCAL EXPERIENCES · KILIMANJARO</small></span></a>
<nav id="primary-navigation" aria-label="Main navigation">{primaryNavigation.map((item) => <a href={item.href} data-i18n={item.key} aria-current={Astro.url.pathname === item.href ? "page" : undefined}>{item.label}</a>)}<a class="nav-cta" href={primaryNavigationCta.href} data-i18n={primaryNavigationCta.key}>{primaryNavigationCta.label}</a></nav>
<div class="language-control"><label for="site-language" class="visually-hidden">Language</label><select id="site-language" aria-label="Select language">{supportedLanguages.map((language) => <option value={language.code}>{language.label}</option>)}</select></div>
<button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="primary-navigation" aria-expanded="false">☰</button></header>}
<script>
// @ts-nocheck
(() => {
 const supported=["en","es","fr","de"], labels={
  en:{skip:"Skip to content",ask:"Ask a local host",footer:"Community-based Chagga experiences in Materuni Village, Moshi, Tanzania.",explore:"Explore",book:"Book your experience"},
  es:{skip:"Ir al contenido",ask:"Habla con un anfitrión",footer:"Experiencias chagga comunitarias en Materuni Village, Moshi, Tanzania.",explore:"Explorar",book:"Reserva tu experiencia"},
  fr:{skip:"Aller au contenu",ask:"Parler à un hôte local",footer:"Expériences chagga communautaires à Materuni Village, Moshi, Tanzanie.",explore:"Explorer",book:"Réserver votre expérience"},
  de:{skip:"Zum Inhalt",ask:"Lokalen Gastgeber fragen",footer:"Gemeinschaftsbasierte Chagga-Erlebnisse in Materuni Village, Moshi, Tansania.",explore:"Entdecken",book:"Erlebnis buchen"}
 };
 const select=document.getElementById("site-language"), requested=new URLSearchParams(location.search).get("lang");
 let saved="";try{saved=localStorage.getItem("materuni-language")||""}catch{}
 const menuButton=document.querySelector(".menu-toggle"),mainNav=document.getElementById("primary-navigation");
 const closeMenu=()=>{mainNav?.classList.remove("open");menuButton?.setAttribute("aria-expanded","false");menuButton?.setAttribute("aria-label","Open menu");if(menuButton)menuButton.textContent="☰"};
 menuButton?.addEventListener("click",()=>{const open=mainNav?.classList.toggle("open")??false;menuButton.setAttribute("aria-expanded",String(open));menuButton.setAttribute("aria-label",open?"Close menu":"Open menu");menuButton.textContent=open?"×":"☰"});
 mainNav?.addEventListener("click",event=>{if(event.target instanceof Element&&event.target.closest("a")&&mainNav.classList.contains("open"))closeMenu()});
 document.addEventListener("keydown",event=>{if(event.key==="Escape"&&mainNav?.classList.contains("open")){closeMenu();menuButton?.focus()}});
 const lang=supported.includes(requested)?requested:(supported.includes(saved)?saved:(supported.includes((navigator.language||"en").slice(0,2).toLowerCase())?(navigator.language||"en").slice(0,2).toLowerCase():"en"));
 function apply(language){
  const t=labels[language]||labels.en;document.documentElement.lang=language;if(select)select.value=language;try{localStorage.setItem("materuni-language",language)}catch{}
  const skip=document.querySelector(".skip-link");if(skip)skip.textContent=t.skip;
  const ask=document.querySelector(".mh-concierge-launch span:last-child");if(ask)ask.textContent=t.ask;
  const footerIntro=document.querySelector(".site-footer>div:first-child>p");if(footerIntro)footerIntro.textContent=t.footer;
  const explore=document.querySelector(".site-footer>div:nth-child(2)>strong");if(explore)explore.textContent=t.explore;
  const booking=document.querySelector('.site-footer a[href="/booking"]');if(booking)booking.textContent=t.book;
  const chat=document.getElementById("mh-chat-language");if(chat&&chat.value!==language){chat.value=language;chat.dispatchEvent(new Event("change"))}
 }
 apply(lang);select?.addEventListener("change",()=>{apply(select.value);loadPageTranslations(select.value)});
 async function loadPageTranslations(language){
  const nodes=[...document.querySelectorAll("[data-i18n]")];
  nodes.forEach(node=>{if(!node.dataset.i18nDefault)node.dataset.i18nDefault=node.textContent||"";node.textContent=node.dataset.i18nDefault});
  const placeholders=[...document.querySelectorAll("[data-i18n-placeholder]")];
  placeholders.forEach(node=>{if(!node.dataset.i18nPlaceholderDefault)node.dataset.i18nPlaceholderDefault=node.getAttribute("placeholder")||"";node.setAttribute("placeholder",node.dataset.i18nPlaceholderDefault)});
  if(language==="en")return;
  const fallback=pageFallbacks[language]||{};
  nodes.forEach(node=>{const value=fallback[node.dataset.i18n];if(typeof value==="string")node.textContent=value});
 }
 window.MateruniApplyPageTranslations=loadPageTranslations;;
 window.MateruniApplyPageTranslations=loadPageTranslations;
 loadPageTranslations(lang);
  function loadSocialLinks(){
   const fallback={facebook_url:"https://www.facebook.com/share/1VTNWPbqcc/",instagram_url:"https://instagram.com/materuni_hosts",google_review_url:"https://g.page/r/CXy6M_Suiip9EBM/review"};
   document.querySelectorAll("[data-social-key]").forEach(link=>{const value=fallback[link.dataset.socialKey];let valid=false;try{const parsed=new URL(value);valid=(parsed.protocol==="https:"||parsed.protocol==="http:")&&parsed.hostname.includes(".")}catch{}if(valid){link.href=value;link.hidden=false;link.removeAttribute("aria-hidden");link.removeAttribute("aria-disabled");link.removeAttribute("tabindex");link.classList.remove("social-link-pending");link.removeAttribute("title")}else{link.hidden=true;link.setAttribute("aria-hidden","true");link.removeAttribute("href")}});
  }
document.addEventListener("DOMContentLoaded",()=>{loadPageTranslations(lang);loadSocialLinks()},{once:true});

})();
</script>
{isAdmin && <div class="admin-topbar"><a class="admin-brand" href="/admin/" aria-label="Materuni Hosts admin home">Materuni Hosts <span>ADMIN</span></a><a class="admin-view-site" href="/" target="_blank" rel="noopener noreferrer">View main website ↗</a></div>}<main id="main-content" class={isAdmin ? "admin-main" : "public-main"} tabindex="-1"><slot /></main>

{!noindex && !isAdmin && <div class="mh-concierge" id="mh-concierge">
  <button class="mh-concierge-launch" id="mh-chat-open" type="button" aria-expanded="false" aria-controls="mh-chat-panel"><span class="mh-chat-icon">✦</span><span>Ask a local host</span></button>
  <section class="mh-chat-panel" id="mh-chat-panel" hidden aria-label="Materuni Hosts guest concierge">
    <header class="mh-chat-header"><div><strong>Materuni Hosts</strong><small id="mh-chat-subtitle">Local experience concierge</small></div><button id="mh-chat-close" type="button" aria-label="Close chat">×</button></header>
    <div class="mh-chat-messages" id="mh-chat-messages" aria-live="polite"></div>
    <form class="mh-chat-form" id="mh-chat-form">
      <select id="mh-chat-language" aria-label="Chat language"><option value="en">English</option><option value="es">Español</option><option value="fr">Français</option><option value="de">Deutsch</option></select>
      <div class="mh-chat-compose"><input id="mh-chat-input" type="text" maxlength="1200" aria-label="Ask Materuni Hosts a question" placeholder="Ask about experiences, dates or prices…" autocomplete="off" required><button id="mh-chat-send" type="submit" aria-label="Send message">Send</button></div>
    </form>
    <a class="mh-chat-whatsapp" id="mh-chat-whatsapp" href="https://wa.me/255612068540" target="_blank" rel="noopener noreferrer">Prefer a person? Chat on WhatsApp</a>
  </section>
</div>}
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../lib/supabase-public";
const conciergeEndpoint = `${supabaseUrl}/functions/v1/guest-concierge`;
const conciergeKey = publishableKey;
const chatEl = id => document.getElementById(id);
const chatStore = { id: "materuni_chat_session", token: "materuni_chat_token" };
const safeSession = { get(key) { try { return sessionStorage.getItem(key) || ""; } catch { return ""; } }, set(key,value) { try { sessionStorage.setItem(key,value); } catch {} }, remove(key) { try { sessionStorage.removeItem(key); } catch {} } };
let chatSessionId = safeSession.get(chatStore.id);
let chatSessionToken = safeSession.get(chatStore.token);
const chatGreetings = {
  en: "Hello! I’m your Materuni Hosts concierge. I can help you choose an experience, understand prices and plan your visit. What would you like to know?",
  es: "¡Hola! Soy tu asistente de Materuni Hosts. Puedo ayudarte a elegir una experiencia, conocer los precios y planificar tu visita. ¿Qué te gustaría saber?",
  fr: "Bonjour ! Je suis votre concierge Materuni Hosts. Je peux vous aider à choisir une expérience, comprendre les prix et organiser votre visite. Que souhaitez-vous savoir ?",
  de: "Hallo! Ich bin Ihr Materuni Hosts Concierge. Ich helfe Ihnen bei der Auswahl eines Erlebnisses, den Preisen und der Planung Ihres Besuchs. Was möchten Sie wissen?"
};
const detectedLanguage = (navigator.language || "en").slice(0,2).toLowerCase();
const languageSelect = chatEl("mh-chat-language");
if (languageSelect) languageSelect.value = ["en","es","fr","de"].includes(detectedLanguage) ? detectedLanguage : "en";
function chatBubble(role, message, mode) {
  const list = chatEl("mh-chat-messages");
  const bubble = document.createElement("div");
  bubble.className = "mh-chat-bubble " + role;
  if (mode) {
    const label = document.createElement("small");
    label.className = "mh-chat-mode";
    label.textContent = mode === "ai" ? "AI concierge" : "Guest guide";
    bubble.append(label);
  }
  const text = document.createElement("p");
  text.textContent = message;
  bubble.append(text);
  list.append(bubble);
  requestAnimationFrame(() => bubble.scrollIntoView({ block: "end", behavior: "smooth" }));
  return bubble;
}
if (chatEl("mh-chat-open") && chatEl("mh-chat-panel") && languageSelect && chatEl("mh-chat-messages") && chatEl("mh-chat-form")) {
  chatBubble("assistant", chatGreetings[languageSelect.value] || chatGreetings.en);
  chatEl("mh-chat-open").addEventListener("click", () => {
    const panel = chatEl("mh-chat-panel");
    panel.hidden = !panel.hidden;
    chatEl("mh-chat-open").setAttribute("aria-expanded", String(!panel.hidden));
    if (!panel.hidden) chatEl("mh-chat-input").focus();
  });
  chatEl("mh-chat-close").addEventListener("click", () => {
    chatEl("mh-chat-panel").hidden = true;
    chatEl("mh-chat-open").setAttribute("aria-expanded", "false");
  });
  languageSelect.addEventListener("change", () => {
    const language = languageSelect.value;
    chatEl("mh-chat-subtitle").textContent = ({en:"Local experience concierge",es:"Asistente de experiencias locales",fr:"Concierge d’expériences locales",de:"Lokaler Erlebnis-Concierge"})[language];
    chatEl("mh-chat-input").placeholder = ({en:"Ask about experiences, dates or prices…",es:"Pregunta sobre experiencias, fechas o precios…",fr:"Posez vos questions sur les expériences, dates ou prix…",de:"Fragen zu Erlebnissen, Terminen oder Preisen…"})[language];
    chatEl("mh-chat-whatsapp").textContent = ({en:"Prefer a person? Chat on WhatsApp",es:"¿Prefieres hablar con una persona? WhatsApp",fr:"Vous préférez un hôte ? Écrivez sur WhatsApp",de:"Lieber persönlich sprechen? WhatsApp"})[language];
    chatBubble("assistant", chatGreetings[language] || chatGreetings.en);
  });
  chatEl("mh-chat-form").addEventListener("submit", async event => {
    event.preventDefault();
    const input = chatEl("mh-chat-input");
    const send = chatEl("mh-chat-send");
    const message = input.value.trim();
    if (!message) return;
    chatBubble("guest", message);
    input.value = "";
    input.disabled = true;
    send.disabled = true;
    const typing = chatBubble("assistant", "…");
    async function requestReply(retry = false) {
      const response = await fetch(conciergeEndpoint, {
        method: "POST",
        headers: { apikey: conciergeKey, "Content-Type": "application/json" },
        body: JSON.stringify({
          message,
          language: languageSelect.value,
          ...(chatSessionId && chatSessionToken ? { session_id: chatSessionId, session_token: chatSessionToken } : {})
        })
      });
      const data = await response.json().catch(() => ({}));
      if (response.status === 401 && !retry) {
        chatSessionId = ""; chatSessionToken = "";
        safeSession.remove(chatStore.id); safeSession.remove(chatStore.token);
        return requestReply(true);
      }
      if (!response.ok) throw new Error(data.error || "The chat is temporarily unavailable.");
      if (data.session_id) { chatSessionId = data.session_id; safeSession.set(chatStore.id, chatSessionId); }
      if (data.session_token) { chatSessionToken = data.session_token; safeSession.set(chatStore.token, chatSessionToken); }
      return data;
    }
    try {
      const data = await requestReply();
      typing.remove();
      chatBubble("assistant", data.reply || "Please contact a local host for help.", data.mode);
    } catch (error) {
      typing.remove();
      chatBubble("assistant", "I’m sorry, the chat is temporarily unavailable. Please reach our local host on WhatsApp: +255 612 068 540.");
    } finally {
      input.disabled = false;
      send.disabled = false;
      input.focus();
    }
  });
}
</script>

