---
import "../styles/global.css";
import { supabaseUrl } from "../lib/supabase-public";
const { title = "Materuni Hosts | Authentic Chagga Experiences", description = "Discover authentic Chagga coffee, waterfalls, food and village life in Materuni, Kilimanjaro, Tanzania.", noindex = false, preloadImage = null } = Astro.props;
const isAdmin = Astro.url.pathname.startsWith("/admin");
const shouldNoindex = noindex || !["materunihosts.com","www.materunihosts.com"].includes(Astro.url.hostname);
const requestedLanguage = Astro.url.searchParams.get("lang");
const canonicalUrl = new URL(Astro.url.pathname, "https://materunihosts.com");
if (requestedLanguage && ["en","es","fr","de"].includes(requestedLanguage)) canonicalUrl.searchParams.set("lang", requestedLanguage);
const canonical = canonicalUrl.toString();
const localizedUrl = (language: string) => { const url = new URL(Astro.url.pathname, "https://materunihosts.com"); url.searchParams.set("lang", language); return url.toString(); };
const breadcrumbLabels: Record<string, string> = {
  experiences: "Experiences",
  camping: "Materuni Camping",
  "day-trips": "Materuni Day Trips",
  itinerary: "Build itinerary",
  booking: "Check availability",
  reviews: "Guest reviews",
  faq: "Frequently asked questions",
  sustainability: "Our approach",
  "travel-guide": "Travel guide",
  privacy: "Privacy policy",
  terms: "Booking terms"
};
const breadcrumbParts = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = [{ "@type": "ListItem", position: 1, name: "Home", item: "https://materunihosts.com/" }];
if (!noindex) {
  breadcrumbParts.forEach((part, index) => {
    const label = breadcrumbLabels[part];
    if (label) breadcrumbItems.push({
      "@type": "ListItem",
      position: breadcrumbItems.length + 1,
      name: label,
      item: new URL("/" + breadcrumbParts.slice(0, index + 1).join("/"), "https://materunihosts.com").toString()
    });
  });
}
const webPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonical,
  "inLanguage": requestedLanguage && ["en","es","fr","de"].includes(requestedLanguage) ? requestedLanguage : "en",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Materuni Hosts",
    "url": "https://materunihosts.com/"
  },
  "about": {
    "@type": "Place",
    "name": "Materuni Village, Moshi, Kilimanjaro, Tanzania"
  },
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": socialImage
  }
};
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems
};
const socialImage = preloadImage ?? `${supabaseUrl}/storage/v1/object/public/materuni-images/hero_image/1791600514716-b2bclfcnhhh.jpg`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TourOperator",
  "name": "Materuni Hosts",
  "url": "https://materunihosts.com/",
  "logo": "https://materunihosts.com/materuni-hosts-logo-round.svg",
  "image": socialImage,
  "description": "Materuni Camping and authentic Chagga coffee, waterfall, cooking and village experiences hosted by local hosts in Materuni Village near Moshi, Tanzania.",
  "telephone": "+255612068540",
  "priceRange": "USD 65–135 per person",
  "hasMap": "https://www.google.com/maps/search/?api=1&query=Materuni%20Hosts%20-%20Waterfall%20Tours%20%26%20Village%20Camping%2C%20Materuni%20Village%2C%20Moshi%2C%20Tanzania",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+255612068540",
    "contactType": "customer service"
  },
  "potentialAction": {
    "@type": "ReserveAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://materunihosts.com/booking",
      "inLanguage": "en",
      "actionPlatform": ["https://schema.org/DesktopWebPlatform", "https://schema.org/MobileWebPlatform"]
    },
    "name": "Request a Materuni experience booking"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Materuni Village",
    "addressRegion": "Kilimanjaro",
    "addressCountry": "TZ"
  },
  "areaServed": {
    "@type": "Place",
    "name": "Materuni Village, Moshi, Kilimanjaro, Tanzania"
  }
};
---
<!doctype html>
<html lang={requestedLanguage && ["en","es","fr","de"].includes(requestedLanguage) ? requestedLanguage : "en"}>
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title><meta name="description" content={description} /><meta name="theme-color" content="#1A3322" /><link rel="canonical" href={canonical} />{!shouldNoindex && <><link rel="alternate" hreflang="en" href={localizedUrl("en")} /><link rel="alternate" hreflang="es" href={localizedUrl("es")} /><link rel="alternate" hreflang="fr" href={localizedUrl("fr")} /><link rel="alternate" hreflang="de" href={localizedUrl("de")} /><link rel="alternate" hreflang="x-default" href={localizedUrl("en")} /></>}<meta property="og:type" content="website" /><meta property="og:site_name" content="Materuni Hosts" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={socialImage} /><meta property="og:locale" content={requestedLanguage==="es"?"es_ES":requestedLanguage==="fr"?"fr_FR":requestedLanguage==="de"?"de_DE":"en_TZ"} /><meta property="og:image:alt" content="Materuni Hosts authentic village experiences in Materuni, Tanzania" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} />{!shouldNoindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}{!shouldNoindex && <script type="application/ld+json" set:html={JSON.stringify(webPageData)} />}{!shouldNoindex && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />}{shouldNoindex && <meta name="robots" content="noindex,nofollow" />}{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
<link rel="icon" type="image/svg+xml" href="/materuni-hosts-logo-round.svg" /><link rel="preconnect" href={supabaseUrl} crossorigin /><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">


<style is:global>
body.admin-shell .site-header,body.admin-shell .site-footer,body.admin-shell .mh-concierge{display:none!important}
body.admin-shell{min-height:100vh}body.admin-shell .admin-main{width:100%;max-width:1440px;margin:0 auto;padding:clamp(18px,3vw,42px);min-height:calc(100vh - 58px)}body.admin-shell .admin-main>.page-hero{margin:0 0 22px;padding:0;background:transparent}body.admin-shell .admin-main .booking-wrap{width:100%;max-width:none;margin:0;padding:0}body.admin-shell .admin-main .booking-panel{border:1px solid #e1d9cc;border-radius:16px;box-shadow:0 12px 36px rgba(26,51,34,.07)}body.admin-shell .admin-main .button{min-height:42px}
body.admin-shell{background:#f4f0e8}
body.admin-shell .admin-topbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:14px clamp(18px,4vw,56px);background:#1A3322;color:#FAF7F2;border-bottom:1px solid #C5A059}
body.admin-shell .admin-brand{font-family:Manrope,sans-serif;font-weight:800;letter-spacing:.02em;color:inherit;text-decoration:none}
body.admin-shell .admin-brand span{font-size:.65rem;letter-spacing:.16em;color:#C5A059;margin-left:.55rem}
body.admin-shell .admin-view-site{color:#FAF7F2;text-decoration:none;border:1px solid rgba(250,247,242,.45);border-radius:999px;padding:.6rem .95rem;font-size:.82rem;font-weight:700}
body.admin-shell .admin-view-site:hover{background:rgba(250,247,242,.12)}
body.admin-shell #main-content{min-height:calc(100vh - 58px)}
@media(max-width:600px){body.admin-shell .admin-topbar{padding:12px 16px}body.admin-shell .admin-view-site{font-size:.75rem;padding:.55rem .7rem}}
</style>
</head>
<body class={Astro.url.pathname.startsWith("/admin") ? "admin-shell" : "public-shell"}>
<a class="skip-link" href="#main-content">Skip to content</a>
{!isAdmin && <header class="site-header"><a class="brand" href="/" aria-label="Materuni Hosts home"><img class="brand-logo" src="/materuni-hosts-logo-round.svg" alt="Materuni Hosts logo" width="86" height="86" /></a>
<nav id="primary-navigation" aria-label="Main navigation"><a href="/" data-i18n="nav_home" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>Home</a><a class="nav-camping" href="/camping" data-i18n="nav_camping">Materuni Camping</a><a href="/day-trips" data-i18n="nav_day_trips">Day Trips</a><a href="/experiences" data-i18n="nav_experiences">All Experiences</a><a href="/sustainability" data-i18n="nav_community">Community & sustainability</a><a href="/reviews" data-i18n="nav_reviews">Guest reviews</a><a href="/faq" data-i18n="nav_faqs">FAQs</a><a class="nav-cta" href="/booking" data-i18n="nav_availability">Check availability</a></nav>
<label class="language-control" for="site-language"><span class="sr-only">Website language</span><select id="site-language" aria-label="Website language"><option value="en">EN</option><option value="es">ES</option><option value="fr">FR</option><option value="de">DE</option></select></label><button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="primary-navigation" aria-expanded="false">☰</button></header>}
<script>
// @ts-nocheck
import { supabaseUrl, publishableKey } from "../lib/supabase-public";
(() => {
 const supported=["en","es","fr","de"], labels={
  en:{skip:"Skip to content",ask:"Ask a local host",footer:"Community-based Chagga experiences in Materuni Village, Moshi, Tanzania.",explore:"Explore",book:"Book your experience"},
  es:{skip:"Ir al contenido",ask:"Habla con un anfitrión",footer:"Experiencias chagga comunitarias en Materuni Village, Moshi, Tanzania.",explore:"Explorar",book:"Reserva tu experiencia"},
  fr:{skip:"Aller au contenu",ask:"Parler à un hôte local",footer:"Expériences chagga communautaires à Materuni Village, Moshi, Tanzanie.",explore:"Explorer",book:"Réserver votre expérience"},
  de:{skip:"Zum Inhalt",ask:"Lokalen Gastgeber fragen",footer:"Gemeinschaftsbasierte Chagga-Erlebnisse in Materuni Village, Moshi, Tansania.",explore:"Entdecken",book:"Erlebnis buchen"}
 };
 const select=document.getElementById("site-language"), saved=localStorage.getItem("materuni-language"), requested=new URLSearchParams(location.search).get("lang");
 const menuButton=document.querySelector(".menu-toggle"),mainNav=document.getElementById("primary-navigation");
 const closeMenu=()=>{mainNav?.classList.remove("open");menuButton?.setAttribute("aria-expanded","false");menuButton?.setAttribute("aria-label","Open menu");if(menuButton)menuButton.textContent="☰"};
 menuButton?.addEventListener("click",()=>{const open=mainNav?.classList.toggle("open")??false;menuButton.setAttribute("aria-expanded",String(open));menuButton.setAttribute("aria-label",open?"Close menu":"Open menu");menuButton.textContent=open?"×":"☰"});
 mainNav?.addEventListener("click",event=>{if(event.target instanceof Element&&event.target.closest("a")&&mainNav.classList.contains("open"))closeMenu()});
 document.addEventListener("keydown",event=>{if(event.key==="Escape"&&mainNav?.classList.contains("open")){closeMenu();menuButton?.focus()}});
 const lang=supported.includes(requested)?requested:(supported.includes(saved)?saved:(supported.includes((navigator.language||"en").slice(0,2).toLowerCase())?(navigator.language||"en").slice(0,2).toLowerCase():"en"));
 function apply(language){
  const t=labels[language]||labels.en;document.documentElement.lang=language;select.value=language;
  const skip=document.querySelector(".skip-link");if(skip)skip.textContent=t.skip;
  const ask=document.querySelector(".mh-concierge-launch span:last-child");if(ask)ask.textContent=t.ask;
  const footerIntro=document.querySelector(".site-footer>div:first-child>p");if(footerIntro)footerIntro.textContent=t.footer;
  const explore=document.querySelector(".site-footer>div:nth-child(2)>strong");if(explore)explore.textContent=t.explore;
  const booking=document.querySelector('.site-footer a[href="/booking"]');if(booking)booking.textContent=t.book;
  localStorage.setItem("materuni-language",language);
  const currentUrl=new URL(location.href);currentUrl.searchParams.set("lang",language);history.replaceState(null,"",currentUrl.pathname+currentUrl.search+currentUrl.hash);
  document.querySelectorAll('a[href^="/"]').forEach(link=>{const target=new URL(link.getAttribute("href"),location.origin);target.searchParams.set("lang",language);link.setAttribute("href",target.pathname+target.search+target.hash)});
  const chat=document.getElementById("mh-chat-language");if(chat&&chat.value!==language){chat.value=language;chat.dispatchEvent(new Event("change"))}
 }
 apply(lang);select.addEventListener("change",()=>{apply(select.value);loadPageTranslations(select.value)});
 async function loadPageTranslations(language){
  const nodes=[...document.querySelectorAll("[data-i18n]")];
  nodes.forEach(node=>{if(!node.dataset.i18nDefault)node.dataset.i18nDefault=node.textContent||""});
  const placeholders=[...document.querySelectorAll("[data-i18n-placeholder]")];
  placeholders.forEach(node=>{if(!node.dataset.i18nPlaceholderDefault)node.dataset.i18nPlaceholderDefault=node.getAttribute("placeholder")||""});
  if(language==="en"){nodes.forEach(node=>{node.textContent=node.dataset.i18nDefault||""});placeholders.forEach(node=>node.setAttribute("placeholder",node.dataset.i18nPlaceholderDefault||""));return}
  const fallback=pageFallbacks[language]||{};
  nodes.forEach(node=>{const value=fallback[node.dataset.i18n];if(typeof value==="string")node.textContent=value});
  try{
   const response=await fetch(`${supabaseUrl}/rest/v1/site_settings?select=setting_value&setting_key=eq.language_content`,{headers:{apikey:publishableKey,Authorization:"Bearer "+publishableKey},cache:"no-store"});
   if(!response.ok)return;
   const rows=await response.json();const data=JSON.parse(rows?.[0]?.setting_value||"{}");const translations=data?.[language]||{};
   document.querySelectorAll("[data-i18n]").forEach(node=>{const value=translations[node.dataset.i18n];if(typeof value==="string"&&value.trim())node.textContent=value});
   placeholders.forEach(node=>{const value=translations[node.dataset.i18nPlaceholder];if(typeof value==="string"&&value.trim())node.setAttribute("placeholder",value)});
  }catch(error){console.warn("Optional page translations unavailable.",error)}
 }
 const pageFallbacks={
  es:{
   exp_per_person:"POR PERSONA",exp_notice:"Todos los precios son por persona en USD. Guía TZS orientativa (15 oct 2026; 1 USD ≈ 2.640 TZS): $65 ≈ 172.000 TZS · $75 ≈ 198.000 TZS · $85 ≈ 224.000 TZS · $110 ≈ 290.000 TZS · $135 ≈ 356.000 TZS. El transporte no está incluido salvo acuerdo previo. Tu anfitrión confirma el importe final antes del pago.",day_price_note:"Precios por persona. Guía TZS orientativa (15 oct 2026; 1 USD ≈ 2.640 TZS): $65 ≈ 172.000 TZS · $75 ≈ 198.000 TZS · $85 ≈ 224.000 TZS · $110 ≈ 290.000 TZS · $135 ≈ 356.000 TZS. Confirma las inclusiones con tu anfitrión antes de reservar.",day_duration_waterfall:"Duración · 7–8 horas",day_duration_coffee:"Duración · 4–5 horas",day_duration_cooking:"Duración · 5–6 horas",itinerary_currency_note:"Precios orientativos en TZS (15 oct 2026; 1 USD ≈ 2.640 TZS): $65 ≈ 172.000 TZS · $75 ≈ 198.000 TZS · $85 ≈ 224.000 TZS · $110 ≈ 290.000 TZS · $135 ≈ 356.000 TZS. Algunas actividades pueden solaparse; tu anfitrión confirmará el plan y el precio final antes del pago.",terms_eyebrow:"ANTES DE RESERVAR",terms_title:"Condiciones de reserva claras y sencillas.",terms_intro:"Qué debes saber al planificar una experiencia en Materuni con un anfitrión local.",terms_booking_title:"Solicitudes de reserva",terms_booking_body:"Enviar el formulario crea una solicitud, no una reserva confirmada. Tu anfitrión revisará la experiencia, la fecha, el tamaño del grupo y la disponibilidad, y después se pondrá en contacto contigo para confirmar los detalles.",terms_prices_title:"Precios",terms_prices_body:"Los precios publicados se muestran en dólares estadounidenses por persona. El total depende de la experiencia y del número de participantes. Tu anfitrión confirmará los detalles y el importe final antes de aceptar la reserva.",terms_transport_title:"Traslados y recogida",terms_transport_body:"Los traslados y la recogida se acuerdan por separado. Indica tu hotel o punto de recogida preferido. No des por incluido el transporte salvo que tu anfitrión lo confirme por escrito.",terms_payment_title:"Pago",terms_payment_body:"Actualmente no hay pago con tarjeta en esta web. Tras confirmar los detalles de la reserva, recibirás las instrucciones de pago. No envíes dinero a una cuenta que Materuni Hosts no haya confirmado.",terms_safety_title:"Condiciones de la experiencia y seguridad",terms_safety_body:"Algunas actividades incluyen caminos naturales irregulares, mojados o empinados. Usa calzado adecuado y sigue las instrucciones del guía. Las condiciones de la cascada y del baño pueden cambiar; solo debes nadar si las condiciones locales y tu guía lo permiten. Informa con antelación sobre movilidad, salud, dieta u otras necesidades prácticas.",terms_weather_title:"Clima y estado de los senderos",terms_weather_body:"La lluvia, los senderos y el nivel del agua pueden afectar la caminata a la cascada y otras actividades al aire libre. Por seguridad, el guía puede recomendar cambiar la ruta, modificar la actividad o reprogramarla. Tu anfitrión explicará las opciones y cualquier diferencia de precio antes de que aceptes el cambio.",terms_deposit_title:"Depósitos y momento del pago",terms_deposit_body:"Enviar una consulta no requiere depósito ni pago. Si se solicita un depósito para una reserva confirmada, tu anfitrión indicará por escrito el importe, la fecha límite, el método de pago y las condiciones de reembolso junto con el presupuesto final. No pagues hasta revisar esas condiciones y recibir la confirmación escrita.",terms_children_title:"Niños y jóvenes",terms_children_body:"Indica las edades de los niños en tu consulta. Los menores de 18 años deben ir acompañados por un adulto responsable. El sendero, el terreno irregular, el clima y el camping pueden no ser adecuados para todas las edades; tu anfitrión hablará contigo sobre la idoneidad antes de aceptar la reserva.",terms_changes_title:"Cambios y cancelaciones",terms_changes_body:"Para cambiar o cancelar una reserva confirmada, contacta con tu anfitrión cuanto antes e incluye la referencia. Los cambios dependen de la disponibilidad. Los plazos de cancelación, reembolsos y opciones por mal tiempo aplicables deben entregarse por escrito antes del pago. Solicita estas condiciones si aún no las has recibido.",terms_contact_title:"Contacto",exp_best_for:"IDEAL PARA",exp_signature_moments:"MOMENTOS DESTACADOS",exp_unique_experience:"TU EXPERIENCIA ÚNICA",exp_shared_inclusions:"Incluido en todas las experiencias de Materuni Hosts",nav_camping:"Camping en Materuni",nav_day_trips:"Excursiones de un día",nav_experiences:"Experiencias",nav_community:"Comunidad y sostenibilidad",nav_reviews:"Opiniones de huéspedes",nav_faqs:"Preguntas frecuentes",nav_availability:"Consultar disponibilidad",
   booking_transfer_label:"Solicitar presupuesto de traslado (opcional)",booking_transfer_none:"Sin traslado / por cuenta propia",booking_transfer_moshi:"Solicitar recogida en Moshi",booking_transfer_arusha:"Solicitar recogida en Arusha",booking_transfer_kia:"Solicitar recogida en KIA",booking_transfer_note:"El traslado no está incluido en el precio. Los tiempos aproximados por carretera son 45–60 minutos desde Moshi, 2,5–3 horas desde Arusha y 1,5–2 horas desde el aeropuerto KIA. El tiempo real depende del punto de recogida, la ruta, la carretera y el tráfico. Tu anfitrión confirmará disponibilidad y presupuesto por separado.",booking_reviews_intro:"Opiniones independientes de viajeros:",booking_reviews_link:"Leer opiniones",booking_leave_review:"Dejar una opinión en Google",
   home_host_eyebrow:"ANFITRIONES LOCALES · OPINIONES REALES",home_host_title:"Descubre Materuni con las personas que viven aquí.",home_host_intro:"Tu visita te acerca a anfitriones locales, senderos del pueblo, tradiciones chagga del café y comida preparada como parte de la experiencia. Publicaremos nombres y retratos aprobados cuando cada perfil esté confirmado; no utilizamos biografías inventadas ni fotografías de anfitriones falsas.",home_host_review_cta:"Información sobre opiniones",home_host_leave_review:"Dejar una opinión en Google",home_host_body:"Viaja al ritmo del pueblo.",home_host_impact_note:"Las experiencias se centran en guías locales, tradiciones del café y la cocina, y en conocer la vida cotidiana de Materuni. Publicaremos cifras verificadas sobre el impacto comunitario cuando se confirme el destino de las aportaciones locales.",home_host_currency:"Guía TZS orientativa (15 oct 2026; 1 USD ≈ TZS 2.640): $65 ≈ 172.000 TZS · $75 ≈ 198.000 TZS · $85 ≈ 224.000 TZS · $110 ≈ 290.000 TZS · $135 ≈ 356.000 TZS. Importes redondeados; el anfitrión confirma el precio final antes del pago.",
   camping_details_eyebrow:"DETALLES DE LA NOCHE",camping_details_title:"Una noche sencilla, acogedora y bien organizada.",camping_details_intro:"Una noche de camping con montaje del equipo, cena, desayuno y tiempo alrededor de la hoguera. Tu anfitrión confirmará el tipo de alojamiento y los detalles prácticos antes del pago.",camping_details_facts_title:"Qué incluye y qué debes confirmar",camping_details_fact_1:"Incluido: una experiencia de camping de una noche y montaje del equipo",camping_details_fact_2:"Confirmado: cena y desayuno, tiempo junto a la hoguera y atención local",camping_details_fact_3:"Antes de pagar, confirma con tu anfitrión la ropa de cama, el acceso a baños y duchas, las condiciones nocturnas y qué artículos personales debes llevar",camping_details_fact_4:"Ultimate incluye equipo de camping mejorado; confirma con tu anfitrión el equipo exacto disponible",
   estimate_heading:"RESUMEN DE TU EXPERIENCIA",estimate_note:"Estimación orientativa",estimate_experience:"Experiencia seleccionada",estimate_unit:"Precio por persona",estimate_total:"Total estimado del grupo",estimate_disclaimer:"Estimación basada en el precio publicado y el número de participantes. El transporte y los extras acordados por separado no están incluidos. Guía TZS orientativa (15 oct 2026; 1 USD ≈ 2.640 TZS): $65 ≈ 172.000 TZS · $75 ≈ 198.000 TZS · $85 ≈ 224.000 TZS · $110 ≈ 290.000 TZS · $135 ≈ 356.000 TZS. El anfitrión confirma el importe final antes del pago.",guest_story_eyebrow:"HISTORIAS DE HUÉSPEDES · EXPERIENCIAS REALES",guest_story_title:"Los mejores recuerdos los cuentan quienes los vivieron.",guest_story_body:"Consulta las opiniones públicas de quienes han visitado Materuni o comparte tu experiencia después de viajar con nosotros. Publicamos opiniones auténticas, nunca testimonios ni valoraciones inventados.",guest_story_reviews:"Leer opiniones de huéspedes ↗",guest_story_how:"Cómo ayudan las opiniones",
   home_hero_title:"Pasa una noche en un pueblo chagga, en las laderas del Kilimanjaro.",home_hero_intro:"Haz de una noche en las estribaciones del Kilimanjaro parte de tu viaje. Materuni Camping reúne naturaleza, tradiciones chagga del café y la cocina, relatos del pueblo y momentos auténticos con anfitriones locales.",home_hero_book:"Reserva Materuni Camping",home_hero_cta:"Descubre Materuni Camping",home_hero_secondary:"Explora las excursiones de un día",
   home_section_eyebrow:"LA ESTANCIA EMBLEMÁTICA DE MATERUNI",home_section_title:"Una experiencia de camping. Muchas formas de conectar.",home_section_intro:"Materuni Camping es nuestra experiencia principal: una estancia nocturna enriquecida por la cascada, el café chagga, la cocina local, la cultura del pueblo y momentos junto a la hoguera.",
   home_story_eyebrow:"COMUNIDAD · CULTURA · CONSERVACIÓN",home_story_title:"Una estancia creada por la gente y el entorno de Materuni.",home_story_intro:"Creemos que viajar debe crear conexiones significativas y respetar los lugares que nos reciben. A través de una experiencia comunitaria, descubrirás el patrimonio chagga, la gastronomía local y la vida cotidiana del pueblo.",
   experiences_hero_title:"Comienza con Materuni Camping. Haz del pueblo parte de tu historia.",experiences_hero_intro:"Nuestra experiencia principal es una estancia nocturna comunitaria en Materuni Village. Los paseos a la cascada, el café chagga, la cocina y las actividades culturales enriquecen la estancia; también se pueden organizar visitas más cortas.",
   story_community_title:"La comunidad es lo primero",story_community_body:"Conoce a los anfitriones locales y descubre Materuni a través de sus conocimientos y participación.",story_culture_title:"La cultura chagga viva",story_culture_body:"Descubre con respeto las tradiciones del café, la gastronomía, los relatos y las prácticas culturales.",story_environment_title:"Cuidar el medio ambiente",story_environment_body:"Disfruta responsablemente del bosque y la montaña, y deja la naturaleza tal como la encontraste.",story_sustainability_title:"Sostenibilidad consciente",story_sustainability_body:"Elige experiencias pausadas y significativas que valoren a la comunidad, la cultura y el entorno.",home_story_cta:"Nuestro enfoque",
   camping_proof_night:"Una estancia más tranquila en Materuni",camping_proof_rate:"Precio publicado por persona",camping_proof_hosts:"Anfitriones locales",camping_proof_connection:"Conexión con la comunidad chagga",camping_story_kicker:"MÁS QUE UN LUGAR PARA DORMIR",camping_story_feature_1:"Camping nocturno con montaje del equipo",camping_story_feature_2:"Visita guiada a la cascada y al pueblo",camping_story_feature_3:"Cocina chagga, cena local y desayuno",camping_story_feature_4:"Relatos junto a la hoguera con anfitriones locales",camping_story_cta:"Solicitar una estancia de camping",camping_offers_kicker:"ELIGE CÓMO QUIERES ALOJARTE",camping_offers_intro:"Elige la estancia nocturna o combínala con más experiencias en las laderas y el pueblo. Tu anfitrión te ayudará a organizar los detalles según tus fechas y grupo.",camping_offer_one_kicker:"ESTANCIA NOCTURNA EMBLEMÁTICA",camping_offer_one_intro:"Una noche en el pueblo con camping, cascada, experiencias culturales, comida local y tiempo con tus anfitriones.",camping_offer_two_kicker:"UNA EXPERIENCIA MÁS COMPLETA EN MATERUNI",camping_offer_two_intro:"Combina la cascada, la cocina chagga, las tradiciones del café y una noche de camping en una visita más completa.",camping_cross_intro:"Descubre la cascada, el café y la cultura chagga con una de nuestras excursiones guiadas de un día.",camping_cross_cta:"Explorar excursiones",camping_pricing_note:"Los precios son por persona. Guía TZS orientativa (15 oct 2026; 1 USD ≈ 2.640 TZS): $65 ≈ 172.000 TZS · $75 ≈ 198.000 TZS · $85 ≈ 224.000 TZS · $110 ≈ 290.000 TZS · $135 ≈ 356.000 TZS. El transporte, gastos personales y propinas no están incluidos salvo acuerdo previo. Tu anfitrión confirma disponibilidad y precio final.",camping_faq_kicker:"INFORMACIÓN ÚTIL",camping_faq_intro:"Queremos que sepas qué esperar para que llegues con tranquilidad y disfrutes del pueblo.",camping_faq_q1:"¿El camping es adecuado para quienes vienen por primera vez?",camping_faq_q2:"¿Está incluido 