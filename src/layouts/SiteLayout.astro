---
import "../styles/global.css";
const { title = "Materuni Hosts | Authentic Chagga Experiences", description = "Discover authentic Chagga coffee, waterfalls, food and village life in Materuni, Kilimanjaro, Tanzania.", noindex = false, preloadImage = null } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://materunihosts.com").toString();
const breadcrumbLabels: Record<string, string> = {
  experiences: "Experiences",
  itinerary: "Build itinerary",
  booking: "Check availability",
  reviews: "Guest reviews",
  faq: "Frequently asked questions",
  sustainability: "Our approach",
  "travel-guide": "Travel guide",
  privacy: "Privacy policy",
  terms: "Booking terms"
};
const breadcrumbParts = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = [{ "@type": "ListItem", position: 1, name: "Home", item: "https://materunihosts.com/" }];
if (!noindex) {
  breadcrumbParts.forEach((part, index) => {
    const label = breadcrumbLabels[part];
    if (label) breadcrumbItems.push({
      "@type": "ListItem",
      position: breadcrumbItems.length + 1,
      name: label,
      item: new URL("/" + breadcrumbParts.slice(0, index + 1).join("/"), "https://materunihosts.com").toString()
    });
  });
}
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems
};
const socialImage = preloadImage ?? "https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/hero_image/1791600514716-b2bclfcnhhh.jpg";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TourOperator",
  "name": "Materuni Hosts",
  "url": "https://materunihosts.com/",
  "logo": "https://materunihosts.com/materuni-hosts-logo-round.svg",
  "image": socialImage,
  "description": "Materuni Camping and authentic Chagga coffee, waterfall, cooking and village experiences hosted by local hosts in Materuni Village near Moshi, Tanzania.",
  "telephone": "+255612068540",
  "email": "hello@materunihosts.com",
  "priceRange": "USD 50–135 per person",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Materuni Village",
    "addressRegion": "Kilimanjaro",
    "addressCountry": "TZ"
  },
  "areaServed": {
    "@type": "Place",
    "name": "Materuni Village, Moshi, Kilimanjaro, Tanzania"
  }
};
