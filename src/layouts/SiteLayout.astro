---
import "../styles/global.css";
const { title = "Materuni Hosts | Authentic Chagga Experiences", description = "Discover authentic Chagga coffee, waterfalls, food and village life in Materuni, Kilimanjaro, Tanzania.", noindex = false, preloadImage = null } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://materunihosts.com").toString();
const socialImage = preloadImage ?? "https://sskmzswoeljxwojcszta.supabase.co/storage/v1/object/public/materuni-images/hero_image/1791600514716-b2bclfcnhhh.jpg";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TourOperator",
  "name": "Materuni Hosts",
  "url": "https://materunihosts.com/",
  "logo": "https://materunihosts.com/materuni-hosts-logo-round.svg",
  "image": socialImage,
  "description": "Authentic Chagga coffee, waterfall, cooking and village experiences hosted in Materuni Village near Moshi, Tanzania.",
  "telephone": "+255612068540",
  "email": "hello@materunihosts.com",
  "priceRange": "USD 50–135 per person",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Materuni Village",
    "addressRegion": "Kilimanjaro",
    "addressCountry": "TZ"
  },
  "areaServed": {
    "@type": "Place",
    "name": "Materuni Village, Moshi, Kilimanjaro, Tanzania"
  }
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title><meta name="description" content={description} /><meta name="theme-color" content="#1A3322" /><link rel="canonical" href={canonical} /><meta property="og:type" content="website" /><meta property="og:site_name" content="Materuni Hosts" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={socialImage} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={socialImage} /><script type="application/ld+json" set:html={JSON.stringify(structuredData)} />{noindex && <meta name="robots" content="noindex,nofollow" />}{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
<link rel="icon" type="image/svg+xml" href="/materuni-hosts-logo-round.svg" /><link rel="preconnect" href="https://sskmzswoeljxwojcszta.supabase.co" crossorigin /><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header"><a class="brand" href="/" aria-label="Materuni Hosts home"><img class="brand-logo" src="/materuni-hosts-logo-round.svg" alt="Materuni Hosts logo" width="86" height="86" /></a>
<nav aria-label="Main navigation"><a href="/experiences">Experiences</a><a href="/itinerary">Build itinerary</a><a href="/reviews">Guest reviews</a><a href="/faq">FAQs</a><a href="/sustainability">Our approach</a><a href="/travel-guide">Travel guide</a><a class="nav-cta" href="/booking">Check availability</a></nav>
<button class="menu-toggle" aria-label="Open menu" aria-expanded="false" onclick="const n=document.querySelector('.site-header nav');const open=n.classList.toggle('open');this.setAttribute('aria-expanded',String(open))">☰</button></header>
<main id="main-content" tabindex="-1"><slot /></main>

{!noindex && <div class="mh-concierge" id="mh-concierge">
  <button class="mh-concierge-launch" id="mh-chat-open" type="button" aria-expanded="false" aria-controls="mh-chat-panel"><span class="mh-chat-icon">✦</span><span>Ask a local host</span></button>
  <section class="mh-chat-panel" id="mh-chat-panel" hidden aria-label="Materuni Hosts guest concierge">
    <header class="mh-chat-header"><div><strong>Materuni Hosts</strong><small id="mh-chat-subtitle">Local experience concierge</small></div><button id="mh-chat-close" type="button" aria-label="Close chat">×</button></header>
    <div class="mh-chat-messages" id="mh-chat-messages" aria-live="polite"></div>
    <form class="mh-chat-form" id="mh-chat-form">
      <select id="mh-chat-language" aria-label="Chat language"><option value="en">English</option><option value="es">Español</option><option value="fr">Français</option><option value="de">Deutsch</option></select>
      <div class="mh-chat-compose"><input id="mh-chat-input" maxlength="1200" placeholder="Ask about experiences, dates or prices…" autocomplete="off" required><button id="mh-chat-send" type="submit" aria-label="Send message">Send</button></div>
    </form>
    <a class="mh-chat-whatsapp" id="mh-chat-whatsapp" href="https://wa.me/255612068540" target="_blank" rel="noopener noreferrer">Prefer a person? Chat on WhatsApp</a>
  </section>
</div>}
<script>
// @ts-nocheck
const conciergeEndpoint = "https://sskmzswoeljxwojcszta.supabase.co/functions/v1/guest-concierge";
const conciergeKey = "sb_publishable_G9ru4P_yKzievqiXjXEEbQ_p28cB_NZ";
const chatEl = id => document.getElementById(id);
const chatStore = { id: "materuni_chat_session", token: "materuni_chat_token" };
let chatSessionId = sessionStorage.getItem(chatStore.id) || "";
let chatSessionToken = sessionStorage.getItem(chatStore.token) || "";
const chatGreetings = {
  en: "Hello! I’m your Materuni Hosts concierge. I can help you choose an experience, understand prices and plan your visit. What would you like to know?",
  es: "¡Hola! Soy tu asistente de Materuni Hosts. Puedo ayudarte a elegir una experiencia, conocer los precios y planificar tu visita. ¿Qué te gustaría saber?",
  fr: "Bonjour ! Je suis votre concierge Materuni Hosts. Je peux vous aider à choisir une expérience, comprendre les prix et organiser votre visite. Que souhaitez-vous savoir ?",
  de: "Hallo! Ich bin Ihr Materuni Hosts Concierge. Ich helfe Ihnen bei der Auswahl eines Erlebnisses, den Preisen und der Planung Ihres Besuchs. Was möchten Sie wissen?"
};
const detectedLanguage = (navigator.language || "en").slice(0,2).toLowerCase();
const languageSelect = chatEl("mh-chat-language");
if (languageSelect) languageSelect.value = ["en","es","fr","de"].includes(detectedLanguage) ? detectedLanguage : "en";
function chatBubble(role, message, mode) {
  const list = chatEl("mh-chat-messages");
  const bubble = document.createElement("div");
  bubble.className = "mh-chat-bubble " + role;
  if (mode) {
    const label = document.createElement("small");
    label.className = "mh-chat-mode";
    label.textContent = mode === "ai" ? "AI concierge" : "Guest guide";
    bubble.append(label);
  }
  const text = document.createElement("p");
  text.textContent = message;
  bubble.append(text);
  list.append(bubble);
  list.scrollTop = list.scrollHeight;
  return bubble;
}
if (chatEl("mh-chat-open")) {
  chatBubble("assistant", chatGreetings[languageSelect.value] || chatGreetings.en);
  chatEl("mh-chat-open").addEventListener("click", () => {
    const panel = chatEl("mh-chat-panel");
    panel.hidden = !panel.hidden;
    chatEl("mh-chat-open").setAttribute("aria-expanded", String(!panel.hidden));
    if (!panel.hidden) chatEl("mh-chat-input").focus();
  });
  chatEl("mh-chat-close").addEventListener("click", () => {
    chatEl("mh-chat-panel").hidden = true;
    chatEl("mh-chat-open").setAttribute("aria-expanded", "false");
  });
  languageSelect.addEventListener("change", () => {
    const language = languageSelect.value;
    chatEl("mh-chat-subtitle").textContent = ({en:"Local experience concierge",es:"Asistente de experiencias locales",fr:"Concierge d’expériences locales",de:"Lokaler Erlebnis-Concierge"})[language];
    chatEl("mh-chat-input").placeholder = ({en:"Ask about experiences, dates or prices…",es:"Pregunta sobre experiencias, fechas o precios…",fr:"Posez vos questions sur les expériences, dates ou prix…",de:"Fragen zu Erlebnissen, Terminen oder Preisen…"})[language];
    chatEl("mh-chat-whatsapp").textContent = ({en:"Prefer a person? Chat on WhatsApp",es:"¿Prefieres hablar con una persona? WhatsApp",fr:"Vous préférez un hôte ? Écrivez sur WhatsApp",de:"Lieber persönlich sprechen? WhatsApp"})[language];
    chatBubble("assistant", chatGreetings[language] || chatGreetings.en);
  });
  chatEl("mh-chat-form").addEventListener("submit", async event => {
    event.preventDefault();
    const input = chatEl("mh-chat-input");
    const send = chatEl("mh-chat-send");
    const message = input.value.trim();
    if (!message) return;
    chatBubble("guest", message);
    input.value = "";
    input.disabled = true;
    send.disabled = true;
    const typing = chatBubble("assistant", "…");
    async function requestReply(retry = false) {
      const response = await fetch(conciergeEndpoint, {
        method: "POST",
        headers: { apikey: conciergeKey, "Content-Type": "application/json" },
        body: JSON.stringify({
          message,
          language: languageSelect.value,
          ...(chatSessionId && chatSessionToken ? { session_id: chatSessionId, session_token: chatSessionToken } : {})
        })
      });
      const data = await response.json().catch(() => ({}));
      if (response.status === 401 && !retry) {
        chatSessionId = ""; chatSessionToken = "";
        sessionStorage.removeItem(chatStore.id); sessionStorage.removeItem(chatStore.token);
        return requestReply(true);
      }
      if (!response.ok) throw new Error(data.error || "The chat is temporarily unavailable.");
      if (data.session_id) { chatSessionId = data.session_id; sessionStorage.setItem(chatStore.id, chatSessionId); }
      if (data.session_token) { chatSessionToken = data.session_token; sessionStorage.setItem(chatStore.token, chatSessionToken); }
      return data;
    }
    try {
      const data = await requestReply();
      typing.remove();
      chatBubble("assistant", data.reply || "Please contact a local host for help.", data.mode);
    } catch (error) {
      typing.remove();
      chatBubble("assistant", "I’m sorry, the chat is temporarily unavailable. Please reach our local host on WhatsApp: +255 612 068 540.");
    } finally {
      input.disabled = false;
      send.disabled = false;
      input.focus();
    }
  });
}
</script>

<footer class="site-footer"><div><a class="brand brand-light" href="/" aria-label="Materuni Hosts home"><img class="brand-logo-footer" src="/materuni-hosts-logo-round.svg" alt="Materuni Hosts logo" width="58" height="58" /></a><p>Authentic Chagga experiences in Materuni Village, Moshi, Tanzania.</p><p class="tagline">Come as a guest. Leave as a friend.</p><div class="social-links" aria-label="Social media"><a href="https://www.instagram.com/REPLACE_MATERUNI_HOSTS" data-social-key="instagram_url" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg><span>Instagram</span></a><a href="https://www.facebook.com/REPLACE_MATERUNI_HOSTS" data-social-key="facebook_url" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" stroke="none" d="M14.5 8H17V4h-3c-3.2 0-5 1.9-5 5v2H6v4h3v5h4v-5h3l1-4h-4V9c0-.7.3-1 1.5-1z"/></svg><span>Facebook</span></a><a href="https://www.tripadvisor.com/REPLACE_MATERUNI_HOSTS" data-social-key="tripadvisor_url" target="_blank" rel="noopener noreferrer" aria-label="Tripadvisor"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9c2-3 5-4 9-4s7 1 9 4"/><circle cx="8" cy="12" r="4"/><circle cx="16" cy="12" r="4"/><circle cx="8" cy="12" r="1" fill="currentColor"/><circle cx="16" cy="12" r="1" fill="currentColor"/><path d="M10.5 17l1.5 2 1.5-2"/></svg><span>Tripadvisor</span></a><a href="https://wa.me/255612068540" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z"/><path d="M9 8.5c.5 2.7 2 4.2 4.7 5l1.1-1.1 2 1c-.2 1.5-1.2 2.2-2.5 2.2-3.7-.5-6.8-3.5-7.2-7.1 0-1.3.8-2.3 2.1-2.5l1 2z"/></svg><span>WhatsApp</span></a></div></div>
<div><strong>Explore</strong><a href="/experiences">Our experiences</a><a href="/itinerary">Build your itinerary</a><a href="/reviews">Guest reviews</a><a href="/faq">FAQs</a><a href="/sustainability">Our approach</a><a href="/travel-guide">Travel guide</a><a href="/privacy">Privacy</a><a href="/terms">Booking terms</a><a href="/booking">Book your experience</a></div>
<div><strong>Talk to a local host</strong><a href="https://wa.me/255612068540" target="_blank" rel="noopener noreferrer">WhatsApp +255 612 068 540</a><a href="mailto:hello@materunihosts.com">hello@materunihosts.com</a><span>Materuni Village, Moshi · Tanzania</span></div><div class="copyright">© {new Date().getFullYear()} Materuni Hosts. Thoughtful experiences, rooted in place.</div></footer>
<script>
// @ts-nocheck

const settingsEndpoint="https://sskmzswoeljxwojcszta.supabase.co/rest/v1/site_settings?select=setting_key,setting_value";
const publicKey="sb_publishable_G9ru4P_yKzievqiXjXEEbQ_p28cB_NZ";
fetch(settingsEndpoint,{headers:{"apikey":publicKey,"Authorization":"Bearer "+publicKey}}).then(response=>response.ok?response.json():[]).then(rows=>rows.forEach(row=>{const link=document.querySelector('[data-social-key="'+row.setting_key+'"]');if(link&&row.setting_value.startsWith("https://"))link.href=row.setting_value;})).catch(()=>{});
</script>
</body></html>